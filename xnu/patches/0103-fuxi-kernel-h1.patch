+	printf("FUXI HUMAN: starts in %u s, %u loops\n", (unsigned)(uintptr_t)arg, fk_human_loops);
+	fk_script_sleep((unsigned)(uintptr_t)arg * 1000u);
+	for (unsigned loop = 1; loop <= fk_human_loops; ++loop) {
