+		return false;
+	}
+	int mode = sweet_hid_touch_mode();
+	uint64_t now = mach_absolute_time();
+	lck_mtx_lock(&fk_hid_lock);
+	bool go = fk_arb.held[0] == 0 && fuxi_tap_wake_allowed(mode, now, &fk_tap_last, interval);
