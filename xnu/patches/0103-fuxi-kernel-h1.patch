+		(void)fk_deliver_locked(0, FUXI_KEY_SRC_TAP, true, now);
+		(void)fk_deliver_locked(0, FUXI_KEY_SRC_TAP, false, now);
+	}
+	lck_mtx_unlock(&fk_hid_lock);
+	if (go) {
+		fuxi_perf_input();
+		printf("FUXI KEYS: tap-to-wake power click (touch mode %#x)\n", mode);
+	}
+	return go;
