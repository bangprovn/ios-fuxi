+ */
+bool
+fuxi_keys_touch_wake(void)
+{
+	static int enabled = -1;
+	static uint64_t interval;
+	if (enabled < 0) {
+		int on = 0;
+		(void)PE_parse_boot_argn("fuxitaptowake", &on, sizeof(on));
+		nanoseconds_to_absolutetime(1500 * NSEC_PER_MSEC, &interval);
+		enabled = on == 1;
