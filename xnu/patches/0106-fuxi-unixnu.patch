+	IOLockUnlock(fb->fLock);
+	IOLog("SWEET FB: display %s\n", off ? "off" : "on");
+#if defined(FUXI)
+	if (fb->fBacklightPowerNotifications) fuxi_backlight_display_state(fb, !off);
+#endif
+	return kIOReturnSuccess;
