--- /dev/null
+++ b/bsd/dev/fuxi_ath12k_os.c
@@ -0,0 +1,165 @@
+/*
+ * FUXI ATH12K, the XNU side of the driver domain's calls (compat/include/lx_os.h): memory, time,
+ * threads, one lock to sleep under, boot arguments. The DMA pool is fuxi_wlan.c's, which owns the
+ * SMMU window. Only kernels built with patch 0117 have this file.
+ *
+ * Adapted from hackios drivers/wifi/hakios.lx.c (APSL 2.0, as the rest of this kernel's sources).
+ */
+#if defined(FUXI) && defined(FUXI_ATH12K)
+#include <kern/clock.h>
+#include <kern/kalloc.h>
+#include <kern/locks.h>
+#include <kern/sched_prim.h>
+#include <kern/thread.h>
+#include <libkern/libkern.h>
+#include <mach/mach_types.h>
+#include <pexpert/pexpert.h>
+#include <sys/errno.h>
+#include <sys/random.h>
+#include <sys/systm.h>
+
+#include "fa_xnu.h"
+#include "fa_lx_os.h"
+
+extern kern_return_t thread_terminate(thread_t thread);
+extern void thread_set_thread_name(thread_t thread, const char *name);
+
+static LCK_GRP_DECLARE(fa_lock_group, "fuxi-ath12k");
+static LCK_MTX_DECLARE(fa_lock, &fa_lock_group);
+static LCK_MTX_DECLARE(fa_mhi_lock, &fa_lock_group);
+
+void *
+lx_os_alloc(unsigned long size)
+{
+	return kalloc_data(size, Z_WAITOK | Z_ZERO);
+}
+
+void
+lx_os_free(void *memory, unsigned long size)
+{
+	kfree_data(memory, size);
+}
+
+void
+lx_os_print(const char *text)
+{
+	printf("%s", text);
+}
+
+void
+lx_os_tell(const char *text)
+{
+	printf("%s", text);
+}
+
+void
+lx_os_panic(const char *text)
+{
+	panic("%s", text);
+}
+
+unsigned long long
+lx_os_nanoseconds(void)
+{
+	uint64_t nanoseconds;
+
+	absolutetime_to_nanoseconds(mach_absolute_time(), &nanoseconds);
+	return nanoseconds;
+}
+
+void *
+lx_os_thread_self(void)
+{
+	return current_thread();
+}
+
+struct fa_thread {
+	void (*function)(void *);
+	void *argument;
+};
+
+static void
+fa_thread_runs(void *parameter, __unused wait_result_t result)
+{
+	struct fa_thread start = *(struct fa_thread *)parameter;
+
+	kfree_type(struct fa_thread, parameter);
+	start.function(start.argument);
+	(void)thread_terminate(current_thread());
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+int
+lx_os_thread(const char *name, void (*function)(void *), void *argument)
+{
+	struct fa_thread *start = kalloc_type(struct fa_thread, Z_WAITOK | Z_ZERO);
+	thread_t thread;
+
+	if (start == NULL) {
+		return ENOMEM;
+	}
+	start->function = function;
+	start->argument = argument;
+	if (kernel_thread_start(fa_thread_runs, start, &thread) != KERN_SUCCESS) {
+		kfree_type(struct fa_thread, start);
+		return EAGAIN;
+	}
+	thread_set_thread_name(thread, name);
+	thread_deallocate(thread);
+	return 0;
+}
+
+void
+lx_os_lock(void)
+{
+	lck_mtx_lock(&fa_lock);
+}
+
+void
+lx_os_unlock(void)
+{
+	lck_mtx_unlock(&fa_lock);
+}
+
+void
+lx_os_sleep(const void *address, unsigned long long nanoseconds)
+{
+	uint64_t deadline;
+
+	nanoseconds_to_absolutetime(nanoseconds, &deadline);
+	deadline += mach_absolute_time();
+	(void)lck_mtx_sleep_deadline(&fa_lock, LCK_SLEEP_DEFAULT, (event_t)address, THREAD_UNINT, deadline);
+}
+
+void
+lx_os_wakeup(const void *address)
+{
+	thread_wakeup((event_t)address);
+}
+
+void
+lx_os_random(void *buffer, unsigned long size)
+{
+	read_random(buffer, (u_int)size);
+}
+
+unsigned
+lx_os_option(const char *name)
+{
+	unsigned value = 0;
+
+	return PE_parse_boot_argn(name, &value, sizeof(value)) ? value : 0;
+}
+
+void
+fuxi_ath12k_mhi_lock(void)
+{
+	lck_mtx_lock(&fa_mhi_lock);
+}
+
+void
+fuxi_ath12k_mhi_unlock(void)
+{
+	lck_mtx_unlock(&fa_mhi_lock);
+}
+#endif /* FUXI && FUXI_ATH12K */
--- /dev/null
+++ b/bsd/dev/fuxi_ath12k_ios.c
@@ -0,0 +1,220 @@
+/*
+ * The ath12k radio as iOS's Wi-Fi backend (fuxiwifiios=2), in XNU's domain: struct fuxi_wifi_backend, whose types the
+ * driver domain does not know, forwarded to fa_xnu.h's plain C. A passphrase ends here: the key is made of it, it is wiped, and
+ * the driver takes only the key. Nothing here says a name, an address or a key. Patch 0117 carries this file to
+ * bsd/dev/fuxi_ath12k_ios.c, so that only kernel-metal4wifi has it.
+ *
+ * SPDX-License-Identifier: MIT
+ */
+#if defined(FUXI)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <sys/fuxi_wifi_ios.h>
+#include <sys/fuxi_wifi_wpa.h>
+#include "fa_xnu.h"
+
+_Static_assert((int)FUXI_WIFI_STA_OFF == FA_IOS_OFF && (int)FUXI_WIFI_STA_IDLE == FA_IOS_IDLE && (int)FUXI_WIFI_STA_SCANNING == FA_IOS_SCANNING &&
+    (int)FUXI_WIFI_STA_JOINING == FA_IOS_JOINING && (int)FUXI_WIFI_STA_JOINED == FA_IOS_JOINED, "the phases are the same numbers");
+
+const struct fuxi_wifi_backend *fuxi_ath12k_ios_backend(void);
+
+static const struct fuxi_wifi_input *ios_input;
+
+/* The two domains' errno differ: FreeBSD's EOPNOTSUPP is not XNU's. */
+static int
+ios_errno(int answer)
+{
+	switch (answer) {
+	case FA_IOS_DONE:
+		return 0;
+	case FA_IOS_NO_AUTH:
+		return EAUTH;
+	case FA_IOS_NO_ANSWER:
+		return ETIMEDOUT;
+	case FA_IOS_NOT_HEARD:
+		return ENOENT;
+	case FA_IOS_REFUSED:
+		return ECONNREFUSED;
+	case FA_IOS_NOT_BUILT:
+		return EOPNOTSUPP;
+	case FA_IOS_NO_MEMORY:
+		return ENOMEM;
+	case FA_IOS_GONE:
+		return ECONNRESET;
+	case FA_IOS_RADIO_DEAD:
+		return ENETDOWN;
+	default:
+		return EIO;
+	}
+}
+
+static void
+ios_rx(const unsigned char *frame, unsigned long length)
+{
+	ios_input->rx_frame(frame, length);
+}
+
+static void
+ios_link(int up)
+{
+	ios_input->link_state(up != 0);
+}
+
+static void
+ios_lost(int answer)
+{
+	fuxi_wifi_sta_lost(ios_errno(answer));
+}
+
+/* The Apple80211 side hears of it as of any other link: it did not ask, and what it then does is for a run to show. */
+static void
+ios_joined_alone(int answer)
+{
+	if (answer == FA_IOS_DONE) {
+		fuxi_wifi_apple80211_event(FUXI_WIFI_STA_LINK, 1);
+	}
+}
+
+static void
+ios_start(const struct fuxi_wifi_input *input)
+{
+	static const struct fa_ios_input driver = { .rx = ios_rx, .link = ios_link, .lost = ios_lost, .joined_alone = ios_joined_alone };
+
+	ios_input = input;
+	fa_ios_start(&driver);
+}
+
+static int
+ios_power(bool on)
+{
+	return ios_errno(fa_ios_power(on));
+}
+
+static int
+ios_scan(const struct fuxi_wifi_sta_scan *what)
+{
+	return ios_errno(fa_ios_scan(what->ssid, what->ssid_length, what->frequencies, what->frequency_count, what->passive));
+}
+
+static void (*ios_each)(const struct fuxi_wifi_sta_bss *, void *);
+
+/* From a table of the driver's to the shape iOS's side reads. Called on the one station thread: `bss` can be kept between calls. */
+static void
+ios_copy(const struct fa_heard *from, struct fuxi_wifi_sta_bss *to)
+{
+	bzero(to, sizeof(*to));
+	memcpy(to->bssid, from->bssid, sizeof(to->bssid));
+	memcpy(to->ssid, from->ssid, sizeof(to->ssid));
+	to->ssid_length = from->ssid_length;
+	to->frequency = from->frequency;
+	to->rssi = from->rssi;
+	to->beacon_interval = from->interval;
+	to->capability = from->capability;
+	to->age_ms = from->age_ms;
+	to->elements_length = (uint16_t)(from->elements_length < sizeof(to->elements) ? from->elements_length : sizeof(to->elements));
+	memcpy(to->elements, from->elements, to->elements_length);
+}
+
+static void
+ios_one(const struct fa_heard *from, void *context)
+{
+	static struct fuxi_wifi_sta_bss bss;
+
+	ios_copy(from, &bss);
+	ios_each(&bss, context);
+}
+
+static void
+ios_heard(void (*each)(const struct fuxi_wifi_sta_bss *, void *), void *context)
+{
+	ios_each = each;
+	fa_ios_heard(ios_one, context);
+}
+
+static int
+ios_join(const struct fuxi_wifi_sta_join *what)
+{
+	static const uint8_t none[6];
+	unsigned char key[32];
+	int answer;
+
+	if (what->security == FUXI_WIFI_STA_OPEN) {
+		answer = fa_ios_join(what->ssid, what->ssid_length, memcmp(what->bssid, none, sizeof(none)) != 0 ? what->bssid : NULL, NULL);
+		return ios_errno(answer);
+	}
+	if (what->security != FUXI_WIFI_STA_WPA2_PSK) {
+		return EOPNOTSUPP;
+	}
+	if (what->passphrase_length != 0) {
+		fuxi_wifi_wpa_pmk(what->passphrase, what->passphrase_length, what->ssid, what->ssid_length, key);
+	} else {
+		memcpy(key, what->pmk, sizeof(key));
+	}
+	answer = fa_ios_join(what->ssid, what->ssid_length, memcmp(what->bssid, none, sizeof(none)) != 0 ? what->bssid : NULL, key);
+	bzero(key, sizeof(key));
+	return ios_errno(answer);
+}
+
+static int
+ios_leave(void)
+{
+	return ios_errno(fa_ios_leave());
+}
+
+static void
+ios_state(struct fuxi_wifi_sta_state *state)
+{
+	static struct fa_ios_state from;	/* (its bytes are a beacon's: nothing secret, and the driver's lock guards the copy) */
+
+	fa_ios_state(&from);
+	bzero(state, sizeof(*state));
+	state->phase = (enum fuxi_wifi_sta_phase)from.phase;
+	state->security = from.protect ? FUXI_WIFI_STA_WPA2_PSK : FUXI_WIFI_STA_OPEN;
+	state->last_error = ios_errno(from.last_answer);
+	if (from.phase == FA_IOS_JOINED) {
+		ios_copy(&from.bss, &state->bss);
+	}
+}
+
+/*
+ * What the radio may tune to, asked only at attach, before the radio is up: the CN domain the firmware has given in every
+ * run so far (w-m2), on the phone's two bands. A channel out of the domain is left out of the scan by the driver anyway.
+ */
+static unsigned
+ios_channels(struct fuxi_wifi_sta_channel *out, unsigned most)
+{
+	static const struct fuxi_wifi_sta_channel known[] = {
+		{ 2412, 0 }, { 2417, 0 }, { 2422, 0 }, { 2427, 0 }, { 2432, 0 }, { 2437, 0 }, { 2442, 0 }, { 2447, 0 }, { 2452, 0 }, { 2457, 0 }, { 2462, 0 }, { 2467, 0 }, { 2472, 0 },
+		{ 5180, 0 }, { 5200, 0 }, { 5220, 0 }, { 5240, 0 },
+		{ 5260, FUXI_WIFI_STA_CHANNEL_PASSIVE | FUXI_WIFI_STA_CHANNEL_RADAR }, { 5280, FUXI_WIFI_STA_CHANNEL_PASSIVE | FUXI_WIFI_STA_CHANNEL_RADAR },
+		{ 5300, FUXI_WIFI_STA_CHANNEL_PASSIVE | FUXI_WIFI_STA_CHANNEL_RADAR }, { 5320, FUXI_WIFI_STA_CHANNEL_PASSIVE | FUXI_WIFI_STA_CHANNEL_RADAR },
+		{ 5745, 0 }, { 5765, 0 }, { 5785, 0 }, { 5805, 0 }, { 5825, 0 },
+	};
+	unsigned count = sizeof(known) / sizeof(known[0]);
+
+	count = count < most ? count : most;
+	memcpy(out, known, count * sizeof(*out));
+	return count;
+}
+
+static bool
+ios_tx(const uint8_t *frame, size_t length)
+{
+	return fa_ios_tx(frame, length) != 0;
+}
+
+static struct fuxi_wifi_backend ios_backend = {
+	.station = { .power = ios_power, .scan = ios_scan, .heard = ios_heard, .join = ios_join, .leave = ios_leave,
+		.state = ios_state, .channels = ios_channels },
+	.tx_frame = ios_tx, .start = ios_start,
+};
+
+/* From fuxi_wifi_ios_init(), before the root is there and long before the radio: the address is the one the radio will be given. */
+const struct fuxi_wifi_backend *
+fuxi_ath12k_ios_backend(void)
+{
+	fuxi_ath12k_station_address(ios_backend.station.address);
+	return &ios_backend;
+}
+#endif /* FUXI */
--- /dev/null
+++ b/bsd/dev/fa_xnu.h
@@ -0,0 +1,112 @@
+/*
+ * The boundary between the driver domain (this object) and the XNU domain (fuxi_wlan.c and
+ * bsd/dev/fuxi_ath12k_os.c), plain C on both sides so that no Linux or FreeBSD type crosses it.
+ * Design section 2, hand-off sequence. Patch 0117 carries this file to bsd/dev/fa_xnu.h, and
+ * tools/ath12k-undefined-allow.json lists what the object may ask for.
+ *
+ * SPDX-License-Identifier: MIT
+ */
+#ifndef _FA_XNU_H_
+#define _FA_XNU_H_
+
+#define FA_DEV_MEM_MOST		4
+#define FA_BUILD_ID_MOST	128
+
+/* The driver domain is compiled with hidden visibility: only these leave the object. */
+#define FA_PUBLIC	__attribute__((__visibility__("default")))
+
+/* What our QMI learnt from the capability response before FW_READY. */
+struct fa_caps {
+	unsigned	chip_id;
+	unsigned	chip_family;
+	unsigned	board_id;		/* 0xff when the firmware does not say */
+	unsigned	soc_id;
+	unsigned	fw_version;
+	char		fw_build_id[FA_BUILD_ID_MOST];
+	struct {
+		unsigned long long start;
+		unsigned long long size;
+	} dev_mem[FA_DEV_MEM_MOST];		/* [0] is the CMEM ath12k's dp.c uses as a base */
+};
+
+/* What ath12k_qmi_firmware_start() hands to our INI, CFG and MODE: tables as ath12k keeps them. */
+struct fa_wlan_cfg {
+	const void	*target_ce;		/* struct ce_pipe_config[]: six little-endian u32 each */
+	unsigned	 target_ce_count;
+	const void	*service_map;		/* struct service_to_pipe[]: three little-endian u32 each */
+	unsigned	 service_map_count;
+	const unsigned	*shadow;		/* register addresses, shadow_reg_v3 */
+	unsigned	 shadow_count;
+};
+
+/* The driver domain offers these. */
+FA_PUBLIC int	fa_firmware_ready(const struct fa_caps *caps, unsigned stage);	/* fw_thread, once; 0 or -errno */
+FA_PUBLIC void	fa_stop(void);			/* rings and registers left alone from now on; repeatable */
+FA_PUBLIC void	fa_set_radio_mac(const unsigned char *mac);	/* before fa_firmware_ready(): station.address */
+FA_PUBLIC void	fa_set_target_ssid(const unsigned char *name, unsigned length);	/* before it, stage 5: the open network, 1-32 bytes */
+FA_PUBLIC void	fa_set_auto_join(const unsigned char *name, unsigned length, const unsigned char *key);	/* before it, stage 8, fuxiwifiauto=1: join this once it is up */
+FA_PUBLIC void	fa_set_target_join(const unsigned char *name, unsigned length, const unsigned char *key);	/* before it, stage 6: the network and its 32-byte key */
+
+/* ---- stage 8: the radio for iOS. bsd/dev/fuxi_ath12k_ios.c is the other side. Plain answers: the domains' errno differ. ---- */
+
+enum { FA_IOS_DONE, FA_IOS_NO_AUTH, FA_IOS_NO_ANSWER, FA_IOS_NOT_HEARD, FA_IOS_REFUSED, FA_IOS_NOT_BUILT, FA_IOS_NO_MEMORY, FA_IOS_GONE, FA_IOS_RADIO_DEAD, FA_IOS_FAILED };
+enum { FA_IOS_OFF, FA_IOS_IDLE, FA_IOS_SCANNING, FA_IOS_JOINING, FA_IOS_JOINED };	/* as enum fuxi_wifi_sta_phase */
+
+#define FA_IOS_ELEMENTS_MOST	1024
+
+struct fa_heard {
+	unsigned char	bssid[6];
+	unsigned char	ssid[32];
+	unsigned char	ssid_length;
+	unsigned short	frequency;		/* MHz */
+	short		rssi;			/* dBm */
+	unsigned short	interval, capability;
+	unsigned	age_ms;			/* filled when it is handed over */
+	unsigned long long heard_at;
+	unsigned short	elements_length;
+	unsigned char	elements[FA_IOS_ELEMENTS_MOST];
+};
+
+struct fa_ios_state {
+	int		phase;
+	int		protect;		/* the network joined or being joined asks for a key */
+	int		last_answer;		/* why the last join failed or the network was lost */
+	struct fa_heard	bss;
+};
+
+/* Called on the radio's threads, never under its lock. Frames are the callee's to copy before returning. */
+struct fa_ios_input {
+	void	(*rx)(const unsigned char *frame, unsigned long length);
+	void	(*link)(int up);
+	void	(*lost)(int answer);
+	void	(*joined_alone)(int answer);	/* an auto join that nobody on iOS's side asked for came to this */
+};
+
+FA_PUBLIC void	fa_ios_start(const struct fa_ios_input *input);	/* once, before the radio is up; sends nothing yet */
+/* One thread, one at a time, each bounded. Each waits for the radio, at most a minute, and answers as above. */
+FA_PUBLIC int	fa_ios_power(int on);		/* off leaves the network and keeps the firmware up */
+FA_PUBLIC int	fa_ios_scan(const unsigned char *ssid, unsigned ssid_length, const unsigned short *frequencies, unsigned frequency_count, int passive);
+FA_PUBLIC void	fa_ios_heard(void (*each)(const struct fa_heard *, void *), void *context);
+FA_PUBLIC int	fa_ios_join(const unsigned char *ssid, unsigned ssid_length, const unsigned char *bssid, const unsigned char *key);	/* key NULL: open; bssid NULL: the best heard */
+FA_PUBLIC int	fa_ios_leave(void);
+/* Any thread. */
+FA_PUBLIC void	fa_ios_state(struct fa_ios_state *state);
+FA_PUBLIC int	fa_ios_tx(const unsigned char *frame, unsigned long length);	/* an Ethernet frame: 1 sent to the driver, 0 dropped */
+
+/* fuxi_wlan.c (FUXI_ATH12K) owes these. */
+void	 fuxi_ath12k_station_address(unsigned char *mac);	/* fuxiwifimac, or the default; says nothing */
+void	*fuxi_ath12k_bar(unsigned long *length);	/* BAR0 mapped contiguously for 0x100000 */
+unsigned fuxi_ath12k_read32(unsigned offset);		/* below 0x100000 of BAR0, fault contained */
+void	 fuxi_ath12k_write32(unsigned offset, unsigned value);
+void	 fuxi_ath12k_mhi_service(void);			/* MHI events and guard, at most every 10 ms */
+int	 fuxi_ath12k_mhi_failed(void);			/* the transport or its guard has failed: firmware or link gone */
+int	 fuxi_ath12k_firmware_start(const struct fa_wlan_cfg *cfg, unsigned mode);	/* INI, CFG, MODE */
+void	 fuxi_ath12k_firmware_stop(void);		/* MODE off */
+void	 fuxi_ath12k_contain(void);			/* containment is wanted when fw_thread gets back */
+void	 fuxi_ath12k_force_rddm(void);			/* once: read RDDM if it is there, else wl18_force_rddm */
+
+/* bsd/dev/fuxi_ath12k_os.c owes these, for fuxi_wlan.c: the MHI lock of design section 2. */
+void	 fuxi_ath12k_mhi_lock(void);
+void	 fuxi_ath12k_mhi_unlock(void);
+
+#endif
--- /dev/null
+++ b/bsd/dev/fa_lx_os.h
@@ -0,0 +1,37 @@
+/*
+ * What the driver domain asks of the XNU side (bsd/dev/fuxi_ath12k_os.c, milestone M1). These
+ * calls are plain C on both sides: no FreeBSD or Linux type crosses here. Same shape of boundary
+ * as hackios bsd/sys/hakios.lx.h, written for this tree. Patch 0117 carries this file to bsd/dev/fa_lx_os.h,
+ * so both sides compile the same declarations.
+ *
+ * SPDX-License-Identifier: MIT (see compat/PROVENANCE.md)
+ */
+#ifndef _LX_OS_H_
+#define _LX_OS_H_
+
+/* Wired zeroed kernel memory; the size is given back when freed. */
+void		*lx_os_alloc(unsigned long size);
+void		 lx_os_free(void *memory, unsigned long size);
+
+/* One piece of Normal-NC memory that the chip reaches at *address (IOVA) through our SMMU window (fuxi_wlan.c). */
+void		*lx_os_radio_memory(unsigned long size, unsigned long long *address);
+
+void		 lx_os_print(const char *text);		/* a line for the log */
+void		 lx_os_tell(const char *text);		/* a line for the log that is always kept */
+void		 lx_os_panic(const char *text) __dead2;
+
+unsigned long long lx_os_nanoseconds(void);		/* monotonic */
+
