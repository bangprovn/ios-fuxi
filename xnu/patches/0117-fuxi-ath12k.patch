+/*
+ * FUXI ATH12K, the XNU side of the driver domain's calls (compat/include/lx_os.h): memory, time,
+ * threads, one lock to sleep under, boot arguments. The DMA pool is fuxi_wlan.c's, which owns the
+ * SMMU window. Only kernels built with patch 0117 have this file.
+ *
+ * Adapted from hackios drivers/wifi/hakios.lx.c (APSL 2.0, as the rest of this kernel's sources).
+ */
+#if defined(FUXI) && defined(FUXI_ATH12K)
+#include <kern/clock.h>
+#include <kern/kalloc.h>
+#include <kern/locks.h>
+#include <kern/sched_prim.h>
+#include <kern/thread.h>
+#include <libkern/libkern.h>
+#include <mach/mach_types.h>
+#include <pexpert/pexpert.h>
+#include <sys/errno.h>
+#include <sys/random.h>
+#include <sys/systm.h>
+
+#include "fa_xnu.h"
+#include "fa_lx_os.h"
+
+extern kern_return_t thread_terminate(thread_t thread);
+extern void thread_set_thread_name(thread_t thread, const char *name);
+
+static LCK_GRP_DECLARE(fa_lock_group, "fuxi-ath12k");
+static LCK_MTX_DECLARE(fa_lock, &fa_lock_group);
+static LCK_MTX_DECLARE(fa_mhi_lock, &fa_lock_group);
+
+void *
+lx_os_alloc(unsigned long size)
+{
+	return kalloc_data(size, Z_WAITOK | Z_ZERO);
+}
+
+void
+lx_os_free(void *memory, unsigned long size)
+{
+	kfree_data(memory, size);
+}
+
+void
+lx_os_print(const char *text)
+{
+	printf("%s", text);
+}
+
+void
+lx_os_tell(const char *text)
+{
+	printf("%s", text);
+}
+
+void
+lx_os_panic(const char *text)
+{
+	panic("%s", text);
+}
+
+unsigned long long
+lx_os_nanoseconds(void)
+{
+	uint64_t nanoseconds;
+
+	absolutetime_to_nanoseconds(mach_absolute_time(), &nanoseconds);
+	return nanoseconds;
+}
+
+void *
+lx_os_thread_self(void)
+{
+	return current_thread();
+}
+
+struct fa_thread {
+	void (*function)(void *);
+	void *argument;
+};
+
+static void
+fa_thread_runs(void *parameter, __unused wait_result_t result)
+{
+	struct fa_thread start = *(struct fa_thread *)parameter;
+
+	kfree_type(struct fa_thread, parameter);
+	start.function(start.argument);
+	(void)thread_terminate(current_thread());
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+int
+lx_os_thread(const char *name, void (*function)(void *), void *argument)
+{
+	struct fa_thread *start = kalloc_type(struct fa_thread, Z_WAITOK | Z_ZERO);
+	thread_t thread;
+
+	if (start == NULL) {
+		return ENOMEM;
+	}
+	start->function = function;
+	start->argument = argument;
+	if (kernel_thread_start(fa_thread_runs, start, &thread) != KERN_SUCCESS) {
+		kfree_type(struct fa_thread, start);
+		return EAGAIN;
+	}
+	thread_set_thread_name(thread, name);
+	thread_deallocate(thread);
+	return 0;
+}
+
+void
+lx_os_lock(void)
+{
+	lck_mtx_lock(&fa_lock);
+}
+
+void
+lx_os_unlock(void)
+{
+	lck_mtx_unlock(&fa_lock);
+}
+
+void
+lx_os_sleep(const void *address, unsigned long long nanoseconds)
+{
+	uint64_t deadline;
+
+	nanoseconds_to_absolutetime(nanoseconds, &deadline);
+	deadline += mach_absolute_time();
+	(void)lck_mtx_sleep_deadline(&fa_lock, LCK_SLEEP_DEFAULT, (event_t)address, THREAD_UNINT, deadline);
+}
+
+void
+lx_os_wakeup(const void *address)
+{
+	thread_wakeup((event_t)address);
+}
+
+void
+lx_os_random(void *buffer, unsigned long size)
+{
+	read_random(buffer, (u_int)size);
+}
+
+unsigned
+lx_os_option(const char *name)
+{
+	unsigned value = 0;
+
+	return PE_parse_boot_argn(name, &value, sizeof(value)) ? value : 0;
+}
+
+void
+fuxi_ath12k_mhi_lock(void)
+{
+	lck_mtx_lock(&fa_mhi_lock);
+}
+
+void
+fuxi_ath12k_mhi_unlock(void)
+{
+	lck_mtx_unlock(&fa_mhi_lock);
+}
+#endif /* FUXI && FUXI_ATH12K */
--- /dev/null
+++ b/bsd/dev/fuxi_ath12k_ios.c
@@ -0,0 +1,228 @@
+/*
+ * The ath12k radio as iOS's Wi-Fi backend (fuxiwifiios=2), in XNU's domain: struct fuxi_wifi_backend, whose types the
+ * driver domain does not know, forwarded to fa_xnu.h's plain C. A passphrase ends here: the key is made of it, it is wiped, and
+ * the driver takes only the key. Nothing here says a name, an address or a key. Patch 0117 carries this file to
+ * bsd/dev/fuxi_ath12k_ios.c, so that only kernel-metal4wifi has it.
+ *
+ * SPDX-License-Identifier: MIT
+ */
+#if defined(FUXI)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <sys/fuxi_wifi_ios.h>
+#include <sys/fuxi_wifi_wpa.h>
+#include "fa_xnu.h"
+
+_Static_assert((int)FUXI_WIFI_STA_OFF == FA_IOS_OFF && (int)FUXI_WIFI_STA_IDLE == FA_IOS_IDLE && (int)FUXI_WIFI_STA_SCANNING == FA_IOS_SCANNING &&
+    (int)FUXI_WIFI_STA_JOINING == FA_IOS_JOINING && (int)FUXI_WIFI_STA_JOINED == FA_IOS_JOINED, "the phases are the same numbers");
+
+const struct fuxi_wifi_backend *fuxi_ath12k_ios_backend(void);
+
+static const struct fuxi_wifi_input *ios_input;
+
+/* The two domains' errno differ: FreeBSD's EOPNOTSUPP is not XNU's. */
+static int
+ios_errno(int answer)
+{
+	switch (answer) {
+	case FA_IOS_DONE:
+		return 0;
+	case FA_IOS_NO_AUTH:
+		return EAUTH;
+	case FA_IOS_NO_ANSWER:
+		return ETIMEDOUT;
+	case FA_IOS_NOT_HEARD:
+		return ENOENT;
+	case FA_IOS_REFUSED:
+		return ECONNREFUSED;
+	case FA_IOS_NOT_BUILT:
+		return EOPNOTSUPP;
+	case FA_IOS_NO_MEMORY:
+		return ENOMEM;
+	case FA_IOS_GONE:
+		return ECONNRESET;
+	case FA_IOS_RADIO_DEAD:
+		return ENETDOWN;
+	default:
+		return EIO;
+	}
+}
+
+static void
+ios_rx(const unsigned char *frame, unsigned long length)
+{
+	ios_input->rx_frame(frame, length);
+}
+
+static void
+ios_link(int up)
+{
+	ios_input->link_state(up != 0);
+}
+
+static void
+ios_lost(int answer)
+{
+	fuxi_wifi_sta_lost(ios_errno(answer));
+}
+
+/* From bsd/dev/fuxi_wifi_apple80211.c, by patch 0117: what wifid has just set, kept for the account of a loss. */
+void fuxi_ath12k_note_request(int number, int value);
+void
+fuxi_ath12k_note_request(int number, int value)
+{
+	fa_ios_note_request(number, value);
+}
+
+/* The Apple80211 side hears of it as of any other link: it did not ask, and what it then does is for a run to show. */
+static void
+ios_joined_alone(int answer)
+{
+	if (answer == FA_IOS_DONE) {
+		fuxi_wifi_apple80211_event(FUXI_WIFI_STA_LINK, 1);
+	}
+}
+
+static void
+ios_start(const struct fuxi_wifi_input *input)
+{
+	static const struct fa_ios_input driver = { .rx = ios_rx, .link = ios_link, .lost = ios_lost, .joined_alone = ios_joined_alone };
+
+	ios_input = input;
+	fa_ios_start(&driver);
+}
+
+static int
+ios_power(bool on)
+{
+	return ios_errno(fa_ios_power(on));
+}
+
+static int
+ios_scan(const struct fuxi_wifi_sta_scan *what)
+{
+	return ios_errno(fa_ios_scan(what->ssid, what->ssid_length, what->frequencies, what->frequency_count, what->passive));
+}
+
+static void (*ios_each)(const struct fuxi_wifi_sta_bss *, void *);
+
+/* From a table of the driver's to the shape iOS's side reads. Called on the one station thread: `bss` can be kept between calls. */
+static void
+ios_copy(const struct fa_heard *from, struct fuxi_wifi_sta_bss *to)
+{
+	bzero(to, sizeof(*to));
+	memcpy(to->bssid, from->bssid, sizeof(to->bssid));
+	memcpy(to->ssid, from->ssid, sizeof(to->ssid));
+	to->ssid_length = from->ssid_length;
+	to->frequency = from->frequency;
+	to->rssi = from->rssi;
+	to->beacon_interval = from->interval;
+	to->capability = from->capability;
+	to->age_ms = from->age_ms;
+	to->elements_length = (uint16_t)(from->elements_length < sizeof(to->elements) ? from->elements_length : sizeof(to->elements));
+	memcpy(to->elements, from->elements, to->elements_length);
+}
+
+static void
+ios_one(const struct fa_heard *from, void *context)
+{
+	static struct fuxi_wifi_sta_bss bss;
+
+	ios_copy(from, &bss);
+	ios_each(&bss, context);
+}
+
+static void
+ios_heard(void (*each)(const struct fuxi_wifi_sta_bss *, void *), void *context)
+{
+	ios_each = each;
+	fa_ios_heard(ios_one, context);
+}
+
+static int
+ios_join(const struct fuxi_wifi_sta_join *what)
+{
+	static const uint8_t none[6];
+	unsigned char key[32];
+	int answer;
+
+	if (what->security == FUXI_WIFI_STA_OPEN) {
+		answer = fa_ios_join(what->ssid, what->ssid_length, memcmp(what->bssid, none, sizeof(none)) != 0 ? what->bssid : NULL, NULL);
+		return ios_errno(answer);
+	}
+	if (what->security != FUXI_WIFI_STA_WPA2_PSK) {
+		return EOPNOTSUPP;
+	}
+	if (what->passphrase_length != 0) {
+		fuxi_wifi_wpa_pmk(what->passphrase, what->passphrase_length, what->ssid, what->ssid_length, key);
+	} else {
+		memcpy(key, what->pmk, sizeof(key));
+	}
+	answer = fa_ios_join(what->ssid, what->ssid_length, memcmp(what->bssid, none, sizeof(none)) != 0 ? what->bssid : NULL, key);
+	bzero(key, sizeof(key));
+	return ios_errno(answer);
+}
+
+static int
+ios_leave(void)
+{
+	return ios_errno(fa_ios_leave());
+}
+
+static void
+ios_state(struct fuxi_wifi_sta_state *state)
+{
+	static struct fa_ios_state from;	/* (its bytes are a beacon's: nothing secret, and the driver's lock guards the copy) */
+
+	fa_ios_state(&from);
+	bzero(state, sizeof(*state));
+	state->phase = (enum fuxi_wifi_sta_phase)from.phase;
+	state->security = from.protect ? FUXI_WIFI_STA_WPA2_PSK : FUXI_WIFI_STA_OPEN;
+	state->last_error = ios_errno(from.last_answer);
+	if (from.phase == FA_IOS_JOINED) {
+		ios_copy(&from.bss, &state->bss);
+	}
+}
+
+/*
+ * What the radio may tune to, asked only at attach, before the radio is up: the CN domain the firmware has given in every
+ * run so far (w-m2), on the phone's two bands. A channel out of the domain is left out of the scan by the driver anyway.
+ */
+static unsigned
+ios_channels(struct fuxi_wifi_sta_channel *out, unsigned most)
+{
+	static const struct fuxi_wifi_sta_channel known[] = {
+		{ 2412, 0 }, { 2417, 0 }, { 2422, 0 }, { 2427, 0 }, { 2432, 0 }, { 2437, 0 }, { 2442, 0 }, { 2447, 0 }, { 2452, 0 }, { 2457, 0 }, { 2462, 0 }, { 2467, 0 }, { 2472, 0 },
+		{ 5180, 0 }, { 5200, 0 }, { 5220, 0 }, { 5240, 0 },
+		{ 5260, FUXI_WIFI_STA_CHANNEL_PASSIVE | FUXI_WIFI_STA_CHANNEL_RADAR }, { 5280, FUXI_WIFI_STA_CHANNEL_PASSIVE | FUXI_WIFI_STA_CHANNEL_RADAR },
+		{ 5300, FUXI_WIFI_STA_CHANNEL_PASSIVE | FUXI_WIFI_STA_CHANNEL_RADAR }, { 5320, FUXI_WIFI_STA_CHANNEL_PASSIVE | FUXI_WIFI_STA_CHANNEL_RADAR },
+		{ 5745, 0 }, { 5765, 0 }, { 5785, 0 }, { 5805, 0 }, { 5825, 0 },
+	};
+	unsigned count = sizeof(known) / sizeof(known[0]);
+
+	count = count < most ? count : most;
+	memcpy(out, known, count * sizeof(*out));
+	return count;
+}
+
+static bool
+ios_tx(const uint8_t *frame, size_t length)
+{
+	return fa_ios_tx(frame, length) != 0;
+}
+
+static struct fuxi_wifi_backend ios_backend = {
+	.station = { .power = ios_power, .scan = ios_scan, .heard = ios_heard, .join = ios_join, .leave = ios_leave,
+		.state = ios_state, .channels = ios_channels },
+	.tx_frame = ios_tx, .start = ios_start,
+};
+
+/* From fuxi_wifi_ios_init(), before the root is there and long before the radio: the address is the one the radio will be given. */
+const struct fuxi_wifi_backend *
+fuxi_ath12k_ios_backend(void)
+{
+	fuxi_ath12k_station_address(ios_backend.station.address);
+	return &ios_backend;
+}
+#endif /* FUXI */
--- /dev/null
+++ b/iokit/Kernel/arm/fuxi_aks_wrap.h
@@ -0,0 +1,71 @@
+/*
+ * Key wrap and unwrap for the built-in AppleKeyStore (SweetKeyStore.cpp), so that securityd can write and read keychain
+ * items on a test phone. THIS IS NOT ENCRYPTION AND PROTECTS NOTHING: there is no Secure Enclave here, the pattern is
+ * fixed and anyone with the root file system can read every item. It keeps the keychain working, and that is all.
+ *
+ * The layout is ours, 8 bytes longer than the key as securityd asks (`in 2/32 out 1/40`): "FXAK", the key class little
+ * endian, the key mixed with the pattern. Items stay readable across boots because nothing here changes. HackiOS answers
+ * the same two selectors the same way; this is written from that description, no code of theirs.
+ *
+ * Plain C with nothing around it: tools/test-fuxi-ath12k.py runs it under the sanitizers.
+ *
+ * SPDX-License-Identifier: MIT
+ */
+#ifndef _FUXI_AKS_WRAP_H_
+#define _FUXI_AKS_WRAP_H_
+
+#define FUXI_AKS_KEY_MOST	256u
+#define FUXI_AKS_OVERHEAD	8u
+#define FUXI_AKS_WRAPPED_MOST	(FUXI_AKS_KEY_MOST + FUXI_AKS_OVERHEAD)
+
+static inline unsigned char
+fuxi_aks_pattern(unsigned at)
+{
+	return ((unsigned char)(0x5au ^ (at * 0x1fu)));
+}
+
+/* The wrapped form of `key` for this class. Its length, 0 when the key's size or the room is not right. */
+static inline unsigned
+fuxi_aks_wrap(const unsigned char *key, unsigned length, unsigned key_class, unsigned char *out, unsigned room)
+{
+	if (length == 0 || length > FUXI_AKS_KEY_MOST || room < length + FUXI_AKS_OVERHEAD) {
+		return (0);
+	}
+	out[0] = 'F';
+	out[1] = 'X';
+	out[2] = 'A';
+	out[3] = 'K';
+	for (unsigned i = 0; i < 4; i++) {
+		out[4 + i] = (unsigned char)(key_class >> (8 * i));
+	}
+	for (unsigned i = 0; i < length; i++) {
+		out[FUXI_AKS_OVERHEAD + i] = key[i] ^ fuxi_aks_pattern(i);
+	}
+	return (length + FUXI_AKS_OVERHEAD);
+}
+
+/* The key back. Its length, 0 when this is not ours, is of another class, or the room is not right. */
+static inline unsigned
+fuxi_aks_unwrap(const unsigned char *wrapped, unsigned length, unsigned key_class, unsigned char *out, unsigned room)
+{
+	unsigned key_length;
+
+	if (length <= FUXI_AKS_OVERHEAD || length > FUXI_AKS_WRAPPED_MOST || wrapped[0] != 'F' || wrapped[1] != 'X' || wrapped[2] != 'A' || wrapped[3] != 'K') {
+		return (0);
+	}
+	key_length = length - FUXI_AKS_OVERHEAD;
+	if (room < key_length) {
+		return (0);
+	}
+	for (unsigned i = 0; i < 4; i++) {
+		if (wrapped[4 + i] != (unsigned char)(key_class >> (8 * i))) {
+			return (0);
+		}
+	}
+	for (unsigned i = 0; i < key_length; i++) {
+		out[i] = wrapped[FUXI_AKS_OVERHEAD + i] ^ fuxi_aks_pattern(i);
+	}
+	return (key_length);
+}
+
+#endif
--- /dev/null
+++ b/bsd/dev/fuxi_remote.h
@@ -0,0 +1,100 @@
+/*
+ * A mailbox from the PC to the phone's kernel, for looking at iOS with nobody there (boot/phone.py): one touch or key
+ * command at a time. The USB monitor runs with its MMU off, so each side keeps the other in mind: the kernel owns the
+ * first cache line and cleans it after writing, the monitor owns the second and the kernel invalidates it before reading.
+ * Both sides check every field with these functions, which need only <stdint.h>, <stdbool.h>.
+ *
+ * There is no text command, by design: a tap is a tap, and nothing here is for typing anybody's password.
+ *
+ * SPDX-License-Identifier: MIT
+ */
+#ifndef _FUXI_REMOTE_H_
+#define _FUXI_REMOTE_H_
+
+#define FUXI_REMOTE_MAGIC	0x45544f4d45525846ull	/* little-endian FXREMOTE */
+#define FUXI_REMOTE_VERSION	1u
+#define FUXI_REMOTE_WIDTH	1080
+#define FUXI_REMOTE_HEIGHT	2400
+#define FUXI_REMOTE_MS_LEAST	20u
+#define FUXI_REMOTE_FLICK_MOST	5000u
+#define FUXI_REMOTE_KEY_MOST	2000u
+#define FUXI_REMOTE_KEYS	3	/* power, volume up, volume down */
+
+enum { FUXI_REMOTE_TAP = 1, FUXI_REMOTE_FLICK = 2, FUXI_REMOTE_KEY = 3 };
+
+enum {
+	FUXI_REMOTE_OK = 0,
+	FUXI_REMOTE_OFF = 1,		/* no mailbox there: the kernel has no fuxiremote=1, or this is not one */
+	FUXI_REMOTE_BUSY = 2,		/* the last command is not finished */
+	FUXI_REMOTE_OUT_OF_ORDER = 3,	/* its number does not follow the last one */
+	FUXI_REMOTE_BAD = 4,		/* a field out of bounds */
+};
+
+struct fuxi_remote_cmd {
+	uint32_t seq;
+	uint32_t kind;
+	int32_t x0, y0, x1, y1;		/* a tap uses x0, y0; a key's number is x0 */
+	uint32_t ms;			/* a flick's length, a key's hold */
+	uint32_t check;
+};
+
+struct fuxi_remote_box {
+	/* the kernel's cache line */
+	uint64_t magic;
+	uint32_t version;
+	uint32_t done;			/* the last number finished, whether it was done or refused */
+	uint32_t refused;
+	uint32_t pad0[11];
+	/* the monitor's cache line */
+	struct fuxi_remote_cmd cmd;
+	uint32_t pad1[8];
+};
+
+static inline uint32_t
+fuxi_remote_check(const struct fuxi_remote_cmd *c)
+{
+	return (c->seq ^ c->kind ^ (uint32_t)c->x0 ^ ((uint32_t)c->y0 << 3) ^ ((uint32_t)c->x1 << 7) ^ ((uint32_t)c->y1 << 11) ^ (c->ms << 13) ^ 0x46585243u);
+}
+
+static inline bool
+fuxi_remote_inside(int32_t x, int32_t y)
+{
+	return (x >= 0 && x < FUXI_REMOTE_WIDTH && y >= 0 && y < FUXI_REMOTE_HEIGHT);
+}
+
+/* Whether the fields can be acted on: the same answer on both sides. */
+static inline bool
+fuxi_remote_valid(const struct fuxi_remote_cmd *c)
+{
+	if (c->seq == 0 || c->check != fuxi_remote_check(c)) {
+		return (false);
+	}
+	switch (c->kind) {
+	case FUXI_REMOTE_TAP:
+		return (fuxi_remote_inside(c->x0, c->y0));
+	case FUXI_REMOTE_FLICK:
+		return (fuxi_remote_inside(c->x0, c->y0) && fuxi_remote_inside(c->x1, c->y1) && c->ms >= FUXI_REMOTE_MS_LEAST && c->ms <= FUXI_REMOTE_FLICK_MOST);
+	case FUXI_REMOTE_KEY:
+		return (c->x0 >= 0 && c->x0 < FUXI_REMOTE_KEYS && c->ms >= FUXI_REMOTE_MS_LEAST && c->ms <= FUXI_REMOTE_KEY_MOST);
+	default:
+		return (false);
+	}
+}
+
+/* The monitor's question before writing a command, from what it reads of the box. */
+static inline uint32_t
+fuxi_remote_may_post(uint64_t magic, uint32_t version, uint32_t done, uint32_t pending, const struct fuxi_remote_cmd *c)
+{
+	if (magic != FUXI_REMOTE_MAGIC || version != FUXI_REMOTE_VERSION) {
+		return (FUXI_REMOTE_OFF);
+	}
+	if (pending != done) {
+		return (FUXI_REMOTE_BUSY);
+	}
+	if (c->seq != done + 1) {
+		return (FUXI_REMOTE_OUT_OF_ORDER);
+	}
+	return (fuxi_remote_valid(c) ? FUXI_REMOTE_OK : FUXI_REMOTE_BAD);
+}
