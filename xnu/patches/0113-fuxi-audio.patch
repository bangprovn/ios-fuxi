+		if (fa_rd(ent) == 0x76616c73u && fa_rd(ent + 4) == 0x656b2d65u) {
+			return fa_rd(ent + 16) & 0xffff;
+		}
+	}
+	return 0x10000000u;
+}
+
+static struct au_gl fa_g;
