+	if (in == 0 || fa_rd(in) != 0x504d5324u) {
+		return 0x40000000u;
+	}
+	unsigned valid = fa_rd(in + 12) >> 16;
+	for (unsigned e = 0; e < valid && e < 16; e++) {
+		uint64_t ent = in + 20 + 20 * e;
