+
+static struct au_gl fa_g;
+static uint32_t fa_log[AU_GL_REC_WORDS * 8];
+static uint32_t fa_m[2 + AU_GL_GPR_BUFFER / 4 + 2];
+static uint64_t fa_start;
+static uint32_t fa_polls;
