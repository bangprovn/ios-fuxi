+		return AU_GL_PRM_NO_ANSWER;
+	}
+	for (unsigned i = 0; i < 1000; i++) {
+		if (!fa_poll(1)) {
+			break;
+		}
+		if (fa_g.graph_status[step] != AU_GL_PRM_NO_ANSWER) {
+			break;
+		}
+	}
+	return fa_g.graph_status[step];
+}
+
+#define FA_STEP(what, build, ...) do { \
