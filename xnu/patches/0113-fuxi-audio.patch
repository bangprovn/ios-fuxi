+    static const Module m[] = {{FUXI_AR_MOD_PCM_CNV, FUXI_AR_IID_CAP_CNV, 1, 1}, {FUXI_AR_MOD_PCM_ENC, FUXI_AR_IID_CAP_ENC, 1, 1},
+                               {FUXI_AR_MOD_RD_SHMEM, FUXI_AR_IID_CAP_SHMEM, 1, 0}};
+    static const Link l[] = {{FUXI_AR_IID_MIC_DMA, FUXI_AR_IID_CAP_CNV}, {FUXI_AR_IID_CAP_CNV, FUXI_AR_IID_CAP_ENC}, {FUXI_AR_IID_CAP_ENC, FUXI_AR_IID_CAP_SHMEM}};
+    return graph_open(out, capacity, port, token, &sg, &c, m, 3, l, 3);
+}
+
+static void hw_ep_mf(W *w, uint32_t iid, const FuxiArFormat *f)
+{
+    const uint32_t at = param_begin(w, iid, PARAM_HW_EP_MF);
+    put32(w, f->rate); put16(w, f->bits); put16(w, f->channels); put32(w, 1);
+    param_end(w, at);
+}
+static void frame_size_factor(W *w, uint32_t iid)
+{
+    const uint32_t at = param_begin(w, iid, PARAM_FRAME_SIZE_FACTOR);
+    put32(w, 1);
+    param_end(w, at);
+}
+static void channel_map(W *w, unsigned channels) {for (unsigned i = 0; i < channels; ++i) put8(w, i + 1);}   /* FL = 1, FR = 2 */
+
+uint32_t fuxi_ar_config_speaker_device(uint8_t *out, uint32_t capacity, uint32_t port, uint32_t token, const FuxiArFormat *f)
+{
+    W w;
+    begin(&w, out, capacity, port, FUXI_AR_APM_IID, token, FUXI_AR_OP_SET_CFG);
+    const uint32_t cmd = cmd_payload_start(&w);
+    const uint32_t at = param_begin(&w, FUXI_AR_IID_SPEAKER_I2S, PARAM_I2S_INTF);
+    put32(&w, LPAIF); put32(&w, I2S_SECONDARY); put16(&w, I2S_SD1); put16(&w, WS_INTERNAL);
+    param_end(&w, at);
+    hw_ep_mf(&w, FUXI_AR_IID_SPEAKER_I2S, f);
+    frame_size_factor(&w, FUXI_AR_IID_SPEAKER_I2S);
+    cmd_payload_end(&w, cmd);
+    return finish(&w);
+}
+
+/* Layouts as pcm_tdm_api.h says them, read from the Xiaomi 14's Linux port (research_notes/audio-next.md). No start here: this reaches no pin. */
+uint32_t fuxi_ar_config_speaker_tdm(uint8_t *out, uint32_t capacity, uint32_t port, uint32_t token, const FuxiArFormat *f, const FuxiArTdm *t)
+{
+    W w;
+    begin(&w, out, capacity, port, FUXI_AR_APM_IID, token, FUXI_AR_OP_SET_CFG);
+    const uint32_t cmd = cmd_payload_start(&w);
+    uint32_t at = param_begin(&w, FUXI_AR_IID_SPEAKER_TDM, PARAM_TDM_INTF);
+    put32(&w, LPAIF); put32(&w, t->intf); put16(&w, WS_INTERNAL); put16(&w, 1);    /* the SoC's sync, data going out */
+    put32(&w, t->slot_mask); put16(&w, t->slots); put16(&w, t->slot_width);
+    put16(&w, t->sync_mode); put16(&w, t->invert_sync); put16(&w, t->sync_data_delay); put16(&w, 0);
+    param_end_exact(&w, at);
+    hw_ep_mf(&w, FUXI_AR_IID_SPEAKER_TDM, f);
+    frame_size_factor(&w, FUXI_AR_IID_SPEAKER_TDM);
+    at = param_begin(&w, FUXI_AR_IID_SPEAKER_TDM, PARAM_TDM_LANE);
+    put16(&w, 1u << t->lane); put16(&w, 0);
+    param_end_exact(&w, at);
+    at = param_begin(&w, FUXI_AR_IID_SPEAKER_TDM, PARAM_HW_INTF_CLOCK);
+    put32(&w, 0); put32(&w, 0); put32(&w, t->clock_attribute); put32(&w, 0);       /* id, frequency and root left to the interface */
+    param_end_exact(&w, at);
+    cmd_payload_end(&w, cmd);
+    return finish(&w);
+}
+
+uint32_t fuxi_ar_config_mic_device(uint8_t *out, uint32_t capacity, uint32_t port, uint32_t token, const FuxiArFormat *f, uint32_t channel_mask)
+{
+    W w;
+    begin(&w, out, capacity, port, FUXI_AR_APM_IID, token, FUXI_AR_OP_SET_CFG);
+    const uint32_t cmd = cmd_payload_start(&w);
+    hw_ep_mf(&w, FUXI_AR_IID_MIC_DMA, f);
+    frame_size_factor(&w, FUXI_AR_IID_MIC_DMA);
+    uint32_t at = param_begin(&w, FUXI_AR_IID_MIC_DMA, PARAM_CODEC_DMA_INTF);
+    put32(&w, LPAIF_RXTX); put32(&w, CODEC_TX3); put32(&w, channel_mask);
+    param_end(&w, at);
+    at = param_begin(&w, FUXI_AR_IID_MIC_DMA, PARAM_HW_EP_POWER_MODE);
+    put32(&w, 0);
+    param_end(&w, at);
+    cmd_payload_end(&w, cmd);
+    return finish(&w);
+}
+
+/* PCM output format of a decoder, converter or encoder. */
+static void pcm_output(W *w, uint32_t iid, const FuxiArFormat *f, uint32_t interleaving)
+{
+    const uint32_t at = param_begin(w, iid, PARAM_PCM_OUTPUT);
+    put32(w, 1); put32(w, MEDIA_PCM); put32(w, (16u + f->channels + 3u) & ~3u);
+    put16(w, f->bits); put16(w, 1); put16(w, f->bits); put16(w, f->bits - 1u); put16(w, 1); put16(w, interleaving); put16(w, 0);
+    put16(w, f->channels);
+    channel_map(w, f->channels);
+    param_end(w, at);
+}
+
+uint32_t fuxi_ar_config_playback_stream(uint8_t *out, uint32_t capacity, uint32_t port, uint32_t token, const FuxiArFormat *f)
+{
+    W w;
+    begin(&w, out, capacity, port, FUXI_AR_APM_IID, token, FUXI_AR_OP_SET_CFG);
+    const uint32_t cmd = cmd_payload_start(&w);
+    pcm_output(&w, FUXI_AR_IID_PLAY_DEC, f, INTERLEAVED);
+    pcm_output(&w, FUXI_AR_IID_PLAY_CNV, f, DEINTERLEAVED_UNPACKED);
+    cmd_payload_end(&w, cmd);
+    return finish(&w);
+}
+
+uint32_t fuxi_ar_config_capture_stream(uint8_t *out, uint32_t capacity, uint32_t port, uint32_t token, const FuxiArFormat *f)
+{
+    W w;
+    begin(&w, out, capacity, port, FUXI_AR_APM_IID, token, FUXI_AR_OP_SET_CFG);
+    const uint32_t cmd = cmd_payload_start(&w);
+    pcm_output(&w, FUXI_AR_IID_CAP_CNV, f, INTERLEAVED);
+    pcm_output(&w, FUXI_AR_IID_CAP_ENC, f, INTERLEAVED);
+    cmd_payload_end(&w, cmd);
+    return finish(&w);
+}
+
+/* The input media format of the playback shared memory endpoint, sent to the endpoint itself. */
+uint32_t fuxi_ar_config_playback_shmem(uint8_t *out, uint32_t capacity, uint32_t port, uint32_t token, const FuxiArFormat *f)
+{
+    W w;
+    begin(&w, out, capacity, port, FUXI_AR_IID_PLAY_SHMEM, token, FUXI_AR_OP_SET_CFG);
+    const uint32_t cmd = cmd_payload_start(&w);
+    const uint32_t at = param_begin(&w, FUXI_AR_IID_PLAY_SHMEM, PARAM_MEDIA_FORMAT);
+    const uint32_t body = align8(12u + 16u + f->channels);
+    put32(&w, 1); put32(&w, MEDIA_PCM); put32(&w, body + PARAM_HEADER - 12u);
+    put32(&w, f->rate); put16(&w, f->bits); put16(&w, 1); put16(&w, f->bits); put16(&w, f->bits - 1u); put16(&w, 1);
+    put16(&w, f->channels);
+    channel_map(&w, f->channels);
+    param_end(&w, at);
+    cmd_payload_end(&w, cmd);
+    return finish(&w);
+}
+
+uint32_t fuxi_ar_graph_command(uint8_t *out, uint32_t capacity, uint32_t port, uint32_t token, uint32_t opcode, uint32_t sg)
+{
+    W w;
+    begin(&w, out, capacity, port, FUXI_AR_APM_IID, token, opcode);
+    const uint32_t cmd = cmd_payload_start(&w);
+    const uint32_t at = param_begin(&w, FUXI_AR_APM_IID, PARAM_SG_LIST);
+    put32(&w, 1); put32(&w, sg);
+    param_end(&w, at);
+    cmd_payload_end(&w, cmd);
+    return finish(&w);
+}
+
+/* As the DSP's own client builds it: the region follows the GPR header directly; the command header space trails the packet. */
+uint32_t fuxi_ar_map(uint8_t *out, uint32_t capacity, uint32_t port, uint32_t token, uint64_t address, uint32_t bytes)
+{
+    W w;
+    begin(&w, out, capacity, port, FUXI_AR_APM_IID, token, FUXI_AR_OP_MEM_MAP);
+    put16(&w, 3); put16(&w, 1); put32(&w, 0);                      /* shared 8-byte-aligned 4 KiB pool, one region, no flags */
+    put32(&w, (uint32_t)address); put32(&w, (uint32_t)(address >> 32)); put32(&w, (bytes + 4095u) & ~4095u);
+    pad_to(&w, w.n + CMD_HEADER);
+    return finish(&w);
+}
+
+uint32_t fuxi_ar_unmap(uint8_t *out, uint32_t capacity, uint32_t port, uint32_t token, uint32_t handle)
+{
+    W w;
+    begin(&w, out, capacity, port, FUXI_AR_APM_IID, token, FUXI_AR_OP_MEM_UNMAP);
+    put32(&w, handle);
+    pad_to(&w, w.n + CMD_HEADER);
+    return finish(&w);
+}
+
+uint32_t fuxi_ar_write(uint8_t *out, uint32_t capacity, uint32_t port, uint32_t token, uint64_t address, uint32_t handle, uint32_t bytes)
+{
+    W w;
+    begin(&w, out, capacity, port, FUXI_AR_IID_PLAY_SHMEM, token, FUXI_AR_OP_WRITE);
+    put32(&w, (uint32_t)address); put32(&w, (uint32_t)(address >> 32)); put32(&w, handle); put32(&w, bytes);
+    put32(&w, 0); put32(&w, 0); put32(&w, 0);                      /* no time stamp, no flags */
+    put32(&w, 0); put32(&w, 0); put32(&w, 0); put32(&w, 0);         /* no metadata */
+    return finish(&w);
+}
+
+uint32_t fuxi_ar_read(uint8_t *out, uint32_t capacity, uint32_t port, uint32_t token, uint64_t address, uint32_t handle, uint32_t bytes)
+{
+    W w;
+    begin(&w, out, capacity, port, FUXI_AR_IID_CAP_SHMEM, token, FUXI_AR_OP_READ);
+    put32(&w, (uint32_t)address); put32(&w, (uint32_t)(address >> 32)); put32(&w, handle); put32(&w, bytes);
+    put32(&w, 0); put32(&w, 0); put32(&w, 0); put32(&w, 0);
+    return finish(&w);
+}
+
+uint32_t fuxi_ar_prm_clock(uint8_t *out, uint32_t capacity, uint32_t port, uint32_t token, uint32_t clock_id, uint32_t hz)
+{
+    return fuxi_ar_prm_clock_attr(out, capacity, port, token, clock_id, hz, 1);
+}
+
+uint32_t fuxi_ar_prm_clock_attr(uint8_t *out, uint32_t capacity, uint32_t port, uint32_t token, uint32_t clock_id, uint32_t hz, uint32_t attribute)
+{
+    W w;
+    begin(&w, out, capacity, port, FUXI_AR_PRM_IID, token, hz ? FUXI_AR_OP_PRM_REQUEST : FUXI_AR_OP_PRM_RELEASE);
+    const uint32_t cmd = cmd_payload_start(&w);
+    const uint32_t at = param_begin(&w, FUXI_AR_PRM_IID, 0x0800102Cu);    /* audio hardware clock */
+    put32(&w, 1); put32(&w, clock_id);
+    if (hz) {put32(&w, hz); put32(&w, attribute); put32(&w, 0);}    /* frequency, attribute (1 "couple no"), default root */
+    set32(&w, at + 8, w.n - at - PARAM_HEADER);                      /* exact size: the reference client does not pad these */
+    cmd_payload_end(&w, cmd);
+    return finish(&w);
+}
+
+uint32_t fuxi_ar_prm_vote(uint8_t *out, uint32_t capacity, uint32_t port, uint32_t token, uint32_t block, int enable)
+{
+    W w;
+    begin(&w, out, capacity, port, FUXI_AR_PRM_IID, token, enable ? FUXI_AR_OP_PRM_REQUEST : FUXI_AR_OP_PRM_RELEASE);
+    const uint32_t cmd = cmd_payload_start(&w);
+    const uint32_t at = param_begin(&w, FUXI_AR_PRM_IID, 0x08001032u);    /* hardware core */
+    put32(&w, block);
+    set32(&w, at + 8, w.n - at - PARAM_HEADER);
+    cmd_payload_end(&w, cmd);
+    return finish(&w);
+}
+
+int fuxi_ar_parse(const uint8_t *in, uint32_t length, FuxiArAnswer *a)
+{
+    FuxiGprPacket p;
+    for (unsigned i = 0; i < sizeof *a; ++i) ((uint8_t *)a)[i] = 0;
+    if (fuxi_gpr_decode(in, length, &p) != FuxiGprOk) return FuxiArBad;
+    a->opcode = p.opcode; a->token = p.token; a->src_port = p.src_port;
+    const uint8_t *d = p.payload;
+    switch (p.opcode) {
+    case FUXI_GPR_OP_BASIC_RESULT:
+        if (p.payload_bytes < 8) return FuxiArBad;
+        a->result_opcode = le32(d); a->status = le32(d + 4);
+        return FuxiArBasicResult;
+    case FUXI_AR_OP_PRM_REQUEST_DONE:
+    case FUXI_AR_OP_PRM_RELEASE_DONE:
+        if (p.payload_bytes < 4) return FuxiArBad;
+        a->status = le32(d + (p.payload_bytes >= 8 ? 4 : 0));
+        return FuxiArPrmDone;
+    case FUXI_GPR_OP_APM_SPF_STATE:
+        if (p.payload_bytes < 4) return FuxiArBad;
+        a->status = le32(d);
+        return FuxiArFrameworkState;
+    case FUXI_AR_OP_MEM_MAP_DONE:
+        if (p.payload_bytes < 4) return FuxiArBad;
+        a->handle = le32(d);
+        return FuxiArMapped;
+    case FUXI_AR_OP_WRITE_DONE:
+        if (p.payload_bytes < 16) return FuxiArBad;
+        a->address = le32(d) | (uint64_t)le32(d + 4) << 32; a->handle = le32(d + 8); a->status = le32(d + 12);
+        return FuxiArWriteDone;
+    case FUXI_AR_OP_READ_DONE:
+        if (p.payload_bytes < 20) return FuxiArBad;
+        a->status = le32(d); a->address = le32(d + 4) | (uint64_t)le32(d + 8) << 32; a->handle = le32(d + 12); a->data_bytes = le32(d + 16);
+        a->offset = p.payload_bytes >= 24 ? le32(d + 20) : 0;   /* RD_SH_MEM_EP_DATA_BUFFER_DONE_V2: status, address, handle, size, offset */
+        return FuxiArReadDone;
+    default:
+        return FuxiArUnknown;
+    }
+}
