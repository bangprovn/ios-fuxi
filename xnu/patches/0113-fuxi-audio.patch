+	}
+	printf("FUXI AUDIO: GLINK up: messages %u, channels %u, adsp_apps %u, its buffers %u\n", fa_g.rx_msgs, fa_g.opened, fa_g.gpr_lcid, fa_g.gpr_riid_n);
+	(void)au_gl_gpr_ask(&fa_g);
+	if (!fa_poll(500)) {
+		return false;
+	}
+	printf("FUXI AUDIO: APM ready %u after %u answers\n", fa_g.gpr_ready, fa_g.gpr_heard);
+	return fa_g.gpr_ready != 0;
+}
+
+/* The TDM's bit clock, from the PRM: Linux's card asks it before anything opens. 6.144 MHz, inverted. The same shape as the others for FA_STEP; 0 lets it go. */
+static uint32_t
+fa_prm_clock(uint8_t *out, uint32_t capacity, uint32_t port, uint32_t token, uint32_t hz)
+{
+#pragma unused(port)
+	return fuxi_ar_prm_clock_attr(out, capacity, 2, token, FA_TDM_CLOCK, hz, 4);
+}
+
+/* LPASS's votes on, and the list to the graph's start. How many failed. */
+static uint32_t
+fa_graph_up(void)
+{
+	uint32_t bad = 0;
+
+	fa_g.prm_sent = 0;
+	fa_g.graph_sent = 0;
+	fa_g.map_handle = 0;
+	fa_g.write_sent = 0;
+	fa_g.write_done = 0;
+	fa_g.write_bad = 0;
+	for (unsigned i = 0; i < 2; i++) {
+		(void)au_gl_prm_step(&fa_g);
+		if (!fa_poll(100)) {
+			return 1;
+		}
+		printf("FUXI AUDIO: vote %u: status %#x\n", i, fa_g.prm_status[i]);
+		bad += fa_g.prm_status[i] != 0;
+	}
+	for (unsigned i = 0; i < FA_BUFFER_BYTES / 4; i++) {
+		((volatile uint32_t *)fa_buffer)[i] = 0;
+	}
+	__asm__ volatile ("dsb osh" ::: "memory");
+	FA_STEP("TDM clock", fa_prm_clock, 6144000u);
+	FA_STEP("open device", fuxi_ar_open_speaker_tdm);
+	FA_STEP("configure device", fuxi_ar_config_speaker_tdm, &fa_format, &fa_tdm);
+	FA_STEP("open stream", fuxi_ar_open_playback_stream_tdm);
+	FA_STEP("configure stream", fuxi_ar_config_playback_stream, &fa_format);
+	FA_STEP("configure its input", fuxi_ar_config_playback_shmem, &fa_format);
+	FA_STEP("map the buffers", fuxi_ar_map, FA_BUFFER | FA_BUFFER_SID << 32, FA_BUFFER_BYTES);
+	FA_STEP("prepare device", fuxi_ar_graph_command, FUXI_AR_OP_GRAPH_PREPARE, FUXI_AR_SG_SPEAKER);
+	FA_STEP("prepare stream", fuxi_ar_graph_command, FUXI_AR_OP_GRAPH_PREPARE, FUXI_AR_SG_PLAY);
+	FA_STEP("start device", fuxi_ar_graph_command, FUXI_AR_OP_GRAPH_START, FUXI_AR_SG_SPEAKER);
+	FA_STEP("start stream", fuxi_ar_graph_command, FUXI_AR_OP_GRAPH_START, FUXI_AR_SG_PLAY);
+	return bad;
+}
+
+/* The list's other end, whatever came of the start: the votes come off even so. */
+static void
+fa_graph_down(void)
+{
+	uint32_t bad = 0;
+
+	/* In step with au_gl_graph_send(): the list's place is its token. */
+	fa_g.graph_sent = 11;
+	FA_STEP("stop stream", fuxi_ar_graph_command, FUXI_AR_OP_GRAPH_STOP, FUXI_AR_SG_PLAY);
+	FA_STEP("stop device", fuxi_ar_graph_command, FUXI_AR_OP_GRAPH_STOP, FUXI_AR_SG_SPEAKER);
+	FA_STEP("close stream", fuxi_ar_graph_command, FUXI_AR_OP_GRAPH_CLOSE, FUXI_AR_SG_PLAY);
+	FA_STEP("close device", fuxi_ar_graph_command, FUXI_AR_OP_GRAPH_CLOSE, FUXI_AR_SG_SPEAKER);
+	FA_STEP("unmap", fuxi_ar_unmap, fa_g.map_handle);
+	FA_STEP("TDM clock off", fa_prm_clock, 0u);
+	fa_g.prm_sent = 2;
+	for (unsigned i = 2; i < 4; i++) {
+		(void)au_gl_prm_step(&fa_g);
+		if (!fa_poll(100)) {
+			break;
+		}
+		printf("FUXI AUDIO: vote %u: status %#x\n", i, fa_g.prm_status[i]);
+	}
+	printf("FUXI AUDIO: down, %u steps failed; rx %u tx %u full %u\n", bad, fa_g.rx_msgs, fa_g.tx_msgs, fa_g.tx_full);
+}
+
+/* ---- /dev/fuxiaudio: one writer, mediaserverd's I/O thread, and this file's thread. Packed left, right. Too much is dropped and counted: the writer is never held. ---- */
+static uint32_t fa_ring[FA_RING_FRAMES];
+static uint32_t fa_ring_head, fa_ring_tail, fa_dropped;
+
+static uint32_t
+fa_ring_count(void)
+{
+	return __atomic_load_n(&fa_ring_head, __ATOMIC_ACQUIRE) - __atomic_load_n(&fa_ring_tail, __ATOMIC_RELAXED);
+}
+
+static int
+fa_dev_open(dev_t dev, int flags, int mode, proc_t p)
+{
+#pragma unused(dev, flags, mode, p)
+	return 0;
+}
+
+static int
+fa_dev_write(dev_t dev, struct uio *uio, int flags)
+{
+#pragma unused(dev, flags)
+	uint32_t chunk[256];
+
+	while (uio_resid(uio) >= 4) {
+		int error;
+		uint32_t frames = uio_resid(uio) / 4 > 256 ? 256u : (uint32_t)(uio_resid(uio) / 4);
+		uint32_t head = __atomic_load_n(&fa_ring_head, __ATOMIC_RELAXED), tail = __atomic_load_n(&fa_ring_tail, __ATOMIC_ACQUIRE);
+
+		if ((error = uiomove((caddr_t)chunk, (int)(frames * 4), uio)) != 0) {
+			return error;
+		}
+		for (uint32_t i = 0; i < frames; i++) {
+			if (head - tail >= FA_RING_FRAMES) {
+				fa_dropped += frames - i;
+				break;
+			}
+			fa_ring[head++ & (FA_RING_FRAMES - 1)] = chunk[i];
+		}
+		__atomic_store_n(&fa_ring_head, head, __ATOMIC_RELEASE);
+	}
+	return 0;
+}
+
+static const struct cdevsw fa_cdevsw = {
+	.d_open       = fa_dev_open,
+	.d_close      = fa_dev_open,
+	.d_read       = eno_rdwrt,
+	.d_write      = fa_dev_write,
+	.d_ioctl      = eno_ioctl,
+	.d_stop       = eno_stop,
+	.d_reset      = eno_reset,
+	.d_ttys       = NULL,
+	.d_select     = eno_select,
+	.d_mmap       = eno_mmap,
+	.d_strategy   = eno_strat,
+	.d_reserved_1 = eno_getc,
+	.d_reserved_2 = eno_putc,
+	.d_type       = 0,
+};
+
+/* ---- the bottom amplifier, fuxiaudioamp=1: au_amp_on.h's sequence, as the loader's au_tone_stage() ran it ---- */
+#define FA_SE0  0x00880000ull
+#define FA_GCC  0x00100000ull
+#define FA_TLMM 0x0f100000ull
+static vm_offset_t fa_se0, fa_gcc, fa_tlmm;
+static bool fa_amp_wanted, fa_amp_up_now, fa_amp_gave_up;
+
+static vm_offset_t
+fa_amp_va(uint64_t pa)
+{
+	if (pa >= FA_SE0 && pa < FA_SE0 + 0x4000) {
+		return fa_se0 + (vm_offset_t)(pa - FA_SE0);
+	}
+	if (pa >= FA_GCC && pa < FA_GCC + 0x80000) {
+		return fa_gcc + (vm_offset_t)(pa - FA_GCC);
+	}
+	if (pa >= FA_TLMM && pa < FA_TLMM + 0x100000 + 0x4000) {
+		return fa_tlmm + (vm_offset_t)(pa - FA_TLMM);
+	}
+	panic("FUXI AUDIO: no window for %#llx", (unsigned long long)pa);
+}
+static uint32_t fa_amp_rd(uint64_t pa) { return *(volatile uint32_t *)fa_amp_va(pa); }
+static int
+fa_amp_wr(uint64_t pa, uint32_t v)
+{
+	__asm__ volatile ("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)fa_amp_va(pa) = v;
+	__asm__ volatile ("dsb osh" ::: "memory");
+	return 0;
+}
+#define AU_AMP_RD(pa) fa_amp_rd(pa)
+#define AU_AMP_WR(pa, v) fa_amp_wr((pa), (v))
+#define AU_AMP_DELAY_US(us) delay_for_interval((us), 1000u)
+#include "fuxi_au_amp.h"
+#include "fuxi_au_amp_on.h"
+
+static const uint8_t fa_amp_pins[8] = {0, 1, 182, 183, 121, 122, 123, 124};
+static uint32_t fa_amp_saved[8][2];
+static struct au_on fa_amp;
+
+/* As the loader's au_pin(): the pin's control, claimed from LPASS where it can be, and its level before the output turns on. */
+static void
+fa_amp_pin(unsigned n, uint32_t ctl, uint32_t out)
+{
+	uint64_t c = FA_TLMM + 0x1000u * n;
+	uint32_t was = fa_amp_rd(c);
+
+	ctl |= was & (1u << 11);
+	if ((was & (1u << 11)) != 0) {
+		ctl |= 1u << 12;
+	}
+	if ((ctl & (1u << 9)) != 0) {
+		(void)fa_amp_wr(c + 4, out << 1);
+	}
+	(void)fa_amp_wr(c, ctl);
+}
+
+static void
+fa_amp_pins_back(void)
+{
+	fa_amp_pin(183, 1u | 1u << 9, 0);
+	delay_for_interval(3000, 1000);
+	for (unsigned i = 0; i < 8; i++) {
+		(void)fa_amp_wr(FA_TLMM + 0x1000u * fa_amp_pins[i] + 4, fa_amp_saved[i][1] & 2u);
+		(void)fa_amp_wr(FA_TLMM + 0x1000u * fa_amp_pins[i], fa_amp_saved[i][0]);
+	}
+}
+
+/* With the graph started, zeros going. Any trouble: it goes down and stays down until the next boot. Nothing is retried. */
+static void
+fa_amp_up(void)
+{
+	int r;
+
+	if (!fa_amp_wanted || fa_amp_gave_up || fa_amp_up_now) {
+		return;
+	}
+	(void)fa_amp_wr(FA_GCC + 0x52010, fa_amp_rd(FA_GCC + 0x52010) | 0x1fu);
+	for (unsigned i = 0; i < 10000 && (fa_amp_rd(FA_GCC + 0x233cc) >> 31) != 0; i++) {
+		delay_for_interval(10, 1000);
+	}
+	if ((fa_amp_rd(FA_GCC + 0x233cc) >> 31) != 0 || !au_amp_engine(FA_SE0)) {
+		printf("FUXI AUDIO: amp: no bus\n");
+		fa_amp_gave_up = true;
+		return;
+	}
+	for (unsigned i = 0; i < 10000 && (fa_amp_rd(FA_GCC + 0x1e004) >> 31) != 0; i++) {
+		delay_for_interval(10, 1000);
+	}
+	for (unsigned i = 0; i < 8; i++) {
+		fa_amp_saved[i][0] = fa_amp_rd(FA_TLMM + 0x1000u * fa_amp_pins[i]);
+		fa_amp_saved[i][1] = fa_amp_rd(FA_TLMM + 0x1000u * fa_amp_pins[i] + 4);
+	}
+	/* The top one in reset all along; gpio68, its earpiece switch, not touched. */
+	fa_amp_pin(182, 1u | 1u << 9, 0);
+	fa_amp_pin(183, 1u | 1u << 9, 0);
+	fa_amp_pin(0, 3u | 2u << 2, 0);
+	fa_amp_pin(1, 3u | 2u << 2, 0);
+	fa_amp_pin(121, 1u << 2 | 3u << 6, 0);
+	fa_amp_pin(123, 1u << 2 | 3u << 6, 0);
+	fa_amp_pin(124, 1u << 2 | 3u << 6, 0);
+	delay_for_interval(3000, 1000);
+	fa_amp_pin(183, 1u | 1u << 9, 1);
+	delay_for_interval(3000, 1000);
+	memset(&fa_amp, 0, sizeof(fa_amp));
+	fa_amp.se = FA_SE0;
+	fa_amp.address = 0x40;
+	r = au_on_prepare(&fa_amp, true, false);
+	if (r == AU_ON_OK) {
+		r = au_on_power_up(&fa_amp);
+	}
+	if (r == AU_ON_OK) {
+		r = au_on_check(&fa_amp);
+	}
+	if (r == AU_ON_OK) {
+		r = au_on_unmute(&fa_amp, 0);
+	}
+	printf("FUXI AUDIO: amp up: %#x at step %u, reg %#x want %#x got %#x, status %#x %#x\n", r, fa_amp.step, fa_amp.failed_reg, fa_amp.failed_want, fa_amp.failed_got, fa_amp.status[0], fa_amp.status[2]);
+	if (r != AU_ON_OK) {
+		fa_amp_gave_up = true;
+		au_on_down(&fa_amp);
+		fa_amp_pins_back();
+		return;
+	}
+	fa_amp_up_now = true;
+}
+
+static void
+fa_amp_down(void)
+{
+	if (!fa_amp_up_now) {
+		return;
+	}
+	au_on_down(&fa_amp);
+	fa_amp_pins_back();
+	fa_amp_up_now = false;
+	printf("FUXI AUDIO: amp down\n");
+}
+
+/* Once in a while as it plays: a flag and it comes down for good. */
+static void
+fa_amp_watch(void)
+{
+	if (fa_amp_up_now && au_on_check(&fa_amp) != AU_ON_OK) {
+		printf("FUXI AUDIO: amp flag: status %#x %#x %#x %#x\n", fa_amp.status[0], fa_amp.status[1], fa_amp.status[2], fa_amp.status[3]);
+		fa_amp_gave_up = true;
+		fa_amp_down();
+	}
+}
+
+/* What has come, or silence, into the next of the DSP's periods. The frames taken. */
+static uint32_t
+fa_fill_period(uint32_t index, uint32_t *peak)
+{
+	volatile uint32_t *out = (volatile uint32_t *)(fa_buffer + index * FA_PERIOD_BYTES);
+	uint32_t tail = __atomic_load_n(&fa_ring_tail, __ATOMIC_RELAXED), have = fa_ring_count(), taken = have < FA_PERIOD_FRAMES ? have : FA_PERIOD_FRAMES;
+
+	for (uint32_t i = 0; i < FA_PERIOD_FRAMES; i++) {
+		uint32_t frame = i < taken ? fa_ring[tail++ & (FA_RING_FRAMES - 1)] : 0;
+		int32_t left = (int16_t)(frame & 0xffff), right = (int16_t)(frame >> 16), mono = (left + right) / 2;
+		uint32_t a = (uint32_t)(mono < 0 ? -mono : mono);
+
+		*peak = a > *peak ? a : *peak;
+		for (uint32_t c = 0; c < 4; c++) {
+			out[4 * i + c] = (uint32_t)(mono * 65536);
+		}
+	}
+	__atomic_store_n(&fa_ring_tail, tail, __ATOMIC_RELEASE);
+	__asm__ volatile ("dsb osh" ::: "memory");
+	return taken;
+}
+
+static void
+fa_stream(void)
+{
+	for (;;) {
+		uint64_t frames = 0;
+		uint32_t idle = 0, peak = 0, short_periods = 0, sent_at_last = 0, last_said = 0;
+
+		while (fa_ring_count() == 0) {
+			if (!fa_poll(0)) {
+				return;
+			}
+			fa_sleep_ms(20);
+		}
+		printf("FUXI AUDIO: samples are coming\n");
+		if (fa_graph_up() != 0) {
+			printf("FUXI AUDIO: the graph did not come up\n");
+			fa_graph_down();
+			return;
+		}
+		fa_amp_up();
+		while (idle < FA_IDLE_PERIODS) {
+			if (fa_g.write_sent < fa_g.write_done + FA_AHEAD) {
+				uint32_t index = fa_g.write_sent % 4, have = fa_ring_count();
+
+				/* Not ahead of the writer while it is writing: a period's wait for what is on its way beats a gap. */
+				if (have >= FA_PERIOD_FRAMES || fa_g.write_sent < fa_g.write_done + 1) {
+					uint32_t taken = fa_fill_period(index, &peak);
+					uint32_t bytes = fuxi_ar_write((uint8_t *)(fa_m + 2), AU_GL_GPR_BUFFER, 1, AU_GL_WRITE_TOKEN + (fa_g.write_sent & 0xffffu),
+					    (FA_BUFFER + index * FA_PERIOD_BYTES) | FA_BUFFER_SID << 32, fa_g.map_handle, FA_PERIOD_BYTES);
+
+					frames += taken;
+					short_periods += taken < FA_PERIOD_FRAMES;
+					idle = taken == 0 ? idle + 1 : 0;
+					if (bytes == 0 || !au_gl_data_send(&fa_g, fa_m, bytes)) {
+						printf("FUXI AUDIO: a buffer could not go, its buffers %u\n", fa_g.gpr_riid_n);
+						idle = FA_IDLE_PERIODS;
+					}
+				}
+			}
+			if (!fa_poll(1)) {
+				return;
+			}
+			if (fa_g.write_sent - sent_at_last >= 250) {
+				sent_at_last = fa_g.write_sent;
+				fa_amp_watch();
+				if (last_said != fa_g.write_sent) {
+					printf("FUXI AUDIO: playing: %u periods sent, %u played, %u bad, %u s of samples, peak %u, %u periods short, %u frames dropped\n", fa_g.write_sent, fa_g.write_done, fa_g.write_bad,
+					    (uint32_t)(frames / 48000), peak, short_periods, fa_dropped);
+					last_said = fa_g.write_sent;
+					peak = 0;
+				}
+			}
+		}
+		fa_amp_down();
+		printf("FUXI AUDIO: quiet: %u periods sent, %u played, %u bad, %u s of samples, %u frames dropped\n", fa_g.write_sent, fa_g.write_done, fa_g.write_bad, (uint32_t)(frames / 48000), fa_dropped);
+		fa_graph_down();
+	}
+}
+
+/* fuxiaudio=1: a second of zeros, through the whole list. */
+static void
+fa_self_test(void)
+{
+	uint32_t i;
+
+	if (fa_graph_up() == 0 && fa_g.map_handle != 0) {
+		for (i = 0; i < 4000 && (fa_g.write_sent < FA_PERIODS || fa_g.write_done < FA_PERIODS); i++) {
+			if (fa_g.write_sent < FA_PERIODS && fa_g.write_sent < fa_g.write_done + 2) {
+				uint32_t bytes = fuxi_ar_write((uint8_t *)(fa_m + 2), AU_GL_GPR_BUFFER, 1, AU_GL_WRITE_TOKEN + fa_g.write_sent,
+				    (FA_BUFFER + (fa_g.write_sent % 4) * FA_PERIOD_BYTES) | FA_BUFFER_SID << 32, fa_g.map_handle, FA_PERIOD_BYTES);
+
+				if (bytes != 0) {
+					(void)au_gl_data_send(&fa_g, fa_m, bytes);
+				}
+			}
+			if (!fa_poll(1)) {
+				break;
+			}
+		}
+		printf("FUXI AUDIO: buffers sent %u played %u, first at %u ms, last at %u ms, last status %#x, bad %u\n", fa_g.write_sent, fa_g.write_done,
+		    fa_g.write_first_ms, fa_g.write_last_ms, fa_g.write_status, fa_g.write_bad);
+		if (fa_g.write_done > 1) {
+			printf("FUXI AUDIO: %u us a buffer of 20 ms\n", (fa_g.write_last_ms - fa_g.write_first_ms) * 1000u / (fa_g.write_done - 1u));
+		}
+	}
+	fa_graph_down();
+}
+
+static void
+fa_thread(void *arg, wait_result_t result)
+{
+#pragma unused(result)
+	if (fa_bring_up()) {
+		if ((uintptr_t)arg == 2) {
+			fa_stream();
+		} else {
+			fa_self_test();
+		}
+	}
+	(void)thread_terminate(current_thread());
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+void
+fuxi_audio_dsp_init(void)
+{
+	int on = 0;
+	thread_t thread;
+
+	if (!PE_parse_boot_argn("fuxiaudio", &on, sizeof(on)) || on <= 0) {
+		return;
+	}
+	if (on == 2) {
+		int major = cdevsw_add(-1, &fa_cdevsw), amp = 0;
+
+		if (PE_parse_boot_argn("fuxiaudioamp", &amp, sizeof(amp)) && amp == 1) {
+			fa_se0 = ml_io_map((vm_offset_t)FA_SE0, 0x4000);
+			fa_gcc = ml_io_map((vm_offset_t)FA_GCC, 0x80000);
+			fa_tlmm = ml_io_map((vm_offset_t)FA_TLMM, 0x104000);
+			fa_amp_wanted = fa_se0 != 0 && fa_gcc != 0 && fa_tlmm != 0;
+			printf("FUXI AUDIO: the amplifier was asked for: %d\n", fa_amp_wanted);
+		}
+
+		if (major < 0 || devfs_make_node(makedev(major, 0), DEVFS_CHAR, UID_ROOT, GID_WHEEL, 0666, "fuxiaudio") == NULL) {
+			printf("FUXI AUDIO: no /dev/fuxiaudio\n");
+			return;
+		}
+	}
+	if (kernel_thread_start(fa_thread, (void *)(uintptr_t)on, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	} else {
+		printf("FUXI AUDIO: kernel_thread_start failed\n");
+	}
+}
+#endif /* FUXI */
--- /dev/null
+++ b/bsd/dev/fuxi_au_glink.h
@@ -0,0 +1,429 @@
+/* Fuxi audio lane: the AP's end of GLINK over SMEM with the ADSP, polled, enough to see what the DSP opens. Plain C so that
+ * tools/test-fuxi-audio-glink.py runs it against a fake DSP under the sanitizers; audio.c gives it the SMEM accessors.
+ * The wire format follows Linux qcom_glink_native.c and qcom_glink_smem.c. It negotiates the version, answers CLOSE and an
+ * intent request, and with AU_GL_ANSWER also completes the opening of a channel. Only with AU_GL_GPR does any data leave, and
+ * then APM_CMD_GET_SPF_STATE alone on adsp_apps, by au_gl_gpr_ask(), which reads a state and sets up nothing. With AU_GL_PRM,
+ * once that says ready, au_gl_prm_step() also votes LPASS's macro and dcodec on and off again. With AU_GL_GRAPH, au_gl_graph_send()
+ * sends what audio.c builds, a packet too long for the DSP's own buffers: it opens, configures and closes a graph and never starts it,
+ * so no clock reaches a pin. With AU_GL_PLAY the list goes on to start it and au_gl_data_send() gives it buffers: audio.c fills them with
+ * zeros and never muxes a pin, so what this proves is the DSP's clock taking them. No amplifier and no register either way. Define AU_GL_RD, AU_GL_WR, AU_GL_WMB and AU_GL_KICK.
+ */
+#ifndef AU_GLINK_H
+#define AU_GLINK_H
+
+enum { AU_GL_VERSION = 0, AU_GL_VERSION_ACK = 1, AU_GL_OPEN = 2, AU_GL_CLOSE = 3, AU_GL_OPEN_ACK = 4, AU_GL_INTENT = 5,
+       AU_GL_RX_DONE = 6, AU_GL_INTENT_REQ = 7, AU_GL_INTENT_REQ_ACK = 8, AU_GL_TX_DATA = 9, AU_GL_CLOSE_ACK = 11,
+       AU_GL_TX_DATA_CONT = 12, AU_GL_READ_NOTIF = 13, AU_GL_RX_DONE_REUSE = 14, AU_GL_SIGNALS = 15 };
+#define AU_GL_FEATURE_REUSE 1u
+#define AU_GL_RESERVE 16u      /* FIFO_FULL_RESERVE + TX_BLOCKED_CMD_RESERVE */
+#define AU_GL_NAME_MOST 32u    /* GLINK_NAME_SIZE */
+#define AU_GL_ANSWER 1u        /* options: complete the opening of what the DSP opens */
+#define AU_GL_REC_WORDS 12u    /* ms, cmd | param1 << 16, param2, bytes after the header, then 32 bytes of them */
+#define AU_GL_FROM_US 0x8000u  /* in a record's cmd: what we sent */
+#define AU_GL_CHANNELS 16u
+#define AU_GL_RESENDS 4u
+#define AU_GL_GPR 2u           /* options: ask the APM on adsp_apps whether it is up. Needs AU_GL_ANSWER */
+#define AU_GL_GPR_ASKS 8u
+#define AU_GL_GPR_INTENTS 8u   /* of the DSP's buffers, as many as there are asks */
+#define AU_GL_GPR_WORDS 16u    /* kept of an answer */
+#define AU_GL_GPR_BUFFER 512u  /* offered for its answers: a size only, what comes in is read from the ring. Linux GPR_MAX 4096 is for graphs */
+#define AU_GL_GPR_OFFERS 16u
+#define AU_GL_OP_GET_SPF_STATE 0x01001021u
+#define AU_GL_OP_SPF_STATE 0x02001007u  /* payload {status}: 1 ready */
+#define AU_GL_PRM 4u           /* options: with AU_GL_GPR, once ready, the votes of au_gl_prm_step() */
+#define AU_GL_PRM_STEPS 4u     /* macro on, dcodec on, dcodec off, macro off */
+#define AU_GL_PRM_NO_ANSWER 0xffffffffu
+#define AU_GL_OP_PRM_REQUEST 0x0100100Fu
+#define AU_GL_OP_PRM_RELEASE 0x01001010u
+#define AU_GL_OP_BASIC_RESULT 0x02001005u  /* payload {opcode, status} */
+#define AU_GL_OP_PRM_REQUEST_DONE 0x02001002u
+#define AU_GL_OP_PRM_RELEASE_DONE 0x02001003u
+#define AU_GL_PRM_TOKEN 0x100u
+#define AU_GL_GRAPH 8u         /* options: with AU_GL_PRM, between the votes, the packets of au_gl_graph_send() */
+#define AU_GL_GRAPH_MOST 32u   /* the longest of audio.c's lists */
+#define AU_GL_GRAPH_TOKEN 0x200u
+#define AU_GL_PLAY 16u         /* options: with AU_GL_GRAPH, the buffers of au_gl_data_send() */
+#define AU_GL_WRITE_TOKEN 0x1000u
+#define AU_GL_TONE 32u         /* options: audio.c's first tone, on the owner's word. For its list and au_tone_stage(); nothing here reads it */
+#define AU_GL_OP_MEM_MAP_DONE 0x02001001u  /* payload {handle} */
+#define AU_GL_OP_WRITE_DONE 0x05001004u    /* payload {address, address, handle, status} */
+#define AU_GL_OP_READ_DONE 0x05001005u     /* payload {status, address, address, handle, bytes, offset} */
+#define AU_GL_READ_TOKEN 0x20000u
+
+struct au_gl {
+	uint64_t desc, tx_fifo, rx_fifo;
+	uint32_t tx_len, rx_len, options, features, ms;
+	uint32_t *log;
+	uint32_t log_most, log_n, log_lost;
+	uint32_t rx_msgs, tx_msgs, tx_full, stuck, version_acked, version_seen, resends, opened, acked_by_dsp;
+	uint16_t rcid[AU_GL_CHANNELS];
+	uint32_t gpr_lcid, gpr_rcid, gpr_acked, gpr_offers, gpr_asked, gpr_heard, gpr_other, gpr_ready;
+	uint32_t gpr_asked_ms, gpr_first_ms, gpr_last_ms, gpr_first_bytes, gpr_last_bytes, gpr_riid_n;
+	uint32_t gpr_riid[AU_GL_GPR_INTENTS], gpr_first[AU_GL_GPR_WORDS], gpr_last[AU_GL_GPR_WORDS];
+	uint32_t prm_sent, prm_status[AU_GL_PRM_STEPS], prm_opcode[AU_GL_PRM_STEPS], prm_sent_ms[AU_GL_PRM_STEPS], prm_heard_ms[AU_GL_PRM_STEPS];
+	uint32_t big_riid, big_have, big_asked, big_refused, big_size, graph_steps, graph_sent, graph_status[AU_GL_GRAPH_MOST], graph_heard_ms[AU_GL_GRAPH_MOST];
+	uint32_t map_handle, write_sent, write_done, write_status, write_bad, write_first_ms, write_last_ms;
+	uint32_t read_sent, read_done, read_status, read_bad, read_bytes, read_offset;
+};
+
+static inline uint32_t au_gl_align8(uint32_t n) { return (n + 7u) & ~7u; }
+
+static inline void au_gl_note(struct au_gl *g, uint32_t cmd, uint32_t p1, uint32_t p2, uint32_t extra, const uint32_t *w, uint32_t words)
+{
+	if (g->log_n >= g->log_most) { g->log_lost++; return; }
+	uint32_t *r = g->log + AU_GL_REC_WORDS * g->log_n++;
+	r[0] = g->ms; r[1] = cmd | p1 << 16; r[2] = p2; r[3] = extra;
+	for (uint32_t i = 0; i < 8; i++) r[4 + i] = i < words ? w[i] : 0;
+}
+
+/* Nothing is sent unless all of it fits. False when it does not, or when the far end's tail cannot be true. */
+static inline bool au_gl_tx(struct au_gl *g, uint32_t cmd, uint32_t p1, uint32_t p2, const uint32_t *extra, uint32_t extra_bytes)
+{
+	uint32_t head = AU_GL_RD(g->desc + 4), tail = AU_GL_RD(g->desc), total = 8u + au_gl_align8(extra_bytes);
+	uint32_t room;
+
+	if (head >= g->tx_len || tail >= g->tx_len || (head & 7u) != 0) { g->tx_full++; return false; }
+	room = tail <= head ? g->tx_len - head + tail : tail - head;
+	if (room < AU_GL_RESERVE + total) { g->tx_full++; return false; }
+	AU_GL_WR(g->tx_fifo + head, cmd | p1 << 16);
+	AU_GL_WR(g->tx_fifo + (head + 4u) % g->tx_len, p2);
+	for (uint32_t i = 0; i < au_gl_align8(extra_bytes) / 4u; i++) {
+		AU_GL_WR(g->tx_fifo + (head + 8u + 4u * i) % g->tx_len, extra[i]);
+	}
+	AU_GL_WMB();
+	AU_GL_WR(g->desc + 4, (head + total) % g->tx_len);
+	AU_GL_KICK();
+	g->tx_msgs++;
+	au_gl_note(g, cmd | AU_GL_FROM_US, p1, p2, extra_bytes, extra, extra_bytes / 4u + ((extra_bytes & 3u) != 0));
+	return true;
+}
+
+static inline bool au_gl_start(struct au_gl *g)
+{
+	AU_GL_WR(g->desc + 8, 0);    /* our tail of what it sends */
+	AU_GL_WR(g->desc + 4, 0);    /* our head of what we send */
+	g->features = AU_GL_FEATURE_REUSE;
+	return au_gl_tx(g, AU_GL_VERSION, 1, g->features, 0, 0);
+}
+
+/* The word `offset` bytes past the tail. Offsets stay word aligned, as the head is 8 byte aligned. */
+static inline uint32_t au_gl_word(const struct au_gl *g, uint32_t tail, uint32_t offset)
+{
+	return AU_GL_RD(g->rx_fifo + (tail + offset) % g->rx_len);
+}
+
+static inline int au_gl_channel(const struct au_gl *g, uint32_t rcid)
+{
+	for (uint32_t i = 0; i < g->opened && i < AU_GL_CHANNELS; i++) {
+		if (g->rcid[i] == rcid) return (int)i;
+	}
+	return -1;
+}
+
+static inline void au_gl_gpr_offer(struct au_gl *g, uint32_t iid)
+{
+	uint32_t pair[2] = {AU_GL_GPR_BUFFER, iid};
+
+	if (g->gpr_offers >= AU_GL_GPR_OFFERS) return;
+	if (au_gl_tx(g, AU_GL_INTENT, g->gpr_lcid, 1, pair, sizeof(pair))) g->gpr_offers++;
+}
+
+/* The one data packet that can leave here. True when it went: a buffer of the DSP's was there and the ring had room. */
+static inline bool au_gl_gpr_ask(struct au_gl *g)
+{
+	uint32_t m[8];
+
+	if ((g->options & AU_GL_GPR) == 0 || !g->gpr_acked || g->gpr_riid_n == 0 || g->gpr_asked >= AU_GL_GPR_ASKS) return false;
+	m[0] = 24; m[1] = 0;                            /* chunk size, left size */
+	m[2] = 0u | 6u << 4 | 24u << 8;                 /* GPR: version 0, 6 header words, 24 bytes */
+	m[3] = 2u | 3u << 8;                            /* to the ADSP's domain, from the APPS' */
+	m[4] = 1; m[5] = 1;                             /* source port and destination: the APM's, as Linux q6apm */
+	m[6] = g->gpr_asked + 1u;                       /* token */
+	m[7] = AU_GL_OP_GET_SPF_STATE;
+	if (!au_gl_tx(g, AU_GL_TX_DATA, g->gpr_lcid, g->gpr_riid[g->gpr_riid_n - 1u], m, sizeof(m))) return false;
+	g->gpr_riid_n--;
+	if (g->gpr_asked++ == 0) g->gpr_asked_ms = g->ms;
+	return true;
+}
+
+/*
+ * The next vote, as Linux q6prm_vote_lpass_core_hw(): PRM_CMD_REQUEST_HW_RSC or _RELEASE_HW_RSC of PARAM_ID_RSC_HW_CORE, blocks 1 the macro
+ * and 2 the dcodec. They go on then come off in the opposite order, whatever each one answers, so nothing stays voted. xnu/fuxi-audio's
+ * fuxi_ar_prm_vote() is held to these bytes by tools/test-fuxi-audio-glink.py. True when it went.
+ */
+static inline bool au_gl_prm_step(struct au_gl *g)
+{
+	static const uint8_t block[AU_GL_PRM_STEPS] = {1, 2, 2, 1};
+	uint32_t step = g->prm_sent, m[18];
+
+	if ((g->options & AU_GL_PRM) == 0 || !g->gpr_ready || g->gpr_riid_n == 0 || step >= AU_GL_PRM_STEPS) return false;
+	m[0] = 60; m[1] = 0;                            /* chunk size, left size */
+	m[2] = 0u | 6u << 4 | 60u << 8;
+	m[3] = 2u | 3u << 8;
+	m[4] = 2; m[5] = 2;                             /* the PRM's port both ways, as Linux q6prm */
+	m[6] = AU_GL_PRM_TOKEN + step;
+	m[7] = step < 2u ? AU_GL_OP_PRM_REQUEST : AU_GL_OP_PRM_RELEASE;
+	m[8] = 0; m[9] = 0; m[10] = 0; m[11] = 20;      /* no shared memory: the 20 bytes come here */
+	m[12] = 2; m[13] = 0x08001032u; m[14] = 4; m[15] = 0;  /* the PRM's parameter, 4 bytes */
+	m[16] = block[step];
+	m[17] = 0;                                      /* the ring's padding, au_gl_tx() goes to 8 bytes */
+	if (!au_gl_tx(g, AU_GL_TX_DATA, g->gpr_lcid, g->gpr_riid[g->gpr_riid_n - 1u], m, 68)) return false;
+	g->gpr_riid_n--;
+	g->prm_status[step] = AU_GL_PRM_NO_ANSWER;
+	g->prm_sent_ms[step] = g->ms;
+	g->prm_sent = step + 1u;
+	return true;
+}
+
+/* A buffer of the DSP's long enough for a graph's packet, as Linux qcom_glink_request_intent(). Once, until it has been used. */
+static inline bool au_gl_big_ask(struct au_gl *g)
+{
+	if ((g->options & AU_GL_GRAPH) == 0 || !g->gpr_acked || g->big_have || g->big_asked) return false;
+	if (!au_gl_tx(g, AU_GL_INTENT_REQ, g->gpr_lcid, AU_GL_GPR_BUFFER, 0, 0)) return false;
+	g->big_asked = 1;
+	return true;
+}
+
+/*
+ * The next packet of audio.c's list, `bytes` long, in `m` after two words kept for GLINK's own sizes, and with room to reach 8 bytes.
+ * True when it went: only into the long buffer, and only that many times.
+ */
+static inline bool au_gl_graph_send(struct au_gl *g, uint32_t *m, uint32_t bytes)
+{
+	if ((g->options & AU_GL_GRAPH) == 0 || !g->gpr_ready || !g->big_have || g->graph_sent >= g->graph_steps || g->graph_sent >= AU_GL_GRAPH_MOST ||
+	    bytes > AU_GL_GPR_BUFFER || bytes > g->big_size) return false;
+	m[0] = bytes; m[1] = 0;
+	if (((8u + bytes) & 7u) != 0) m[(8u + bytes) / 4u] = 0;
+	if (!au_gl_tx(g, AU_GL_TX_DATA, g->gpr_lcid, g->big_riid, m, 8u + bytes)) return false;
+	g->big_have = 0;
+	g->graph_status[g->graph_sent++] = AU_GL_PRM_NO_ANSWER;
+	return true;
+}
+
+/* One of audio.c's buffers, into one of the DSP's small ones. `m` as for au_gl_graph_send(). */
+static inline bool au_gl_data_send(struct au_gl *g, uint32_t *m, uint32_t bytes)
+{
+	if ((g->options & AU_GL_PLAY) == 0 || g->map_handle == 0u || g->gpr_riid_n == 0 || bytes > 128u) return false;
+	m[0] = bytes; m[1] = 0;
+	if (((8u + bytes) & 7u) != 0) m[(8u + bytes) / 4u] = 0;
+	if (!au_gl_tx(g, AU_GL_TX_DATA, g->gpr_lcid, g->gpr_riid[g->gpr_riid_n - 1u], m, 8u + bytes)) return false;
+	g->gpr_riid_n--;
+	g->write_sent++;
+	return true;
+}
+
+/* One empty buffer for what comes back, the same way. */
+static inline bool au_gl_read_send(struct au_gl *g, uint32_t *m, uint32_t bytes)
+{
+	if ((g->options & AU_GL_PLAY) == 0 || g->map_handle == 0u || g->gpr_riid_n == 0 || bytes > 128u) return false;
+	m[0] = bytes; m[1] = 0;
+	if (((8u + bytes) & 7u) != 0) m[(8u + bytes) / 4u] = 0;
+	if (!au_gl_tx(g, AU_GL_TX_DATA, g->gpr_lcid, g->gpr_riid[g->gpr_riid_n - 1u], m, 8u + bytes)) return false;
+	g->gpr_riid_n--;
+	g->read_sent++;
+	return true;
+}
+
+/* An answer on adsp_apps, while it is still in the ring. `tail` is at its header, so its bytes begin 16 past. */
+static inline void au_gl_gpr_take(struct au_gl *g, uint32_t tail, uint32_t bytes)
+{
+	uint32_t *keep = g->gpr_heard == 0 ? g->gpr_first : g->gpr_last;
+
+	for (uint32_t i = 0; i < AU_GL_GPR_WORDS; i++) keep[i] = i * 4u < bytes ? au_gl_word(g, tail, 16u + 4u * i) : 0;
+	if (g->gpr_heard == 0) { g->gpr_first_ms = g->ms; g->gpr_first_bytes = bytes; }
+	g->gpr_last_ms = g->ms; g->gpr_last_bytes = bytes;
+	if (keep[5] == AU_GL_OP_SPF_STATE && bytes >= 28u && keep[6] == 1u) g->gpr_ready = 1;
+	/* A vote's answer, by its token. As fuxi_ar_parse(): the status is the second word of the payload, or the only one. */
+	if (keep[4] >= AU_GL_PRM_TOKEN && keep[4] - AU_GL_PRM_TOKEN < AU_GL_PRM_STEPS && keep[4] - AU_GL_PRM_TOKEN < g->prm_sent && bytes >= 28u &&
+	    (keep[5] == AU_GL_OP_BASIC_RESULT || keep[5] == AU_GL_OP_PRM_REQUEST_DONE || keep[5] == AU_GL_OP_PRM_RELEASE_DONE)) {
+		uint32_t step = keep[4] - AU_GL_PRM_TOKEN;
+
+		g->prm_status[step] = bytes >= 32u ? keep[7] : keep[6];
+		g->prm_opcode[step] = keep[5];
+		g->prm_heard_ms[step] = g->ms;
+	}
+	if (keep[4] >= AU_GL_GRAPH_TOKEN && keep[4] - AU_GL_GRAPH_TOKEN < g->graph_sent && keep[4] - AU_GL_GRAPH_TOKEN < AU_GL_GRAPH_MOST) {
+		uint32_t step = keep[4] - AU_GL_GRAPH_TOKEN;
+
+		if (bytes >= 32u && keep[5] == AU_GL_OP_BASIC_RESULT) {
+			g->graph_status[step] = keep[7];
+			g->graph_heard_ms[step] = g->ms;
+		} else if (bytes >= 32u && (keep[5] == AU_GL_OP_PRM_REQUEST_DONE || keep[5] == AU_GL_OP_PRM_RELEASE_DONE)) {
+			g->graph_status[step] = keep[7];    /* the clock, on a list that has it */
+			g->graph_heard_ms[step] = g->ms;
+		} else if (bytes >= 28u && keep[5] == AU_GL_OP_MEM_MAP_DONE) {
+			g->map_handle = keep[6];
+			g->graph_status[step] = 0;
+			g->graph_heard_ms[step] = g->ms;
+		}
+	}
+	if (keep[5] == AU_GL_OP_WRITE_DONE && bytes >= 40u) {
+		if (g->write_done++ == 0u) g->write_first_ms = g->ms;
+		g->write_last_ms = g->ms;
+		g->write_status = keep[9];
+		g->write_bad += keep[9] != 0u;
+	}
+	if (keep[5] == AU_GL_OP_READ_DONE && bytes >= 44u) {
+		g->read_done++;
+		g->read_status = keep[6];
+		g->read_bad += keep[6] != 0u;
+		g->read_bytes = keep[10];
+		g->read_offset = bytes >= 48u ? keep[11] : 0u;
+	}
+	g->gpr_heard++;
+}
+
+/*
+ * One message from the DSP, if a whole one is there. True when one was taken. Lengths come from the far end, so each is
+ * bounded before use; what cannot be read safely stops the reader for good (g->stuck), as there is no way to find the next.
+ */
+static inline bool au_gl_step(struct au_gl *g)
+{
+	uint32_t head, tail, avail, w0, cmd, p1, p2, extra = 0, total, words[8];
+	bool gpr_channel;
+
+	if (g->stuck || !g->rx_fifo || !g->rx_len) return false;
+	head = AU_GL_RD(g->desc + 12);
+	tail = AU_GL_RD(g->desc + 8);
+	if (head >= g->rx_len || tail >= g->rx_len || ((head | tail) & 3u) != 0) { g->stuck = 1; return false; }
+	avail = head < tail ? g->rx_len - tail + head : head - tail;
+	if (avail < 8) return false;
+	w0 = au_gl_word(g, tail, 0);
+	p2 = au_gl_word(g, tail, 4);
+	cmd = w0 & 0xffffu;
+	p1 = w0 >> 16;
+	total = 8;
+	switch (cmd) {
+	case AU_GL_VERSION: case AU_GL_VERSION_ACK: case AU_GL_CLOSE: case AU_GL_OPEN_ACK: case AU_GL_RX_DONE:
+	case AU_GL_INTENT_REQ: case AU_GL_INTENT_REQ_ACK: case AU_GL_CLOSE_ACK: case AU_GL_READ_NOTIF:
+	case AU_GL_RX_DONE_REUSE: case AU_GL_SIGNALS:
+		break;
+	case AU_GL_OPEN:
+		if (p2 == 0 || p2 > g->rx_len / 2) { g->stuck = 2; return false; }
+		extra = p2;
+		total = 8u + au_gl_align8(p2);
+		break;
+	case AU_GL_INTENT:
+		if (p2 > g->rx_len / 16) { g->stuck = 3; return false; }
+		extra = 8u * p2;
+		total = 8u + extra;
+		break;
+	case AU_GL_TX_DATA: case AU_GL_TX_DATA_CONT:
+		if (avail < 16) return false;
+		extra = au_gl_word(g, tail, 8);
+		if (extra > g->rx_len / 2) { g->stuck = 4; return false; }
+		total = au_gl_align8(16u + extra);
+		break;
+	default:
+		g->stuck = 5;
+		au_gl_note(g, cmd, p1, p2, 0, 0, 0);
+		return false;
+	}
+	if (avail < total) return false;
+	for (uint32_t i = 0; i < 8; i++) {
+		words[i] = i * 4u < total - 8u ? au_gl_word(g, tail, 8u + 4u * i) : 0;
+	}
+	g->rx_msgs++;
+	gpr_channel = g->gpr_lcid != 0 && p1 == g->gpr_rcid;
+	/* Every channel's buffers would fill the log before the answer comes. */
+	if ((g->options & AU_GL_GPR) == 0 || cmd != AU_GL_INTENT || gpr_channel) au_gl_note(g, cmd, p1, p2, extra, words, 8);
+	if (cmd == AU_GL_TX_DATA && gpr_channel) au_gl_gpr_take(g, tail, extra);
+	AU_GL_WR(g->desc + 8, (tail + total) % g->rx_len);
+
+	switch (cmd) {
+	case AU_GL_VERSION:
+		if (p1 == 0) break;
+		if (p1 == 1) g->features &= p2;
+		g->version_seen = 1;
+		(void)au_gl_tx(g, AU_GL_VERSION_ACK, 1, g->features, 0, 0);
+		break;
+	case AU_GL_VERSION_ACK:
+		if (p1 == 0) break;
+		if (p1 == 1 && p2 == g->features) { g->version_acked = 1; break; }
+		if (p1 == 1) g->features &= p2;
+		if (g->resends++ < AU_GL_RESENDS) (void)au_gl_tx(g, AU_GL_VERSION, 1, g->features, 0, 0);
+		break;
+	case AU_GL_OPEN:
+		if ((g->options & AU_GL_ANSWER) != 0 && g->opened < AU_GL_CHANNELS && p2 <= AU_GL_NAME_MOST && au_gl_channel(g, p1) < 0) {
+			/* As qcom_glink_create_remote(): its opening acknowledged, then ours under the same name. */
+			uint32_t lcid = ++g->opened;
+
+			g->rcid[lcid - 1] = (uint16_t)p1;
+			(void)au_gl_tx(g, AU_GL_OPEN_ACK, p1, 0, 0, 0);
+			(void)au_gl_tx(g, AU_GL_OPEN, lcid, p2, words, p2);
+			/* "adsp_apps" and its NUL */
+			if ((g->options & AU_GL_GPR) != 0 && p2 == 10u && words[0] == 0x70736461u && words[1] == 0x7070615fu && (words[2] & 0xffffu) == 0x0073u) {
+				g->gpr_lcid = lcid;
+				g->gpr_rcid = p1;
+			}
+		}
+		break;
+	case AU_GL_OPEN_ACK:
+		g->acked_by_dsp++;
+		/* As Linux once a channel is up: buffers offered, so that the APM has somewhere to answer. */
+		if (g->gpr_lcid != 0 && p1 == g->gpr_lcid && !g->gpr_acked) {
+			g->gpr_acked = 1;
+			au_gl_gpr_offer(g, 1);
+			au_gl_gpr_offer(g, 2);
+		}
+		break;
+	case AU_GL_INTENT:
+		if (gpr_channel) {
+			for (uint32_t i = 0; i < p2 && i < 4u; i++) {
+				if (words[2u * i] >= AU_GL_GPR_BUFFER) {
+					if ((g->options & AU_GL_GRAPH) != 0) {
+						g->big_riid = words[2u * i + 1u];
+						g->big_size = words[2u * i];
+						g->big_have = 1;
+						g->big_asked = 0;
+					}
+				} else if (words[2u * i] >= 24u && g->gpr_riid_n < AU_GL_GPR_INTENTS) {
