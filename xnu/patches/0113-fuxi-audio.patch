+static uint32_t
+fa_rd(uint64_t pa)
+{
+	if (pa >= FA_SMEM && pa + 4 <= FA_SMEM + FA_SMEM_SIZE) {
+		return *(volatile uint32_t *)(fa_smem + (vm_offset_t)(pa - FA_SMEM));
+	}
+	return 0xffffffffu;
+}
