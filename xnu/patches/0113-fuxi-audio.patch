+                               {FUXI_AR_MOD_PCM_CNV, FUXI_AR_IID_PLAY_CNV, 1, 1}};
+    static const Link l[] = {{FUXI_AR_IID_PLAY_SHMEM, FUXI_AR_IID_PLAY_DEC}, {FUXI_AR_IID_PLAY_DEC, FUXI_AR_IID_PLAY_CNV}, {FUXI_AR_IID_PLAY_CNV, FUXI_AR_IID_SPEAKER_TDM}};
