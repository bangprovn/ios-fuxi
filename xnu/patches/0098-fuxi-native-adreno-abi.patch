+int fuxi_gpu_abi_status(uint64_t *faults, uint64_t *suspends)
+{
+ FG_GUARD;
+ if (!faults || !suspends) return -1;
+ *faults=*suspends=0;
+ if (!fg_abi_live) return -1;
