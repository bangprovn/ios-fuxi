--- a/iokit/Kernel/arm/NativeAdrenoABI.h
+++ b/iokit/Kernel/arm/NativeAdrenoABI.h
@@ -0,0 +1,181 @@
+/* SPDX-License-Identifier: MIT */
+#ifndef NATIVE_ADRENO_ABI_H
+#define NATIVE_ADRENO_ABI_H
+#include <stdint.h>
+
+/* Versioned kernel/user-client wire ABI for the native Adreno driver. This is
+ * NOT the Metal, IOKit or Turnip ABI and it does not describe an ioctl. The
+ * IOKit service will copy exactly these fixed-size records across its external
+ * methods. All fields are little endian; both participants are ARM64. Every
+ * array is inside one fixed record so a caller cannot pass a length that
+ * disagrees with the storage. Unknown versions, methods and flags are refused
+ * rather than ignored. */
+enum {
+    NativeAdrenoAbiVersion = 2,
+    NativeAdrenoAbiMaxBuffers = 128,   /* a frame's IBs in one atomic submission (Adreno740 MIT); 16 before */
+    NativeAdrenoAbiHostPageBytes = 16384,
+    NativeAdrenoAbiMaxBoBytesShift = 28, /* 256MiB per object */
+    NativeAdrenoMethodQuery = 1,
+    NativeAdrenoMethodBoAlloc = 2,
+    NativeAdrenoMethodBoMap = 3,
+    NativeAdrenoMethodBoFree = 4,
+    NativeAdrenoMethodSubmit = 5,
+    NativeAdrenoMethodWaitFence = 6,
+    NativeAdrenoMethodGetTimestamp = 7,
+    NativeAdrenoMethodGetStatus = 8,
+    NativeAdrenoMethodSetMetadata = 9,
+    NativeAdrenoMethodGetMetadata = 10,
+    NativeAdrenoMethodCreateQueue = 11,
+    NativeAdrenoMethodCloseQueue = 12,
+    NativeAdrenoMethodBoCpuMap = 13,
+    NativeAdrenoMethodBoCpuUnmap = 14,
+    NativeAdrenoMethodGetDeviceInfo = 15,
+    NativeAdrenoMethodBoImport = 16,
+    NativeAdrenoAbiMetadataBytes = 64,
+    NativeAdrenoAbiMaxQueues = 8
+};
+struct NativeAdrenoAbiParams {
+    uint32_t abi_version;
+    uint32_t input_bits;          /* GPU VA bits below 2^input_bits */
+    uint32_t output_bits;         /* physical address bits */
+    uint32_t flags;               /* NativeAdrenoParamsHostImport or zero */
+    uint64_t max_bo_bytes;
+};
+enum {
+    NativeAdrenoParamsHostImport = 1, /* BoImport pins the caller's own pages (an IOSurface's) as a BO */
+    NativeAdrenoParamsImportGpuOnly = 2 /* BoMap accepts NativeAdrenoMapGpuOnly in `reserved` for an imported BO */
+};
+/* BoMap.reserved bits (zero keeps the old behaviour, every other bit is refused). NativeAdrenoMapGpuOnly: the caller promises that no CPU
+ * thread reads or writes the imported range from this map until BoFree/unmap (Metal storageModePrivate textures and buffers, private
+ * render targets). The kernel then cleans the range once at map, skips the per-submit clean and the retirement invalidate, and
+ * invalidates it once at unmap. Ignored for allocated BOs. A kernel that does not report NativeAdrenoParamsImportGpuOnly refuses it. */
+enum { NativeAdrenoMapGpuOnly = 1 };
+struct NativeAdrenoAbiBoAlloc {
+    uint64_t bytes;               /* 4KiB multiple, <= max_bo_bytes */
+    uint32_t align_log2;          /* 12..24 */
+    uint32_t contiguous;          /* 1 requires one raw physical span */
+};
+struct NativeAdrenoAbiBoAllocReply {
+    uint64_t handle;              /* opaque to userspace, nonzero */
+};
+/* ABI v2: pins a writable range in the opening task (and only that task may
+ * call BoImport). Reply is NativeAdrenoAbiBoAllocReply. The original CPU cache
+ * policy is preserved; no CPU-map token is issued. Kernel cleans/invalidates
+ * imported mappings before submit and invalidates after retirement/drain.
+ * fuxigpuncimport is a bitmask: bit 0 (1) cleans GPU-writable imports once at map time (below);
+ * bit 1 (2) writes CP_RB_WPTR as a fenced register; bit 2 (4) recovers a stalled job (see docs-lanes/unixnu-port.md).
+ * With bit 0 it requires NO CPU writes until unmap, including between submissions.
+ * Completion/drained-fault invalidation is retained for CPU readers.
+ * GPU access uses Normal NC, outer-shareable SMMU leaves. Caller must keep the
+ * original allocation alive and externally synchronize CPU/other GPU access.
+ * BoFree/task death unmaps and unwires after DMA retirement, or quarantines on
+ * an unconfirmed drain. No foreign-device/MMIO or surface-ID import. */
+struct NativeAdrenoAbiBoImport {
+    uint64_t address;             /* nonzero, 16KiB aligned task VA */
+    uint64_t bytes;               /* 16KiB multiple, <= max_bo_bytes */
+};
+struct NativeAdrenoAbiBoMap {
+    uint64_t handle;
+    uint64_t iova;                /* 4KiB aligned, inside the mounted aperture */
+    uint32_t permissions;         /* bit0 read, bit1 write; read required */
+    uint32_t writeback;           /* 0 normal non-coherent, 1 WB/WA */
+    uint32_t shareability;        /* 2 outer, 3 inner */
+    uint32_t reserved;            /* zero, or NativeAdrenoMapGpuOnly */
+};
+struct NativeAdrenoAbiBoMapReply {
+    uint64_t iova;
+};
+struct NativeAdrenoAbiBoFree {
+    uint64_t handle;
+};
+struct NativeAdrenoAbiSubmitBuffer {
+    uint64_t handle;
+    uint64_t iova;
+    uint64_t bytes;               /* 4-byte multiple, dword count = bytes/4 */
+};
+struct NativeAdrenoAbiSubmit {
+    uint32_t buffer_count;        /* 1..NativeAdrenoAbiMaxBuffers */
+    uint32_t reserved;            /* zero */
+    uint64_t queue;               /* open queue; 0 is created by open() */
+    uint64_t wait_fence;          /* zero or an earlier fence of this client */
+    uint64_t wait_timeout_ns;     /* used only when wait_fence is nonzero */
+    struct NativeAdrenoAbiSubmitBuffer buffers[NativeAdrenoAbiMaxBuffers];
+};
+struct NativeAdrenoAbiMetadata {
+    uint64_t handle;              /* object identity */
+    uint32_t bytes;               /* set: length; get: requested capacity */
+    uint32_t reserved;            /* zero */
+    char text[NativeAdrenoAbiMetadataBytes]; /* raw bytes, not NUL terminated */
+};
+struct NativeAdrenoAbiSubmitReply {
+    uint64_t fence;               /* nonzero CP timestamp value */
+};
+struct NativeAdrenoAbiWaitFence {
+    uint64_t fence;
+    uint64_t timeout_ns;          /* 0 polls once */
+};
+struct NativeAdrenoAbiTimestamp {
+    uint64_t ticks;               /* GPU always-on counter value */
+};
+struct NativeAdrenoAbiBoCpuMap {
+    uint64_t handle;
+};
+struct NativeAdrenoAbiBoCpuMapReply {
+    uint32_t token;               /* clientMemoryForType selector */
+    uint32_t reserved;            /* zero */
+    uint64_t bytes;               /* bytes the mapping covers */
+};
+struct NativeAdrenoAbiBoCpuUnmap {
+    uint64_t handle;
+    uint32_t token;               /* exactly the token returned by map */
+    uint32_t reserved;            /* zero */
+};
+struct NativeAdrenoAbiQueue {
+    uint64_t queue;               /* zero for create, an open id for close */
+};
+struct NativeAdrenoAbiQueueReply {
+    uint64_t queue;               /* nonzero id of the created queue */
+};
+struct NativeAdrenoAbiStatus {
+    uint64_t faults;              /* monotonic; change means context lost */
+    uint64_t suspends;            /* monotonic suspend/reset count */
+};
+/* Fixed facts of the mounted GPU that the Vulkan driver needs and cannot derive: all come from the board code, which takes
+ * them from the pinned sources (a6xx catalog, UBWC config, the programmed UCHE ranges), never from a guess. */
+enum {
+    NativeAdrenoDeviceClientIova = 1,     /* flags: the client chooses BO addresses (BoMap iova) */
+    NativeAdrenoDeviceCachedCoherent = 2  /* flags: unused until IO-coherent BO memory exists */
+};
+struct NativeAdrenoAbiDeviceInfo {
+    uint32_t chip_id;             /* ADRENO_CHIPID, e.g. 0x43050a01 */
+    uint32_t gmem_bytes;
+    uint64_t gmem_base;           /* UCHE GMEM window start (GPU address) */
+    uint64_t uche_trap_base;
+    uint64_t va_start;            /* first GPU address the client may map */
+    uint64_t va_size;
+    uint32_t highest_bank_bit;
+    uint32_t ubwc_swizzle;        /* bit0 level 1, bit1 level 2, bit2 level 3 */
+    uint32_t macrotile_mode;      /* 0 four channel, 1 eight channel */
+    uint32_t ubwc_version;        /* encoder version, 4 for UBWC 4.0 */
+    uint32_t flags;
+    uint32_t reserved;            /* zero */
+};
+#if defined(__cplusplus)
+static_assert(sizeof(NativeAdrenoAbiDeviceInfo) == 64, "ABI device info layout");
+static_assert(sizeof(NativeAdrenoAbiParams) == 24, "ABI params layout");
+static_assert(sizeof(NativeAdrenoAbiBoAlloc) == 16, "ABI alloc layout");
+static_assert(sizeof(NativeAdrenoAbiBoMap) == 32, "ABI map layout");
+static_assert(sizeof(NativeAdrenoAbiBoImport) == 16, "ABI import layout");
+static_assert(sizeof(NativeAdrenoAbiSubmitBuffer) == 24, "ABI buffer layout");
+static_assert(sizeof(NativeAdrenoAbiSubmit) == 32 + 24 * NativeAdrenoAbiMaxBuffers, "ABI submit layout");
+static_assert(sizeof(NativeAdrenoAbiBoCpuMap) == 8, "ABI cpu map layout");
+static_assert(sizeof(NativeAdrenoAbiBoCpuMapReply) == 16, "ABI cpu map reply layout");
+static_assert(sizeof(NativeAdrenoAbiBoCpuUnmap) == 16, "ABI cpu unmap layout");
+static_assert(sizeof(NativeAdrenoAbiQueue) == 8, "ABI queue layout");
+static_assert(sizeof(NativeAdrenoAbiQueueReply) == 8, "ABI queue reply layout");
+static_assert(sizeof(NativeAdrenoAbiMetadata) == 80, "ABI metadata layout");
+static_assert(sizeof(NativeAdrenoAbiWaitFence) == 16, "ABI wait layout");
+static_assert(sizeof(NativeAdrenoAbiTimestamp) == 8, "ABI timestamp layout");
+static_assert(sizeof(NativeAdrenoAbiStatus) == 16, "ABI status layout");
+#endif
+#endif
--- a/iokit/Kernel/arm/fuxi_abi_wire.h
+++ b/iokit/Kernel/arm/fuxi_abi_wire.h
@@ -0,0 +1,138 @@
+/* SPDX-License-Identifier: MIT
+ * A7xx framing adapted from UniXNU NativeAdrenoRing.cpp.
+ * Copyright (c) 2026 NativeAdreno contributors. See LICENSE.NativeAdreno.
+ */
+#ifndef FUXI_ABI_WIRE_H
+#define FUXI_ABI_WIRE_H
+#include "NativeAdrenoABI.h"
+#define FG_ABI_VA_START UINT64_C(0x20000000)
+#define FG_ABI_VA_SIZE UINT64_C(0x60000000)
+#define FG_ABI_PA_BITS 36u /* Fuxi ID2.OAS=1; existing present mapper has the same limit. */
+#define FG_ABI_MAX_BYTES (UINT64_C(1) << 28)
+/* Internal quotas, independent of the unchanged per-object wire limit. */
+#define FG_ABI_MAX_BOS 1024u
+#define FG_ABI_MAX_WIRED_BYTES (UINT64_C(768) << 20)
+#define FG_ABI_CONTIG_TRY_BYTES (UINT64_C(1) << 20)
+#define FG_ABI_MAX_IMPORTS 512u
+/* Internal: bit 8 of the permissions handed to fuxi_gpu_abi_map_import means NativeAdrenoMapGpuOnly was passed in BoMap.reserved. */
+#define FG_ABI_IMPORT_GPU_ONLY 0x100u
+/* fuxi_gpu_abi_clean_split: what the per-submit import clean cost, by class [GPU-writable, read-only] and size bucket, the KiB GPU_ONLY
+ * imports skipped, and the three biggest mapped imports (KiB, permission bits, +16 when GPU_ONLY). */
+struct fuxi_gpu_clean_split {
+ uint64_t kib[2], ns[2], bkt_kib[4], bkt_ns[4], go_kib, mapped_kib, top_kib[3];
+ uint64_t dty_checked, dty_dirty, dty_kib, dty_full_kib, dty_check_ns, dty_clean_ns, ivac_ns;
+ uint32_t imports, go_imports, top_perm[3], dty_state, dty_imports, submits; /* dty_state: 0 off, 1 untested, 2 active, 3 refused */
+};
+/* Exact direct-selector wire lengths. */
+static inline unsigned fg_abi_input_size(unsigned method)
+{
+ static const unsigned sizes[17] = {0,0,16,32,8,32+24*NativeAdrenoAbiMaxBuffers,16,0,0,80,80,8,8,8,16,0,16};
+ return method <= 16 ? sizes[method] : 0;
+}
+/* Submit records of the 16-IB layout (416 bytes) are still accepted: a Turnip built before the 128-IB header keeps working on a newer
+ * kernel (the kernel image and the root's libvulkan are updated separately). The records differ only in how many buffers follow. */
+#define FG_ABI_SUBMIT_V1_BYTES 416u
+static inline unsigned fg_abi_input_ok(unsigned method, unsigned size)
+{
+ return size == fg_abi_input_size(method) || (method == NativeAdrenoMethodSubmit && size == FG_ABI_SUBMIT_V1_BYTES);
+}
+/* IBs a submit record of this many bytes can hold. */
+static inline unsigned fg_abi_submit_capacity(unsigned size)
+{
+ return size >= 32 ? (size-32)/24 : 0;
+}
+static inline unsigned fg_abi_output_size(unsigned method)
+{
+ static const unsigned sizes[17] = {0,24,8,8,0,8,0,8,16,0,80,8,0,16,0,64,8};
+ return method <= 16 ? sizes[method] : 0;
+}
+/* Bounded per-call timing, window totals in mach ticks. Slot 0 is the wait for
+ * the client lock, 1..16 are the selectors, the rest are phases inside them. */
+/* 17..24 are phases inside alloc and map, logged on their own "stages" line: walk/zero/allocmem/bind are alloc's segment walk, bzero,
+ * descriptor allocation+prepare and view bind; mapwait is the time a map spent retrying a busy GPU before its last attempt (only maps
+ * that retried), maplock the last attempt's wait for the GPU lock, mapwork its work under that lock (pmap walk, leaves, barrier). */
+enum { FG_ABI_STAT_LOCK=0, FG_ABI_STAT_WALK=17, FG_ABI_STAT_ZERO=18, FG_ABI_STAT_SLEEP=19, FG_ABI_STAT_MAPWAIT=20, FG_ABI_STAT_MAPLOCK=21,
+ FG_ABI_STAT_MAPWORK=22, FG_ABI_STAT_ALLOCMEM=23, FG_ABI_STAT_BIND=24, FG_ABI_STATS=25 };
+struct fg_abi_stat { uint64_t count, total, max; };
+/* submit_split slots of the client (FuxiAdrenoUserClient abiSplit); the backend's phases come from fuxi_gpu_abi_submit_split. */
+enum { FG_SPLIT_ARGS, FG_SPLIT_FENCE, FG_SPLIT_LOOKUP, FG_SPLIT_BACKEND, FG_SPLIT_SLEEP, FG_SPLIT_TOTAL, FG_SPLIT_BOS, FG_SPLIT_LIVE, FG_SPLIT_ATT,
+ FG_SPLIT_WAITS, FG_SPLIT_EVENTS, FG_SPLIT_WN0, FG_SPLIT_WN1, FG_SPLIT_WN2, FG_SPLIT_WT0, FG_SPLIT_WT1, FG_SPLIT_WT2, FG_SPLIT_DONE, FG_SPLIT_LOCKED, FG_SPLIT_RELEASE, FG_SPLIT_SUMS=FG_SPLIT_DONE, FG_SPLIT_WINDOW=600 };
+static inline void fg_abi_stat_add(struct fg_abi_stat *stats, unsigned slot, uint64_t ticks)
+{
+ if (slot >= FG_ABI_STATS) return;
+ stats[slot].count++; stats[slot].total += ticks;
+ if (ticks > stats[slot].max) stats[slot].max = ticks;
+}
+static inline int fg_abi_range(uint64_t iova, uint64_t bytes)
+{
+ return bytes && !((iova|bytes)&4095) && iova >= FG_ABI_VA_START &&
+     iova-FG_ABI_VA_START < FG_ABI_VA_SIZE && bytes <= FG_ABI_VA_SIZE-(iova-FG_ABI_VA_START);
+}
+static inline int fg_abi_alloc_valid(uint64_t bytes, unsigned align, unsigned contiguous)
+{
+ return bytes && !(bytes&4095) && bytes <= FG_ABI_MAX_BYTES && align >= 12 && align <= 24 && contiguous <= 1;
+}
+static inline int fg_abi_import_valid(uint64_t address, uint64_t bytes)
+{
+ return address && bytes && !((address|bytes)&(NativeAdrenoAbiHostPageBytes-1)) &&
+     bytes<=FG_ABI_MAX_BYTES && address<(UINT64_C(1)<<47) && bytes<=(UINT64_C(1)<<47)-address;
+}
+static inline int fg_abi_map_valid(uint64_t iova, uint64_t bytes, unsigned perms,
+    unsigned wb, unsigned sh, unsigned reserved)
+{
+ return fg_abi_range(iova,bytes) && (perms==1 || perms==3) && wb<=1 && (sh==2 || sh==3) && !reserved;
+}
+static inline int fg_abi_ib_valid(uint64_t base, uint64_t length, uint64_t iova, uint64_t bytes)
+{
+ return length && bytes && !((iova|bytes)&3) && bytes/4 <= 0xfffff &&
+     iova>=base && iova-base<length && bytes<=length-(iova-base);
+}
+static inline unsigned fg_abi_parity(unsigned x)
+{
+ x^=x>>16; x^=x>>8; x^=x>>4; return (0x9669u>>(x&15))&1;
+}
+static inline uint32_t fg_abi_pkt7(unsigned op, unsigned n)
+{ return 0x70000000u | n | fg_abi_parity(n)<<15 | op<<16 | fg_abi_parity(op)<<23; }
+static inline uint32_t fg_abi_pkt4(unsigned reg, unsigned n)
+{ return 0x40000000u | n | fg_abi_parity(n)<<7 | reg<<8 | fg_abi_parity(reg)<<27; }
+/* Words of the largest frame: reset 11+26, one 4-word IB packet per buffer, fence 31, trailing WFI. The ring (8192 words) is idle at submit. */
+#define FG_ABI_FRAME_WORDS (11+26+4*NativeAdrenoAbiMaxBuffers+31+1)
+/* Caller supplies FG_ABI_FRAME_WORDS words. Fixed-size framing: 37 + count*4 + 31 + WFI.
+ * fence_base+4 is BR completion, +12 is BV completion; +0/+8 unused here.
+ * Reset on each return from the present context, which changes CP state. */
+static inline unsigned fg_abi_frame(uint32_t *w, const uint64_t *iova,
+    const uint64_t *bytes, unsigned count, uint32_t fence_base,
+    uint32_t previous, uint32_t seq, int reset)
+{
+ if (!w || !iova || !bytes || !count || count>NativeAdrenoAbiMaxBuffers || !seq || (fence_base&15)) return 0;
+ for (unsigned i=0;i<count;i++)
+  if (!bytes[i] || ((iova[i]|bytes[i])&3) || iova[i]>>32 || bytes[i]/4>0xfffff) return 0;
+ unsigned n=0;
+#define P1(op,a) do { w[n++]=fg_abi_pkt7(op,1); w[n++]=(a); } while (0)
+#define TS(op,event,addr,val) do { w[n++]=fg_abi_pkt7(op,4); w[n++]=(event); w[n++]=(addr); w[n++]=0; w[n++]=(val); } while (0)
+ P1(0x17,0x80000001u); /* sync BR */
+ if (reset) {
+  TS(0x14,0,fence_base+4,previous);
+  P1(0x17,0x80000003u); P1(0x1f,0xf); P1(0x17,0x80000003u);
+  P1(0x46,0x26); P1(0x17,0x80000001u);
+  w[n++]=fg_abi_pkt4(0x050e,1); w[n++]=1;
+  P1(0x46,0x31);
+  w[n++]=fg_abi_pkt7(0x3c,6); w[n++]=3; w[n++]=0x050f;
+  w[n++]=0; w[n++]=1; w[n++]=1; w[n++]=0;
+ }
+ P1(0x46,0x32); P1(0x46,0x33); w[n++]=fg_abi_pkt7(0x26,0);
+ P1(0x17,3); P1(0x65,0x101); /* BOTH, IFPC off */
+ for (unsigned i=0;i<count;i++) {
+  w[n++]=fg_abi_pkt7(0x3f,3); w[n++]=(uint32_t)iova[i]; w[n++]=0; w[n++]=(uint32_t)(bytes[i]/4);
+ }
+ w[n++]=fg_abi_pkt4(0x0885,1); w[n++]=seq;
+ P1(0x17,1); P1(0x46,0x18); P1(0x46,0x19);
+ P1(0x17,2); TS(0x46,0x08000031u,fence_base+12,seq);
+ P1(0x17,1); TS(0x14,0,fence_base+12,seq);
+ TS(0x46,0x88000031u,fence_base+4,seq);
+ P1(0x17,3); P1(0x65,0x100); w[n++]=fg_abi_pkt7(0x26,0);
+#undef P1
+#undef TS
+ return n;
+}
+#endif
