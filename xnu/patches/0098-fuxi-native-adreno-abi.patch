+  uint32_t high=g3_gr(0x981), low=g3_gr(0x980), again=g3_gr(0x981);
+  if (fg_access_failed) { (void)fg_abi_fault("client timestamp MMIO"); return -2; }
+  if (high==again) { *ticks=((uint64_t)high<<32)|low; return 0; }
