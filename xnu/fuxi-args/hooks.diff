+
+/* /chosen fuxi-args (fuxi_boot_args.h): the boot line, a space, then the property, which the parser scans instead. */
+static char fuxi_boot_line[BOOT_LINE_LENGTH + FUXI_ARGS_MAX];
+static unsigned int fuxi_args_at, fuxi_args_taken;     /* the property's text in fuxi_boot_line; 0: not taken */
+static unsigned int fuxi_args_size;                    /* the property's size in the ADT */
+static int fuxi_args_result = -1;                      /* fuxi_args_merge's answer; -1: no property */
+
+void fuxi_boot_args_adopt(void);
+void fuxi_boot_args_say(void);
+
+/*
+ * PE_init_platform, right after SecureDTInit: no boot-arg has been read yet. It only copies: there is no thread yet,
+ * so no printf; fuxi_boot_args_say reports it.
+ */
+void
+fuxi_boot_args_adopt(void)
+{
+	DTEntry chosen;
+	void const *prop;
+	unsigned int size;
+
+	if (SecureDTLookupEntry(NULL, "/chosen", &chosen) != kSuccess ||
+	    SecureDTGetProperty(chosen, "fuxi-args", &prop, &size) != kSuccess) {
+		return;
+	}
+	fuxi_args_size = size;
+	fuxi_args_result = fuxi_args_merge(PE_boot_args(), BOOT_LINE_LENGTH, prop, size, fuxi_boot_line,
+	    (unsigned int)sizeof(fuxi_boot_line), &fuxi_args_at, &fuxi_args_taken);
+}
+
+/* PE_init_iokit, after "iBoot version": what was taken, into boot.log. */
+void
+fuxi_boot_args_say(void)
+{
+	if (fuxi_args_result < 0) {
+		printf("FUXI ARGS: no /chosen fuxi-args, the boot line alone\n");
+	} else if (fuxi_args_result == FUXI_ARGS_TAKEN) {
+		printf("FUXI ARGS: %u bytes from /chosen fuxi-args: %s\n", fuxi_args_taken, fuxi_boot_line + fuxi_args_at);
+	} else {
+		printf("FUXI ARGS: /chosen fuxi-args (%u bytes) not taken, %s: the boot line alone\n",
+		    fuxi_args_size, fuxi_args_why(fuxi_args_result));
+	}
+}
+
+/* What PE_parse_boot_argn and PE_parse_boot_arg_str scan. */
+static char *
+pe_parse_args(void)
+{
+	return fuxi_args_taken ? fuxi_boot_line : PE_boot_args();
+}
+#endif /* FUXI */
