+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include "fuxi_exec_inject.h"
+#if defined(FUXI)
+/* fla: the governor's launch boost (bsd/dev/fuxi_perf.c); it returns at once when off */
+extern void fuxi_perf_launch(const char *name);
+#endif
+/* Boot-arg fxinj (fuxi_exec_inject.h), read on every exec: nothing cached, nothing to race on. */
+static unsigned
+fuxi_inject_mode(void)
+{
+	unsigned mode = 0;
+
+	if (!PE_parse_boot_argn("fxinj", &mode, sizeof(mode))) {
+		mode = 0;
+	}
+	return mode & FUXI_INJECT_ALL;
+}
+
+/* The mode once, then the first programs that get a library. */
+static void
+fuxi_inject_said(unsigned mode, const char *name, const char *library)
+{
+	static volatile SInt32 said;
+	SInt32 n = OSIncrementAtomic(&said);
+
+	if (n == 0) {
+		printf("FUXI INJECT: fxinj=%u:%s%s\n", mode,
+		    (mode & FUXI_INJECT_APPS) ? " applications get " FUXI_INJECT_APP_LIB ";" : "",
+		    (mode & FUXI_INJECT_SPRINGBOARD) ? " SpringBoard gets " FUXI_INJECT_SB_LIB : "");
+	}
+	if (n < FUXI_INJECT_SAID) {
+		printf("FUXI INJECT: %s <- %s\n", name, library);
+	}
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
