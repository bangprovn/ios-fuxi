+			{
+				/* how busy each core was since the last summary: (user + system) / (user + system + idle) */
+				static unsigned int previous[8][4];
+				char busy[64];
+				int at = 0;
+
+				for (int cpu = 0; cpu < 8 && at < (int)sizeof(busy) - 6; cpu++) {
