+					all = work + ticks[2] - previous[cpu][2];
+					memcpy(previous[cpu], ticks, sizeof(ticks));
+					at += snprintf(busy + at, sizeof(busy) - at, " %u", all != 0 ? work * 100 / all : 0);
+				}
+				IOLog("FuxiFramebuffer: busy %% per core%s\n", busy);
