diff --git a/bsd/kern/kern_exec.c b/bsd/kern/kern_exec.c
index 8f5cb9a..3974abb 100644
--- a/bsd/kern/kern_exec.c
+++ b/bsd/kern/kern_exec.c
@@ -8857,10 +8857,40 @@ process_signature(proc_t p, struct image_params *imgp)
 	}
 
 	/* call the launch constraints hook */
-	os_reason_t launch_constraint_reason;
+	os_reason_t launch_constraint_reason = OS_REASON_NULL;
 	if ((error = mac_proc_check_launch_constraints(p, imgp, &launch_constraint_reason)) != 0) {
-		signature_failure_reason = launch_constraint_reason;
-		goto done;
+		/*
+		 * boot-arg fuxi_lcskip=WORD: the programs whose file name holds WORD are let through AMFI's
+		 * launch constraints (category 1 wants the system volume; Fuxi's own tools live on the init
+		 * disk). The name comes from the vnode: imgp->ip_strings is gone by now.
+		 */
+		static char fuxi_lcskip[64];
+		static int fuxi_lcskip_read;
+		const char *fuxi_name = NULL;
+
+		if (!fuxi_lcskip_read) {
+			if (!PE_parse_boot_argn("fuxi_lcskip", fuxi_lcskip, sizeof(fuxi_lcskip))) {
+				fuxi_lcskip[0] = '\0';
+			}
+			fuxi_lcskip_read = 1;
+		}
+		if (fuxi_lcskip[0] != '\0' && imgp->ip_vp != NULL) {
+			fuxi_name = vnode_getname(imgp->ip_vp);
+		}
+		if (fuxi_name != NULL && strnstr(fuxi_name, fuxi_lcskip, MAXPATHLEN) != NULL) {
+			printf("fuxi: pid %d %s: launch constraints error %d skipped\n", proc_getpid(p), fuxi_name, error);
+			vnode_putname(fuxi_name);
+			if (launch_constraint_reason != OS_REASON_NULL) {
+				os_reason_free(launch_constraint_reason);
+			}
+			error = 0;
+		} else {
+			if (fuxi_name != NULL) {
+				vnode_putname(fuxi_name);
+			}
+			signature_failure_reason = launch_constraint_reason;
+			goto done;
+		}
 	}
 
 	/*
