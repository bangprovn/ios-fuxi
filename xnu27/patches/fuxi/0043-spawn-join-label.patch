+#if defined(FUXI)
+/*
+ * argv[1] of a spawn (for launchd's xpcproxy the job's label) into label, for the persona choice below. The
+ * thread is still the parent's, so argv is read from its address space.
+ */
+static void
+fuxi_spawn_label(proc_t parent, user_addr_t argv, char *label, size_t size)
+{
+	user_addr_t arg = 0;
+	size_t done;
+
+	label[0] = '\0';
+	if (argv == USER_ADDR_NULL) {
+		return;
+	}
+	if (proc_is64bit(parent)) {
+		uint64_t a;
+
+		if (copyin(argv + sizeof(a), &a, sizeof(a)) != 0) {
+			return;
+		}
+		arg = (user_addr_t)a;
+	} else {
+		uint32_t a;
+
+		if (copyin(argv + sizeof(a), &a, sizeof(a)) != 0) {
+			return;
+		}
+		arg = (user_addr_t)a;
+	}
+	if (arg == USER_ADDR_NULL || copyinstr(arg, label, size, &done) != 0) {
+		label[0] = '\0';
+	}
+}
+#endif
