diff --git a/osfmk/ipc/ipc_kmsg.c b/osfmk/ipc/ipc_kmsg.c
index 190e5d2..d66e1e9 100644
--- a/osfmk/ipc/ipc_kmsg.c
+++ b/osfmk/ipc/ipc_kmsg.c
@@ -4736,6 +4736,174 @@ ipc_kmsg_deflate(
  *		MACH_RCV_INVALID_DATA    Couldn't copy to user message.
  *		the incoming "mr"        Copied data out of message buffer.
  */
+#if defined(FUXI)
+#include <pexpert/pexpert.h>
+extern void proc_name(int pid, char *buf, int size);
+
+/*
+ * fuxi_msgdump=RECEIVER:SENDER[,RECEIVER:SENDER]: every message a process whose name starts with RECEIVER
+ * receives from one whose name starts with SENDER ("*" for any) is logged as text: its inline body and its first
+ * out-of-line region, printable bytes as they are, others as \xx, runs of zeros as ".". XPC's wire format keeps
+ * its keys and string values readable, so this shows what daemons tell each other (containermanagerd answers
+ * INVALID_PERSONA and its os_log cannot be seen). fuxi_msgdump_max=N messages (default 300).
+ */
+#define FUXI_MSGDUMP_BYTES 1536
+
+static bool
+fuxi_msgdump_match(const char *list, const char *recv, const char *send)
+{
+	const char *p = list;
+
+	while (*p != '\0') {
+		const char *comma = strchr(p, ',');
+		size_t n = comma != NULL ? (size_t)(comma - p) : strlen(p);
+		const char *colon = NULL;
+
+		for (size_t k = 0; k < n; k++) {
+			if (p[k] == ':') {
+				colon = p + k;
+				break;
+			}
+		}
+
+		if (colon != NULL) {
+			size_t rn = (size_t)(colon - p), sn = n - rn - 1;
+
+			if (rn > 0 && strncmp(recv, p, rn) == 0 &&
+			    ((sn == 1 && colon[1] == '*') || (sn > 0 && strncmp(send, colon + 1, sn) == 0))) {
+				return true;
+			}
+		}
+		p += n + (comma != NULL);
+	}
+	return false;
+}
+
+static void
+fuxi_msgdump_bytes(const char *tag, const uint8_t *b, size_t len)
+{
+	char line[220];
+	size_t o = 0;
+
+	for (size_t i = 0; i < len; i++) {
+		char piece[8];
+
+		if (b[i] == 0) {
+			size_t j = i;
+
+			while (j + 1 < len && b[j + 1] == 0) {
+				j++;
+			}
+			i = j;
+			piece[0] = '.';
+			piece[1] = '\0';
+		} else if (b[i] >= 0x20 && b[i] < 0x7f && b[i] != '\\') {
+			piece[0] = (char)b[i];
+			piece[1] = '\0';
+		} else {
+			snprintf(piece, sizeof(piece), "\\%02x", b[i]);
+		}
+		size_t pl = strlen(piece);
+		if (o + pl >= 200) {
+			line[o] = '\0';
+			printf("fuxi: msg %s %s\n", tag, line);
+			o = 0;
+		}
+		memcpy(line + o, piece, pl);
+		o += pl;
+	}
+	if (o > 0) {
+		line[o] = '\0';
+		printf("fuxi: msg %s %s\n", tag, line);
+	}
+}
+
+static void
+fuxi_msgdump(int sender, mach_vm_address_t addr, mach_msg_size_t size)
+{
+	static char list[160];
+	static int parsed, max = 300, count;
+	uint8_t *buf;
+	char recv[32], send[32], tag[96];
+	mach_msg_header_t hdr;
+	size_t off, n;
+	int me;
+
+	if (!parsed) {
+		parsed = 1;
+		if (!PE_parse_boot_argn("fuxi_msgdump", list, sizeof(list))) {
+			list[0] = '\0';
+		}
+		PE_parse_boot_argn("fuxi_msgdump_max", &max, sizeof(max));
+	}
+	if (list[0] == '\0' || count >= max || size < sizeof(hdr)) {
+		return;
+	}
+	me = task_pid(current_task());
+	recv[0] = send[0] = '\0';
+	proc_name(me, recv, sizeof(recv));
+	if (sender > 0) {
+		proc_name(sender, send, sizeof(send));
+	} else {
+		strlcpy(send, sender == 0 ? "kernel" : "?", sizeof(send));
+	}
+	if (!fuxi_msgdump_match(list, recv, send)) {
+		return;
+	}
+	if (copyinmsg((user_addr_t)addr, &hdr, (mach_msg_size_t)sizeof(hdr)) != 0) {
+		return;
+	}
+	buf = kalloc_data(FUXI_MSGDUMP_BYTES, Z_WAITOK);
+	if (buf == NULL) {
+		return;
+	}
+	count++;
+	snprintf(tag, sizeof(tag), "%d %s[%d]<-%s[%d] id %d size %u", count, recv, me, send, sender, hdr.msgh_id, size);
+	off = sizeof(hdr);
+	if ((hdr.msgh_bits & MACH_MSGH_BITS_COMPLEX) && size >= off + 4) {
+		uint32_t ndesc = 0;
+
+		copyinmsg((user_addr_t)(addr + off), &ndesc, 4);
+		off += 4;
+		for (uint32_t d = 0; d < ndesc && d < 16 && off + 12 <= size; d++) {
+			uint8_t desc[16];
+
+			if (copyinmsg((user_addr_t)(addr + off), desc, 12) != 0) {
+				break;
+			}
+			uint8_t type = desc[11];
+			size_t dsize = type == MACH_MSG_PORT_DESCRIPTOR ? 12 : 16;
+
+			if ((type == MACH_MSG_OOL_DESCRIPTOR || type == MACH_MSG_OOL_VOLATILE_DESCRIPTOR) && off + 16 <= size &&
+			    copyinmsg((user_addr_t)(addr + off), desc, 16) == 0) {
+				uint64_t oaddr;
+				uint32_t osize;
+
+				memcpy(&oaddr, desc, 8);
+				memcpy(&osize, desc + 12, 4);
+				n = osize < FUXI_MSGDUMP_BYTES ? (size_t)osize : FUXI_MSGDUMP_BYTES;
+				if (n > 0 && copyinmsg((user_addr_t)oaddr, buf, (mach_msg_size_t)n) == 0) {
+					char otag[110];
+
+					snprintf(otag, sizeof(otag), "%s ool %u", tag, osize);
+					fuxi_msgdump_bytes(otag, buf, n);
+				}
+			}
+			off += dsize;
+		}
+	}
+	if (off < size) {
+		n = size - off < FUXI_MSGDUMP_BYTES ? (size_t)(size - off) : FUXI_MSGDUMP_BYTES;
+		if (copyinmsg((user_addr_t)(addr + off), buf, (mach_msg_size_t)n) == 0) {
+			fuxi_msgdump_bytes(tag, buf, n);
+		}
+	} else {
+		printf("fuxi: msg %s (no inline body)\n", tag);
+	}
+	kfree_data(buf, FUXI_MSGDUMP_BYTES);
+}
+#endif
+
 mach_msg_return_t
 ipc_kmsg_put_to_user(
 	ipc_kmsg_t              kmsg,     /* scalar or vector */
@@ -4750,6 +4918,9 @@ ipc_kmsg_put_to_user(
 	mach_vm_address_t       aux_rcv_addr = recv_bufs->recv_aux_addr;
 	mach_msg_size_t         usize = 0;
 	ikm_deflate_context_t   dctx;
+#if defined(FUXI)
+	int fuxi_sender = (int)ipc_kmsg_get_trailer(kmsg)->msgh_audit.val[5];
+#endif
 
 	/*
 	 * After this, the kmsg() is mangled beyond recognition,
@@ -4855,6 +5026,9 @@ ipc_kmsg_put_to_user(
 		mr = MACH_RCV_INVALID_DATA;
 		goto out;
 	}
+#if defined(FUXI)
+	fuxi_msgdump(fuxi_sender, msg_rcv_addr, msgr->msgr_msg_size);
+#endif
 
 out:
