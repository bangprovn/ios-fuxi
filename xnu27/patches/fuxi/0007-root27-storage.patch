+/* A kext IOMedia, initialised through the mirror and checked through its properties. */
+static IOMedia *
+media_create(const OSMetaClass *meta, UInt64 size, UInt64 block, bool whole, const char *hint, OSDictionary *props)
+{
+	OSObject *obj = meta->alloc();
+	if (!obj || !obj->metaCast("IOMedia")) {
+		OSSafeReleaseNULL(obj);
+		return NULL;
+	}
+	IOMedia *m = static_cast<IOMedia *>(obj);
+	OSNumber *n;
+	OSBoolean *b;
+	OSString *s;
+	if (!m->init(0, size, block, 0, whole, false, hint, props) ||
+	    !(n = OSDynamicCast(OSNumber, m->getProperty(kIOMediaSizeKey))) || n->unsigned64BitValue() != size ||
+	    !(b = OSDynamicCast(OSBoolean, m->getProperty(kIOMediaWholeKey))) || b->getValue() != whole ||
+	    !(s = OSDynamicCast(OSString, m->getProperty(kIOMediaContentHintKey))) ||
+	    !s->isEqualTo(hint ? hint : "")) {
+		IOLog("FUXI ROOT27: IOMedia::init did not take (vtable mirror out of date?)\n");
+		m->release();
+		return NULL;
+	}
+	return m;
+}
+
+static bool
+put(OSDictionary *d, const char *key, OSObject *value)
+{
+	bool ok = value && d->setObject(key, value);
+	OSSafeReleaseNULL(value);
+	return ok;
+}
+
+static bool
+publish(const OSMetaClass *meta, unsigned i, const char *hint)
+{
+	const struct fx27_window *w = &fr.win[i];
+	char uuid[37];
+	fx27_window_uuid(w->sha256, uuid);
+	FuxiRootWindow *top = new FuxiRootWindow, *scheme = new FuxiRootWindow;
+	OSDictionary *sp = OSDictionary::withCapacity(2), *pp = OSDictionary::withCapacity(4);
+	IOMedia *whole = NULL, *part = NULL;
+	bool ok = false;
+	if (!top || !scheme || !sp || !pp || !top->initWindow(i, NULL)) {
+		goto out;
+	}
+	if (!put(sp, gIOMatchCategoryKey->getCStringNoCopy(), OSString::withCString(kIOStorageCategory)) ||
+	    !put(sp, kIOMediaContentMaskKey, OSString::withCString("GUID_partition_scheme")) ||
+	    !put(pp, kIOMediaPartitionIDKey, OSNumber::withNumber(1ULL, 32)) ||
+	    !put(pp, kIOMediaBaseKey, OSNumber::withNumber(0ULL, 64)) ||
+	    !put(pp, kIOMediaUUIDKey, OSString::withCString(uuid)) || !scheme->initWindow(i, sp) ||
+	    !(whole = media_create(meta, w->size, 512, true, NULL, NULL)) ||
+	    !(part = media_create(meta, w->size, 512, false, hint, pp))) {
+		goto out;
+	}
+	top->setName(w->name);
+	part->setName(w->name);
+	part->setLocation("1");
+	if (!top->attach(IOService::getPlatform()) || !whole->attach(top) || !scheme->attach(whole) ||
+	    !part->attach(scheme)) {
+		goto out;
+	}
+	top->registerService();
+	whole->registerService();
+	scheme->registerService();
+	part->registerService();
+	IOLog("FUXI ROOT27: window %s at %#llx, %llu bytes, read-only, UUID %s, hint %s\n",
+	    w->name, w->offset, w->size, uuid, hint);
+	ok = true;
+out:
+	OSSafeReleaseNULL(sp);
+	OSSafeReleaseNULL(pp);
+	OSSafeReleaseNULL(top);
+	OSSafeReleaseNULL(scheme);
+	OSSafeReleaseNULL(whole);
+	OSSafeReleaseNULL(part);
+	return ok;
+}
+
+static IOReturn
+root_open(void)
+{
+	DTEntry node;
+	const uint64_t *reg = NULL;
+	const uint8_t *table = NULL, *blocks = NULL;
+	unsigned int size = 0, tsize = 0;
+	IOReturn ret;
+	if (SecureDTLookupEntry(NULL, "/chosen", &node) != kSuccess ||
+	    SecureDTGetProperty(node, "fuxi-root-extents", (void const **)&table, &tsize) != kSuccess ||
+	    SecureDTGetProperty(node, "fuxi-root-blocks", (void const **)&blocks, &size) != kSuccess ||
+	    size != 8 || SecureDTLookupEntry(NULL, "/fuxi-ufs", &node) != kSuccess ||
+	    SecureDTGetProperty(node, "reg", (void const **)&reg, &size) != kSuccess || size < 16) {
+		IOLog("FUXI ROOT27: no /chosen fuxi-root-extents/-blocks or /fuxi-ufs reg\n");
+		return kIOReturnNotFound;
+	}
+	fr.root_blocks = fx27_le64(blocks);
+	if ((ret = ufs_power())) {
+		return ret;
+	}
+	fr.dmamd = IOBufferMemoryDescriptor::inTaskWithPhysicalMask(kernel_task,
+	    kIODirectionInOut | kIOMemoryPhysicallyContiguous, DMA_SIZE, 0xFFFFFFFFF000ULL);
+	if (!fr.dmamd || fr.dmamd->prepare() != kIOReturnSuccess) {
+		return kIOReturnNoMemory;
+	}
+	fr.dma = (uint8_t *)fr.dmamd->getBytesNoCopy();
+	fr.dma_pa = fr.dmamd->getPhysicalSegment(0, NULL, kIOMemoryMapperNone);
+	fr.regs = ml_io_map(reg[0], reg[1]);
+	fr.lock = IOLockAlloc();
+	if (!fr.dma || !fr.dma_pa || !fr.regs || !fr.lock) {
+		return kIOReturnNoMemory;
+	}
+	bzero(fr.dma, DMA_SIZE);
+	IOLockLock(fr.lock);
+	IOLog("FUXI ROOT27: CAP=0x%x HCS=0x%x HCE=0x%x DMA=0x%llx\n", ufs_rd(REG_CAP), ufs_rd(REG_HCS),
+	    ufs_rd(REG_HCE), fr.dma_pa);
+	ret = ufs_take_over_host();
+	if (!ret) {
+		static const uint8_t active[6] = { 0x1b, 0, 0, 0, 0x10, 0 };
+		fr.lun = WLUN_DEVICE;
+		for (int i = 0; i < 3 && (ret = ufs_scsi(active, sizeof(active), 0)); i++) {
+		}
+		fr.lun = 0;
+	}
+	if (!ret) {
+		static const uint8_t tur[6] = { 0x00 };
+		for (int i = 0; i < 3 && (ret = ufs_scsi(tur, sizeof(tur), 0)); i++) {
+		}
+	}
+	if (!ret) {
+		ret = ufs_find_userdata();
+	}
+	if (!ret) {
+		int e = fx27_load_extents(table, tsize, fr.root_blocks, fr.part_blocks, fr.ext, &fr.next);
+		if (e) {
+			IOLog("FUXI ROOT27: bad extent table (%d)\n", e);
+			ret = kIOReturnBadArgument;
+		} else {
+			fr.guard = true;
+		}
+	}
+	IOLockUnlock(fr.lock);
+	if (ret) {
+		IOLog("FUXI ROOT27: UFS/userdata/extents failed: 0x%x\n", ret);
+		return ret;
+	}
+	IOLog("FUXI ROOT27: userdata first block 0x%llx, %llu blocks; root %u extents, %llu blocks\n",
+	    fr.part_first, fr.part_blocks, fr.next, fr.root_blocks);
+	return kIOReturnSuccess;
+}
+
+static IOReturn
+root_manifest(void)
+{
+	static uint8_t hdr[FX27_HDR];
+	IOBufferMemoryDescriptor *md = IOBufferMemoryDescriptor::withCapacity(FX27_HDR, kIODirectionIn);
+	uint8_t digest[32];
+	uint64_t done;
+	SHA256_CTX ctx;
+	int e;
+	if (!md) {
+		return kIOReturnNoMemory;
+	}
+	md->setLength(FX27_HDR);
+	IOReturn ret = root_read(0, FX27_HDR, md, 0, &done);
+	if (!ret) {
+		memcpy(hdr, md->getBytesNoCopy(), FX27_HDR);
+	}
+	md->release();
+	if (ret) {
+		return ret;
+	}
+	SHA256_Init(&ctx);
+	SHA256_Update(&ctx, hdr, FX27_HDR - 32);
+	SHA256_Final(digest, &ctx);
+	if (memcmp(digest, hdr + FX27_HDR - 32, 32)) {
+		IOLog("FUXI ROOT27: manifest hash mismatch\n");
+		return kIOReturnBadMedia;
+	}
+	if ((e = fx27_manifest(hdr, fr.root_blocks * FX27_BLOCK, fr.win, &fr.nwin))) {
+		IOLog("FUXI ROOT27: bad manifest (%d)\n", e);
+		return kIOReturnBadMedia;
+	}
+	return kIOReturnSuccess;
+}
+
+static void
+fuxi_root27_thread(void *, wait_result_t)
+{
+	char hint[64] = APFS_GPT_TYPE;
+	const OSSymbol *name = OSSymbol::withCStringNoCopy("IOMedia");
+	const OSMetaClass *meta = NULL;
+	PE_parse_boot_argn("fuxi_root27_hint", hint, sizeof(hint));
+	if (root_open() || root_manifest()) {
+		OSSafeReleaseNULL(name);
+		return;
+	}
+	OSKext::loadKextWithIdentifier("com.apple.iokit.IOStorageFamily", false);
+	for (int i = 0; i < 600 && !(meta = OSMetaClass::copyMetaClassWithName(name)); i++) {
+		IOSleep(100);
+	}
+	OSSafeReleaseNULL(name);
+	if (!meta) {
+		IOLog("FUXI ROOT27: IOStorageFamily (IOMedia) never loaded\n");
+		return;
+	}
+	for (unsigned i = 0; i < fr.nwin; i++) {
+		publish(meta, i, hint);
+	}
+	meta->releaseMetaClass();
+}
+
+void
+fuxi_root27_start(void)
+{
+	uint32_t on = 0;
+	thread_t thread;
+	if (!PE_parse_boot_argn("fuxi_root27", &on, sizeof(on)) || on != 1) {
+		return;
+	}
+	if (kernel_thread_start(fuxi_root27_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
+#endif /* FUXI */
diff --git a/iokit/Kernel/arm/fuxi_root27.h b/iokit/Kernel/arm/fuxi_root27.h
new file mode 100644
index 0000000..d32ff30
--- /dev/null
+++ b/iokit/Kernel/arm/fuxi_root27.h
@@ -0,0 +1,229 @@
+/*
+ * Fuxi iOS 27 root file (K4): pure logic shared by FuxiRoot27.cpp and the host
+ * tests (tools/test-fuxi-ios27.py compiles this header with the host cc and
+ * compares it with its Python mirror). No kernel headers, no libc.
+ *
+ * The root is one pinned, preallocated file inside Android's f2fs userdata.
+ * ADT /chosen "fuxi-root-extents" lists it as u64 triples {file block,
+ * partition block, blocks} (4 KiB units, userdata-relative, file blocks
+ * contiguous from 0) and "fuxi-root-blocks" is the root size in blocks, the
+ * same properties as the xnu-8796 lane (xnu/patches/0088). The file starts with
+ * the 4 KiB SHNGROOT manifest of tools/ios27-root.py image: magic, version 1,
+ * window count, image bytes, 128-byte entries {name[32], offset, size,
+ * block_size 512, flags (bit 0 read-only), sha256, reserved}, SHA-256 of bytes
+ * 0..4063 at 4064 (checked by the caller), windows 1 MiB aligned from 1 MiB.
+ */
+#ifndef FUXI_ROOT27_H
+#define FUXI_ROOT27_H
+#include <stdint.h>
+
+#define FX27_BLOCK              4096u
+#define FX27_MIB                0x100000u
+#define FX27_HDR                4096u
+#define FX27_ENTRY              128u
+#define FX27_MAX_WINDOWS        31u             /* (4064 - 32 - 24) / 128 */
+#define FX27_MAX_EXTENTS        1024u
+#define FX27_BOUNCE             (1u << 20)
+
+enum {
+	FX27_OK = 0,
+	FX27_E_TABLE,           /* property missing, empty, not triples or too many */
+	FX27_E_EXTENT,          /* file block out of order, empty or outside the partition */
+	FX27_E_OVERLAP,         /* two extents share partition blocks */
+	FX27_E_SHORT,           /* the extents end before fuxi-root-blocks */
+	FX27_E_MAGIC,           /* manifest magic or version */
+	FX27_E_COUNT,           /* window count */
+	FX27_E_WINDOW,          /* window name, alignment, order, block size or bounds */
+	FX27_E_SIZE,            /* manifest image bytes beyond the root file */
+	FX27_E_MAP,             /* a file block has no extent */
+};
+
+struct fx27_extent { uint64_t file, part, count; };
+struct fx27_window { char name[32]; uint64_t offset, size; uint32_t flags; uint8_t sha256[32]; };
+struct fx27_io { uint64_t lba; uint32_t blocks, skip, want; };
+
+static inline uint64_t
+fx27_le64(const uint8_t *p)
+{
+	uint64_t v = 0;
+	for (int i = 7; i >= 0; i--) {
+		v = v << 8 | p[i];
+	}
+	return v;
+}
+
+static inline uint32_t
+fx27_le32(const uint8_t *p)
+{
+	return (uint32_t)p[0] | (uint32_t)p[1] << 8 | (uint32_t)p[2] << 16 | (uint32_t)p[3] << 24;
+}
+
+/*
+ * Validate the ADT table against the partition (part_blocks long) and keep the
+ * extents that cover root blocks [0, want); the last one is cut at want.
+ */
+static inline int
+fx27_load_extents(const uint8_t *table, uint64_t size, uint64_t want, uint64_t part_blocks,
+    struct fx27_extent *ext, unsigned *count)
+{
+	unsigned n = 0;
+	uint64_t pos = 0;
+	*count = 0;
+	if (!table || size == 0 || size % 24 || size / 24 > FX27_MAX_EXTENTS || want == 0) {
+		return FX27_E_TABLE;
+	}
+	for (uint64_t i = 0; i < size / 24 && pos < want; i++) {
+		uint64_t file = fx27_le64(table + 24 * i), part = fx27_le64(table + 24 * i + 8);
+		uint64_t blocks = fx27_le64(table + 24 * i + 16);
+		if (file != pos || blocks == 0 || part >= part_blocks || blocks > part_blocks - part) {
+			return FX27_E_EXTENT;
+		}
+		if (blocks > want - pos) {
+			blocks = want - pos;
+		}
+		for (unsigned j = 0; j < n; j++) {
+			if (part < ext[j].part + ext[j].count && ext[j].part < part + blocks) {
+				return FX27_E_OVERLAP;
+			}
+		}
+		ext[n].file = file;
+		ext[n].part = part;
+		ext[n].count = blocks;
+		n++;
+		pos += blocks;
+	}
+	if (pos != want) {
+		return FX27_E_SHORT;
+	}
+	*count = n;
+	return FX27_OK;
+}
+
+/* Device LBA of root block lblk; *run = blocks left in its extent. */
+static inline int
+fx27_map(const struct fx27_extent *ext, unsigned n, uint64_t part_first, uint64_t lblk,
+    uint64_t *lba, uint64_t *run)
+{
+	for (unsigned i = 0; i < n; i++) {
+		if (lblk >= ext[i].file && lblk - ext[i].file < ext[i].count) {
+			*lba = part_first + ext[i].part + (lblk - ext[i].file);
+			*run = ext[i].count - (lblk - ext[i].file);
+			return 1;
+		}
+	}
+	return 0;
+}
+
+/* The I/O guard: device blocks [lba, lba + count) lie inside one extent. */
+static inline int
+fx27_io_allowed(const struct fx27_extent *ext, unsigned n, uint64_t part_first, uint64_t lba,
+    uint64_t count)
+{
+	if (count == 0) {
+		return 0;
+	}
+	for (unsigned i = 0; i < n; i++) {
+		uint64_t first = part_first + ext[i].part;
+		if (lba >= first && lba - first < ext[i].count && count <= ext[i].count - (lba - first)) {
+			return 1;
+		}
+	}
+	return 0;
+}
+
+/*
+ * Next device read for root bytes [pos, pos + left): at most one bounce
+ * buffer, never across an extent. want bytes of the result start skip bytes
+ * into the first block.
+ */
+static inline int
+fx27_plan(const struct fx27_extent *ext, unsigned n, uint64_t part_first, uint64_t pos,
+    uint64_t left, struct fx27_io *io)
+{
+	uint64_t run;
+	io->skip = (uint32_t)(pos % FX27_BLOCK);
+	io->want = (uint32_t)(left < FX27_BOUNCE - io->skip ? left : FX27_BOUNCE - io->skip);
+	io->blocks = (io->skip + io->want + FX27_BLOCK - 1) / FX27_BLOCK;
+	if (left == 0 || !fx27_map(ext, n, part_first, pos / FX27_BLOCK, &io->lba, &run)) {
+		return FX27_E_MAP;
+	}
+	if (io->blocks > run) {
+		io->blocks = (uint32_t)run;
+		io->want = io->blocks * FX27_BLOCK - io->skip;
+	}
+	return FX27_OK;
+}
+
+/* Parse the manifest (hash checked by the caller) of a root file root_bytes long. */
+static inline int
+fx27_manifest(const uint8_t *hdr, uint64_t root_bytes, struct fx27_window *win, unsigned *count)
+{
+	static const char magic[8] = { 'S', 'H', 'N', 'G', 'R', 'O', 'O', 'T' };
+	uint64_t prev = FX27_MIB, total = fx27_le64(hdr + 16);
+	uint32_t n = fx27_le32(hdr + 12);
+	*count = 0;
+	for (int i = 0; i < 8; i++) {
+		if (hdr[i] != (uint8_t)magic[i]) {
+			return FX27_E_MAGIC;
+		}
+	}
+	if (fx27_le32(hdr + 8) != 1) {
+		return FX27_E_MAGIC;
+	}
+	if (n == 0 || n > FX27_MAX_WINDOWS) {
+		return FX27_E_COUNT;
+	}
+	if (total > root_bytes) {
+		return FX27_E_SIZE;
+	}
+	for (uint32_t i = 0; i < n; i++) {
+		const uint8_t *e = hdr + 24 + FX27_ENTRY * i;
+		uint64_t off = fx27_le64(e + 32), size = fx27_le64(e + 40);
+		unsigned len = 0;
+		while (len < 32 && e[len]) {
+			len++;
+		}
+		if (len == 0 || len == 32 || off % FX27_MIB || off < prev || size == 0 || size % 512 ||
+		    off > total || size > total - off || fx27_le32(e + 48) != 512) {
+			return FX27_E_WINDOW;
+		}
+		for (unsigned c = 0; c < 32; c++) {
+			win[i].name[c] = c < len ? (char)e[c] : 0;
+		}
+		win[i].offset = off;
+		win[i].size = size;
+		win[i].flags = fx27_le32(e + 52);
+		for (unsigned c = 0; c < 32; c++) {
+			win[i].sha256[c] = e[56 + c];
+		}
+		prev = off + size;
+	}
+	*count = n;
+	return FX27_OK;
+}
+
+/*
+ * The partition UUID published for a window: the first 16 bytes of its manifest
+ * SHA-256 as an RFC 4122 version 4 UUID, upper case (37 bytes with the NUL).
+ */
+static inline void
+fx27_window_uuid(const uint8_t *sha256, char *out)
+{
+	static const char hex[] = "0123456789ABCDEF";
+	unsigned o = 0;
+	for (unsigned i = 0; i < 16; i++) {
+		uint8_t b = sha256[i];
+		if (i == 6) {
+			b = (uint8_t)((b & 0x0f) | 0x40);
+		} else if (i == 8) {
+			b = (uint8_t)((b & 0x3f) | 0x80);
+		}
+		if (i == 4 || i == 6 || i == 8 || i == 10) {
+			out[o++] = '-';
+		}
+		out[o++] = hex[b >> 4];
+		out[o++] = hex[b & 15];
+	}
+	out[o] = 0;
+}
+#endif /* FUXI_ROOT27_H */
diff --git a/iokit/Kernel/arm/fuxi_storage_abi.h b/iokit/Kernel/arm/fuxi_storage_abi.h
