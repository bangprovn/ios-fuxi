+/*
+ * Fuxi iOS 27 root storage (K4).
+ *
+ * The root is one pinned file inside Android's f2fs userdata (UFS LUN 0); see
+ * fuxi_root27.h for the ADT extent table and the SHNGROOT manifest. This file
+ * reads it over the bootloader-initialised Qualcomm UFS host (polled UTP
+ * transfer requests in slot 0: the default, non-UniXNU path of the xnu-8796
+ * lane's sweet_ufs.c) and publishes every manifest window as IOStorageFamily media
+ * the way an iPhone shows disk0 / disk0s1:
+ *
+ *   platform - FuxiRootWindow - IOMedia (whole) - FuxiRootWindow ("IOStorage",
+ *   Content Mask GUID_partition_scheme) - IOMedia (window name, location 1,
+ *   Content Hint = APFS GPT type, UUID from the window's manifest SHA-256)
+ *
+ * IOMedia belongs to the prelinked Apple IOStorageFamily, which the kernel
+ * cannot link against: it is created through its OSMetaClass and driven
+ * through the vtable mirror in fuxi_storage_abi.h; the providers are ours and
+ * serve reads directly from the window. Every window is read-only (writes are
+ * refused here and IOMedia is not writable); the only commands are TEST UNIT
+ * READY, the device-WLUN ACTIVE power START STOP UNIT and READ(10), and once
+ * the extent table is loaded no READ(10) leaves the file's extents.
+ *
+ * Off unless boot-arg fuxi_root27=1. fuxi_root27_hint= replaces the content
+ * hint. Started from bsd_init() after vfsinit(); IOFindBSDRoot waits for the
+ * media (ADT /chosen root-matching, tools/mkadt-fuxi27.py --root-uuid).
+ */
+#if defined(FUXI)
+#include <IOKit/system.h>
+#include <kern/clock.h>
+#include <IOKit/IOService.h>
+#include <IOKit/IOPlatformExpert.h>
+#include <IOKit/IOLib.h>
+#include <IOKit/IOLocks.h>
+#include <IOKit/IOBufferMemoryDescriptor.h>
+#include <libkern/c++/OSKext.h>
+#include <libkern/crypto/sha2.h>
+#include <pexpert/pexpert.h>
+#include <pexpert/device_tree.h>
+#include "fuxi_root27.h"
+#include "fuxi_storage_abi.h"
+
+extern "C" {
+extern vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
+extern void flush_dcache64(addr64_t addr, unsigned count, int phys);
+void fuxi_root27_start(void);
+}
+
+#define REG_CAP         0x00
+#define REG_IS          0x20
+#define REG_IE          0x24
+#define REG_HCS         0x30
+#define REG_HCE         0x34
+#define REG_UTRLBA      0x50
+#define REG_UTRLBAU     0x54
+#define REG_UTRLDBR     0x58
+#define REG_UTRLCLR     0x5c
+#define REG_UTRLRSR     0x60
+#define HCS_DP          (1u << 0)
+#define HCS_UTRLRDY     (1u << 1)
+#define CAP_64AS        (1u << 24)
+#define PRDT_CHUNK      (256u << 10)
+#define DMA_UTRL        0x0000
+#define DMA_UCD         0x1000
+#define DMA_BOUNCE      0x4000
+#define DMA_SIZE        (DMA_BOUNCE + FX27_BOUNCE)
+#define WLUN_DEVICE     0xd0
+#define APFS_GPT_TYPE   "7C3457EF-0000-11AA-AA11-00306543ECAC"
+
+struct utrd { uint32_t dw0, dw1, dw2, dw3, ucdba, ucdbau, resp, prdt; };
+struct ucd {
+	uint8_t cmd[512], resp[512];
+	struct { uint32_t addr_lo, addr_hi, rsvd, dbc; } prdt[FX27_BOUNCE / PRDT_CHUNK];
+};
+
+static struct {
+	vm_offset_t regs;
+	IOBufferMemoryDescriptor *dmamd;
+	uint8_t *dma;
+	uint64_t dma_pa;
+	uint8_t lun, tag;
+	bool guard;                     /* extents loaded: READ(10) only inside them */
+	uint64_t part_first, part_blocks, root_blocks;
+	struct fx27_extent ext[FX27_MAX_EXTENTS];
+	unsigned next;
+	struct fx27_window win[FX27_MAX_WINDOWS];
+	unsigned nwin;
+	IOLock *lock;
+} fr;
+
+static inline uint32_t
+ufs_rd(uint32_t off)
+{
+	return *(volatile uint32_t *)(fr.regs + off);
+}
+
+static inline void
+ufs_wr(uint32_t off, uint32_t v)
+{
+	*(volatile uint32_t *)(fr.regs + off) = v;
+}
+
+static void
+dma_sync(uint32_t off, uint32_t len)
+{
+	flush_dcache64((addr64_t)(fr.dma_pa + off), len, TRUE);
+}
+
+/* One read-only command in slot 0, data into the bounce buffer. Lock held. */
+static IOReturn
+ufs_scsi(const uint8_t *cdb, unsigned cdb_len, uint32_t len)
+{
+	bool power = len == 0 && cdb_len == 6 && fr.lun == WLUN_DEVICE && cdb[0] == 0x1b &&
+	    !cdb[1] && !cdb[2] && !cdb[3] && cdb[4] == 0x10 && !cdb[5];
+	bool tur = len == 0 && cdb_len == 6 && fr.lun == 0 && cdb[0] == 0x00;
+	bool rd = cdb_len == 10 && fr.lun == 0 && cdb[0] == 0x28 && len > 0 && len <= FX27_BOUNCE &&
+	    len == ((uint32_t)cdb[7] << 8 | cdb[8]) * FX27_BLOCK && (!fr.guard ||
+	    fx27_io_allowed(fr.ext, fr.next, fr.part_first,
+	    (uint64_t)cdb[2] << 24 | cdb[3] << 16 | cdb[4] << 8 | cdb[5], (uint64_t)cdb[7] << 8 | cdb[8]));
+	if (!power && !tur && !rd) {
+		IOLog("FUXI ROOT27: refusing command 0x%02x lun 0x%x len %u\n", cdb[0], fr.lun, len);
+		return kIOReturnNotPermitted;
+	}
+	struct utrd *utrd = (struct utrd *)(void *)(fr.dma + DMA_UTRL);
+	struct ucd *ucd = (struct ucd *)(void *)(fr.dma + DMA_UCD);
+	uint64_t ucd_pa = fr.dma_pa + DMA_UCD, bounce_pa = fr.dma_pa + DMA_BOUNCE;
+	bzero(utrd, sizeof(*utrd));
+	bzero(ucd, sizeof(*ucd));
+	ucd->cmd[0] = 0x01;
+	ucd->cmd[1] = len ? 0x40 : 0x00;
+	ucd->cmd[2] = fr.lun;
+	ucd->cmd[3] = ++fr.tag;
+	ucd->cmd[12] = (uint8_t)(len >> 24);
+	ucd->cmd[13] = (uint8_t)(len >> 16);
+	ucd->cmd[14] = (uint8_t)(len >> 8);
+	ucd->cmd[15] = (uint8_t)len;
+	memcpy(&ucd->cmd[16], cdb, cdb_len);
+	utrd->dw0 = (1u << 28) | ((len ? 2u : 0u) << 25) | (1u << 24);
+	utrd->dw2 = 0x0f;
+	utrd->ucdba = (uint32_t)ucd_pa;
+	utrd->ucdbau = (uint32_t)(ucd_pa >> 32);
+	utrd->resp = (512u / 4) << 16 | (512u / 4);
+	if (len) {
+		uint32_t n = 0;
+		for (uint32_t done = 0; done < len; done += PRDT_CHUNK, n++) {
+			uint32_t chunk = len - done < PRDT_CHUNK ? len - done : PRDT_CHUNK;
+			ucd->prdt[n].addr_lo = (uint32_t)(bounce_pa + done);
+			ucd->prdt[n].addr_hi = (uint32_t)((bounce_pa + done) >> 32);
+			ucd->prdt[n].dbc = chunk - 1;
+		}
+		utrd->prdt = (1024u / 4) << 16 | n;
+	}
+	dma_sync(DMA_UTRL, sizeof(*utrd));
+	dma_sync(DMA_UCD, sizeof(*ucd));
+	if (len) {
+		dma_sync(DMA_BOUNCE, len);
+	}
+	__builtin_arm_dsb(0xf);
+	ufs_wr(REG_UTRLDBR, 1);
+	uint64_t deadline;
+	clock_interval_to_deadline(5, kSecondScale, &deadline);
+	while (ufs_rd(REG_UTRLDBR) & 1) {
+		if (mach_absolute_time() > deadline) {
+			ufs_wr(REG_UTRLCLR, ~1u);
+			IOLog("FUXI ROOT27: command 0x%02x timed out\n", cdb[0]);
+			return kIOReturnTimeout;
+		}
+		IODelay(2);
+	}
+	__builtin_arm_dsb(0xf);
+	ufs_wr(REG_IS, ufs_rd(REG_IS));
+	dma_sync(DMA_UTRL, sizeof(*utrd));
+	dma_sync(DMA_UCD, sizeof(*ucd));
+	if (len) {
+		dma_sync(DMA_BOUNCE, len);
+	}
+	uint32_t ocs = utrd->dw2 & 0xff;
+	if (ocs || ucd->resp[0] != 0x21 || ucd->resp[6] || ucd->resp[7]) {
+		IOLog("FUXI ROOT27: command 0x%02x failed: ocs 0x%x upiu 0x%x response 0x%x status 0x%x\n",
+		    cdb[0], ocs, ucd->resp[0], ucd->resp[6], ucd->resp[7]);
+		return kIOReturnIOError;
+	}
+	return kIOReturnSuccess;
+}
+
+static IOReturn
+ufs_read_blocks(uint64_t lba, uint32_t count)
+{
+	if (count == 0 || lba + count - 1 > UINT32_MAX || count > FX27_BOUNCE / FX27_BLOCK) {
+		return kIOReturnBadArgument;
+	}
+	uint8_t cdb[10] = {
+		0x28, 0, (uint8_t)(lba >> 24), (uint8_t)(lba >> 16), (uint8_t)(lba >> 8), (uint8_t)lba,
+		0, (uint8_t)(count >> 8), (uint8_t)count, 0
+	};
+	return ufs_scsi(cdb, sizeof(cdb), count * FX27_BLOCK);
+}
+
+static IOReturn
+ufs_find_userdata(void)
+{
+	const uint8_t *b = fr.dma + DMA_BOUNCE;
+	IOReturn ret = ufs_read_blocks(1, 1);
+	if (ret) {
+		return ret;
+	}
+	if (memcmp(b, "EFI PART", 8)) {
+		return kIOReturnNotFound;
+	}
+	uint64_t entry_lba = fx27_le64(b + 72);
+	uint32_t nent = fx27_le32(b + 80), esz = fx27_le32(b + 84);
+	if (esz != 128 || nent == 0 || nent > FX27_BOUNCE / esz) {
+		return kIOReturnUnsupported;
+	}
+	if ((ret = ufs_read_blocks(entry_lba, (nent * esz + FX27_BLOCK - 1) / FX27_BLOCK))) {
+		return ret;
+	}
+	static const char want[] = "userdata";         /* UTF-16LE name at 56, NUL terminated */
+	for (uint32_t i = 0; i < nent; i++) {
+		const uint8_t *e = b + i * esz;
+		unsigned c = 0;
+		while (c < sizeof(want) && e[56 + 2 * c] == (uint8_t)want[c] && !e[57 + 2 * c]) {
+			c++;
+		}
+		if (c != sizeof(want)) {
+			continue;
+		}
+		uint64_t first = fx27_le64(e + 32), last = fx27_le64(e + 40);
+		if (last < first) {
+			return kIOReturnNotFound;
+		}
+		fr.part_first = first;
+		fr.part_blocks = last - first + 1;
+		return kIOReturnSuccess;
+	}
+	return kIOReturnNotFound;
+}
+
+static IOReturn
+ufs_take_over_host(void)
+{
+	uint32_t hce = ufs_rd(REG_HCE), hcs = ufs_rd(REG_HCS);
+	if (!(hce & 1) || !(hcs & HCS_DP) || !(hcs & HCS_UTRLRDY) || ufs_rd(REG_UTRLDBR)) {
+		IOLog("FUXI ROOT27: host not idle (hce 0x%x hcs 0x%x)\n", hce, hcs);
+		return kIOReturnNotReady;
+	}
+	if (((fr.dma_pa + DMA_SIZE - 1) >> 32) && !(ufs_rd(REG_CAP) & CAP_64AS)) {
+		return kIOReturnUnsupported;
+	}
+	ufs_wr(REG_IE, 0);
+	ufs_wr(REG_IS, ufs_rd(REG_IS));
+	ufs_wr(REG_UTRLRSR, 0);
+	uint64_t list = fr.dma_pa + DMA_UTRL;
+	ufs_wr(REG_UTRLBA, (uint32_t)list);
+	ufs_wr(REG_UTRLBAU, (uint32_t)(list >> 32));
+	ufs_wr(REG_UTRLRSR, 1);
+	if (ufs_rd(REG_UTRLBA) != (uint32_t)list || ufs_rd(REG_UTRLBAU) != (uint32_t)(list >> 32) ||
+	    !(ufs_rd(REG_UTRLRSR) & 1)) {
+		IOLog("FUXI ROOT27: host did not take our request list\n");
+		return kIOReturnIOError;
+	}
+	return kIOReturnSuccess;
+}
+
+/* Disable only the UFS PHY AHB clock auto-gating (GCC 0x177024), as the 8796 lane. */
+static IOReturn
+ufs_power(void)
+{
+	vm_offset_t gcc = ml_io_map(0x177000, 0x1000);
+	if (!gcc) {
+		return kIOReturnNoMemory;
+	}
+	volatile uint32_t *ahb = (volatile uint32_t *)(gcc + 0x24);
+	uint32_t old = *ahb;
+	if (!(old & 1) || !(*(volatile uint32_t *)(gcc + 4) & 0x80000000) ||
+	    ((*(volatile uint32_t *)(gcc + 0x18) | *(volatile uint32_t *)(gcc + 0x68)) & 0x80000000)) {
+		IOLog("FUXI ROOT27: UFS power/AXI/UniPro not ready\n");
+		return kIOReturnNotReady;
+	}
+	*ahb = old & ~2u;
+	__builtin_arm_dsb(0xf);
+	uint64_t deadline;
+	clock_interval_to_deadline(1, kMillisecondScale, &deadline);
+	while ((*ahb & 0x80000000) && mach_absolute_time() < deadline) {
+	}
+	if (*ahb & 0x80000000) {
+		*ahb = old;
+		return kIOReturnTimeout;
+	}
+	return kIOReturnSuccess;
+}
+
+/* Root bytes [pos, pos + len) into buffer at offset, through the extent map. */
+static IOReturn
+root_read(uint64_t pos, uint64_t len, IOMemoryDescriptor *buffer, IOByteCount offset, uint64_t *done)
+{
+	struct fx27_io io;
+	IOReturn ret = kIOReturnSuccess;
+	*done = 0;
+	IOLockLock(fr.lock);
+	while (*done < len) {
+		if (fx27_plan(fr.ext, fr.next, fr.part_first, pos + *done, len - *done, &io) ||
+		    !fx27_io_allowed(fr.ext, fr.next, fr.part_first, io.lba, io.blocks)) {
+			ret = kIOReturnBadArgument;
+			break;
+		}
+		if ((ret = ufs_read_blocks(io.lba, io.blocks))) {
+			break;
+		}
+		if (buffer) {
+			if (buffer->writeBytes(offset + *done, fr.dma + DMA_BOUNCE + io.skip, io.want) != io.want) {
+				ret = kIOReturnUnderrun;
+				break;
+			}
+		}
+		*done += io.want;
+	}
+	IOLockUnlock(fr.lock);
+	return ret;
+}
+
+class FuxiRootWindow : public IOStorage
+{
+	OSDeclareDefaultStructors(FuxiRootWindow);
+	unsigned window;
+public:
+	bool initWindow(unsigned index, OSDictionary *props);
+	IOReturn serve(UInt64 byteStart, IOMemoryDescriptor *buffer, UInt64 *actual);
+	virtual bool open(IOService *client, IOOptionBits options, IOStorageAccess access) APPLE_KEXT_OVERRIDE;
+	virtual IOReturn read(IOService *client, UInt64 byteStart, IOMemoryDescriptor *buffer,
+	    IOStorageAttributes *attributes = 0, UInt64 *actualByteCount = 0) APPLE_KEXT_OVERRIDE;
+	virtual IOReturn write(IOService *client, UInt64 byteStart, IOMemoryDescriptor *buffer,
+	    IOStorageAttributes *attributes = 0, UInt64 *actualByteCount = 0) APPLE_KEXT_OVERRIDE;
+	virtual void read(IOService *client, UInt64 byteStart, IOMemoryDescriptor *buffer,
+	    IOStorageAttributes *attributes, IOStorageCompletion *completion) APPLE_KEXT_OVERRIDE;
+	virtual void write(IOService *client, UInt64 byteStart, IOMemoryDescriptor *buffer,
+	    IOStorageAttributes *attributes, IOStorageCompletion *completion) APPLE_KEXT_OVERRIDE;
+	virtual IOReturn unmap(IOService *client, IOStorageExtent *extents, UInt32 extentsCount,
+	    IOStorageUnmapOptions options = 0) APPLE_KEXT_OVERRIDE;
+	virtual bool lockPhysicalExtents(IOService *client) APPLE_KEXT_OVERRIDE;
+	virtual IOStorage * copyPhysicalExtent(IOService *client, UInt64 *byteStart, UInt64 *byteCount) APPLE_KEXT_OVERRIDE;
+	virtual void unlockPhysicalExtents(IOService *client) APPLE_KEXT_OVERRIDE;
+	virtual IOReturn setPriority(IOService *client, IOStorageExtent *extents, UInt32 extentsCount,
+	    IOStoragePriority priority) APPLE_KEXT_OVERRIDE;
+	virtual IOReturn synchronize(IOService *client, UInt64 byteStart, UInt64 byteCount,
+	    IOStorageSynchronizeOptions options = 0) APPLE_KEXT_OVERRIDE;
+	virtual IOReturn getProvisionStatus(IOService *client, UInt64 byteStart, UInt64 byteCount,
+	    UInt32 *extentsCount, IOStorageProvisionExtent *extents,
+	    IOStorageGetProvisionStatusOptions options = 0) APPLE_KEXT_OVERRIDE;
+};
+
+const OSMetaClass &IOStorage::gMetaClass = IOService::gMetaClass;
+OSDefineMetaClassAndStructors(FuxiRootWindow, IOStorage);
+
+bool
+FuxiRootWindow::initWindow(unsigned index, OSDictionary *props)
+{
+	window = index;
+	return IOService::init(props);
+}
+
+IOReturn
+FuxiRootWindow::serve(UInt64 byteStart, IOMemoryDescriptor *buffer, UInt64 *actual)
+{
+	const struct fx27_window *w = &fr.win[window];
+	UInt64 length = buffer ? buffer->getLength() : 0, done = 0;
+	IOReturn ret = kIOReturnBadArgument;
+	if (buffer && byteStart <= w->size && length <= w->size - byteStart) {
+		ret = root_read(w->offset + byteStart, length, buffer, 0, &done);
+	}
+	if (actual) {
+		*actual = done;
+	}
+	return ret;
+}
+
+bool
+FuxiRootWindow::open(IOService *, IOOptionBits, IOStorageAccess access)
+{
+	return !(access & 0x2);         /* kIOStorageAccessWriter */
+}
+
+IOReturn
+FuxiRootWindow::read(IOService *, UInt64 byteStart, IOMemoryDescriptor *buffer, IOStorageAttributes *,
+    UInt64 *actualByteCount)
+{
+	return serve(byteStart, buffer, actualByteCount);
+}
+
+IOReturn
+FuxiRootWindow::write(IOService *, UInt64, IOMemoryDescriptor *, IOStorageAttributes *, UInt64 *actualByteCount)
+{
+	if (actualByteCount) {
+		*actualByteCount = 0;
+	}
+	return kIOReturnNotWritable;
+}
+
+void
+FuxiRootWindow::read(IOService *, UInt64 byteStart, IOMemoryDescriptor *buffer, IOStorageAttributes *,
+    IOStorageCompletion *completion)
+{
+	UInt64 actual = 0;
+	IOReturn ret = serve(byteStart, buffer, &actual);
+	if (completion && completion->action) {
+		completion->action(completion->target, completion->parameter, ret, actual);
+	}
+}
+
+void
+FuxiRootWindow::write(IOService *, UInt64, IOMemoryDescriptor *, IOStorageAttributes *,
+    IOStorageCompletion *completion)
+{
+	if (completion && completion->action) {
+		completion->action(completion->target, completion->parameter, kIOReturnNotWritable, 0);
+	}
+}
+
+IOReturn
+FuxiRootWindow::unmap(IOService *, IOStorageExtent *, UInt32, IOStorageUnmapOptions)
+{
+	return kIOReturnUnsupported;
+}
+
+bool
+FuxiRootWindow::lockPhysicalExtents(IOService *)
+{
+	return false;
+}
+
+IOStorage *
+FuxiRootWindow::copyPhysicalExtent(IOService *, UInt64 *, UInt64 *)
+{
+	return NULL;
+}
+
+void
+FuxiRootWindow::unlockPhysicalExtents(IOService *)
+{
+}
