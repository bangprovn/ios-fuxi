+ * distributed on an 'AS IS' basis, WITHOUT WARRANTY OF ANY KIND, EITHER
+ * EXPRESS OR IMPLIED, AND APPLE HEREBY DISCLAIMS ALL SUCH WARRANTIES,
+ * INCLUDING WITHOUT LIMITATION, ANY WARRANTIES OF MERCHANTABILITY,
+ * FITNESS FOR A PARTICULAR PURPOSE, QUIET ENJOYMENT OR NON-INFRINGEMENT.
+ * Please see the License for the specific language governing rights and
+ * limitations under the License.
+ *
+ * @APPLE_LICENSE_HEADER_END@
+ */
+/*
+ * Fuxi K4: the vtable shape of IOStorageFamily's IOStorage and IOMedia, so the
+ * native kernel can create an IOMedia of the prelinked (Apple) IOStorageFamily
+ * and serve its I/O without linking against the kext. Declarations only, taken
+ * from IOStorageFamily-337.100.1 IOStorage.h / IOMedia.h (APSL 2.0,
+ * github.com/apple-oss-distributions/IOStorageFamily) as compiled for iOS:
+ * TARGET_OS_OSX 0 (no attach/synchronizeCache/discard slots, unmap and
+ * synchronize pure) and no vtable padding (APPLE_KEXT_VTABLE_PADDING 0, so the
+ * reserved slots do not exist). Only the slot order and the method names and
+ * types matter: arm64e signs each vtable entry with the mangled name of the
+ * method that introduced the slot, so the classes keep Apple's names.
+ *
+ * IOStorage here is never registered as a class: its gMetaClass is IOService's,
+ * so subclasses (FuxiRootWindow) metaCast to IOService, not to the kext's
+ * IOStorage, and IOMedia::handleOpen skips the provider open. IOMedia is never
+ * constructed here: FuxiRoot27.cpp allocates it through the kext's metaclass
+ * and calls only init().
+ */
+#ifndef FUXI_STORAGE_ABI_H
+#define FUXI_STORAGE_ABI_H
+#include <IOKit/IOService.h>
+#include <IOKit/IOMemoryDescriptor.h>
+
+typedef UInt32 IOStorageUnmapOptions;
+typedef UInt32 IOStorageAccess;
+typedef UInt8 IOStoragePriority;
+typedef UInt32 IOStorageSynchronizeOptions;
+typedef UInt64 IOStorageGetProvisionStatusOptions;
+typedef UInt32 IOMediaAttributeMask;
+struct IOStorageAttributes;
+struct IOStorageExtent;
+struct IOStorageProvisionExtent;
+typedef void (*IOStorageCompletionAction)(void *target, void *parameter, IOReturn status, UInt64 actualByteCount);
+struct IOStorageCompletion {
+	void *target;
+	IOStorageCompletionAction action;
+	void *parameter;
+};
+
+#define kIOStorageCategory              "IOStorage"
+#define kIOMediaContentMaskKey          "Content Mask"
+#define kIOMediaBaseKey                 "Base"
+#define kIOMediaPartitionIDKey          "Partition ID"
+#define kIOMediaUUIDKey                 "UUID"
+#define kIOMediaSizeKey                 "Size"
+#define kIOMediaWholeKey                "Whole"
+#define kIOMediaContentHintKey          "Content Hint"
+
+class IOStorage : public IOService
+{
+protected:
+	IOStorage(const OSMetaClass *meta) : IOService(meta)
+	{
+	}
+	virtual ~IOStorage() APPLE_KEXT_OVERRIDE
+	{
+	}
+	void *_expansionData;           /* IOStorage::ExpansionData *, kept for the layout */
+public:
+	static const OSMetaClass &gMetaClass;
+
+	virtual bool open(IOService *client, IOOptionBits options, IOStorageAccess access) = 0;
+	virtual IOReturn read(IOService *client, UInt64 byteStart, IOMemoryDescriptor *buffer,
+	    IOStorageAttributes *attributes = 0, UInt64 *actualByteCount = 0) = 0;
+	virtual IOReturn write(IOService *client, UInt64 byteStart, IOMemoryDescriptor *buffer,
+	    IOStorageAttributes *attributes = 0, UInt64 *actualByteCount = 0) = 0;
+	virtual void read(IOService *client, UInt64 byteStart, IOMemoryDescriptor *buffer,
+	    IOStorageAttributes *attributes, IOStorageCompletion *completion) = 0;
+	virtual void write(IOService *client, UInt64 byteStart, IOMemoryDescriptor *buffer,
+	    IOStorageAttributes *attributes, IOStorageCompletion *completion) = 0;
+	virtual IOReturn unmap(IOService *client, IOStorageExtent *extents, UInt32 extentsCount,
+	    IOStorageUnmapOptions options = 0) = 0;
+	virtual bool lockPhysicalExtents(IOService *client) = 0;
+	virtual IOStorage * copyPhysicalExtent(IOService *client, UInt64 *byteStart, UInt64 *byteCount) = 0;
+	virtual void unlockPhysicalExtents(IOService *client) = 0;
+	virtual IOReturn setPriority(IOService *client, IOStorageExtent *extents, UInt32 extentsCount,
+	    IOStoragePriority priority) = 0;
+	virtual IOReturn synchronize(IOService *client, UInt64 byteStart, UInt64 byteCount,
+	    IOStorageSynchronizeOptions options = 0) = 0;
+	virtual IOReturn getProvisionStatus(IOService *client, UInt64 byteStart, UInt64 byteCount,
+	    UInt32 *extentsCount, IOStorageProvisionExtent *extents, IOStorageGetProvisionStatusOptions options = 0) = 0;
+};
+
+class IOMedia : public IOStorage
+{
+	IOMedia() = delete;
+public:
+	virtual UInt64 getPreferredBlockSize() const = 0;
+	virtual UInt64 getSize() const = 0;
+	virtual UInt64 getBase() const = 0;
