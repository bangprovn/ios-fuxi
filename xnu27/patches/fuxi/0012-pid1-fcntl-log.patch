index 8adfaf2..e4702ca 100644
--- a/bsd/kern/kern_descrip.c
+++ b/bsd/kern/kern_descrip.c
@@ -78,6 +78,9 @@
 #include <sys/kernel.h>
 #include <sys/vnode_internal.h>
 #include <sys/proc_internal.h>
+#if defined(FUXI)
+#include <kern/clock.h>
+#endif
 #include <sys/kauth.h>
 #include <sys/file_internal.h>
 #include <sys/guarded.h>
@@ -2876,8 +2879,45 @@ outdrop:
 	return sys_fcntl_outdrop(p, fd, fp, vp, error);
 }
 
+#if defined(FUXI)
+static int sys_fcntl_nocancel_impl(proc_t p, struct fcntl_nocancel_args *uap, int32_t *retval);
+
+/* fuxi_proc_log=1: pid 1's fcntl calls (dyld's code-signature registration of the shared cache) with timing */
+int
+sys_fcntl_nocancel(proc_t p, struct fcntl_nocancel_args *uap, int32_t *retval)
+{
+	char *path;
+	vnode_t vp = NULLVP;
+	int len = MAXPATHLEN, error;
+	uint64_t t0, ns;
+
+	if (proc_getpid(p) != 1 || !fuxi_proc_log()) {
+		return sys_fcntl_nocancel_impl(p, uap, retval);
+	}
+	path = kalloc_data(MAXPATHLEN, Z_WAITOK | Z_ZERO);
+	if (path != NULL && file_vnode(uap->fd, &vp) == 0) {
+		if (vn_getpath(vp, path, &len) != 0) {
+			path[0] = '\0';
+		}
+		file_drop(uap->fd);
+	}
+	printf("fuxi: fcntl pid 1 fd %d cmd %d %s\n", uap->fd, uap->cmd, path != NULL ? path : "");
+	t0 = mach_absolute_time();
+	error = sys_fcntl_nocancel_impl(p, uap, retval);
+	absolutetime_to_nanoseconds(mach_absolute_time() - t0, &ns);
+	printf("fuxi: fcntl pid 1 fd %d cmd %d -> %d (%llu ms)\n", uap->fd, uap->cmd, error, ns / 1000000ULL);
+	if (path != NULL) {
+		kfree_data(path, MAXPATHLEN);
+	}
+	return error;
+}
+
+static int
+sys_fcntl_nocancel_impl(proc_t p, struct fcntl_nocancel_args *uap, int32_t *retval)
+#else
 int
 sys_fcntl_nocancel(proc_t p, struct fcntl_nocancel_args *uap, int32_t *retval)
+#endif
 {
 	int fd = uap->fd;
 	int cmd = uap->cmd;
