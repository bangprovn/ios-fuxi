+
+SYSCTL_PROC(_kern, OID_AUTO, apfs_stats, CTLTYPE_STRING | CTLFLAG_RW | CTLFLAG_LOCKED,
+    0, 0, sysctl_apfs_stats, "A", "APFS: where the time goes; write to zero it");
+
+/* ------------------------------------------------------------------ vnodes */
+
+static uint32_t
+apfs_hash_index(uint64_t obj_id)
+{
+	/* the low bits of an identifier are the ones that differ between neighbours */
+	return (uint32_t)((obj_id ^ (obj_id >> 17)) % APFS_HASH_BUCKETS);
+}
+
+/* The vnode for an object, making one if there is not one already. */
+int
+apfs_node_vnode(struct apfs_mount *am, uint64_t obj_id, vnode_t dvp,
+    struct componentname *cnp, vnode_t *vpp)
+{
+	struct vnode_fsparam vfsp;
+	struct apfs_node *an;
+	struct apfs_inode ino;
+	uint32_t b = apfs_hash_index(obj_id);
+	uint64_t size = 0;
+	enum vtype vtype;
+	int error;
+
+	/* already have one? */
+	apfs_lock(am);
+	for (an = am->am_hash[b]; an != NULL; an = an->an_next) {
+		if (an->an_id == obj_id && an->an_attached) {
+			vnode_t vp = an->an_vp;
+			uint32_t vid = vnode_vid(vp);
+
+			apfs_unlock(am);
+			if (vnode_getwithvid(vp, vid) == 0) {
+				os_atomic_inc(&am->am_node_found, relaxed);
+				/*
+				 * Found by a lookup: the name goes into the name cache, as vnode_create
+				 * puts it there for a new vnode -- else every later lookup of this
+				 * name comes back here for the lock.  (The volume does not change;
+				 * a synthetic name is looked for only where there is no real one, and
+				 * adding one purges its directory's entries.)  The name cache keeps
+				 * one name per vnode and leaves one that has a name already as it is.
+				 */
+				if (dvp != NULLVP && cnp != NULL && (cnp->cn_flags & MAKEENTRY)) {
+					cache_enter(dvp, vp, cnp);
+					os_atomic_inc(&am->am_node_named, relaxed);
+				}
+				*vpp = vp;
+				return 0;
+			}
+			/* it was going away under us: fall through and make a new one */
+			apfs_lock(am);
+			break;
+		}
+	}
+
+	if (obj_id >= APFS_SYNTH_BASE) {
+		/* a synthetic directory: an empty one, root's, made up here */
+		const struct apfs_synth *sy = NULL;
+		uint32_t i;
+
+		for (i = 0; i < am->am_nsynth; i++) {
+			if (am->am_synth[i].id == obj_id) {
+				sy = &am->am_synth[i];
+			}
+		}
+		bzero(&ino, sizeof(ino));
+		if (sy == NULL) {
+			error = ENOENT;
+		} else {
+			ino.obj_id = obj_id;
+			ino.parent_id = sy->parent;
+			ino.mode = APFS_S_IFDIR | 0755;
+			error = 0;
+		}
+	} else {
+		error = apfs_inode_get(&am->am_vol, obj_id, &ino);
+		if (error == 0) {
+			uint32_t i;
+
+			error = apfs_inode_size(&am->am_vol, &ino, &size);
+			if (error) {
+				size = ino.size;       /* the stream's size is still better than nothing */
+				error = 0;
+			}
+			/* a directory with another name: ".." is where that name is */
+			for (i = 0; i < am->am_nsynth; i++) {
+				if (am->am_synth[i].alias && am->am_synth[i].id == obj_id) {
+					ino.parent_id = am->am_synth[i].parent;
+				}
+			}
+		}
+	}
+	apfs_unlock(am);
+	if (error) {
+		return error;
+	}
+
+	switch (ino.mode & APFS_S_IFMT) {
+	case APFS_S_IFREG:  vtype = VREG; break;
+	case APFS_S_IFDIR:  vtype = VDIR; break;
+	case APFS_S_IFLNK:  vtype = VLNK; break;
+	case APFS_S_IFCHR:  vtype = VCHR; break;
+	case APFS_S_IFBLK:  vtype = VBLK; break;
+	case APFS_S_IFIFO:  vtype = VFIFO; break;
+	case APFS_S_IFSOCK: vtype = VSOCK; break;
+	default:
+		return EIO;
+	}
+
+	an = kalloc_type(struct apfs_node, Z_WAITOK | Z_ZERO);
+	if (an == NULL) {
+		return ENOMEM;
+	}
+	an->an_mount = am;
+	an->an_id = obj_id;
+	an->an_parent = ino.parent_id;
+	an->an_mode = ino.mode;
+	an->an_size = size;
+	an->an_ino = ino;       /* nothing here can change: the mount is read only */
+
+	bzero(&vfsp, sizeof(vfsp));
+	vfsp.vnfs_mp = am->am_mp;
+	vfsp.vnfs_vtype = vtype;
+	vfsp.vnfs_str = "apfs";
+	vfsp.vnfs_dvp = dvp;
+	vfsp.vnfs_fsnode = an;
+	vfsp.vnfs_vops = apfs_vnodeop_p;
+	vfsp.vnfs_markroot = (obj_id == am->am_root_id);
+	vfsp.vnfs_marksystem = 0;
+	vfsp.vnfs_rdev = (vtype == VCHR || vtype == VBLK) ? (dev_t)ino.rdev : 0;
+	vfsp.vnfs_filesize = size;
+	vfsp.vnfs_cnp = cnp;
+	/* let VFS cache the name only when it came from a lookup that has one */
+	vfsp.vnfs_flags = (dvp != NULL && cnp != NULL) ? 0 : VNFS_NOCACHE;
+
+	error = vnode_create(VNCREATE_FLAVOR, VCREATESIZE, &vfsp, &an->an_vp);
+	if (error) {
+		kfree_type(struct apfs_node, an);
+		return error;
+	}
+	vnode_settag(an->an_vp, VT_OTHER);
+
+	apfs_lock(am);
+	an->an_next = am->am_hash[b];
+	am->am_hash[b] = an;
+	an->an_attached = true;
+	apfs_unlock(am);
+	os_atomic_inc(&am->am_node_made, relaxed);
+
+	*vpp = an->an_vp;
+	return 0;
+}
+
+/* A synthetic directory by where it is and its name; with am_lock held. */
+const struct apfs_synth *
+apfs_synth_find(struct apfs_mount *am, uint64_t parent, const char *name, size_t len)
+{
+	uint32_t i;
+
+	for (i = 0; i < am->am_nsynth; i++) {
+		if (am->am_synth[i].parent == parent && strlen(am->am_synth[i].name) == len &&
+		    memcmp(am->am_synth[i].name, name, len) == 0) {
+			return &am->am_synth[i];
+		}
+	}
+	return NULL;
+}
+
+/*
+ * sysctl kern.apfs_synthetic=PATH: a synthetic directory at PATH, whose parent must be a
+ * directory of an APFS volume (real or synthetic) and which must not exist yet.
+ * PATH=TARGET: at PATH, another name for the directory TARGET of the same volume.  Root
+ * only; nothing ever takes one away again but unmounting.
+ */
+static int
+apfs_sysctl_synthetic SYSCTL_HANDLER_ARGS
+{
+#pragma unused(oidp, arg1, arg2)
+	char path[MAXPATHLEN], name[APFS_SYNTH_NAMELEN], *target;
+	vnode_t dvp = NULLVP, vp = NULLVP, tvp = NULLVP;
+	struct apfs_mount *am;
+	struct apfs_node *dn;
+	uint64_t target_id = 0;
+	const char *slash;
+	size_t len;
+	int error;
+
+	if (req->newptr == USER_ADDR_NULL) {
+		return SYSCTL_OUT(req, "", 1);          /* reading it says nothing */
+	}
+	if ((error = suser(kauth_cred_get(), NULL)) != 0) {
+		return error;
+	}
+	if (req->newlen == 0 || req->newlen >= sizeof(path)) {
+		return EINVAL;
+	}
+	error = SYSCTL_IN(req, path, req->newlen);
+	if (error) {
+		return error;
+	}
+	path[req->newlen] = '\0';
+	target = strchr(path, '=');
+	if (target != NULL) {
+		*target++ = '\0';
+		error = vnode_lookup(target, 0, &tvp, vfs_context_current());
+		if (error) {
+			return error;
+		}
+		if (vnode_vtype(tvp) != VDIR || vnode_mount(tvp) == NULL ||
+		    strcmp(vfs_statfs(vnode_mount(tvp))->f_fstypename, "apfs") != 0) {
+			vnode_put(tvp);
+			return ENOTDIR;
+		}
+		target_id = APFS_VP(tvp)->an_id;
+	}
+	while ((len = strlen(path)) > 1 && path[len - 1] == '/') {
+		path[len - 1] = '\0';
+	}
+	slash = strrchr(path, '/');
+	if (slash == NULL || slash[1] == '\0') {
+		error = EINVAL;
+		goto out;
+	}
+	len = strlen(slash + 1);
+	if (len >= sizeof(name)) {
+		error = EINVAL;
+		goto out;
+	}
+	strlcpy(name, slash + 1, sizeof(name));        /* before the path is cut to its parent */
+	if (strcmp(name, ".") == 0 || strcmp(name, "..") == 0) {
+		error = EINVAL;
+		goto out;
+	}
+	if (vnode_lookup(path, 0, &vp, vfs_context_current()) == 0) {
+		vnode_put(vp);
+		error = EEXIST;
+		goto out;
+	}
+	path[slash - path == 0 ? 1 : slash - path] = '\0';     /* the parent ("/" for "/name") */
+	error = vnode_lookup(path, 0, &dvp, vfs_context_current());
+	if (error) {
+		goto out;
+	}
+	if (vnode_vtype(dvp) != VDIR || vnode_mount(dvp) == NULL ||
+	    strcmp(vfs_statfs(vnode_mount(dvp))->f_fstypename, "apfs") != 0 ||
+	    (tvp != NULLVP && vnode_mount(tvp) != vnode_mount(dvp))) {
+		vnode_put(dvp);
+		error = ENOTSUP;
+		goto out;
+	}
+	dn = APFS_VP(dvp);
+	am = dn->an_mount;
+	apfs_lock(am);
+	if (am->am_synth == NULL) {
+		am->am_synth = kalloc_data(APFS_SYNTH_MAX * sizeof(*am->am_synth), Z_WAITOK | Z_ZERO);
+	}
+	if (am->am_synth == NULL) {
+		error = ENOMEM;
+	} else if (apfs_synth_find(am, dn->an_id, name, len) != NULL) {
+		error = EEXIST;
+	} else if (am->am_nsynth >= APFS_SYNTH_MAX) {
+		error = ENOSPC;
+	} else {
+		uint32_t n0 = am->am_nsynth;
+		uint64_t id = (tvp != NULLVP) ? target_id : APFS_SYNTH_BASE + n0;
+		struct apfs_inode ino;
+
+		/* an id the volume does not use itself, or nothing (reading the tree may let go of the lock) */
+		if (tvp == NULLVP && apfs_inode_get(&am->am_vol, id, &ino) != ENOENT) {
+			error = EEXIST;
+		} else if (am->am_nsynth != n0 || apfs_synth_find(am, dn->an_id, name, len) != NULL) {
+			error = EBUSY;          /* another was made meanwhile: try again */
+		} else {
+			struct apfs_synth *sy = &am->am_synth[am->am_nsynth];
+
+			sy->parent = dn->an_id;
+			sy->alias = (tvp != NULLVP);
+			sy->id = id;
+			strlcpy(sy->name, name, sizeof(sy->name));
+			am->am_nsynth++;
+			error = 0;
+		}
+	}
+	apfs_unlock(am);
+	/* the parent's entries changed: what the name cache has of it is stale */
+	cache_purge(dvp);
+	cache_purge_negatives(dvp);     /* (the new name was known not to be there) */
+	vnode_put(dvp);
+out:
+	if (tvp != NULLVP) {
+		vnode_put(tvp);
+	}
+	return error;
+}
+
+SYSCTL_PROC(_kern, OID_AUTO, apfs_synthetic, CTLTYPE_STRING | CTLFLAG_RW | CTLFLAG_LOCKED,
+    NULL, 0, apfs_sysctl_synthetic, "A",
+    "write PATH: an empty synthetic directory on an APFS volume (a mount point)");
+
+/* Take a node out of the hash; called from vnop_reclaim. */
+void
+apfs_node_detach(struct apfs_node *an)
+{
+	struct apfs_mount *am = an->an_mount;
+	uint32_t b = apfs_hash_index(an->an_id);
+	struct apfs_node **pp;
+
+	apfs_lock(am);
+	for (pp = &am->am_hash[b]; *pp != NULL; pp = &(*pp)->an_next) {
+		if (*pp == an) {
+			*pp = an->an_next;
+			break;
+		}
+	}
+	an->an_attached = false;
+	apfs_unlock(am);
+}
+
+/* apfs_lib lets go of the mount's lock round decompression, through these */
+static void
+apfs_lib_unlock(void *ctx)
+{
+	apfs_unlock_inner((struct apfs_mount *)ctx);     /* the operation goes on */
+}
+
+static void
+apfs_lib_relock(void *ctx)
+{
+	apfs_lock_inner((struct apfs_mount *)ctx);
+}
+
+/* ------------------------------------------------------- threads for one request */
+
+/*
+ * apfs_lib's nx->parallel: a few kernel threads that help a request of many compressed
+ * pieces along, each reading and decompressing whole pieces into the caller's buffer while
+ * the caller does the same.  A request posts a job and wakes as many helpers as it can
+ * use; a helper that comes takes a worker number and then items until none are left.  The
+ * caller works through items too, then takes its job off the list -- no helper can join
+ * after that -- and waits for the helpers still inside it.  The job lives on the caller's
+ * stack, which is why nothing may touch it once the caller is back.
+ *
+ * Boot-arg apfs_par=N: at most N threads on one request, the caller's included (default:
+ * four, or the processors if fewer -- see apfs_pool_start(); 1 turns the helpers off).
+ */
+struct apfs_pjob {
+	struct apfs_pjob *pj_next;
+	int             (*pj_fn)(void *arg, uint32_t item, uint32_t worker);
+	void             *pj_arg;
+	uint32_t          pj_items;
+	uint32_t          pj_workers;
+	volatile SInt32   pj_taken;     /* items handed out so far (may run past pj_items) */
+	volatile SInt32   pj_error;
+	uint32_t          pj_joined;    /* worker numbers given out; under apfs_pool_lock */
+	uint32_t          pj_active;    /* helpers inside the job now; under apfs_pool_lock */
+};
+
+static struct apfs_pjob *apfs_pool_jobs;        /* oldest first */
+static uint32_t apfs_pool_threads;
+static uint32_t apfs_par_max;                   /* threads on one request, the caller's included */
+
+static void
+apfs_pjob_work(struct apfs_pjob *pj, uint32_t worker)
+{
+	for (;;) {
+		SInt32 item = OSIncrementAtomic(&pj->pj_taken);
+		int error;
+
+		if (item < 0 || (uint32_t)item >= pj->pj_items) {
+			break;
+		}
+		error = pj->pj_fn(pj->pj_arg, (uint32_t)item, worker);
+		if (error != 0) {
+			OSCompareAndSwap(0, (UInt32)error, (volatile UInt32 *)&pj->pj_error);
+		}
+	}
+}
+
+static void
+apfs_pool_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	lck_mtx_lock(&apfs_pool_lock);
+	for (;;) {
+		struct apfs_pjob *pj;
+		uint32_t worker;
+
+		for (pj = apfs_pool_jobs; pj != NULL; pj = pj->pj_next) {
+			if (pj->pj_joined < pj->pj_workers &&
+			    (uint32_t)pj->pj_taken < pj->pj_items) {
+				break;
+			}
+		}
+		if (pj == NULL) {
+			(void)msleep(&apfs_pool_jobs, &apfs_pool_lock, PRIBIO, "apfs_pool", NULL);
+			continue;
+		}
+		worker = pj->pj_joined++;
+		pj->pj_active++;
+		lck_mtx_unlock(&apfs_pool_lock);
+		apfs_pjob_work(pj, worker);
+		lck_mtx_lock(&apfs_pool_lock);
+		if (--pj->pj_active == 0) {
+			wakeup(&pj->pj_active);
+		}
+	}
+}
+
+static int
+apfs_parallel(__unused void *ctx, uint32_t items, uint32_t workers,
+    int (*fn)(void *arg, uint32_t item, uint32_t worker), void *arg)
+{
+	struct apfs_pjob pj, **pp;
+	uint32_t i;
+
+	bzero(&pj, sizeof(pj));
+	pj.pj_fn = fn;
+	pj.pj_arg = arg;
+	pj.pj_items = items;
+	pj.pj_workers = workers;
+	pj.pj_joined = 1;               /* the caller is worker 0 */
+
+	lck_mtx_lock(&apfs_pool_lock);
+	for (pp = &apfs_pool_jobs; *pp != NULL; pp = &(*pp)->pj_next) {
+	}
+	*pp = &pj;
+	for (i = 1; i < workers; i++) {
+		wakeup_one((caddr_t)&apfs_pool_jobs);
+	}
+	lck_mtx_unlock(&apfs_pool_lock);
+
+	apfs_pjob_work(&pj, 0);
+
+	lck_mtx_lock(&apfs_pool_lock);
+	for (pp = &apfs_pool_jobs; *pp != &pj; pp = &(*pp)->pj_next) {
+	}
+	*pp = pj.pj_next;
+	while (pj.pj_active > 0) {
+		(void)msleep(&pj.pj_active, &apfs_pool_lock, PRIBIO, "apfs_pjob", NULL);
+	}
+	lck_mtx_unlock(&apfs_pool_lock);
+	return pj.pj_error;
+}
+
+/*
+ * The helpers, once, at the first mount.  Four threads on one request at most unless
+ * apfs_par says otherwise: on this phone one reader with 1 MB reads took 765 ms over the
+ * restore ramdisk with two, 612 with four or five, 714 with all eight -- the four small
+ * cores take two and a half times as long over a piece, and a request waits for its
+ * slowest one.
+ */
+static void
+apfs_pool_start(void)
+{
+	uint32_t want = ml_get_topology_info()->num_cpus, i;
+
+	if (want > 4) {
+		want = 4;
+	}
+	if (want < 1) {
+		want = 1;
+	}
+	PE_parse_boot_argn("apfs_par", &want, sizeof(want));
+	if (want < 1) {
+		want = 1;
+	}
+	lck_mtx_lock(&apfs_pool_lock);
+	if (apfs_par_max != 0) {
+		lck_mtx_unlock(&apfs_pool_lock);
+		return;
+	}
+	apfs_par_max = want;
+	lck_mtx_unlock(&apfs_pool_lock);
+	for (i = 0; i + 1 < want; i++) {
+		thread_t th;
+
+		if (kernel_thread_start(apfs_pool_thread, NULL, &th) != KERN_SUCCESS) {
+			break;
+		}
+		thread_deallocate(th);
+		OSIncrementAtomic((volatile SInt32 *)&apfs_pool_threads);
+	}
+	printf("apfs: %u threads on a request of many pieces (%u helpers)\n", want,
+	    apfs_pool_threads);
+}
+
+/* ------------------------------------------------------------------ mount */
+
+static void
+apfs_free_mount(struct apfs_mount *am)
+{
+	if (am->am_synth != NULL) {
+		kfree_data(am->am_synth, APFS_SYNTH_MAX * sizeof(*am->am_synth));
+	}
+	while (am->am_iobuf_kept > 0) {
+		kfree_data(am->am_iobuf[--am->am_iobuf_kept], am->am_iobuf_size);
+	}
+	apfs_nx_close(&am->am_nx);
+	if (am->am_procs != NULL) {
+		kfree_data(am->am_procs, APFS_LOCK_PROCS * sizeof(am->am_procs[0]));
+	}
+	lck_spin_destroy(&am->am_iobuf_spin, &apfs_lck_grp);
+	lck_spin_destroy(&am->am_procs_spin, &apfs_lck_grp);
+	lck_mtx_destroy(&am->am_lock, &apfs_lck_grp);
+	kfree_type(struct apfs_mount, am);
+}
+
+/*
+ * Which container of the device and which volume of it: containers lie back to back, each
+ * saying in its superblock how big it is (nx_block_count blocks of nx_block_size), so the
+ * N-th starts where the one before it ends -- the RAM disks of this port hold several (the
+ * boot volume, a cryptex) and so may the phone's darwin partition.  volume < 0: the first
+ * that has a root directory.
+ */
+static int
+apfs_mount_common(mount_t mp, vnode_t devvp, vfs_context_t ctx, uint32_t container, int volume)
+{
+	struct apfs_mount *am;
+	struct apfs_devctx *dc;
+	struct apfs_dev dev;
+	struct vfsstatfs *sp;
+	uint32_t devblock = 0;
+	uint64_t devblocks = 0, nx_size = 0;
+	int error;
+
+	if (VNOP_IOCTL(devvp, DKIOCGETBLOCKSIZE, (caddr_t)&devblock, 0, ctx) != 0 ||
+	    devblock == 0 || (APFS_META_CHUNK % devblock) != 0) {
+		return EINVAL;
+	}
+	(void)VNOP_IOCTL(devvp, DKIOCGETBLOCKCOUNT, (caddr_t)&devblocks, 0, ctx);
+
+	am = kalloc_type(struct apfs_mount, Z_WAITOK | Z_ZERO);
+	if (am == NULL) {
+		return ENOMEM;
+	}
+	lck_mtx_init(&am->am_lock, &apfs_lck_grp, LCK_ATTR_NULL);
+	lck_spin_init(&am->am_iobuf_spin, &apfs_lck_grp, LCK_ATTR_NULL);
+	lck_spin_init(&am->am_procs_spin, &apfs_lck_grp, LCK_ATTR_NULL);
+	{
+		uint32_t ubc = 1;
+
+		(void)PE_parse_boot_argn("apfs_ubc_read", &ubc, sizeof(ubc));
+		am->am_ubc_read = (ubc != 0);
+	}
+	am->am_procs = kalloc_data(APFS_LOCK_PROCS * sizeof(am->am_procs[0]), Z_WAITOK | Z_ZERO);
+	am->am_mp = mp;
+	am->am_devvp = devvp;
+	am->am_devblock = devblock;
+
+	dc = kalloc_type(struct apfs_devctx, Z_WAITOK | Z_ZERO);
+	if (dc == NULL) {
+		apfs_free_mount(am);
+		return ENOMEM;
+	}
+	dc->dc_devvp = devvp;
+	dc->dc_devblock = devblock;
+	{
+		uint8_t *sb = kalloc_data(APFS_META_CHUNK, Z_WAITOK);
+		uint64_t devsize = devblocks * (uint64_t)devblock;
+		uint32_t i;
+
+		error = (sb == NULL) ? ENOMEM : 0;
+		for (i = 0; error == 0; i++) {
+			uint32_t bs;
+			uint64_t bc;
+
+			error = apfs_dev_read(dc, 0, sb, APFS_META_CHUNK);
+			if (error == 0 && memcmp(sb + 32, "NXSB", 4) != 0) {
+				error = EINVAL;         /* (no container here: as the root, the next filesystem's turn) */
+			}
+			if (error) {
+				break;
+			}
+			bs = (uint32_t)sb[36] | (uint32_t)sb[37] << 8 | (uint32_t)sb[38] << 16 | (uint32_t)sb[39] << 24;
+			bc = 0;
+			for (int b = 7; b >= 0; b--) {
+				bc = (bc << 8) | sb[40 + b];
+			}
+			nx_size = bc * bs;
+			if (bs < 4096 || bc == 0 || (nx_size % devblock) != 0 ||
+			    (devsize != 0 && dc->dc_base + nx_size > devsize)) {
+				printf("apfs: container %u: %llu blocks of %u do not fit the device\n", i,
+				    (unsigned long long)bc, bs);
+				error = EINVAL;
+				break;
+			}
+			if (i == container) {
+				break;
+			}
+			dc->dc_base += nx_size;
+		}
+		if (sb != NULL) {
+			kfree_data(sb, APFS_META_CHUNK);
+		}
+		if (error) {
+			kfree_type(struct apfs_devctx, dc);
+			apfs_free_mount(am);
+			return error;
+		}
+	}
+
+	bzero(&dev, sizeof(dev));
+	dev.ctx = dc;
+	dev.size = nx_size;
+	dev.read = apfs_dev_read;
+	dev.read_data = apfs_dev_read_data;
+
+	error = apfs_nx_open(&am->am_nx, &dev);
+	if (error) {
+		/*
+		 * EINVAL means the magic was not there, so this is not an APFS container at
+		 * all: as the root filesystem that lets vfs_mountroot() try the next one
+		 * without a word.
+		 */
+		if (error != EINVAL) {
+			printf("apfs: cannot read the container: %d\n", error);
+		}
+		kfree_type(struct apfs_devctx, dc);
+		apfs_free_mount(am);
+		return error;
+	}
+
+	/* apfs_nx_open() starts from a clean slate, so the lock is handed over only now */
+	am->am_nx.unlock = apfs_lib_unlock;
+	am->am_nx.relock = apfs_lib_relock;
+	am->am_nx.lock_ctx = am;
+	am->am_iobuf_size = APFS_IOBUF_DEFAULT;
+	{
+		uint32_t round = 0;
+
+		if (PE_parse_boot_argn("apfs_round", &round, sizeof(round)) &&
+		    round >= 64 * 1024 && round <= APFS_IOBUF_MAX && (round % (64 * 1024)) == 0) {
+			am->am_iobuf_size = round;
+		}
+	}
+	(void)PE_parse_boot_argn("apfs_meta_cluster", &am->am_nx.meta_cluster,
+	    sizeof(am->am_nx.meta_cluster));
+	/*
+	 * The phone's flash and QEMU's virtio disk cost tens of microseconds a request; this
+	 * port's other disks (md, the resident image; rsp, part of an image) answer with a
+	 * memory copy.  Boot-arg apfs_cheap=0/1 says otherwise.
+	 */
+	{
+		dev_t rdev = vnode_specrdev(devvp);
+		uint32_t cheap;
+
+#if defined(FUXI)
+		/* Fuxi: the root is a file on UFS flash (FuxiRoot27). */
+		am->am_nx.cheap_requests = false;
+#else
+		am->am_nx.cheap_requests = !redwood_ufs_dev(rdev) && !redwood_virtio_blk_dev(rdev);
+#endif
+		if (PE_parse_boot_argn("apfs_cheap", &cheap, sizeof(cheap))) {
+			am->am_nx.cheap_requests = (cheap != 0);
+		}
+		printf("apfs: device %d,%d: requests to it %s\n", major(rdev), minor(rdev),
+		    am->am_nx.cheap_requests ? "cost next to nothing (a disk in memory)" :
+		    "are worth putting together");
+	}
+	apfs_pool_start();
+	if (apfs_pool_threads > 0) {
+		am->am_nx.parallel = apfs_parallel;
+		am->am_nx.parallel_max = apfs_pool_threads + 1;
+	}
+
+	/* the first volume that has a root directory */
+	{
+		uint32_t i;
+		bool got = false;
+
+		/* with the lock, as every call into apfs_lib from now on (it may let go of it) */
+		apfs_lock(am);
+		for (i = 0; i < APFS_NX_MAX_FILE_SYSTEMS && !got; i++) {
+			struct apfs_inode ino;
+
+			if (am->am_nx.fs_oid[i] == 0 || (volume >= 0 && i != (uint32_t)volume)) {
+				continue;
+			}
+			if (apfs_vol_open(&am->am_nx, i, &am->am_vol) != 0) {
+				continue;
+			}
+			if (apfs_inode_get(&am->am_vol, APFS_ROOT_DIR_INO_NUM, &ino) == 0) {
+				got = true;
+			}
+		}
+		apfs_unlock(am);
+		if (!got) {
+			printf("apfs: no readable volume with a root directory\n");
+			kfree_type(struct apfs_devctx, dc);
+			apfs_free_mount(am);
+			return EINVAL;
+		}
+	}
+	am->am_root_id = APFS_ROOT_DIR_INO_NUM;
+
+	vfs_setfsprivate(mp, am);
+	vfs_setflags(mp, MNT_RDONLY | MNT_LOCAL);
+	vfs_setlocklocal(mp);
+
+	sp = vfs_statfs(mp);
+	sp->f_bsize = am->am_nx.block_size;
+	sp->f_iosize = am->am_nx.block_size;
+	sp->f_blocks = am->am_nx.block_count;
+	sp->f_bfree = 0;
+	sp->f_bavail = 0;
+	sp->f_bused = am->am_vol.alloc_count;
+	sp->f_files = am->am_vol.num_files + am->am_vol.num_dirs;
+	sp->f_ffree = 0;
+	/* (several volumes of one device are told apart by which container and volume) */
+	sp->f_fsid.val[0] = (int32_t)vnode_specrdev(devvp);
+	sp->f_fsid.val[1] = (int32_t)((vfs_typenum(mp) & 0xff) | (container << 8) | (am->am_vol.index << 20));
+	strlcpy(sp->f_fstypename, "apfs", sizeof(sp->f_fstypename));
+
+	apfs_the_mount = am;
+	am->am_rdev = vnode_specrdev(devvp);
+	lck_mtx_lock(&apfs_pool_lock);
+	am->am_next = apfs_mounts;
+	apfs_mounts = am;
+	lck_mtx_unlock(&apfs_pool_lock);
+	printf("apfs: volume %u \"%s\" of container %u (at %llu MB): %llu files, %llu directories, %llu blocks of %u used\n",
+	    am->am_vol.index, am->am_vol.name, container, (unsigned long long)(dc->dc_base >> 20), (unsigned long long)am->am_vol.num_files,
+	    (unsigned long long)am->am_vol.num_dirs,
+	    (unsigned long long)am->am_vol.alloc_count, am->am_nx.block_size);
+	return 0;
+}
+
+/*
+ * As the root filesystem: EINVAL lets vfs_mountroot() try the next quietly.  Boot-args
+ * apfs_root_c=N and apfs_root_v=M say which container of the device and which volume of it
+ * (default: the first container, its first volume with a root directory).
+ */
+int
+apfs_mountroot(mount_t mp, vnode_t devvp, vfs_context_t ctx)
+{
+	uint32_t c = 0;
+	int v = -1;
+
+	(void)PE_parse_boot_argn("apfs_root_c", &c, sizeof(c));
+	(void)PE_parse_boot_argn("apfs_root_v", &v, sizeof(v));
+	return apfs_mount_common(mp, devvp, ctx, c, v);
+}
+
+/*
+ * mount(2), and kernel_mount().  The mount data is the path of the block device holding
+ * the container, as a string.  VFS does not resolve it for us the way it does for a
+ * filesystem marked VFC_VFSLOCALARGS -- see the note in vfs_conf.c for why this one is
+ * not -- so it is looked up and opened here, and closed again in apfs_unmount().
+ */
+static int
+apfs_mount(mount_t mp, vnode_t devvp, user_addr_t data, vfs_context_t ctx)
+{
+	char *path;
+	vnode_t vp = NULLVP;
+	size_t len = 0;
+	uint32_t container = 0;
+	int volume = -1;
+	int error;
+
+	if (vfs_isupdate(mp)) {
+		/* nothing about a mounted volume can change, least of all to read-write */
+		return vfs_iswriteupgrade(mp) ? EROFS : 0;
+	}
+	if (devvp != NULLVP) {
+		/* mounted as the root: VFS found the device and owns the vnode */
+		return apfs_mountroot(mp, devvp, ctx);
+	}
+	if (data == USER_ADDR_NULL) {
+		return EINVAL;
+	}
+	path = kalloc_data(MAXPATHLEN, Z_WAITOK);
+	if (path == NULL) {
+		return ENOMEM;
+	}
+	if (vfs_iskernelmount(mp)) {
+		/* kernel_mount() hands the pointer through untouched */
+		error = (strlcpy(path, CAST_DOWN(char *, data), MAXPATHLEN) < MAXPATHLEN)
+		    ? 0 : ENAMETOOLONG;
+	} else {
+		error = copyinstr(data, path, MAXPATHLEN, &len);
+	}
+	/* "DEVICE[,c=N][,v=M]": the container (from 0) and the volume (by index) */
+	if (error == 0) {
+		char *opt = strchr(path, ',');
+
+		while (opt != NULL) {
+			char *next = strchr(opt + 1, ',');
+
+			*opt = '\0';
+			if (strncmp(opt + 1, "c=", 2) == 0) {
+				container = (uint32_t)strtoul(opt + 3, NULL, 10);
+			} else if (strncmp(opt + 1, "v=", 2) == 0) {
+				volume = (int)strtoul(opt + 3, NULL, 10);
+			} else {
+				error = EINVAL;
+			}
+			opt = next;
+		}
+	}
+	if (error == 0) {
+		error = vnode_lookup(path, 0, &vp, ctx);
+	}
+	if (error == 0 && !vnode_isblk(vp)) {
+		error = ENOTBLK;
+	}
+	if (error == 0) {
+		bool shared = false;
+
+		error = VNOP_OPEN(vp, FREAD, ctx);
+		if (error == EBUSY && apfs_device_held(vnode_specrdev(vp))) {
+			/*
+			 * Mounted already -- by us, another container of it (the root's RAM disk and the
+			 * cryptex after the boot volume): read through it as it is open, not opened
+			 * again.  Anything else mounted on a device stays EBUSY.
+			 */
+			shared = true;
+			error = 0;
+		}
+		if (error == 0) {
+			/*
+			 * The iocount from the lookup is kept for as long as the volume is
+			 * mounted; apfs_unmount() closes and drops it.
+			 */
+			error = apfs_mount_common(mp, vp, ctx, container, volume);
+			if (error == 0) {
+				APFS_MP(mp)->am_owns_devvp = true;
+				APFS_MP(mp)->am_shares_devvp = shared;
+				/* what mount(8) and df show as where it came from */
+				if (vfs_statfs(mp)->f_mntfromname[0] == '\0' || container != 0 || volume >= 0) {
+					char opts[40] = "";
+
+					if (container != 0) {
+						snprintf(opts, sizeof(opts), ",c=%u", container);
+					}
+					if (volume >= 0) {
+						snprintf(opts + strlen(opts), sizeof(opts) - strlen(opts), ",v=%d", volume);
+					}
+					snprintf(vfs_statfs(mp)->f_mntfromname, MAXPATHLEN, "%s%s", path, opts);
+				}
+			} else if (!shared) {
+				(void)VNOP_CLOSE(vp, FREAD, ctx);
+			}
+		}
+		if (error != 0) {
+			vnode_put(vp);
+		}
+	} else if (vp != NULLVP) {
+		vnode_put(vp);
+	}
+	kfree_data(path, MAXPATHLEN);
+	return error;
+}
+
+static int
+apfs_unmount(mount_t mp, int mntflags, vfs_context_t ctx)
+{
+	struct apfs_mount *am = APFS_MP(mp);
+	int error = vflush(mp, NULLVP, (mntflags & MNT_FORCE) ? FORCECLOSE : 0);
+
+	if (error) {
+		return error;
+	}
+	if (apfs_the_mount == am) {
+		apfs_the_mount = NULL;
+	}
+	lck_mtx_lock(&apfs_pool_lock);
+	for (struct apfs_mount **pp = &apfs_mounts; *pp != NULL; pp = &(*pp)->am_next) {
+		if (*pp == am) {
+			*pp = am->am_next;
+			break;
+		}
+	}
+	lck_mtx_unlock(&apfs_pool_lock);
+	vfs_setfsprivate(mp, NULL);
+	if (am->am_owns_devvp && am->am_devvp != NULLVP) {
+		if (!am->am_shares_devvp) {
+			(void)VNOP_CLOSE(am->am_devvp, FREAD, ctx);
+		}
+		vnode_put(am->am_devvp);
+	}
+	apfs_free_mount(am);
+	return 0;
+}
+
+static int
+apfs_root(mount_t mp, vnode_t *vpp, __unused vfs_context_t ctx)
+{
+	struct apfs_mount *am = APFS_MP(mp);
+
+	return apfs_node_vnode(am, am->am_root_id, NULLVP, NULL, vpp);
+}
+
+static int
+apfs_vget(mount_t mp, ino64_t ino, vnode_t *vpp, __unused vfs_context_t ctx)
+{
+	return apfs_node_vnode(APFS_MP(mp), (uint64_t)ino, NULLVP, NULL, vpp);
+}
+
+static int
+apfs_vfs_getattr(mount_t mp, struct vfs_attr *fsap, __unused vfs_context_t ctx)
+{
+	struct apfs_mount *am = APFS_MP(mp);
+	uint64_t files = am->am_vol.num_files + am->am_vol.num_dirs;
+
+	VFSATTR_RETURN(fsap, f_objcount, files);
+	VFSATTR_RETURN(fsap, f_bsize, am->am_nx.block_size);
+	VFSATTR_RETURN(fsap, f_iosize, am->am_nx.block_size);
+	VFSATTR_RETURN(fsap, f_blocks, am->am_nx.block_count);
+	VFSATTR_RETURN(fsap, f_bfree, 0);
+	VFSATTR_RETURN(fsap, f_bavail, 0);
+	VFSATTR_RETURN(fsap, f_bused, am->am_vol.alloc_count);
+	VFSATTR_RETURN(fsap, f_files, files);
+	VFSATTR_RETURN(fsap, f_ffree, 0);
+
+	if (VFSATTR_IS_ACTIVE(fsap, f_capabilities)) {
+		vol_capabilities_attr_t *cap = &fsap->f_capabilities;
+		bool nocase = (am->am_vol.incompat & APFS_INCOMPAT_CASE_INSENSITIVE) != 0;
+
+		bzero(cap, sizeof(*cap));
+		/*
+		 * An object's identifier never changes and apfs_vget() finds an object by it,
+		 * which is what lets fsgetpath(2) and /.vol work for this volume: without it,
+		 * what asks for a file's path by its identifier (LaunchServices among them) gets
+		 * nothing.
+		 */
+		cap->capabilities[VOL_CAPABILITIES_FORMAT] =
+		    VOL_CAP_FMT_PERSISTENTOBJECTIDS |
+		    VOL_CAP_FMT_SYMBOLICLINKS |
+		    VOL_CAP_FMT_HARDLINKS |
+		    VOL_CAP_FMT_SPARSE_FILES |
+		    VOL_CAP_FMT_CASE_PRESERVING |
+		    VOL_CAP_FMT_FAST_STATFS |
+		    VOL_CAP_FMT_2TB_FILESIZE |
+		    VOL_CAP_FMT_PATH_FROM_ID |
+		    (nocase ? 0 : VOL_CAP_FMT_CASE_SENSITIVE);
+		cap->capabilities[VOL_CAPABILITIES_INTERFACES] =
+		    VOL_CAP_INT_ADVLOCK |
+		    VOL_CAP_INT_FLOCK |
+		    VOL_CAP_INT_EXTENDED_ATTR;
+		cap->valid[VOL_CAPABILITIES_FORMAT] =
+		    VOL_CAP_FMT_PERSISTENTOBJECTIDS |
+		    VOL_CAP_FMT_SYMBOLICLINKS |
+		    VOL_CAP_FMT_HARDLINKS |
+		    VOL_CAP_FMT_JOURNAL |
+		    VOL_CAP_FMT_JOURNAL_ACTIVE |
+		    VOL_CAP_FMT_SPARSE_FILES |
+		    VOL_CAP_FMT_ZERO_RUNS |
+		    VOL_CAP_FMT_CASE_SENSITIVE |
+		    VOL_CAP_FMT_CASE_PRESERVING |
+		    VOL_CAP_FMT_FAST_STATFS |
+		    VOL_CAP_FMT_2TB_FILESIZE |
+		    VOL_CAP_FMT_HIDDEN_FILES |
+		    VOL_CAP_FMT_PATH_FROM_ID;
+		cap->valid[VOL_CAPABILITIES_INTERFACES] =
+		    VOL_CAP_INT_ADVLOCK |
+		    VOL_CAP_INT_FLOCK |
+		    VOL_CAP_INT_EXTENDED_ATTR;
+		VFSATTR_SET_SUPPORTED(fsap, f_capabilities);
+	}
+	if (VFSATTR_IS_ACTIVE(fsap, f_vol_name)) {
+		strlcpy(fsap->f_vol_name, am->am_vol.name, MAXPATHLEN);
+		VFSATTR_SET_SUPPORTED(fsap, f_vol_name);
+	}
+	if (VFSATTR_IS_ACTIVE(fsap, f_uuid)) {
+		memcpy(fsap->f_uuid, am->am_nx.uuid, sizeof(fsap->f_uuid));
+		VFSATTR_SET_SUPPORTED(fsap, f_uuid);
+	}
+	return 0;
+}
+
+/* Nothing is ever dirty. */
+static int
+apfs_sync(__unused mount_t mp, __unused int waitfor, __unused vfs_context_t ctx)
+{
+	return 0;
+}
+
+static int
+apfs_init(__unused struct vfsconf *vfsc)
+{
+	return 0;
+}
+
+struct vfsops apfs_vfsops = {
+	.vfs_mount = apfs_mount,
+	.vfs_unmount = apfs_unmount,
+	.vfs_root = apfs_root,
+	.vfs_getattr = apfs_vfs_getattr,
+	.vfs_sync = apfs_sync,
+	.vfs_vget = apfs_vget,
+	.vfs_init = apfs_init,
+};
diff --git a/bsd/miscfs/apfs/apfs_vnops.c b/bsd/miscfs/apfs/apfs_vnops.c
new file mode 100644
--- /dev/null
+++ b/bsd/miscfs/apfs/apfs_vnops.c
@@ -0,0 +1,1271 @@
+/*
+ * apfs vnode operations.  Read only; see apfs.h.
+ *
+ * Every call into apfs_lib is made under the mount's lock, because apfs_lib hands out
+ * pointers into its own block cache and its cursors carry no locking.
+ */
+
+#include <kern/kalloc.h>
+#include <libkern/OSAtomic.h>
+#include <libkern/libkern.h>
+#include <miscfs/apfs/apfs.h>
+#include <sys/attr.h>
+#include <sys/dirent.h>
+#include <sys/errno.h>
+#include <sys/namei.h>
+#include <sys/stat.h>
+#include <sys/systm.h>
+#include <sys/ubc.h>
+#include <sys/uio.h>
+#include <sys/mount_internal.h>
+#include <sys/unistd.h>
+#include <sys/vnode_internal.h>
+#include <sys/xattr.h>
+#include <os/atomic_private.h>
+#include <vfs/vfs_support.h>
+
+/* How much is read out of a file at a time when copying into a uio. */
+
+extern integer_t thread_kern_get_pri(thread_t thr);    /* the thread's base priority */
+#if defined(FUXI)
+/* Fuxi: the HakiOS kernel's per-thread runnable/run clocks are not here; the lock statistics read zero. */
+static inline void
+thread_runnable_and_run_self(uint64_t *runnable, uint64_t *run)
+{
+	*runnable = 0;
+	*run = 0;
+}
+#else
+extern void thread_runnable_and_run_self(uint64_t *runnable, uint64_t *run);
+#endif
+
+/* The statistics of the calling process (with the lock held) */
+static struct apfs_lock_proc *
+lock_proc(struct apfs_mount *am)
+{
+	static struct apfs_lock_proc nowhere;   /* (no table: counted, and never shown) */
+	struct apfs_lock_proc *lp;
+	char name[MAXCOMLEN + 1];
+	uint32_t i;
+
+	if (am->am_procs == NULL) {
+		return &nowhere;
+	}
+	proc_selfname(name, sizeof(name));
+	lck_spin_lock(&am->am_procs_spin);
+	for (i = 0; i < am->am_nprocs; i++) {
+		if (strncmp(am->am_procs[i].name, name, sizeof(name)) == 0) {
+			lp = &am->am_procs[i];
+			goto out;
+		}
+	}
+	if (am->am_nprocs < APFS_LOCK_PROCS - 1) {
+		strlcpy(am->am_procs[am->am_nprocs].name, name, sizeof(name));
+		lp = &am->am_procs[am->am_nprocs++];
+		goto out;
+	}
+	if (am->am_nprocs == APFS_LOCK_PROCS - 1) {
+		strlcpy(am->am_procs[am->am_nprocs].name, "(the rest)", sizeof(name));
+		am->am_nprocs++;
+	}
+	lp = &am->am_procs[APFS_LOCK_PROCS - 1];
+out:
+	lck_spin_unlock(&am->am_procs_spin);
+	return lp;
+}
+
+/* The statistics of a caller of apfs_lock (with the lock held) */
+static struct apfs_lock_site *
+lock_site(struct apfs_mount *am, const char *name)
+{
+	uint32_t i;
+
+	for (i = 0; i < APFS_LOCK_SITES && am->am_sites[i].name != NULL; i++) {
+		if (am->am_sites[i].name == name) {
+			return &am->am_sites[i];
+		}
+	}
+	if (i == APFS_LOCK_SITES) {
+		i = APFS_LOCK_SITES - 1;        /* (more callers than kept: the last one takes the rest) */
+	} else {
+		am->am_sites[i].name = name;
+	}
+	return &am->am_sites[i];
+}
+
+/* The lock taken, by site: how long it was waited for, how many others were waiting */
+static void
+lock_take(struct apfs_mount *am, const char *site, bool relock)
+{
+	static uint64_t limits[4];
+	uint64_t t0 = apfs_ticks(), waited, long_wait, runnable0, run0;
+	uint32_t others = os_atomic_inc_orig(&am->am_lock_waiting, relaxed);
+	struct apfs_lock_site *ls;
+	unsigned k;
+
+	if (limits[3] == 0) {
+		nanoseconds_to_absolutetime(2000, &limits[0]);
+		nanoseconds_to_absolutetime(10000, &limits[1]);
+		nanoseconds_to_absolutetime(100000, &limits[2]);
+		nanoseconds_to_absolutetime(1000000, &limits[3]);
+	}
+	thread_runnable_and_run_self(&runnable0, &run0);
+	lck_mtx_lock(&am->am_lock);
+	os_atomic_dec(&am->am_lock_waiting, relaxed);
+	waited = apfs_ticks() - t0;
+	long_wait = limits[3];
+	/* (the holder's own: no atomics needed) */
+	am->am_lock_wait_ticks += waited;
+	am->am_lock_waits++;
+	for (k = 0; k < 4 && waited >= limits[k]; k++) {
+	}
+	am->am_lock_wait_hist[k]++;
+	if (waited > am->am_lock_wait_max) {
+		am->am_lock_wait_max = waited;
+	}
+	am->am_waiters_hist[others == 0 ? 0 : others == 1 ? 1 : others <= 3 ? 2 : others <= 7 ? 3 : 4]++;
+	{
+		int pri = thread_kern_get_pri(current_thread());
+		unsigned b = pri <= 4 ? 0 : pri <= 20 ? 1 : pri <= 31 ? 2 : pri <= 46 ? 3 : 4;
+
+		am->am_prio_wait[b] += waited;
+		if (waited >= limits[3]) {
+			uint64_t runnable, run;
+
+			am->am_prio_long[b]++;
+			am->am_prio_long_wait[b] += waited;
+			/* where the time went: runnable includes running, and the rest was blocked */
+			thread_runnable_and_run_self(&runnable, &run);
+			runnable -= runnable0;
+			run -= run0;
+			am->am_long_blocked[b] += waited > runnable ? waited - runnable : 0;
+			am->am_long_queued[b] += runnable > run ? runnable - run : 0;
+			am->am_long_oncpu[b] += run;
+			am->am_long_cpu[cpu_number() & 7]++;
+		}
+	}
+	if (waited >= limits[1]) {
+		struct apfs_lock_proc *lp = lock_proc(am);
+
+		lp->waits++;
+		lp->wait += waited;
+		if (waited > lp->wait_max) {
+			lp->wait_max = waited;
+		}
+		lp->wait_long += waited >= limits[3];
+	}
+	if (relock) {
+		/* apfs_lib taking it back in the middle of an operation: the operation's */
+		thread_t self = current_thread();
+		uint32_t i;
+
+		site = "apfs_lib";
+		for (i = 0; i < am->am_nops; i++) {
+			if (am->am_ops[i].th == self) {
+				site = am->am_ops[i].site;
+				break;
+			}
+		}
+	}
+	ls = lock_site(am, site);
+	if (relock) {
+		ls->relocks++;
+	} else {
+		ls->takes++;
+	}
+	ls->wait += waited;
+	if (waited > ls->wait_max) {
+		ls->wait_max = waited;
+	}
+	ls->wait_long += waited >= long_wait;
+	am->am_lock_site = site;
+	am->am_lock_t0 = apfs_ticks();
+}
+
+void
+apfs_lock_inner(struct apfs_mount *am)
+{
+	lock_take(am, NULL, true);
+}
+
+void
+apfs_unlock_inner(struct apfs_mount *am)
+{
+	static uint64_t limits[4];
+	uint64_t held = apfs_ticks() - am->am_lock_t0;
+	struct apfs_lock_site *ls;
+	unsigned k;
+
+	if (limits[3] == 0) {
+		nanoseconds_to_absolutetime(10000, &limits[0]);
+		nanoseconds_to_absolutetime(100000, &limits[1]);
+		nanoseconds_to_absolutetime(1000000, &limits[2]);
+		nanoseconds_to_absolutetime(10000000, &limits[3]);
+	}
+	am->am_lock_held_ticks += held;
+	for (k = 0; k < 4 && held >= limits[k]; k++) {
+	}
+	am->am_lock_hold_hist[k]++;
+	if (held > am->am_lock_hold_max) {
+		am->am_lock_hold_max = held;
+	}
+	if (am->am_lock_site != NULL) {
+		ls = lock_site(am, am->am_lock_site);
+		ls->hold += held;
+		if (held > ls->hold_max) {
+			ls->hold_max = held;
+		}
+		ls->hold_long += held >= limits[2];
+	}
+	lck_mtx_unlock(&am->am_lock);
+}
+
+/* An operation begins: the lock, and the epoch it began at noted */
+void
+apfs_lock_at(struct apfs_mount *am, const char *site)
+{
+	lock_take(am, site, false);
+	if (am->am_nops < APFS_OPS_MAX) {
+		am->am_ops[am->am_nops].th = current_thread();
+		am->am_ops[am->am_nops].epoch = am->am_nx.epoch;
+		am->am_ops[am->am_nops].site = site;
+		am->am_nops++;
+	} else {
+		am->am_untracked++;
+	}
+}
+
+/* An operation ends: what nobody still going can be reading is freed, and the lock let go of */
+void
+apfs_unlock(struct apfs_mount *am)
+{
+	thread_t self = current_thread();
+	uint64_t oldest = am->am_nx.epoch;
+	uint32_t i;
+	bool found = false;
+
+	for (i = 0; i < am->am_nops; i++) {
+		if (!found && am->am_ops[i].th == self) {
+			am->am_ops[i] = am->am_ops[--am->am_nops];
+			found = true;
+			if (i == am->am_nops) {
+				break;
+			}
+		}
+		if (am->am_ops[i].epoch < oldest) {
+			oldest = am->am_ops[i].epoch;
+		}
+	}
+	if (!found && am->am_untracked > 0) {
+		am->am_untracked--;
+	}
+	if (am->am_untracked == 0 && am->am_nx.retired != NULL) {
+		apfs_nx_reclaim(&am->am_nx, oldest);
+	}
+	apfs_unlock_inner(am);
+}
+
+/* The inode record of the object a vnode stands for. */
+static int
+apfs_vp_inode(vnode_t vp, struct apfs_inode *ino)
+{
+	struct apfs_node *an = APFS_VP(vp);
+
+	return apfs_inode_get(&an->an_mount->am_vol, an->an_id, ino);
+}
+
+/* ------------------------------------------------------------------ lookup */
+
+static int
+apfs_vnop_lookup(struct vnop_lookup_args *ap)
+{
+	vnode_t dvp = ap->a_dvp;
+	struct componentname *cnp = ap->a_cnp;
+	struct apfs_mount *am = APFS_VP_MOUNT(dvp);
+	struct apfs_node *dn = APFS_VP(dvp);
+	uint64_t id = 0;
+	uint8_t dt = 0;
+	int error;
+
+	*ap->a_vpp = NULLVP;
+	if (!vnode_isdir(dvp)) {
+		return ENOTDIR;
+	}
+	if (cnp->cn_namelen == 1 && cnp->cn_nameptr[0] == '.') {
+		error = vnode_get(dvp);
+		if (error == 0) {
+			*ap->a_vpp = dvp;
+		}
+		return error;
+	}
+	if (cnp->cn_flags & ISDOTDOT) {
+		return apfs_node_vnode(am, dn->an_parent, NULLVP, NULL, ap->a_vpp);
+	}
+
+	/*
+	 * The name cache first, as a file system's lookup is to ask it (namei's own quick path
+	 * leaves the entries for names that are not there to us): -1, the vnode, with an iocount;
+	 * ENOENT, known not to be there (for a CREATE or RENAME it says 0 and forgets the entry).
+	 */
+	error = cache_lookup(dvp, ap->a_vpp, cnp);
+	if (error == -1) {
+		os_atomic_inc(&am->am_lookup_positive_hits, relaxed);
+		return 0;
+	}
+	if (error == ENOENT) {
+		os_atomic_inc(&am->am_lookup_negative_hits, relaxed);
+		return ENOENT;
+	}
+
+	apfs_lock(am);
+	if (dn->an_id >= APFS_SYNTH_BASE) {
+		error = ENOENT;                 /* nothing of a synthetic directory is on the volume */
+	} else {
+		error = apfs_lookup(&am->am_vol, dn->an_id, cnp->cn_nameptr,
+		    (size_t)cnp->cn_namelen, &id, &dt);
+	}
+	if (error == ENOENT && am->am_nsynth > 0) {
+		const struct apfs_synth *sy = apfs_synth_find(am, dn->an_id, cnp->cn_nameptr,
+		    (size_t)cnp->cn_namelen);
+
+		if (sy != NULL) {
+			id = sy->id;
+			error = 0;
+		}
+	}
+	apfs_unlock(am);
+	/*
+	 * What is there is found whatever the caller means to do with it -- VFS refuses the
+	 * change itself on a read-only mount, and mkdir of a directory that exists is to fail
+	 * with EEXIST, not EROFS (xpcproxy gives up on the latter).  Only a name that is not
+	 * there and is to be made is refused here.
+	 */
+	if (error == ENOENT && (cnp->cn_flags & ISLASTCN) &&
+	    (cnp->cn_nameiop == CREATE || cnp->cn_nameiop == RENAME)) {
+		return EROFS;
+	}
+	/*
+	 * A name that is not there stays not there (the volume cannot change; a synthetic
+	 * directory added later purges its parent's entries): the name cache says so from now on,
+	 * instead of asking again -- iOS asks for missing files thousands of times after a boot.
+	 */
+	if (error == ENOENT && cnp->cn_nameiop == LOOKUP && (cnp->cn_flags & MAKEENTRY)) {
+		cache_enter(dvp, NULLVP, cnp);
+		os_atomic_inc(&am->am_lookup_negative, relaxed);
+	}
+	if (error) {
+		return error;
+	}
+	return apfs_node_vnode(am, id, dvp, cnp, ap->a_vpp);
+}
+
+/* ------------------------------------------------------------------ attributes */
+
+static int
+apfs_vnop_getattr(struct vnop_getattr_args *ap)
+{
+	vnode_t vp = ap->a_vp;
+	struct vnode_attr *vap = ap->a_vap;
+	struct apfs_mount *am = APFS_VP_MOUNT(vp);
+	struct apfs_node *an = APFS_VP(vp);
+	struct apfs_inode ino;
+	uint64_t size = 0;
+	int error;
+
+	ino = an->an_ino;
+	size = an->an_size;
+
+	VATTR_RETURN(vap, va_rdev, (dev_t)ino.rdev);
+	VATTR_RETURN(vap, va_nlink, vnode_isdir(vp) ? 2 : (uint32_t)(ino.nchildren > 0
+	    ? ino.nchildren : 1));
+	VATTR_RETURN(vap, va_data_size, size);
+	VATTR_RETURN(vap, va_total_size, size);
+	VATTR_RETURN(vap, va_total_alloc, ino.alloced_size);
+	VATTR_RETURN(vap, va_data_alloc, ino.alloced_size);
+	VATTR_RETURN(vap, va_iosize, am->am_nx.block_size);
+	VATTR_RETURN(vap, va_uid, ino.owner);
+	VATTR_RETURN(vap, va_gid, ino.group);
+	VATTR_RETURN(vap, va_mode, ino.mode & 07777);
+	VATTR_RETURN(vap, va_flags, ino.bsd_flags);
+	VATTR_RETURN(vap, va_fileid, an->an_id);
+	VATTR_RETURN(vap, va_linkid, an->an_id);
+	VATTR_RETURN(vap, va_parentid, ino.parent_id);
+	VATTR_RETURN(vap, va_fsid, (uint32_t)vfs_statfs(am->am_mp)->f_fsid.val[0]);
+	VATTR_RETURN(vap, va_filerev, 0);
+	VATTR_RETURN(vap, va_gen, 0);
+	VATTR_RETURN(vap, va_type, vnode_vtype(vp));
+
+	/* the times are nanoseconds since the Unix epoch */
+	if (VATTR_IS_ACTIVE(vap, va_access_time)) {
+		vap->va_access_time.tv_sec = (long)(ino.access_time / 1000000000ULL);
+		vap->va_access_time.tv_nsec = (long)(ino.access_time % 1000000000ULL);
+		VATTR_SET_SUPPORTED(vap, va_access_time);
+	}
+	if (VATTR_IS_ACTIVE(vap, va_modify_time)) {
+		vap->va_modify_time.tv_sec = (long)(ino.mod_time / 1000000000ULL);
+		vap->va_modify_time.tv_nsec = (long)(ino.mod_time % 1000000000ULL);
+		VATTR_SET_SUPPORTED(vap, va_modify_time);
+	}
+	if (VATTR_IS_ACTIVE(vap, va_change_time)) {
+		vap->va_change_time.tv_sec = (long)(ino.change_time / 1000000000ULL);
+		vap->va_change_time.tv_nsec = (long)(ino.change_time % 1000000000ULL);
+		VATTR_SET_SUPPORTED(vap, va_change_time);
+	}
+	if (VATTR_IS_ACTIVE(vap, va_create_time)) {
+		vap->va_create_time.tv_sec = (long)(ino.create_time / 1000000000ULL);
+		vap->va_create_time.tv_nsec = (long)(ino.create_time % 1000000000ULL);
+		VATTR_SET_SUPPORTED(vap, va_create_time);
+	}
+	return 0;
+}
+
+/* ------------------------------------------------------------------ reading */
+
+/*
+ * A buffer for one round of vnop_read: one of those kept, or a new one.  The kept ones have
+ * a lock of their own, so that a read takes am_lock only for the reading itself.
+ */
+static uint8_t *
+apfs_iobuf_get(struct apfs_mount *am)
+{
+	uint8_t *buf = NULL;
+
+	lck_spin_lock(&am->am_iobuf_spin);
+	if (am->am_iobuf_kept > 0) {
+		buf = am->am_iobuf[--am->am_iobuf_kept];
+	}
+	lck_spin_unlock(&am->am_iobuf_spin);
+	if (buf == NULL) {
+		buf = kalloc_data(am->am_iobuf_size, Z_WAITOK);
+	}
+	return buf;
+}
+
+static void
+apfs_iobuf_put(struct apfs_mount *am, uint8_t *buf)
+{
+	lck_spin_lock(&am->am_iobuf_spin);
+	if (am->am_iobuf_kept < APFS_IOBUF_KEEP) {
+		am->am_iobuf[am->am_iobuf_kept++] = buf;
+		buf = NULL;
+	}
+	lck_spin_unlock(&am->am_iobuf_spin);
+	if (buf != NULL) {
+		kfree_data(buf, am->am_iobuf_size);
+	}
+}
+
+/*
+ * read(2) through the page cache, as decmpfs reads a compressed HFS file
+ * (decmpfs_read_compressed): what the cache has is copied from it; for the rest the file's
+ * pages are taken in a UPL, the ones not valid yet read into it by apfs_read_file -- what
+ * pagein does -- and the UPL committed, so that the pages stay: the next read(2) of them
+ * finds them, and so does a mapping of the file, which is the same pages.  At least
+ * APFS_FILL_ALIGN at a time, aligned to it: a compressed file is kept in 64 KB pieces, and a
+ * piece decompressed for a small read would be decompressed again for the next one.
+ */
+#define APFS_FILL_ALIGN         (64 * 1024)
+#define APFS_FILL_MAX           (1024 * 1024)   /* at most this much in one UPL */
+/*
+ * A reader going through a file in order (it starts where the last read(2) of the file ended)
+ * is given more than it asked for, twice as much each time it comes to the end of what it was
+ * given, up to APFS_FILL_MAX: fewer UPLs, larger requests to the device.  The cluster layer
+ * does the same for a file system that uses it.
+ */
+
+/* [at, at + len) of the file into dst, as pagein reads it; past the end, zeros */
+static int
+apfs_fill(struct apfs_mount *am, vnode_t vp, struct apfs_inode *ino, uint64_t size, off_t at,
+    uint8_t *dst, size_t len, uint64_t *filled)
+{
+	int error = 0;
+
+	while (len > 0) {
+		size_t want, got = 0;
+
+		if ((uint64_t)at >= size) {
+			bzero(dst, len);
+			break;
+		}
+		want = (size_t)MIN((uint64_t)len, size - (uint64_t)at);
+		os_atomic_inc(&am->am_nx.requests, relaxed);
+		apfs_lock(am);
+		error = apfs_read_file(&am->am_vol, ino, &APFS_VP(vp)->an_cf, (uint64_t)at, dst, want, &got);
+		apfs_unlock(am);
+		os_atomic_dec(&am->am_nx.requests, relaxed);
+		if (error) {
+			break;
+		}
+		if (got == 0) {
+			bzero(dst, len);        /* (shorter than its size says: zeros, as pagein gives) */
+			break;
+		}
+		at += (off_t)got;
+		dst += got;
+		len -= got;
+		*filled += got;
+	}
+	return error;
+}
+
+static int
+apfs_read_cached(struct apfs_mount *am, vnode_t vp, struct uio *uio, struct apfs_inode *ino,
+    uint64_t size, uint64_t *cached, uint64_t *filled)
+{
+	int error = 0;
+
+	while (uio_resid(uio) > 0 && (uint64_t)uio_offset(uio) < size) {
+		uint64_t left = MIN((uint64_t)uio_resid(uio), size - (uint64_t)uio_offset(uio));
+		int count = (int)MIN(left, (uint64_t)INT_MAX), resid = count, copy, copy_resid, npages, i;
+		off_t pos, want_end, upl_pos, upl_end;
+		upl_page_info_t *pl = NULL;
+		vm_offset_t address = 0;
+		upl_t upl = NULL;
+		int upl_size;
+
+		/* what the cache has already, up to the first page it has not */
+		error = cluster_copy_ubc_data(vp, uio, &resid, 0);
+		*cached += (uint64_t)(count - resid);
+		if (error) {
+			break;
+		}
+		if (resid == 0) {
+			continue;
+		}
+
+		/* the rest: the pages from there, the missing ones read in */
+		pos = uio_offset(uio);
+		left = MIN((uint64_t)uio_resid(uio), size - (uint64_t)pos);
+		want_end = pos + (off_t)left;
+		upl_pos = pos & ~((off_t)APFS_FILL_ALIGN - 1);
+		upl_end = (want_end + APFS_FILL_ALIGN - 1) & ~((off_t)APFS_FILL_ALIGN - 1);
+		{
+			struct apfs_node *an = APFS_VP(vp);
+			uint32_t window = APFS_FILL_ALIGN;
+
+			/* (where this read(2) began: before what the cache gave it just now) */
+			if ((uint64_t)pos - (uint64_t)(count - resid) == os_atomic_load(&an->an_read_next, relaxed)) {
+				window = MIN(MAX(os_atomic_load(&an->an_read_window, relaxed) * 2,
+				    (uint32_t)APFS_FILL_ALIGN), (uint32_t)APFS_FILL_MAX);
+			}
+			os_atomic_store(&an->an_read_window, window, relaxed);
+			if (upl_end < upl_pos + (off_t)window) {
+				upl_end = upl_pos + (off_t)window;
+			}
+		}
+		if (upl_end > (off_t)round_page_64(size)) {
+			upl_end = (off_t)round_page_64(size);
+		}
+		if (upl_end - upl_pos > APFS_FILL_MAX) {
+			upl_end = upl_pos + APFS_FILL_MAX;
+		}
+		upl_size = (int)(upl_end - upl_pos);
+		if (ubc_create_upl_kernel(vp, upl_pos, upl_size, &upl, &pl, UPL_SET_LITE,
+		    VM_KERN_MEMORY_FILE) != KERN_SUCCESS || upl == NULL) {
+			error = EIO;
+			break;
+		}
+		if (ubc_upl_map(upl, &address) != KERN_SUCCESS || address == 0) {
+			ubc_upl_abort_range(upl, 0, (upl_size_t)upl_size, UPL_ABORT_FREE_ON_EMPTY);
+			error = EIO;
+			break;
+		}
+		npages = upl_size / PAGE_SIZE;
+		for (i = 0; i < npages && error == 0;) {
+			int j;
+
+			if (upl_valid_page(pl, i)) {
+				i++;
+				continue;
+			}
+			for (j = i + 1; j < npages && !upl_valid_page(pl, j); j++) {
+			}
+			error = apfs_fill(am, vp, ino, size, upl_pos + (off_t)i * PAGE_SIZE,
+			    (uint8_t *)address + (size_t)i * PAGE_SIZE, (size_t)(j - i) * PAGE_SIZE, filled);
+			i = j;
+		}
+		(void)ubc_upl_unmap(upl);
+		if (error) {
+			ubc_upl_abort_range(upl, 0, (upl_size_t)upl_size, UPL_ABORT_FREE_ON_EMPTY);
+			break;
+		}
+		/* out of the UPL what this read asked for; then the pages go into the cache */
+		copy = (int)(MIN(upl_end, want_end) - pos);
+		copy_resid = copy;
+		error = cluster_copy_upl_data(uio, upl, (int)(pos - upl_pos), &copy_resid);
+		ubc_upl_commit_range(upl, 0, (upl_size_t)upl_size, UPL_COMMIT_FREE_ON_EMPTY |
+		    UPL_COMMIT_INACTIVATE | UPL_COMMIT_CLEAR_DIRTY | UPL_COMMIT_WRITTEN_BY_KERNEL);
+		if (error) {
+			break;
+		}
+		if (copy_resid == copy) {
+			error = EIO;            /* (nothing copied: cannot happen, and must not loop) */
+			break;
+		}
+	}
+	return error;
+}
+
+/* read(2) the old way: into a buffer of the driver's and out of it, every time (apfs_ubc_read=0) */
+static int
+apfs_read_direct(struct vnop_read_args *ap)
+{
+	vnode_t vp = ap->a_vp;
+	struct uio *uio = ap->a_uio;
+	struct apfs_mount *am = APFS_VP_MOUNT(vp);
+	struct apfs_inode ino;
+	uint8_t *buf;
+	uint64_t size = 0;
+	uint64_t t0, read_bytes = 0;
+	struct apfs_lock_proc *lp = NULL;
+	int error = 0;
+
+	ino = APFS_VP(vp)->an_ino;
+	size = APFS_VP(vp)->an_size;
+	t0 = apfs_ticks();
+	if (uio_resid(uio) > 0 && (uint64_t)uio_offset(uio) < size) {
+		buf = apfs_iobuf_get(am);
+		if (buf == NULL) {
+			return ENOMEM;
+		}
+		/* (how many reads are going on: a hint to apfs_lib, kept without the lock) */
+		os_atomic_inc(&am->am_nx.requests, relaxed);
+		apfs_lock(am);
+		{
+			lp = lock_proc(am);
+			os_atomic_inc(&lp->read_calls, relaxed);
+			os_atomic_add(&lp->read_bytes,
+			    (uint64_t)MIN((uint64_t)uio_resid(uio), size - (uint64_t)uio_offset(uio)), relaxed);
+		}
+		/*
+		 * The lock is held for the reading of each round and let go of for its uiomove;
+		 * taken again only if another round follows.  What comes after the last one (the
+		 * buffer given back, the counts) needs no am_lock.
+		 */
+		for (;;) {
+			size_t round = (os_atomic_load(&am->am_nx.requests, relaxed) <= 1)
+			    ? am->am_iobuf_size : MIN(am->am_iobuf_size, APFS_ROUND_SHARED);
+			size_t want = (size_t)MIN((user_ssize_t)round, uio_resid(uio));
+			size_t got = 0;
+
+			error = apfs_read_file(&am->am_vol, &ino, &APFS_VP(vp)->an_cf,
+			    (uint64_t)uio_offset(uio), buf, want, &got);
+			apfs_unlock(am);
+			if (error || got == 0) {
+				break;
+			}
+			error = uiomove((caddr_t)buf, (int)got, uio);
+			if (error) {
+				break;
+			}
+			read_bytes += got;
+			if (uio_resid(uio) <= 0 || (uint64_t)uio_offset(uio) >= size) {
+				break;
+			}
+			apfs_lock(am);
+		}
+		os_atomic_dec(&am->am_nx.requests, relaxed);
+		apfs_iobuf_put(am, buf);
+	}
+	if (lp != NULL) {
+		/* (the entry stays where it is; a zeroing meanwhile costs at most this one read's time) */
+		os_atomic_add(&lp->read_ticks, apfs_ticks() - t0, relaxed);
+	}
+	os_atomic_add(&am->am_read_ticks, apfs_ticks() - t0, relaxed);
+	os_atomic_inc(&am->am_read_calls, relaxed);
+	os_atomic_add(&am->am_read_bytes, read_bytes, relaxed);
+	return error;
+}
+
+static int
+apfs_vnop_read(struct vnop_read_args *ap)
+{
+	vnode_t vp = ap->a_vp;
+	struct uio *uio = ap->a_uio;
+	struct apfs_mount *am = APFS_VP_MOUNT(vp);
+	struct apfs_inode ino;
+	struct apfs_lock_proc *lp;
+	uint64_t size, t0, before, cached = 0, filled = 0;
+	int error = 0;
+
+	if (vnode_isdir(vp)) {
+		return EISDIR;
+	}
+	if (!vnode_isreg(vp)) {
+		return EINVAL;
+	}
+	if (uio_offset(uio) < 0) {
+		return EINVAL;
+	}
+	if (!am->am_ubc_read || !UBCINFOEXISTS(vp)) {
+		return apfs_read_direct(ap);
+	}
+	ino = APFS_VP(vp)->an_ino;
+	size = APFS_VP(vp)->an_size;
+	t0 = apfs_ticks();
+	before = (uint64_t)uio_resid(uio);
+	lp = lock_proc(am);
+	os_atomic_inc(&lp->read_calls, relaxed);
+	if (uio_resid(uio) > 0 && (uint64_t)uio_offset(uio) < size) {
+		error = apfs_read_cached(am, vp, uio, &ino, size, &cached, &filled);
+	}
+	os_atomic_store(&APFS_VP(vp)->an_read_next, (uint64_t)uio_offset(uio), relaxed);
+	os_atomic_add(&lp->read_bytes, before - (uint64_t)uio_resid(uio), relaxed);
+	os_atomic_add(&lp->read_ticks, apfs_ticks() - t0, relaxed);
+	os_atomic_add(&am->am_read_ticks, apfs_ticks() - t0, relaxed);
+	os_atomic_inc(&am->am_read_calls, relaxed);
+	os_atomic_add(&am->am_read_bytes, before - (uint64_t)uio_resid(uio), relaxed);
+	os_atomic_add(&am->am_read_cached, cached, relaxed);
+	os_atomic_add(&am->am_read_filled, filled, relaxed);
+	return error;
+}
+
+/*
+ * Page in.  Everything goes through apfs_read_file rather than the cluster layer: a
+ * compressed file has no block mapping at all, and a plain one is read out of the extents
+ * just as cheaply here.
+ */
+static int
+apfs_vnop_pagein(struct vnop_pagein_args *ap)
+{
+	vnode_t vp = ap->a_vp;
+	struct apfs_mount *am = APFS_VP_MOUNT(vp);
+	upl_t upl = ap->a_pl;
+	upl_offset_t upl_offset = ap->a_pl_offset;
+	off_t offset = ap->a_f_offset;
+	struct apfs_inode ino;
+	vm_offset_t address = 0;
+	uint64_t size = 0;
+	uint64_t t0 = apfs_ticks();
+	struct apfs_lock_proc *lp = NULL;
+	off_t at, end;
+	int error = 0;
+
+	if (upl == NULL) {
+		return EINVAL;
+	}
+	if (offset < 0 || (offset & PAGE_MASK_64) || (ap->a_size & PAGE_MASK) ||
+	    (upl_offset & PAGE_MASK)) {
+		error = EINVAL;
+	} else {
+		ino = APFS_VP(vp)->an_ino;
+		size = APFS_VP(vp)->an_size;
+		if (ubc_upl_map(upl, &address) != KERN_SUCCESS) {
+			error = ENOMEM;
+		}
+	}
+	if (error) {
+		if (!(ap->a_flags & UPL_NOCOMMIT)) {
+			ubc_upl_abort_range(upl, upl_offset, (upl_size_t)ap->a_size,
+			    UPL_ABORT_FREE_ON_EMPTY | UPL_ABORT_ERROR);
+		}
+		return error;
+	}
+
+	/*
+	 * Say once how big a range the paging machinery asks for.  It decides how much the
+	 * holding of a decompressed piece can save: if a request already covers a whole
+	 * 64 KB piece, the piece was being decompressed once per request anyway.
+	 */
+	{
+		static bool said;
+
+		if (!said) {
+			said = true;
+			printf("apfs: pagein asks for %u bytes at a time (page size %u)\n",
+			    (unsigned)ap->a_size, (unsigned)PAGE_SIZE);
+		}
+	}
+	end = offset + (off_t)ap->a_size;
+	for (at = offset; at < end;) {
+		uint8_t *dst = (uint8_t *)address + upl_offset + (at - offset);
+		size_t want, got = 0;
+
+		if ((uint64_t)at >= size) {
+			bzero(dst, (size_t)(end - at));         /* past the end of the file */
+			break;
+		}
+		want = (size_t)MIN(end - at, (off_t)(size - (uint64_t)at));
+		os_atomic_inc(&am->am_nx.requests, relaxed);
+		apfs_lock(am);
+		if (at == offset) {
+			lp = lock_proc(am);
+			lp->pagein_calls++;
+			lp->pagein_bytes += ap->a_size;
+		}
+		error = apfs_read_file(&am->am_vol, &ino, &APFS_VP(vp)->an_cf, (uint64_t)at,
+		    dst, want, &got);
+		apfs_unlock(am);
+		os_atomic_dec(&am->am_nx.requests, relaxed);
+		if (error) {
+			break;
+		}
+		if (got == 0) {
+			bzero(dst, (size_t)(end - at));
+			break;
+		}
+		at += got;
+		/* the last page of the file: zero what lies past its end */
+		if ((uint64_t)at >= size && at < end) {
+			bzero((uint8_t *)address + upl_offset + (at - offset),
+			    (size_t)(end - at));
+			break;
+		}
+	}
+
+	ubc_upl_unmap(upl);
+	/* (the counts: without the lock, which would be taken for nothing else) */
+	if (lp != NULL) {
+		os_atomic_add(&lp->pagein_ticks, apfs_ticks() - t0, relaxed);
+	}
+	os_atomic_add(&am->am_pagein_ticks, apfs_ticks() - t0, relaxed);
+	os_atomic_inc(&am->am_pagein_calls, relaxed);
+	os_atomic_add(&am->am_pagein_bytes, (uint64_t)ap->a_size, relaxed);
+	if (!(ap->a_flags & UPL_NOCOMMIT)) {
+		if (error) {
+			ubc_upl_abort_range(upl, upl_offset, (upl_size_t)ap->a_size,
+			    UPL_ABORT_FREE_ON_EMPTY | UPL_ABORT_ERROR);
+		} else {
+			ubc_upl_commit_range(upl, upl_offset, (upl_size_t)ap->a_size,
+			    UPL_COMMIT_CLEAR_DIRTY | UPL_COMMIT_FREE_ON_EMPTY);
+		}
+	}
+	return error;
+}
+
+/* ------------------------------------------------------------------ directories */
+
+#define APFS_DIRSIZ(namlen) \
+	((sizeof(struct dirent) - (MAXNAMLEN + 1)) + (((namlen) + 1 + 3) & ~3))
+
+struct apfs_rd_ctx {
+	struct uio *rd_uio;
+	off_t       rd_start;           /* where this call is to resume */
+	off_t       rd_pos;             /* where we are in the stream of entries */
+	int         rd_count;
+	bool        rd_full;
+	int         rd_error;
+};
+
+static int
+apfs_vnop_readdir_one(struct apfs_rd_ctx *rc, const char *name, size_t name_len,
+    uint64_t file_id, uint8_t d_type)
+{
+	struct dirent de;
+
+	if (name_len > MAXNAMLEN) {
+		return 0;               /* cannot be named through this interface; skip it */
+	}
+	bzero(&de, sizeof(de));
+	de.d_fileno = (ino_t)file_id;
+	de.d_type = d_type;
+	de.d_namlen = (uint8_t)name_len;
+	de.d_reclen = (uint16_t)APFS_DIRSIZ(name_len);
+
+	if (rc->rd_pos >= rc->rd_start) {
+		if (uio_resid(rc->rd_uio) < (user_ssize_t)de.d_reclen) {
+			rc->rd_full = true;
+			return EEXIST;      /* stop the walk: no room for this one */
+		}
+		memcpy(de.d_name, name, name_len);
+		rc->rd_error = uiomove((caddr_t)&de, de.d_reclen, rc->rd_uio);
+		if (rc->rd_error) {
+			return EEXIST;
+		}
+		rc->rd_count++;
+	}
+	rc->rd_pos += de.d_reclen;
+	return 0;
+}
+
+static int
+apfs_readdir_cb(void *ctx, const char *name, size_t name_len, uint64_t file_id,
+    uint8_t d_type)
+{
+	return apfs_vnop_readdir_one(ctx, name, name_len, file_id, d_type);
+}
+
+static int
+apfs_vnop_readdir(struct vnop_readdir_args *ap)
+{
+	vnode_t vp = ap->a_vp;
+	struct apfs_mount *am = APFS_VP_MOUNT(vp);
+	struct apfs_node *an = APFS_VP(vp);
+	struct apfs_rd_ctx rc;
+	int error;
+
+	if (ap->a_flags & (VNODE_READDIR_EXTENDED | VNODE_READDIR_REQSEEKOFF)) {
+		return EINVAL;
+	}
+	if (!vnode_isdir(vp)) {
+		return ENOTDIR;
+	}
+	bzero(&rc, sizeof(rc));
+	rc.rd_uio = ap->a_uio;
+	rc.rd_start = uio_offset(ap->a_uio);
+
+	/*
+	 * A directory's entries are a run of records in the tree with no index, so there is
+	 * nothing to seek to: the walk starts at the beginning every time and skips what
+	 * has already been handed over.  "." and ".." come first and are not in the tree.
+	 */
+	error = apfs_vnop_readdir_one(&rc, ".", 1, an->an_id, DT_DIR);
+	if (error == 0) {
+		error = apfs_vnop_readdir_one(&rc, "..", 2, an->an_parent, DT_DIR);
+	}
+	if (error == 0) {
+		uint32_t i;
+
+		apfs_lock(am);
+		if (an->an_id < APFS_SYNTH_BASE) {
+			error = apfs_readdir(&am->am_vol, an->an_id, apfs_readdir_cb, &rc);
+		}
+		/* the synthetic directories in this one, after what is on the volume */
+		for (i = 0; error == 0 && i < am->am_nsynth; i++) {
+			if (am->am_synth[i].parent == an->an_id) {
+				error = apfs_vnop_readdir_one(&rc, am->am_synth[i].name,
+				    strlen(am->am_synth[i].name), am->am_synth[i].id, DT_DIR);
+			}
+		}
+		apfs_unlock(am);
+	}
+	if (error == EEXIST) {
+		error = 0;              /* we stopped it ourselves */
+	}
+	if (rc.rd_error != 0) {
+		return rc.rd_error;
+	}
+	if (error != 0) {
+		return error;
+	}
+	uio_setoffset(ap->a_uio, rc.rd_pos);
+	if (ap->a_eofflag != NULL) {
+		*ap->a_eofflag = rc.rd_full ? 0 : 1;
+	}
+	if (ap->a_numdirent != NULL) {
+		*ap->a_numdirent = rc.rd_count;
+	}
+	return 0;
+}
+
+static int
+apfs_vnop_readlink(struct vnop_readlink_args *ap)
+{
+	vnode_t vp = ap->a_vp;
+	struct apfs_mount *am = APFS_VP_MOUNT(vp);
+	struct apfs_node *an = APFS_VP(vp);
+	struct apfs_link *link;
+	char *buf;
+	size_t n = 0;
+	int error;
+
+	if (!vnode_islnk(vp)) {
+		return EINVAL;
+	}
+	link = os_atomic_load(&an->an_link, acquire);
+	if (link == NULL) {
+		/* the first time: from the tree, with the lock; kept for every time after */
+		buf = kalloc_data(MAXPATHLEN, Z_WAITOK);
+		if (buf == NULL) {
+			return ENOMEM;
+		}
+		apfs_lock(am);
+		error = apfs_readlink(&am->am_vol, an->an_id, buf, MAXPATHLEN, &n);
+		apfs_unlock(am);
+		if (error) {
+			kfree_data(buf, MAXPATHLEN);
+			return error;
+		}
+		link = kalloc_data(sizeof(*link) + n, Z_WAITOK);
+		if (link == NULL) {
+			error = uiomove(buf, (int)n, ap->a_uio);
+			kfree_data(buf, MAXPATHLEN);
+			return error;
+		}
+		link->len = n;
+		memcpy(link->text, buf, n);
+		kfree_data(buf, MAXPATHLEN);
+		if (!os_atomic_cmpxchg(&an->an_link, NULL, link, release)) {
+			kfree_data(link, sizeof(*link) + n);        /* somebody else's is in */
+			link = os_atomic_load(&an->an_link, acquire);
+		}
+	}
+	return uiomove(link->text, (int)link->len, ap->a_uio);
+}
+
+/* ------------------------------------------------------------------ attributes */
+
+/*
+ * The attributes the operating system keeps for itself are not shown to user space: they
+ * are how a symbolic link and a compressed file are stored, not things a reader should
+ * see.
+ */
+static bool
+apfs_xattr_hidden(const char *name)
+{
+	return strcmp(name, APFS_SYMLINK_EA_NAME) == 0 ||
+	       strcmp(name, APFS_DECMPFS_XATTR_NAME) == 0 ||
+	       strcmp(name, APFS_RSRC_FORK_XATTR_NAME) == 0;
+}
+
+static int
+apfs_vnop_getxattr(struct vnop_getxattr_args *ap)
+{
+	vnode_t vp = ap->a_vp;
+	struct apfs_mount *am = APFS_VP_MOUNT(vp);
+	struct apfs_node *an = APFS_VP(vp);
+	struct apfs_xattr xa;
+	uint8_t *buf;
+	size_t n = 0, whole;
+	int error;
+
+	if (ap->a_name == NULL) {
+		return EINVAL;
+	}
+	if (apfs_xattr_hidden(ap->a_name)) {
+		return ENOATTR;
+	}
+	apfs_lock(am);
+	error = apfs_xattr_lookup(&am->am_vol, an->an_id, ap->a_name, &xa);
+	apfs_unlock(am);
+	if (error) {
+		return error == ENOENT ? ENOATTR : error;
+	}
+	whole = (xa.flags & APFS_XATTR_DATA_STREAM) ? (size_t)xa.stream_size : xa.data_len;
+	if (ap->a_uio == NULL) {
+		*ap->a_size = whole;    /* only the size was asked for */
+		return 0;
+	}
+	if (uio_resid(ap->a_uio) < (user_ssize_t)whole) {
+		return ERANGE;
+	}
+	buf = kalloc_data(whole ? whole : 1, Z_WAITOK);
+	if (buf == NULL) {
+		return ENOMEM;
+	}
+	apfs_lock(am);
+	error = apfs_xattr_read(&am->am_vol, an->an_id, ap->a_name, buf, whole, &n);
+	apfs_unlock(am);
+	if (error == 0) {
+		error = uiomove((caddr_t)buf, (int)n, ap->a_uio);
+	}
+	kfree_data(buf, whole ? whole : 1);
+	return error;
+}
+
+struct apfs_lx_ctx {
+	struct uio *lx_uio;
+	size_t      lx_size;
+	int         lx_error;
+};
+
+static int
+apfs_listxattr_cb(void *ctx, const char *name, size_t name_len,
+    __unused const struct apfs_xattr *xa)
+{
+	struct apfs_lx_ctx *lc = ctx;
+
+	if (apfs_xattr_hidden(name)) {
+		return 0;
+	}
+	if (lc->lx_uio == NULL) {
+		lc->lx_size += name_len + 1;
+		return 0;
+	}
+	if (uio_resid(lc->lx_uio) < (user_ssize_t)(name_len + 1)) {
+		lc->lx_error = ERANGE;
+		return EEXIST;
+	}
+	lc->lx_error = uiomove((caddr_t)(uintptr_t)name, (int)name_len + 1, lc->lx_uio);
+	return lc->lx_error ? EEXIST : 0;
+}
+
+static int
+apfs_vnop_listxattr(struct vnop_listxattr_args *ap)
+{
+	struct apfs_mount *am = APFS_VP_MOUNT(ap->a_vp);
+	struct apfs_node *an = APFS_VP(ap->a_vp);
+	struct apfs_lx_ctx lc;
+	int error;
+
+	bzero(&lc, sizeof(lc));
+	lc.lx_uio = ap->a_uio;
+	apfs_lock(am);
+	error = apfs_xattr_list(&am->am_vol, an->an_id, apfs_listxattr_cb, &lc);
+	apfs_unlock(am);
+	if (error == EEXIST) {
+		error = 0;
+	}
+	if (error == 0 && lc.lx_error != 0) {
+		return lc.lx_error;
+	}
+	if (error) {
+		return error;
+	}
+	if (ap->a_uio == NULL && ap->a_size != NULL) {
+		*ap->a_size = lc.lx_size;
+	}
+	return 0;
+}
+
+/* ------------------------------------------------------------------ the rest */
+
+static int
+apfs_vnop_open(struct vnop_open_args *ap)
+{
+	if (ap->a_mode & (FWRITE | O_TRUNC | O_CREAT)) {
+		return EROFS;
+	}
+	return 0;
+}
+
+static int
+apfs_vnop_close(__unused struct vnop_close_args *ap)
+{
+	return 0;
+}
+
+static int
+apfs_vnop_mmap(__unused struct vnop_mmap_args *ap)
+{
+	/* the mount is read-only, so VFS has already refused a writable mapping */
+	return 0;
+}
+
+static int
+apfs_vnop_mnomap(__unused struct vnop_mnomap_args *ap)
+{
+	return 0;
+}
+
+/*
+ * The last reference to this file has gone.  Give back what was worked out about how its
+ * contents are stored -- the table of compressed pieces and, above all, the 64 KB of the
+ * piece last decompressed.
+ *
+ * It used to be kept until the vnode was reclaimed, which is later: VFS holds on to
+ * vnodes it may want again, up to desiredvnodes of them (1024 here), so up to 64 MB of
+ * pieces nobody was reading.  Here each file gives it back as soon as it is closed, and
+ * the cache still covers what it is for: the reads of one file, one after another.
+ * (This was first suspected of resetting the phone on long walks; it was not -- memory
+ * stayed flat throughout -- see redwood_apfs_check.c for what was.)
+ */
+static int
+apfs_vnop_inactive(struct vnop_inactive_args *ap)
+{
+	struct apfs_node *an = APFS_VP(ap->a_vp);
+
+	if (an == NULL) {
+		return 0;
+	}
+	/*
+	 * Most files hold nothing to give back (a directory, a link, a file not compressed): then
+	 * not even the lock. Looked at without it: a state being set up meanwhile is given back with
+	 * the vnode instead (apfs_vnop_reclaim), which is all a wrong "nothing" can cost.
+	 */
+	if (os_atomic_load(&an->an_cf.piece_off, relaxed) == NULL &&
+	    os_atomic_load(&an->an_cf.piece_len, relaxed) == NULL &&
+	    os_atomic_load(&an->an_cf.held_data, relaxed) == NULL &&
+	    os_atomic_load(&an->an_cf.ra_data, relaxed) == NULL) {
+		os_atomic_inc(&an->an_mount->am_inactive_free, relaxed);
+		return 0;
+	}
+	apfs_lock(an->an_mount);
+	apfs_cfile_fini(&an->an_cf);
+	apfs_unlock(an->an_mount);
+	return 0;
+}
+
+static int
+apfs_vnop_reclaim(struct vnop_reclaim_args *ap)
+{
+	vnode_t vp = ap->a_vp;
+	struct apfs_node *an = APFS_VP(vp);
+
+	if (an != NULL) {
+		apfs_lock(an->an_mount);
+		apfs_cfile_fini(&an->an_cf);
+		apfs_unlock(an->an_mount);
+		apfs_node_detach(an);
+		vnode_clearfsnode(vp);
+		if (an->an_link != NULL) {
+			kfree_data(an->an_link, sizeof(*an->an_link) + an->an_link->len);
+		}
+		kfree_type(struct apfs_node, an);
+	}
+	return 0;
+}
+
+/*
+ * No ioctl or fsctl means anything here.  ENOTTY is what callers take for "this filesystem
+ * does not have that"; the default, ENOTSUP, is not -- the iOS dyld, probing the root
+ * volume for APFS features, gives up on it.
+ */
+static int
+apfs_vnop_ioctl(__unused struct vnop_ioctl_args *ap)
+{
+	return ENOTTY;
+}
+
+static int
+apfs_vnop_pathconf(struct vnop_pathconf_args *ap)
+{
+	switch (ap->a_name) {
+	case _PC_LINK_MAX:
+		*ap->a_retval = 32767;
+		return 0;
+	case _PC_NAME_MAX:
+		*ap->a_retval = 255;
+		return 0;
+	case _PC_PATH_MAX:
+		*ap->a_retval = PATH_MAX;
+		return 0;
+	case _PC_CHOWN_RESTRICTED:
+		*ap->a_retval = 1;
+		return 0;
+	case _PC_NO_TRUNC:
+		*ap->a_retval = 1;
+		return 0;
+	case _PC_CASE_SENSITIVE:
+		*ap->a_retval = (APFS_VP_MOUNT(ap->a_vp)->am_vol.incompat &
+		    APFS_INCOMPAT_CASE_INSENSITIVE) ? 0 : 1;
+		return 0;
+	case _PC_CASE_PRESERVING:
+		*ap->a_retval = 1;
+		return 0;
+	case _PC_XATTR_SIZE_BITS:
+		*ap->a_retval = 32;
+		return 0;
+	default:
+		return EINVAL;
+	}
+}
+
+#define VOPFUNC int (*)(void *)
+
+int(**apfs_vnodeop_p)(void *);
+const struct vnodeopv_entry_desc apfs_vnodeop_entries[] = {
+	{ .opve_op = &vnop_default_desc, .opve_impl = (VOPFUNC)vn_default_error },
+	{ .opve_op = &vnop_ioctl_desc, .opve_impl = (VOPFUNC)apfs_vnop_ioctl },
+	{ .opve_op = &vnop_lookup_desc, .opve_impl = (VOPFUNC)apfs_vnop_lookup },
+	{ .opve_op = &vnop_open_desc, .opve_impl = (VOPFUNC)apfs_vnop_open },
+	{ .opve_op = &vnop_close_desc, .opve_impl = (VOPFUNC)apfs_vnop_close },
+	{ .opve_op = &vnop_getattr_desc, .opve_impl = (VOPFUNC)apfs_vnop_getattr },
+	{ .opve_op = &vnop_read_desc, .opve_impl = (VOPFUNC)apfs_vnop_read },
+	{ .opve_op = &vnop_getxattr_desc, .opve_impl = (VOPFUNC)apfs_vnop_getxattr },
+	{ .opve_op = &vnop_listxattr_desc, .opve_impl = (VOPFUNC)apfs_vnop_listxattr },
+	{ .opve_op = &vnop_fsync_desc, .opve_impl = (VOPFUNC)nop_fsync },
+	{ .opve_op = &vnop_readdir_desc, .opve_impl = (VOPFUNC)apfs_vnop_readdir },
+	{ .opve_op = &vnop_readlink_desc, .opve_impl = (VOPFUNC)apfs_vnop_readlink },
+	{ .opve_op = &vnop_inactive_desc, .opve_impl = (VOPFUNC)apfs_vnop_inactive },
+	{ .opve_op = &vnop_reclaim_desc, .opve_impl = (VOPFUNC)apfs_vnop_reclaim },
+	{ .opve_op = &vnop_pathconf_desc, .opve_impl = (VOPFUNC)apfs_vnop_pathconf },
+	{ .opve_op = &vnop_mmap_desc, .opve_impl = (VOPFUNC)apfs_vnop_mmap },
+	{ .opve_op = &vnop_mnomap_desc, .opve_impl = (VOPFUNC)apfs_vnop_mnomap },
+	{ .opve_op = &vnop_pagein_desc, .opve_impl = (VOPFUNC)apfs_vnop_pagein },
+	{ .opve_op = (struct vnodeop_desc *)NULL, .opve_impl = (VOPFUNC)NULL }
+};
+const struct vnodeopv_desc apfs_vnodeop_opv_desc = {
+	.opv_desc_vector_p = &apfs_vnodeop_p,
+	.opv_desc_ops = apfs_vnodeop_entries
+};
diff --git a/bsd/miscfs/apfs/apfs_write.c b/bsd/miscfs/apfs/apfs_write.c
new file mode 100644
--- /dev/null
+++ b/bsd/miscfs/apfs/apfs_write.c
@@ -0,0 +1,446 @@
+/*
+ * Writing into APFS: the contents of an existing file, in place.
+ *
+ * The driver beside this file reads APFS and does not write it, and that one fact shapes the
+ * whole port: /private/var has to be a filesystem in memory, remade empty at every boot, and
+ * what is to outlive a boot has to be packed into an archive and put somewhere that is not a
+ * filesystem at all (userland/src/var_store.c).  This file is the first step out of that, and
+ * it is a deliberately small one.
+ *
+ * What a write has to touch, and in what order
+ * -------------------------------------------
+ * APFS never overwrites a structure it has published.  A change is a transaction: fresh copies
+ * of everything from the changed record up to the container superblock, written into free
+ * space, and then one block -- a new container superblock in the checkpoint descriptor ring,
+ * with a transaction identifier one larger -- that makes all of them live at once.  For a
+ * single record of a single file that is, from the bottom up:
+ *
+ *   1. the data blocks of the file                     (not in any tree; this file writes these)
+ *   2. the leaf of the file-system tree holding the record, and every node above it to the root
+ *      (apfs_btree_node_phys, virtual objects: a new block each)
+ *   3. a new entry per new node in the volume's object map, keyed (oid, xid)  (apfs_omap_*)
+ *      -- which is itself a B-tree of physical nodes, so its own path to the root as well
+ *   4. the extent-reference tree, if the set of physical extents changed  (apfs_j_phys_ext_val)
+ *   5. a new copy of the volume superblock, and an entry for it in the container's object map
+ *      (apfs_superblock, apfs_omap_phys at nx_omap_oid)
+ *   6. the space manager, for every block allocated and freed above: the chunk bitmaps
+ *      (APFS_OBJECT_TYPE_SPACEMAN_BITMAP) in the internal pool, the chunk-info blocks that
+ *      count their free blocks, the totals in the space manager itself, and the two free
+ *      queues that hold freed blocks until no older checkpoint can want them
+ *   7. the ephemeral objects -- the space manager and the reaper -- copied into the checkpoint
+ *      data ring, and a checkpoint map (apfs_checkpoint_map_phys) in the descriptor ring that
+ *      says where in the ring each of them landed
+ *   8. the container superblock (apfs_nx_superblock) last, into the next block of the
+ *      descriptor ring, with nx_next_xid raised and its Fletcher-64 covering the lot
+ *
+ * Step 8 is the commit, and it is a commit because of how the reader finds the container:
+ * apfs_nx_open() scans the whole descriptor ring and takes the superblock with the largest
+ * transaction identifier that passes its checksum, passing over without a word anything that
+ * does not (apfs_lib.c).  So up to and including a torn step 8 the previous checkpoint is still
+ * the live one and nothing of steps 1-7 is reachable; after an intact step 8 all of it is.
+ * That is the whole of APFS's crash safety and it is cheap -- but only if every one of steps
+ * 1-7 went to blocks that the previous checkpoint does not use, which is what the space
+ * manager is for, and the space manager is the part of APFS this driver does not model at all.
+ *
+ * What the reader here already understands, and what it does not
+ * -------------------------------------------------------------
+ * Understood: the object header and its Fletcher-64; the descriptor ring and picking the live
+ * superblock out of it; both object maps, looked up by (oid, xid); B-tree nodes of every shape
+ * the volumes use (virtual and physical children, fixed and variable key/value sizes, sealed
+ * nodes with hashes); the file-system tree's records -- inodes, directory records, attributes,
+ * data streams, file extents; the separate extent tree of a sealed volume; holes; and the
+ * contents of compressed files.
+ *
+ * Not modelled, not even as a structure definition: the space manager and every part of it
+ * (chunk bitmaps, chunk-info blocks and their blocks, the internal pool and its ring of bitmap
+ * copies, the free queues) -- the word appears in apfs_format.h twice, both times as an object
+ * type constant; the checkpoint data ring; the checkpoint map, which the header says outright
+ * is skipped because only the space manager needs it; the snapshot metadata tree; the integrity
+ * metadata and per-file hashes of a sealed volume.  Also absent is any notion of a dirty object,
+ * an allocation, or a transaction: nothing in apfs_lib.c holds a block to be written later.
+ *
+ * So the smallest change to one metadata record needs the space manager, the checkpoint rings
+ * and a transaction, which is most of a writable APFS.  That is the honest cost, and it is why
+ * this file does something else.
+ *
+ * What this file does
+ * -------------------
+ * It replaces bytes inside a file that already exists, without changing its length, its extents
+ * or any other structure.  Nothing in steps 2-8 above happens, because nothing in them has
+ * anything to say about the bytes in a data block: the only blocks written are blocks that the
+ * file's own extent records, and the extent-reference tree, both say belong to that one file.
+ *
+ * It is therefore safe against a power failure in the strong sense, and not by being atomic:
+ * every structure of the container is exactly as it was, so the volume mounts, every tree and
+ * every checksum still checks, and every other file is byte for byte what it was.  The one
+ * thing a failure can leave behind is a mixture of the old and the new contents of the file
+ * being written -- which is a loss the caller is in a position to notice and handle, as
+ * var_store.c already does for the raw blocks it writes today: two slots, and a checksum
+ * written last.
+ *
+ * What it refuses, and why.  Every one of these is read off the volume before a byte goes out:
+ *
+ *   the device cannot write                 dev.write is NULL, as it is at every mount
+ *   a sealed volume                         its integrity metadata holds a hash of each file's
+ *                                           contents, and we do not update them
+ *   a volume with snapshots                 a snapshot refers to these very blocks
+ *   no extent-reference tree                then nothing can say the blocks are not shared
+ *   not a regular file, or no data stream
+ *   a compressed file                       its bytes are in an attribute or a resource fork,
+ *                                           and its decmpfs header states the size
+ *   past the end of the file                a write that grows a file changes its records
+ *   a hole in the range                     filling one means allocating, which means step 6
+ *   an extent whose extent-reference record does not begin at the same block, does not cover
+ *       the whole extent, is not owned by this stream, or has more than one reference
+ *                                           -- a clone, a snapshot or a tree we misread
+ *   a block outside the container, or inside block zero, the checkpoint rings or the container's
+ *       object map                          -- the bound that holds even if a tree was misread
+ *
+ * The bounds are deliberately three deep, after the fashion of the writes into the phone's
+ * flash (bsd/dev/redwood_ufs.c): the file's own extents say which blocks are its contents, the
+ * extent-reference tree says the same blocks are that stream's and nobody else's, and a plain
+ * range check refuses anything near the container's own structures whatever the trees said.
+ * Then every block is read back and compared before the next one goes out.
+ *
+ * What is left out that a filesystem would do: the file's modification time is not touched (a
+ * stale mtime is a lie, but not damage, and setting it is a transaction), and in the kernel the
+ * pages of the file in the unified buffer cache would have to be invalidated by the caller --
+ * there is no caller in the kernel yet, which is why that is not done here.
+ */
+
+#include "apfs_write.h"
+
+/* ------------------------------------------------------------------ little-endian reads */
+
+static inline uint32_t
+w_le32(const uint8_t *p)
+{
+	return (uint32_t)p[0] | (uint32_t)p[1] << 8 | (uint32_t)p[2] << 16 | (uint32_t)p[3] << 24;
+}
+
+static inline uint64_t
+w_le64(const uint8_t *p)
+{
+	return (uint64_t)w_le32(p) | (uint64_t)w_le32(p + 4) << 32;
+}
+
+/* ------------------------------------------------------------------ the volume */
+
+int
+apfs_write_volume_ok(struct apfs_vol *vol, const char **why)
+{
+	const char *reason = NULL;
+
+	if (vol->nx->dev.write == NULL) {
+		reason = "the device does not take writes";
+	} else if (vol->nx->block_size < APFS_NX_MINIMUM_BLOCK_SIZE) {
+		reason = "the container's block size makes no sense";
+	} else if (vol->incompat & APFS_INCOMPAT_SEALED_VOLUME) {
+		reason = "a sealed volume: its integrity metadata hashes the contents";
+	} else if (vol->integrity_meta_oid != 0) {
+		reason = "the volume has integrity metadata: the contents are hashed";
+	} else if (vol->num_snapshots != 0) {
+		reason = "the volume has snapshots, which share its blocks";
+	} else if (vol->role == APFS_VOL_ROLE_SYSTEM || vol->role == APFS_VOL_ROLE_PREBOOT) {
+		/*
+		 * Not an APFS rule but this port's: the system volume of iOS is not ours to
+		 * change.  It is worth saying out loud because the gates above do not catch it --
+		 * on an iPhone that volume is sealed, but the copy this port boots from was
+		 * unpacked out of an IPSW and is not, so it would otherwise pass every check
+		 * here.  What keeps it safe on the phone is where a write may go at all (the
+		 * loader's BLOCK_WRITE_FIRST and a kernel whose block devices refuse every
+		 * write); this is one more fence in front of that, not instead of it.
+		 */
+		reason = "the volume is iOS's own system or preboot volume";
+	} else if (vol->extentref_oid == 0) {
+		reason = "no extent-reference tree: nothing can say a block is not shared";
+	}
+	if (why != NULL) {
+		*why = reason;
+	}
+	return reason == NULL ? 0 : EROFS;
+}
+
+/*
+ * Blocks [start, start + count) may hold the contents of a file and nothing else.  This knows
+ * nothing of any tree: it is the bound that stands even if every tree was read wrongly.
+ */
+static bool
+blocks_are_free_ground(struct apfs_nx *nx, uint64_t start, uint64_t count)
+{
+	uint64_t end;
+
+	if (count == 0 || start == 0 || start >= nx->block_count) {
+		return false;
+	}
+	if (count > nx->block_count - start) {
+		return false;
+	}
+	end = start + count;
+	/* the two checkpoint rings, as the live container superblock names them */
+	if (nx->xp_desc_blocks != 0 && start < nx->xp_desc_base + nx->xp_desc_blocks &&
+	    end > nx->xp_desc_base) {
+		return false;
+	}
+	if (nx->xp_data_blocks != 0 && start < nx->xp_data_base + nx->xp_data_blocks &&
+	    end > nx->xp_data_base) {
+		return false;
+	}
+	/* the container's object map, which is at a block address and not behind one */
+	if (nx->omap_addr >= start && nx->omap_addr < end) {
+		return false;
+	}
+	return true;
+}
+
+/*
+ * The extent-reference tree's word on an extent: one record, beginning at this very block,
+ * covering the whole of it, owned by this stream, referred to once.  Anything else -- a record
+ * that begins elsewhere, a shorter one, another owner, a second reference -- is a clone, a
+ * snapshot, or a tree we did not read the way the writer of it meant, and is refused.
+ */
+static int
+extent_is_ours(struct apfs_btree *er, uint64_t stream_id, uint64_t phys, uint64_t blocks,
+    const char **why)
+{
+	struct apfs_cursor cur;
+	struct apfs_rec rec;
+	uint64_t len, owner;
+	int32_t refcnt;
+	int error;
+
+	error = apfs_seek(er, phys, APFS_TYPE_EXTENT, &cur);
+	if (error) {
+		*why = "the extent-reference tree cannot be read";
+		return error;
+	}
+	error = apfs_cursor_next(&cur, &rec);
+	if (error != 0 || rec.obj_id != phys || rec.type != APFS_TYPE_EXTENT) {
+		*why = "no extent-reference record begins at this extent's first block";
+		return EROFS;
+	}
+	if (rec.val == NULL || rec.val_len < 20) {
+		*why = "an extent-reference record too short to be one";
+		return EIO;
+	}
+	len = w_le64(rec.val) & APFS_PEXT_LEN_MASK;
+	owner = w_le64(rec.val + 8);
+	refcnt = (int32_t)w_le32(rec.val + 16);
+	if (len < blocks) {
+		*why = "the extent-reference record covers less than the extent";
+		return EROFS;
+	}
+	if (owner != stream_id) {
+		*why = "the extent-reference record names another stream as the owner";
+		return EROFS;
+	}
+	if (refcnt != 1) {
+		*why = "the extent is referred to more than once: a clone or a snapshot";
+		return EROFS;
+	}
+	return 0;
+}
+
+/* ------------------------------------------------------------------ the write */
+
+/*
+ * One block out and read back again.  A device that says a write went through and then hands
+ * back something else is the one failure no amount of checking above can catch, so every block
+ * is compared before the next goes out -- the same bargain the writes into the phone's flash
+ * make (bsd/dev/redwood_ufs.c).
+ */
+static int
+block_out(struct apfs_nx *nx, uint64_t block, const uint8_t *data, uint8_t *scratch)
+{
+	uint64_t at = block * (uint64_t)nx->block_size;
+	int error;
+
+	error = nx->dev.write(nx->dev.ctx, at, data, nx->block_size);
+	if (error) {
+		return error;
+	}
+	error = nx->dev.read_data != NULL ?
+	    nx->dev.read_data(nx->dev.ctx, at, scratch, nx->block_size) :
+	    nx->dev.read(nx->dev.ctx, at, scratch, nx->block_size);
+	if (error) {
+		return error;
+	}
+	if (memcmp(scratch, data, nx->block_size) != 0) {
+		apfs_log("block %llu read back as something else than it was written\n",
+		    (unsigned long long)block);
+		return EIO;
+	}
+	return 0;
+}
+
+int
+apfs_write_in_place(struct apfs_vol *vol, uint64_t obj_id, uint64_t off, const void *buf,
+    size_t len, struct apfs_write_report *rep)
+{
+	struct apfs_nx *nx = vol->nx;
+	struct apfs_inode ino;
+	struct apfs_xattr xa;
+	struct apfs_btree er;
+	const uint8_t *src = buf;
+	uint8_t *block = NULL, *scratch = NULL;
+	uint32_t bs = nx->block_size;
+	uint64_t at = off, left = len;
+	const char *why = NULL;
+	int error;
+
+	memset(rep, 0, sizeof(*rep));
+	rep->bytes = len;
+
+	error = apfs_write_volume_ok(vol, &why);
+	if (error) {
+		goto refuse;
+	}
+	error = apfs_inode_get(vol, obj_id, &ino);
+	if (error) {
+		why = "there is no such inode";
+		goto refuse;
+	}
+	if ((ino.mode & APFS_S_IFMT) != APFS_S_IFREG) {
+		why = "not a regular file";
+		error = EROFS;
+		goto refuse;
+	}
+	if (!ino.has_dstream) {
+		why = "the file has no data stream";
+		error = EROFS;
+		goto refuse;
+	}
+	/*
+	 * A compressed file keeps its bytes in an attribute or a resource fork and its decmpfs
+	 * header states the uncompressed size, so writing over its extents writes over nothing
+	 * a reader looks at -- or over the resource fork, which is a different stream.
+	 */
+	error = apfs_xattr_lookup(vol, obj_id, APFS_DECMPFS_XATTR_NAME, &xa);
+	if (error == 0) {
+		why = "the file is compressed: its bytes are not in its extents";
+		error = EROFS;
+		goto refuse;
+	}
+	if (error != ENOENT) {
+		why = "the file's attributes cannot be read";
+		goto refuse;
+	}
+	if (len == 0) {
+		error = 0;
+		goto out;
+	}
+	if (off > ino.size || len > ino.size - off) {
+		why = "the write would go past the end of the file";
+		error = EROFS;
+		goto refuse;
+	}
+	error = apfs_extentref_open(vol, &er);
+	if (error) {
+		why = "the extent-reference tree cannot be opened";
+		goto refuse;
+	}
+	block = apfs_alloc(bs);
+	scratch = apfs_alloc(bs);
+	if (block == NULL || scratch == NULL) {
+		why = "no memory";
+		error = ENOMEM;
+		goto refuse;
+	}
+
+	/*
+	 * An extent at a time.  Looking one up walks the stream's extents from the front, so a
+	 * write across a badly fragmented file costs more than it looks -- which is fine for what
+	 * this is for (a file of a few extents written whole) and would not be for a filesystem.
+	 */
+	while (left > 0) {
+		struct apfs_extent ext;
+		uint64_t ext_blocks, piece;
+
+		error = apfs_extent_at(vol, ino.private_id, at, &ext);
+		if (error) {
+			why = "no extent of the file covers this offset";
+			error = error == ENOENT ? EROFS : error;
+			goto refuse;
+		}
+		if (ext.phys == 0) {
+			why = "a hole in the range: filling one means allocating blocks";
+			error = EROFS;
+			goto refuse;
+		}
+		ext_blocks = ext.length / bs;
+		if (!blocks_are_free_ground(nx, ext.phys, ext_blocks)) {
+			why = "the extent is not where a file's contents can be";
+			error = EROFS;
+			goto refuse;
+		}
+		error = extent_is_ours(&er, ino.private_id, ext.phys, ext_blocks, &why);
+		if (error) {
+			goto refuse;
+		}
+		/* how much of this extent the write still wants */
+		piece = ext.length - (at - ext.logical);
+		if (piece > left) {
+			piece = left;
+		}
+
+		/*
+		 * Whole blocks only: the write path on the phone takes nothing else, and a
+		 * partial block is the file's own bytes either way, so it is read, patched and
+		 * written back whole.
+		 */
+		while (piece > 0) {
+			uint64_t in_block = (at - ext.logical) % bs;
+			uint64_t take = bs - in_block;
+			uint64_t b = ext.phys + (at - ext.logical) / bs;
+
+			if (take > piece) {
+				take = piece;
+			}
+			if (in_block == 0 && take == bs) {
+				memcpy(block, src, bs);
+			} else {
+				error = nx->dev.read_data != NULL ?
+				    nx->dev.read_data(nx->dev.ctx, b * (uint64_t)bs, block, bs) :
+				    nx->dev.read(nx->dev.ctx, b * (uint64_t)bs, block, bs);
+				if (error) {
+					why = "the block to be patched cannot be read";
+					goto refuse;
+				}
+				memcpy(block + in_block, src, (size_t)take);
+				rep->partial++;
+			}
+			error = block_out(nx, b, block, scratch);
+			rep->calls++;
+			if (error) {
+				why = "the device did not take the block";
+				goto refuse;
+			}
+			if (rep->blocks == 0) {
+				rep->first_block = b;
+			}
+			rep->blocks++;
+			src += take;
+			at += take;
+			piece -= take;
+			left -= take;
+		}
+	}
+	error = 0;
+	goto out;
+
+refuse:
+	if (why == NULL) {
+		why = "the write failed";
+	}
+	rep->why = why;
+	apfs_log("write of %llu bytes at %llu of inode %llu refused: %s\n",
+	    (unsigned long long)len, (unsigned long long)off, (unsigned long long)obj_id, why);
+out:
+	if (block != NULL) {
+		apfs_free(block, bs);
+	}
+	if (scratch != NULL) {
+		apfs_free(scratch, bs);
+	}
+	return error;
+}
diff --git a/bsd/miscfs/apfs/apfs_write.h b/bsd/miscfs/apfs/apfs_write.h
new file mode 100644
--- /dev/null
+++ b/bsd/miscfs/apfs/apfs_write.h
@@ -0,0 +1,41 @@
+/*
+ * Writing into APFS: the contents of an existing file, in place.
+ *
+ * See apfs_write.c for what this does and, more to the point, what it does not.
+ */
+
+#ifndef _MISCFS_APFS_APFS_WRITE_H_
+#define _MISCFS_APFS_APFS_WRITE_H_
+
+#include "apfs_lib.h"
+
+/* What a write did, or why it was refused.  Filled in whether it went well or not. */
+struct apfs_write_report {
+	const char *why;                /* NULL when the write went through */
+	uint64_t    first_block;        /* the first block written, 0 if none was */
+	uint64_t    blocks;             /* blocks written */
+	uint64_t    bytes;              /* bytes of the file the caller asked to replace */
+	uint64_t    partial;            /* blocks read, patched and written back whole */
+	uint64_t    calls;              /* calls to dev.write */
+};
+
+/*
+ * May this volume be written at all?  Answered from the volume alone, before any file is
+ * named: 0, or EROFS with the reason in *why.  apfs_write_in_place() asks this itself; it
+ * is here so that a caller can say at mount time whether writing is possible.
+ */
+int apfs_write_volume_ok(struct apfs_vol *vol, const char **why);
+
+/*
+ * Replace `len` bytes at offset `off` of the file `obj_id` with `buf`, leaving its length,
+ * its extents and every other structure of the container exactly as they were.  Refuses
+ * (EROFS, with the reason in rep->why) anything it cannot do that way -- see apfs_write.c.
+ *
+ * The blocks go out in ascending order of offset and each is read back and compared before
+ * the next, so a caller that puts its own checksum in the last bytes of what it writes can
+ * tell afterwards whether a write that was cut short got there.
+ */
+int apfs_write_in_place(struct apfs_vol *vol, uint64_t obj_id, uint64_t off,
+    const void *buf, size_t len, struct apfs_write_report *rep);
+
+#endif /* _MISCFS_APFS_APFS_WRITE_H_ */
diff --git a/bsd/miscfs/apfs/apfs_zbitmap.c b/bsd/miscfs/apfs/apfs_zbitmap.c
