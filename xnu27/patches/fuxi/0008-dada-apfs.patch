+ * included in all copies or substantial portions of the Software.
+ *
+ * THE SOFTWARE IS PROVIDED "AS IS", WITHOUT WARRANTY OF ANY KIND,
+ * EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES
+ * OF MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND
+ * NONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT
+ * HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY,
+ * WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING
+ * FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR
+ * OTHER DEALINGS IN THE SOFTWARE.
+ */
+
+#include "lib_common.h"
+#include "zlib_constants.h"
+
+LIBDEFLATEAPI enum libdeflate_result
+libdeflate_zlib_decompress_ex(struct libdeflate_decompressor *d,
+			      const void *in, size_t in_nbytes,
+			      void *out, size_t out_nbytes_avail,
+			      size_t *actual_in_nbytes_ret,
+			      size_t *actual_out_nbytes_ret)
+{
+	const u8 *in_next = in;
+	const u8 * const in_end = in_next + in_nbytes;
+	u16 hdr;
+	size_t actual_in_nbytes;
+	size_t actual_out_nbytes;
+	enum libdeflate_result result;
+
+	if (in_nbytes < ZLIB_MIN_OVERHEAD)
+		return LIBDEFLATE_BAD_DATA;
+
+	/* 2 byte header: CMF and FLG  */
+	hdr = get_unaligned_be16(in_next);
+	in_next += 2;
+
+	/* FCHECK */
+	if ((hdr % 31) != 0)
+		return LIBDEFLATE_BAD_DATA;
+
+	/* CM */
+	if (((hdr >> 8) & 0xF) != ZLIB_CM_DEFLATE)
+		return LIBDEFLATE_BAD_DATA;
+
+	/* CINFO */
+	if ((hdr >> 12) > ZLIB_CINFO_32K_WINDOW)
+		return LIBDEFLATE_BAD_DATA;
+
+	/* FDICT */
+	if ((hdr >> 5) & 1)
+		return LIBDEFLATE_BAD_DATA;
+
+	/* Compressed data  */
+	result = libdeflate_deflate_decompress_ex(d, in_next,
+					in_end - ZLIB_FOOTER_SIZE - in_next,
+					out, out_nbytes_avail,
+					&actual_in_nbytes, actual_out_nbytes_ret);
+	if (result != LIBDEFLATE_SUCCESS)
+		return result;
+
+	if (actual_out_nbytes_ret)
+		actual_out_nbytes = *actual_out_nbytes_ret;
+	else
+		actual_out_nbytes = out_nbytes_avail;
+
+	in_next += actual_in_nbytes;
+
+	/* ADLER32  */
+	if (libdeflate_adler32(1, out, actual_out_nbytes) !=
+	    get_unaligned_be32(in_next))
+		return LIBDEFLATE_BAD_DATA;
+	in_next += 4;
+
+	if (actual_in_nbytes_ret)
+		*actual_in_nbytes_ret = in_next - (u8 *)in;
+
+	return LIBDEFLATE_SUCCESS;
+}
+
+LIBDEFLATEAPI enum libdeflate_result
+libdeflate_zlib_decompress(struct libdeflate_decompressor *d,
+			   const void *in, size_t in_nbytes,
+			   void *out, size_t out_nbytes_avail,
+			   size_t *actual_out_nbytes_ret)
+{
+	return libdeflate_zlib_decompress_ex(d, in, in_nbytes,
+					     out, out_nbytes_avail,
+					     NULL, actual_out_nbytes_ret);
+}
diff --git a/bsd/miscfs/apfs/libdeflate/libdeflate.h b/bsd/miscfs/apfs/libdeflate/libdeflate.h
new file mode 100644
--- /dev/null
+++ b/bsd/miscfs/apfs/libdeflate/libdeflate.h
@@ -0,0 +1,411 @@
+/*
+ * libdeflate.h - public header for libdeflate
+ */
+
+#ifndef LIBDEFLATE_H
+#define LIBDEFLATE_H
+
+#include <stddef.h>
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#define LIBDEFLATE_VERSION_MAJOR	1
+#define LIBDEFLATE_VERSION_MINOR	24
+#define LIBDEFLATE_VERSION_STRING	"1.24"
+
+/*
+ * Users of libdeflate.dll on Windows can define LIBDEFLATE_DLL to cause
+ * __declspec(dllimport) to be used.  This should be done when it's easy to do.
+ * Otherwise it's fine to skip it, since it is a very minor performance
+ * optimization that is irrelevant for most use cases of libdeflate.
+ */
+#ifndef LIBDEFLATEAPI
+#  if defined(LIBDEFLATE_DLL) && (defined(_WIN32) || defined(__CYGWIN__))
+#    define LIBDEFLATEAPI	__declspec(dllimport)
+#  else
+#    define LIBDEFLATEAPI
+#  endif
+#endif
+
+/* ========================================================================== */
+/*                             Compression                                    */
+/* ========================================================================== */
+
+struct libdeflate_compressor;
+struct libdeflate_options;
+
+/*
+ * libdeflate_alloc_compressor() allocates a new compressor that supports
+ * DEFLATE, zlib, and gzip compression.  'compression_level' is the compression
+ * level on a zlib-like scale but with a higher maximum value (1 = fastest, 6 =
+ * medium/default, 9 = slow, 12 = slowest).  Level 0 is also supported and means
+ * "no compression", specifically "create a valid stream, but only emit
+ * uncompressed blocks" (this will expand the data slightly).
+ *
+ * The return value is a pointer to the new compressor, or NULL if out of memory
+ * or if the compression level is invalid (i.e. outside the range [0, 12]).
+ *
+ * Note: for compression, the sliding window size is defined at compilation time
+ * to 32768, the largest size permissible in the DEFLATE format.  It cannot be
+ * changed at runtime.
+ *
+ * A single compressor is not safe to use by multiple threads concurrently.
+ * However, different threads may use different compressors concurrently.
+ */
+LIBDEFLATEAPI struct libdeflate_compressor *
+libdeflate_alloc_compressor(int compression_level);
+
+/*
+ * Like libdeflate_alloc_compressor(), but adds the 'options' argument.
+ */
+LIBDEFLATEAPI struct libdeflate_compressor *
+libdeflate_alloc_compressor_ex(int compression_level,
+			       const struct libdeflate_options *options);
+
+/*
+ * libdeflate_deflate_compress() performs raw DEFLATE compression on a buffer of
+ * data.  It attempts to compress 'in_nbytes' bytes of data located at 'in' and
+ * write the result to 'out', which has space for 'out_nbytes_avail' bytes.  The
+ * return value is the compressed size in bytes, or 0 if the data could not be
+ * compressed to 'out_nbytes_avail' bytes or fewer.
+ *
+ * If compression is successful, then the output data is guaranteed to be a
+ * valid DEFLATE stream that decompresses to the input data.  No other
+ * guarantees are made about the output data.  Notably, different versions of
+ * libdeflate can produce different compressed data for the same uncompressed
+ * data, even at the same compression level.  Do ***NOT*** do things like
+ * writing tests that compare compressed data to a golden output, as this can
+ * break when libdeflate is updated.  (This property isn't specific to
+ * libdeflate; the same is true for zlib and other compression libraries too.)
+ */
+LIBDEFLATEAPI size_t
+libdeflate_deflate_compress(struct libdeflate_compressor *compressor,
+			    const void *in, size_t in_nbytes,
+			    void *out, size_t out_nbytes_avail);
+
+/*
+ * libdeflate_deflate_compress_bound() returns a worst-case upper bound on the
+ * number of bytes of compressed data that may be produced by compressing any
+ * buffer of length less than or equal to 'in_nbytes' using
+ * libdeflate_deflate_compress() with the specified compressor.  This bound will
+ * necessarily be a number greater than or equal to 'in_nbytes'.  It may be an
+ * overestimate of the true upper bound.  The return value is guaranteed to be
+ * the same for all invocations with the same compressor and same 'in_nbytes'.
+ *
+ * As a special case, 'compressor' may be NULL.  This causes the bound to be
+ * taken across *any* libdeflate_compressor that could ever be allocated with
+ * this build of the library, with any options.
+ *
+ * Note that this function is not necessary in many applications.  With
+ * block-based compression, it is usually preferable to separately store the
+ * uncompressed size of each block and to store any blocks that did not compress
+ * to less than their original size uncompressed.  In that scenario, there is no
+ * need to know the worst-case compressed size, since the maximum number of
+ * bytes of compressed data that may be used would always be one less than the
+ * input length.  You can just pass a buffer of that size to
+ * libdeflate_deflate_compress() and store the data uncompressed if
+ * libdeflate_deflate_compress() returns 0, indicating that the compressed data
+ * did not fit into the provided output buffer.
+ */
+LIBDEFLATEAPI size_t
+libdeflate_deflate_compress_bound(struct libdeflate_compressor *compressor,
+				  size_t in_nbytes);
+
+/*
+ * Like libdeflate_deflate_compress(), but uses the zlib wrapper format instead
+ * of raw DEFLATE.
+ */
+LIBDEFLATEAPI size_t
+libdeflate_zlib_compress(struct libdeflate_compressor *compressor,
+			 const void *in, size_t in_nbytes,
+			 void *out, size_t out_nbytes_avail);
+
+/*
+ * Like libdeflate_deflate_compress_bound(), but assumes the data will be
+ * compressed with libdeflate_zlib_compress() rather than with
+ * libdeflate_deflate_compress().
+ */
+LIBDEFLATEAPI size_t
+libdeflate_zlib_compress_bound(struct libdeflate_compressor *compressor,
+			       size_t in_nbytes);
+
+/*
+ * Like libdeflate_deflate_compress(), but uses the gzip wrapper format instead
+ * of raw DEFLATE.
+ */
+LIBDEFLATEAPI size_t
+libdeflate_gzip_compress(struct libdeflate_compressor *compressor,
+			 const void *in, size_t in_nbytes,
+			 void *out, size_t out_nbytes_avail);
+
+/*
+ * Like libdeflate_deflate_compress_bound(), but assumes the data will be
+ * compressed with libdeflate_gzip_compress() rather than with
+ * libdeflate_deflate_compress().
+ */
+LIBDEFLATEAPI size_t
+libdeflate_gzip_compress_bound(struct libdeflate_compressor *compressor,
+			       size_t in_nbytes);
+
+/*
+ * libdeflate_free_compressor() frees a compressor that was allocated with
+ * libdeflate_alloc_compressor().  If a NULL pointer is passed in, no action is
+ * taken.
+ */
+LIBDEFLATEAPI void
+libdeflate_free_compressor(struct libdeflate_compressor *compressor);
+
+/* ========================================================================== */
+/*                             Decompression                                  */
+/* ========================================================================== */
+
+struct libdeflate_decompressor;
+struct libdeflate_options;
+
+/*
+ * libdeflate_alloc_decompressor() allocates a new decompressor that can be used
+ * for DEFLATE, zlib, and gzip decompression.  The return value is a pointer to
+ * the new decompressor, or NULL if out of memory.
+ *
+ * This function takes no parameters, and the returned decompressor is valid for
+ * decompressing data that was compressed at any compression level and with any
+ * sliding window size.
+ *
+ * A single decompressor is not safe to use by multiple threads concurrently.
+ * However, different threads may use different decompressors concurrently.
+ */
+LIBDEFLATEAPI struct libdeflate_decompressor *
+libdeflate_alloc_decompressor(void);
+
+/*
+ * Like libdeflate_alloc_decompressor(), but adds the 'options' argument.
+ */
+LIBDEFLATEAPI struct libdeflate_decompressor *
+libdeflate_alloc_decompressor_ex(const struct libdeflate_options *options);
+
+/*
+ * Result of a call to libdeflate_deflate_decompress(),
+ * libdeflate_zlib_decompress(), or libdeflate_gzip_decompress().
+ */
+enum libdeflate_result {
+	/* Decompression was successful.  */
+	LIBDEFLATE_SUCCESS = 0,
+
+	/* Decompression failed because the compressed data was invalid,
+	 * corrupt, or otherwise unsupported.  */
+	LIBDEFLATE_BAD_DATA = 1,
+
+	/* A NULL 'actual_out_nbytes_ret' was provided, but the data would have
+	 * decompressed to fewer than 'out_nbytes_avail' bytes.  */
+	LIBDEFLATE_SHORT_OUTPUT = 2,
+
+	/* The data would have decompressed to more than 'out_nbytes_avail'
+	 * bytes.  */
+	LIBDEFLATE_INSUFFICIENT_SPACE = 3,
+};
+
+/*
+ * libdeflate_deflate_decompress() decompresses a DEFLATE stream from the buffer
+ * 'in' with compressed size up to 'in_nbytes' bytes.  The uncompressed data is
+ * written to 'out', a buffer with size 'out_nbytes_avail' bytes.  If
+ * decompression succeeds, then 0 (LIBDEFLATE_SUCCESS) is returned.  Otherwise,
+ * a nonzero result code such as LIBDEFLATE_BAD_DATA is returned, and the
+ * contents of the output buffer are undefined.
+ *
+ * Decompression stops at the end of the DEFLATE stream (as indicated by the
+ * BFINAL flag), even if it is actually shorter than 'in_nbytes' bytes.
+ *
+ * libdeflate_deflate_decompress() can be used in cases where the actual
+ * uncompressed size is known (recommended) or unknown (not recommended):
+ *
+ *   - If the actual uncompressed size is known, then pass the actual
+ *     uncompressed size as 'out_nbytes_avail' and pass NULL for
+ *     'actual_out_nbytes_ret'.  This makes libdeflate_deflate_decompress() fail
+ *     with LIBDEFLATE_SHORT_OUTPUT if the data decompressed to fewer than the
+ *     specified number of bytes.
+ *
+ *   - If the actual uncompressed size is unknown, then provide a non-NULL
+ *     'actual_out_nbytes_ret' and provide a buffer with some size
+ *     'out_nbytes_avail' that you think is large enough to hold all the
+ *     uncompressed data.  In this case, if the data decompresses to less than
+ *     or equal to 'out_nbytes_avail' bytes, then
+ *     libdeflate_deflate_decompress() will write the actual uncompressed size
+ *     to *actual_out_nbytes_ret and return 0 (LIBDEFLATE_SUCCESS).  Otherwise,
+ *     it will return LIBDEFLATE_INSUFFICIENT_SPACE if the provided buffer was
+ *     not large enough but no other problems were encountered, or another
+ *     nonzero result code if decompression failed for another reason.
+ */
+LIBDEFLATEAPI enum libdeflate_result
+libdeflate_deflate_decompress(struct libdeflate_decompressor *decompressor,
+			      const void *in, size_t in_nbytes,
+			      void *out, size_t out_nbytes_avail,
+			      size_t *actual_out_nbytes_ret);
+
+/*
+ * Like libdeflate_deflate_decompress(), but adds the 'actual_in_nbytes_ret'
+ * argument.  If decompression succeeds and 'actual_in_nbytes_ret' is not NULL,
+ * then the actual compressed size of the DEFLATE stream (aligned to the next
+ * byte boundary) is written to *actual_in_nbytes_ret.
+ */
+LIBDEFLATEAPI enum libdeflate_result
+libdeflate_deflate_decompress_ex(struct libdeflate_decompressor *decompressor,
+				 const void *in, size_t in_nbytes,
+				 void *out, size_t out_nbytes_avail,
+				 size_t *actual_in_nbytes_ret,
+				 size_t *actual_out_nbytes_ret);
+
+/*
+ * Like libdeflate_deflate_decompress(), but assumes the zlib wrapper format
+ * instead of raw DEFLATE.
+ *
+ * Decompression will stop at the end of the zlib stream, even if it is shorter
+ * than 'in_nbytes'.  If you need to know exactly where the zlib stream ended,
+ * use libdeflate_zlib_decompress_ex().
+ */
+LIBDEFLATEAPI enum libdeflate_result
+libdeflate_zlib_decompress(struct libdeflate_decompressor *decompressor,
+			   const void *in, size_t in_nbytes,
+			   void *out, size_t out_nbytes_avail,
+			   size_t *actual_out_nbytes_ret);
+
+/*
+ * Like libdeflate_zlib_decompress(), but adds the 'actual_in_nbytes_ret'
+ * argument.  If 'actual_in_nbytes_ret' is not NULL and the decompression
+ * succeeds (indicating that the first zlib-compressed stream in the input
+ * buffer was decompressed), then the actual number of input bytes consumed is
+ * written to *actual_in_nbytes_ret.
+ */
+LIBDEFLATEAPI enum libdeflate_result
+libdeflate_zlib_decompress_ex(struct libdeflate_decompressor *decompressor,
+			      const void *in, size_t in_nbytes,
+			      void *out, size_t out_nbytes_avail,
+			      size_t *actual_in_nbytes_ret,
+			      size_t *actual_out_nbytes_ret);
+
+/*
+ * Like libdeflate_deflate_decompress(), but assumes the gzip wrapper format
+ * instead of raw DEFLATE.
+ *
+ * If multiple gzip-compressed members are concatenated, then only the first
+ * will be decompressed.  Use libdeflate_gzip_decompress_ex() if you need
+ * multi-member support.
+ */
+LIBDEFLATEAPI enum libdeflate_result
+libdeflate_gzip_decompress(struct libdeflate_decompressor *decompressor,
+			   const void *in, size_t in_nbytes,
+			   void *out, size_t out_nbytes_avail,
+			   size_t *actual_out_nbytes_ret);
+
+/*
+ * Like libdeflate_gzip_decompress(), but adds the 'actual_in_nbytes_ret'
+ * argument.  If 'actual_in_nbytes_ret' is not NULL and the decompression
+ * succeeds (indicating that the first gzip-compressed member in the input
+ * buffer was decompressed), then the actual number of input bytes consumed is
+ * written to *actual_in_nbytes_ret.
+ */
+LIBDEFLATEAPI enum libdeflate_result
+libdeflate_gzip_decompress_ex(struct libdeflate_decompressor *decompressor,
+			      const void *in, size_t in_nbytes,
+			      void *out, size_t out_nbytes_avail,
+			      size_t *actual_in_nbytes_ret,
+			      size_t *actual_out_nbytes_ret);
+
+/*
+ * libdeflate_free_decompressor() frees a decompressor that was allocated with
+ * libdeflate_alloc_decompressor().  If a NULL pointer is passed in, no action
+ * is taken.
+ */
+LIBDEFLATEAPI void
+libdeflate_free_decompressor(struct libdeflate_decompressor *decompressor);
+
+/* ========================================================================== */
+/*                                Checksums                                   */
+/* ========================================================================== */
+
+/*
+ * libdeflate_adler32() updates a running Adler-32 checksum with 'len' bytes of
+ * data and returns the updated checksum.  When starting a new checksum, the
+ * required initial value for 'adler' is 1.  This value is also returned when
+ * 'buffer' is specified as NULL.
+ */
+LIBDEFLATEAPI uint32_t
+libdeflate_adler32(uint32_t adler, const void *buffer, size_t len);
+
+
+/*
+ * libdeflate_crc32() updates a running CRC-32 checksum with 'len' bytes of data
+ * and returns the updated checksum.  When starting a new checksum, the required
+ * initial value for 'crc' is 0.  This value is also returned when 'buffer' is
+ * specified as NULL.
+ */
+LIBDEFLATEAPI uint32_t
+libdeflate_crc32(uint32_t crc, const void *buffer, size_t len);
+
+/* ========================================================================== */
+/*                           Custom memory allocator                          */
+/* ========================================================================== */
+
+/*
+ * Install a custom memory allocator which libdeflate will use for all memory
+ * allocations by default.  'malloc_func' is a function that must behave like
+ * malloc(), and 'free_func' is a function that must behave like free().
+ *
+ * The per-(de)compressor custom memory allocator that can be specified in
+ * 'struct libdeflate_options' takes priority over this.
+ *
+ * This doesn't affect the free() function that will be used to free
+ * (de)compressors that were already in existence when this is called.
+ */
+LIBDEFLATEAPI void
+libdeflate_set_memory_allocator(void *(*malloc_func)(size_t),
+				void (*free_func)(void *));
+
+/*
+ * Advanced options.  This is the options structure that
+ * libdeflate_alloc_compressor_ex() and libdeflate_alloc_decompressor_ex()
+ * require.  Most users won't need this and should just use the non-"_ex"
+ * functions instead.  If you do need this, it should be initialized like this:
+ *
+ *	struct libdeflate_options options;
+ *
+ *	memset(&options, 0, sizeof(options));
+ *	options.sizeof_options = sizeof(options);
+ *	// Then set the fields that you need to override the defaults for.
+ */
+struct libdeflate_options {
+
+	/*
+	 * This field must be set to the struct size.  This field exists for
+	 * extensibility, so that fields can be appended to this struct in
+	 * future versions of libdeflate while still supporting old binaries.
+	 */
+	size_t sizeof_options;
+
+	/*
+	 * An optional custom memory allocator to use for this (de)compressor.
+	 * 'malloc_func' must be a function that behaves like malloc(), and
+	 * 'free_func' must be a function that behaves like free().
+	 *
+	 * This is useful in cases where a process might have multiple users of
+	 * libdeflate who want to use different memory allocators.  For example,
+	 * a library might want to use libdeflate with a custom memory allocator
+	 * without interfering with user code that might use libdeflate too.
+	 *
+	 * This takes priority over the "global" memory allocator (which by
+	 * default is malloc() and free(), but can be changed by
+	 * libdeflate_set_memory_allocator()).  Moreover, libdeflate will never
+	 * call the "global" memory allocator if a per-(de)compressor custom
+	 * allocator is always given.
+	 */
+	void *(*malloc_func)(size_t);
+	void (*free_func)(void *);
+};
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* LIBDEFLATE_H */
diff --git a/bsd/miscfs/apfs/libzbitmap/libzbitmap.c b/bsd/miscfs/apfs/libzbitmap/libzbitmap.c
new file mode 100644
--- /dev/null
+++ b/bsd/miscfs/apfs/libzbitmap/libzbitmap.c
@@ -0,0 +1,448 @@
+// SPDX-License-Identifier: GPL-2.0+ OR MIT (taken here under MIT)
+/*
+ * Copyright (C) 2022 Corellium LLC
+ *
+ * Author: Ernesto A. Fernández <ernesto@corellium.com>
+ *
+ * Ported from libzbitmap (https://github.com/eafer/libzbitmap). Only the
+ * decompression code is included.
+ */
+
+/* (the port: errno and memcmp/memcpy from where the kernel and the host tool each have them) */
+#ifdef KERNEL
+#include <sys/errno.h>
+#include <string.h>
+#else
+#include <errno.h>
+#include <string.h>
+#endif
+#include "libzbitmap.h"
+
+#define ZBM_MAGIC       "ZBM\x09"
+#define ZBM_MAGIC_SZ    4
+
+#define ZBM_MAX_DECMP_CHUNK_SIZE        0x8000
+#define ZBM_MAX_DECMP_CHUNK_SIZE_BITS   15
+
+struct uint24 {
+    uint8_t     low;
+    uint8_t     mid;
+    uint8_t     hig;
+};
+
+/* This header is shared by both compressed and decompressed chunks */
+struct zbm_chunk_hdr {
+    struct uint24   len;        /* Length of the chunk */
+    struct uint24   decmp_len;  /* Length of the chunk after decompression */
+};
+
+/* The full header for compressed chunks */
+struct zbm_cmp_chunk_hdr {
+    /* Shared with decompressed chunks */
+    struct zbm_chunk_hdr hdr;
+
+    /* Offset for each of the three metadata areas */
+    struct uint24   meta_off_1;
+    struct uint24   meta_off_2;
+    struct uint24   meta_off_3;
+};
+
+/* Pointer to a half-byte */
+struct nybl_ptr {
+    uint8_t         *addr;  /* Address of the byte */
+    int             nibble; /* Which of the two nibbles? */
+};
+
+/* 0-2 and 0xf are not real bitmap indexes */
+#define ZBM_BITMAP_COUNT        (16 - 1 - 3)
+#define ZBM_BITMAP_BASE         3
+#define ZBM_BITMAP_BYTECNT      17
+#define ZBM_MAX_PERIOD_BYTECNT  2
+
+struct zbm_bmap {
+    uint8_t     bitmap;         /* The bitmap */
+    uint8_t     period_bytecnt; /* Read this many bytes to get the new period */
+};
+
+struct zbm_state {
+    /* Updated during a chunk read */
+    uint8_t         *dest;      /* Write the next byte here */
+    size_t          dest_left;  /* Room left in destination buffer */
+    uint32_t        written;    /* Bytes written so far for current chunk */
+    uint16_t        period;     /* Repetition period for decompression, in bytes */
+
+    /* Updated right before a chunk read */
+    const uint8_t   *src_end;   /* End of current chunk */
+    uint32_t        len;        /* Length of the chunk */
+    uint32_t        decmp_len;  /* Expected chunk length after decompression */
+
+    /* Updated after a chunk read */
+    const uint8_t   *src;       /* Start of buffer, or current chunk if any */
+    size_t          src_left;   /* Room left in the source buffer */
+    size_t          prewritten; /* Bytes written for previous chunks */
+
+    /* Current position in data and metadata areas for this chunk */
+    const uint8_t   *data;
+    const uint8_t   *meta_1;
+    const uint8_t   *meta_2;
+    struct nybl_ptr meta_3;
+
+    /* Array of bitmaps for the current chunk */
+    struct zbm_bmap bitmaps[ZBM_BITMAP_COUNT];
+};
+
+static int zbm_check_magic(struct zbm_state *state)
+{
+    if(state->src_left < ZBM_MAGIC_SZ)
+        return -EINVAL;
+
+    if(memcmp(state->src, ZBM_MAGIC, ZBM_MAGIC_SZ))
+        return -EINVAL;
+
+    state->src += ZBM_MAGIC_SZ;
+    state->src_left -= ZBM_MAGIC_SZ;
+    return 0;
+}
+
+static uint32_t zbm_u24_to_u32(struct uint24 n)
+{
+    uint32_t res;
+
+    res = n.hig;
+    res <<= 8;
+    res += n.mid;
+    res <<= 8;
+    res += n.low;
+    return res;
+}
+
+/* Some chunks just have regular uncompressed data, but with a header */
+static int zbm_chunk_is_uncompressed(struct zbm_state *state)
+{
+    return state->len == state->decmp_len + sizeof(struct zbm_chunk_hdr);
+}
+
+static int zbm_handle_uncompressed_chunk(struct zbm_state *state)
+{
+    state->meta_1 = state->meta_2 = NULL;
+    state->meta_3.addr = NULL;
+    state->meta_3.nibble = 0;
+    state->data = state->src + sizeof(struct zbm_chunk_hdr);
+    memcpy(state->dest, state->data, state->decmp_len);
+
+    state->dest += state->decmp_len;
+    state->dest_left -= state->decmp_len;
+    state->written = state->decmp_len;
+    return 0;
+}
+
+static int zbm_read_nibble(struct nybl_ptr *nybl, const uint8_t *limit, uint8_t *result)
+{
+    if(nybl->addr >= limit)
+        return -EINVAL;
+
+    if(nybl->nibble == 0) {
+        *result = *nybl->addr & 0xf;
+        nybl->nibble = 1;
+    } else {
+        *result = (*nybl->addr >> 4) & 0xf;
+        nybl->nibble = 0;
+        ++nybl->addr;
+    }
+    return 0;
+}
+
+static void zbm_rewind_nibble(struct nybl_ptr *nybl)
+{
+    if(nybl->nibble == 0) {
+        nybl->nibble = 1;
+        --nybl->addr;
+    } else {
+        nybl->nibble = 0;
+    }
+}
+
+static int zbm_apply_bitmap(struct zbm_state *state, struct zbm_bmap *bitmap)
+{
+    int i;
+
+    /* The periods are stored in the first metadata area */
+    if(bitmap->period_bytecnt) {
+        state->period = 0;
+        for(i = 0; i < bitmap->period_bytecnt; ++i) {
+            if(state->meta_1 >= state->src_end)
+                return -EINVAL;
+            state->period |= *state->meta_1 << i * 8;
+            ++state->meta_1;
+        }
+    }
+    if(state->period == 0)
+        return -EINVAL;
+
+    for(i = 0; i < 8; ++i) {
+        if(state->written == state->decmp_len)
+            break;
+        if(bitmap->bitmap & 1 << i) {
+            if(state->data >= state->src_end)
+                return -EINVAL;
+            *state->dest = *state->data;
+            ++state->data;
+        } else {
+            if(state->prewritten + state->written < state->period)
+                return -EINVAL;
+            *state->dest = *(state->dest - state->period);
+        }
+        ++state->dest;
+        --state->dest_left;
+        ++state->written;
+    }
+
+    return 0;
+}
+
+static int zbm_apply_bitmap_number(struct zbm_state *state, uint8_t bmp_num)
+{
+    struct zbm_bmap next = {0};
+
+    /* Not a valid bitmap number (it signals a repetition) */
+    if(bmp_num == 0xf)
+        return -EINVAL;
+
+    /* An actual index in the bitmap array */
+    if(bmp_num > ZBM_MAX_PERIOD_BYTECNT)
+        return zbm_apply_bitmap(state, &state->bitmaps[bmp_num - ZBM_BITMAP_BASE]);
+
+    /* For < 2, use the next bitmap in the second metadata area */
+    if(state->meta_2 >= state->src_end)
+        return -EINVAL;
+    next.bitmap = *state->meta_2;
+    next.period_bytecnt = bmp_num;
+    ++state->meta_2;
+    return zbm_apply_bitmap(state, &next);
+}
+
+/* Find out how many times we need to repeat the current bitmap operation */
+static int zbm_read_repetition_count(struct zbm_state *state, uint16_t *repeat)
+{
+    uint8_t nibble;
+    uint16_t total;
+    int err;
+
+    /* Don't confuse the trailing bitmaps with a repetition count */
+    if(state->decmp_len - state->written <= 8) {
+        *repeat = 1;
+        return 0;
+    }
+
+    err = zbm_read_nibble(&state->meta_3, state->src_end, &nibble);
+    if(err)
+        return err;
+
+    if(nibble != 0xf) {
+        /* No repetition count: the previous bitmap number gets applied once */
+        zbm_rewind_nibble(&state->meta_3);
+        *repeat = 1;
+        return 0;
+    }
+
+    /*
+     * Under this scheme, repeating a bitmap number 3 times wouldn't save any
+     * space, so the repetition count starts from 4.
+     */
+    total = 4;
+    while(nibble == 0xf) {
+        err = zbm_read_nibble(&state->meta_3, state->src_end, &nibble);
+        if(err)
+            return err;
+        total += nibble;
+        if(total < nibble)
+            return -EINVAL;
+    }
+
+    *repeat = total;
+    return 0;
+}
+
+static int zbm_decompress_single_bitmap(struct zbm_state *state)
+{
+    uint8_t bmp_num;
+    uint16_t repeat;
+    int i;
+    int err;
+
+    /* The current nibble is the offset of the next bitmap to apply */
+    err = zbm_read_nibble(&state->meta_3, state->src_end, &bmp_num);
+    if(err)
+        return err;
+
+    err = zbm_read_repetition_count(state, &repeat);
+    if(err)
+        return err;
+
+    for(i = 0; i < repeat; ++i) {
+        err = zbm_apply_bitmap_number(state, bmp_num);
+        if(err)
+            return err;
+    }
+    return 0;
+}
+
+/* Pointer to a bit */
+struct bit_ptr {
+    uint8_t         *addr;  /* Address of the byte */
+    int             offset; /* Bit number */
+};
+
+/* This function does not perform boundary checks, the caller must do it */
+static int zbm_read_single_bit(struct bit_ptr *bit)
+{
+    int res = *bit->addr >> bit->offset & 1;
+
+    ++bit->offset;
+    if(bit->offset != 8)
+        return res;
+    bit->offset = 0;
+    ++bit->addr;
+    return res;
+}
+
+static int zbm_read_single_bitmap(struct bit_ptr *bit, const uint8_t *limit, struct zbm_bmap *result)
+{
+    int i;
+
+    result->bitmap = 0;
+    result->period_bytecnt = 0;
+
+    /* The bitmap itself */
+    for(i = 0; i < 8; ++i) {
+        if(bit->addr >= limit)
+            return -EINVAL;
+        result->bitmap |= zbm_read_single_bit(bit) << i;
+    }
+
+    /*
+     * The two trailing bits tell us how many bytes to read for the next
+     * repetition period
+     */
+    for(i = 0; i < 2; ++i) {
+        if(bit->addr >= limit)
+            return -EINVAL;
+        result->period_bytecnt |= zbm_read_single_bit(bit) << i;
+    }
+
+    return 0;
+}
+
+static int zbm_read_bitmaps(struct zbm_state *state)
+{
+    struct bit_ptr bmap = {0};
+    int err, i;
+
+    if(state->len < ZBM_BITMAP_BYTECNT)
+        return -EINVAL;
+
+    bmap.addr = (uint8_t *)state->src_end - ZBM_BITMAP_BYTECNT;
+    bmap.offset = 0;
+
+    for(i = 0; i < ZBM_BITMAP_COUNT; ++i) {
+        err = zbm_read_single_bitmap(&bmap, state->src_end, &state->bitmaps[i]);
+        if(err)
+            return err;
+        if(state->bitmaps[i].period_bytecnt > ZBM_MAX_PERIOD_BYTECNT)
+            return -EINVAL;
+    }
+    return 0;
+}
+
+static int zbm_handle_compressed_chunk(struct zbm_state *state)
+{
+    const struct zbm_cmp_chunk_hdr *hdr = NULL;
+    uint32_t meta_off_1, meta_off_2, meta_off_3;
+    int err;
+
+    state->written = 0;
+    state->period = 8;
+
+    if(state->len < sizeof(*hdr))
+        return -EINVAL;
+    hdr = (struct zbm_cmp_chunk_hdr *)state->src;
+    state->data = state->src + sizeof(*hdr);
+
+    meta_off_1 = zbm_u24_to_u32(hdr->meta_off_1);
+    meta_off_2 = zbm_u24_to_u32(hdr->meta_off_2);
+    meta_off_3 = zbm_u24_to_u32(hdr->meta_off_3);
+    if(meta_off_1 >= state->len || meta_off_2 >= state->len || meta_off_3 >= state->len)
+        return -EINVAL;
+    state->meta_1 = state->src + meta_off_1;
+    state->meta_2 = state->src + meta_off_2;
+    state->meta_3.addr = (uint8_t *)state->src + meta_off_3;
+    state->meta_3.nibble = 0;
+
+    err = zbm_read_bitmaps(state);
+    if(err)
+        return err;
+
+    while(state->written < state->decmp_len) {
+        err = zbm_decompress_single_bitmap(state);
+        if(err)
+            return err;
+    }
+
+    return 0;
+}
+
+static int zbm_handle_chunk(struct zbm_state *state)
+{
+    const struct zbm_chunk_hdr *decmp_hdr = NULL;
+
+    if(state->src_left < sizeof(*decmp_hdr))
+        return -EINVAL;
+    decmp_hdr = (struct zbm_chunk_hdr *)state->src;
+
+    state->len = zbm_u24_to_u32(decmp_hdr->len);
+    if(state->len > state->src_left)
+        return -EINVAL;
+    state->src_end = state->src + state->len;
+
+    state->decmp_len = zbm_u24_to_u32(decmp_hdr->decmp_len);
+    if(state->decmp_len > ZBM_MAX_DECMP_CHUNK_SIZE)
+        return -EINVAL;
+    if(!state->dest) /* We just wanted the length, so we are done */
+        return 0;
+    if(state->decmp_len > state->dest_left)
+        return -ERANGE;
+
+    if(zbm_chunk_is_uncompressed(state))
+        return zbm_handle_uncompressed_chunk(state);
+
+    return zbm_handle_compressed_chunk(state);
+}
+
+int zbm_decompress(void *dest, size_t dest_size, const void *src, size_t src_size, size_t *out_len)
+{
+    struct zbm_state state = {0};
+    int err;
+
+    state.src = src;
+    state.src_left = src_size;
+    state.dest = dest;
+    state.dest_left = dest_size;
+    state.prewritten = 0;
+
+    err = zbm_check_magic(&state);
+    if(err)
+        return err;
+
+    /* The final chunk has zero decompressed length */
+    do {
+        err = zbm_handle_chunk(&state);
+        if(err)
+            return err;
+        state.src += state.len;
+        state.src_left -= state.len;
+        state.prewritten += state.decmp_len;
+    } while(state.decmp_len != 0);
+
+    *out_len = state.prewritten;
+    return 0;
+}
diff --git a/bsd/miscfs/apfs/libzbitmap/libzbitmap.h b/bsd/miscfs/apfs/libzbitmap/libzbitmap.h
new file mode 100644
--- /dev/null
+++ b/bsd/miscfs/apfs/libzbitmap/libzbitmap.h
@@ -0,0 +1,31 @@
+/* SPDX-License-Identifier: GPL-2.0+ OR MIT (taken here under MIT) */
+/*
+ * Copyright (c) 2022 Corellium LLC
+ *
+ * Author: Ernesto A. Fernández <ernesto@corellium.com>
+ *
+ * Ported from libzbitmap (https://github.com/eafer/libzbitmap). Only the
+ * decompression code is included.
+ */
+
+#ifndef _LIBZBITMAP_H
+#define _LIBZBITMAP_H
+
+#include <stdint.h>
+#include <stddef.h>
+
+/**
+ * zbm_decompress - Decompress an LZBITMAP buffer
+ * @dest:       destination buffer (may be NULL)
+ * @dest_size:  size of the destination buffer
+ * @src:        source buffer
+ * @src_size:   size of the source buffer
+ * @out_len:    on return, the length of the decompressed output
+ *
+ * May be called with a NULL destination buffer to retrieve the expected length
+ * of the decompressed data. Returns 0 on success, or a negative error code in
+ * case of failure.
+ */
+int zbm_decompress(void *dest, size_t dest_size, const void *src, size_t src_size, size_t *out_len);
+
+#endif /* _LIBZBITMAP_H */
diff --git a/bsd/miscfs/ramfs/ramfs.c b/bsd/miscfs/ramfs/ramfs.c
new file mode 100644
--- /dev/null
+++ b/bsd/miscfs/ramfs/ramfs.c
@@ -0,0 +1,2095 @@
+/*
+ * ramfs: a read-write filesystem that lives entirely in kernel memory.
+ *
+ * The open-source kernel has no writable filesystem of its own, and the
+ * bring-up system has no storage driver, so /private/var and /tmp are kept
+ * here. Everything is lost at shutdown.
+ *
+ * Nodes (files, directories, symlinks, socket names) are plain kernel
+ * structures; a directory is a list of (name, node) entries, so hard links
+ * are just two entries naming one node. File contents are kept in
+ * individually allocated pages hanging off the node. That copy is the truth:
+ * read() and write() go straight to it, and the page cache is used only for
+ * mmap, with page-in and page-out copying between the two. After a write(),
+ * the pages of the page cache that hold what was written are brought up to
+ * date in place (ramfs_refresh_cache()).
+ *
+ * One mutex per mount guards all of it. It is never held while user memory
+ * is touched (a fault there could come back to this filesystem as a
+ * page-in): data moves through a bounce buffer instead.
+ *
+ * A node lives while it is named by a directory or has a vnode; after the
+ * last unlink it is freed when its vnode is reclaimed.
+ */
+
+#include <kern/assert.h>
+#include <kern/kalloc.h>
+#include <kern/locks.h>
+#include <libkern/libkern.h>
+#include <mach/vm_param.h>
+#include <sys/attr.h>
+#include <sys/dirent.h>
+#include <sys/errno.h>
+#include <sys/fcntl.h>
+#include <sys/mount_internal.h>
+#include <sys/namei.h>
+#include <sys/proc.h>
+#include <sys/queue.h>
+#include <sys/stat.h>
+#include <sys/systm.h>
+#include <sys/time.h>
+#include <sys/ubc.h>
+#include <sys/uio.h>
+#include <sys/unistd.h>
+#include <sys/vnode_internal.h>
+#include <sys/xattr.h>
+#include <uuid/uuid.h>
+#include <vfs/vfs_support.h>
+#include <vm/vm_kern.h>
+#include <vm/vm_kern_xnu.h>
+
+#define RAMFS_MAX_NAME          255
+#define RAMFS_MAX_XATTR         (16u * 1024 * 1024)
+#define RAMFS_ROOT_INO          2
+
+struct ramfs_mount;
+struct ramfs_node;
+
+struct ramfs_dirent {
+	TAILQ_ENTRY(ramfs_dirent) rd_link;
+	struct ramfs_node *rd_node;
+	char              *rd_name;             /* rd_namelen bytes and a terminator */
+	uint32_t           rd_namelen;
+};
+
+/* An extended attribute: iOS keeps container metadata, ACLs and much else in them. */
+struct ramfs_xattr {
+	TAILQ_ENTRY(ramfs_xattr) rx_link;
+	char   *rx_name;                        /* rx_namelen bytes and a terminator */
+	size_t  rx_namelen;
+	void   *rx_data;
+	size_t  rx_size;
+};
+
+struct ramfs_node {
+	struct ramfs_mount *rn_mount;
+	uint64_t            rn_ino;
+	enum vtype          rn_type;
+	uint32_t            rn_mode;            /* permission bits only */
+	uid_t               rn_uid;
+	gid_t               rn_gid;
+	uint32_t            rn_bsdflags;
+	uint32_t            rn_nlink;
+	uint32_t            rn_state;
+	vnode_t             rn_vp;
+	uint32_t            rn_vid;
+	struct timespec     rn_atime, rn_mtime, rn_ctime, rn_btime;
+	uint64_t            rn_size;            /* file: bytes; symlink: target length */
+
+	/* directory */
+	struct ramfs_node  *rn_parent;          /* NULL once the directory has been removed */
+	TAILQ_HEAD(, ramfs_dirent) rn_entries;
+	uint32_t            rn_nentries;
+
+	/* regular file */
+	void              **rn_pages;           /* rn_nslots slots; NULL is a hole that reads as zeros */
+	uint64_t            rn_nslots;
+	uint64_t            rn_nalloc;          /* pages actually allocated */
+	bool                rn_mapped_write;    /* has been mapped writable: the page cache may be ahead of us */
+
+	/* symlink */
+	char               *rn_target;
+
+	struct ramfs_node  *rn_hnext;           /* the next node in rm_hash's chain */
+	bool                rn_hashed;
+
+	TAILQ_HEAD(, ramfs_xattr) rn_xattrs;
+};
+#define RAMFS_N_CREATING        0x1         /* a thread is in vnode_create() for this node */
+#define RAMFS_N_WANTED          0x2         /* somebody sleeps on the node */
+
+struct ramfs_mount {
+	mount_t             rm_mp;
+	lck_mtx_t           rm_lock;
+	struct ramfs_node  *rm_root;
+	uint64_t            rm_next_ino;
+	uint64_t            rm_nodes;
+	uint64_t            rm_pages;           /* file pages in use */
+	uint64_t            rm_max_pages;
+	struct ramfs_node **rm_hash;            /* every node by its number, for vfs_vget */
+};
+
+#define RAMFS_HASH_SIZE         4096u       /* chains, a power of two */
+
+/* file pages in use on all the mounts together (each mount has its own lock): for the kernel's memory report */
+_Atomic uint64_t ramfs_pages_in_use;
+
+#define RAMFS_MP(mp)    ((struct ramfs_mount *)vfs_fsprivate(mp))
+#define RAMFS_NODE(vp)  ((struct ramfs_node *)vnode_fsnode(vp))
+
+static LCK_GRP_DECLARE(ramfs_lck_grp, "ramfs");
+
+extern int(**ramfs_vnodeop_p)(void *);
+
+/* ------------------------------------------------------------------------ */
+/* Nodes                                                                    */
+
+static struct ramfs_node *
+ramfs_node_alloc(struct ramfs_mount *rm, enum vtype type, struct vnode_attr *vap)
+{
+	struct ramfs_node *node = kalloc_type(struct ramfs_node, Z_WAITOK | Z_ZERO | Z_NOFAIL);
+	struct timespec now;
+
+	nanotime(&now);
+	node->rn_mount = rm;
+	node->rn_type = type;
+	node->rn_mode = type == VLNK ? 0755 : (type == VDIR ? 0755 : 0644);
+	node->rn_atime = node->rn_mtime = node->rn_ctime = node->rn_btime = now;
+	TAILQ_INIT(&node->rn_entries);
+	TAILQ_INIT(&node->rn_xattrs);
+
+	if (vap != NULL) {
+		if (VATTR_IS_ACTIVE(vap, va_mode)) {
+			node->rn_mode = vap->va_mode & ALLPERMS;
+			VATTR_SET_SUPPORTED(vap, va_mode);
+		}
+		if (VATTR_IS_ACTIVE(vap, va_uid)) {
+			node->rn_uid = vap->va_uid;
+			VATTR_SET_SUPPORTED(vap, va_uid);
+		}
+		if (VATTR_IS_ACTIVE(vap, va_gid)) {
+			node->rn_gid = vap->va_gid;
+			VATTR_SET_SUPPORTED(vap, va_gid);
+		}
+		if (VATTR_IS_ACTIVE(vap, va_flags)) {
+			node->rn_bsdflags = vap->va_flags;
+			VATTR_SET_SUPPORTED(vap, va_flags);
+		}
+		if (VATTR_IS_ACTIVE(vap, va_create_time)) {
+			node->rn_btime = vap->va_create_time;
+			VATTR_SET_SUPPORTED(vap, va_create_time);
+		}
+		if (VATTR_IS_ACTIVE(vap, va_modify_time)) {
+			node->rn_mtime = vap->va_modify_time;
+			VATTR_SET_SUPPORTED(vap, va_modify_time);
+		}
+		if (VATTR_IS_ACTIVE(vap, va_access_time)) {
+			node->rn_atime = vap->va_access_time;
+			VATTR_SET_SUPPORTED(vap, va_access_time);
+		}
+		if (VATTR_IS_ACTIVE(vap, va_change_time)) {
+			node->rn_ctime = vap->va_change_time;
+			VATTR_SET_SUPPORTED(vap, va_change_time);
+		}
+		VATTR_SET_SUPPORTED(vap, va_type);
+	}
+	return node;
+}
+
+/*
+ * A page of a file's contents, and giving it back. Not from a kalloc zone, as it once was: all the
+ * kernel's zones share one ceiling, and a few hundred MB of files in data.kalloc.16384 met it --
+ * first writes failing with ENOSPC ("there isn't enough space" while most of this filesystem's own
+ * allowance was free: dpkg's database could not be written), then, on an allocation that may not
+ * fail, the kernel panicked with the zone map exhausted. Straight from the VM instead, a wired page
+ * of kernel_map each, as the contents of a RAM disk are. wait=false: never wait for memory (the
+ * page-out path, which may be the pageout daemon looking for some).
+ */
+static void *
+ramfs_page_alloc(bool wait)
+{
+	vm_offset_t addr = 0;
+	kma_flags_t flags = KMA_KOBJECT | KMA_DATA | KMA_ZERO | (wait ? KMA_NONE : KMA_NOPAGEWAIT);
+
+	return kmem_alloc(kernel_map, &addr, PAGE_SIZE, flags, VM_KERN_MEMORY_FILE) == KERN_SUCCESS ?
+	       (void *)addr : NULL;
+}
+
+static void
+ramfs_page_free(void *page)
+{
+	kmem_free(kernel_map, (vm_offset_t)page, PAGE_SIZE);
+}
+
+/*
+ * Make the page array big enough for page `index`, before the mount lock is taken: under it the
+ * array can only grow by an allocation that does not wait (ramfs_grow_slots), and one that failed
+ * under memory pressure failed the write with ENOSPC. Nothing is promised: ramfs_store looks again.
+ */
+static void
+ramfs_reserve_slots(struct ramfs_mount *rm, struct ramfs_node *node, uint64_t index)
+{
+	for (int tries = 0; tries < 4; tries++) {
+		uint64_t have, want;
+		void **slots;
+
+		lck_mtx_lock(&rm->rm_lock);
+		have = node->rn_nslots;
+		lck_mtx_unlock(&rm->rm_lock);
+		if (index < have) {
+			return;
+		}
+		for (want = have ? have : 4; want <= index; want *= 2) {
+		}
+		slots = kalloc_type(void *, want, Z_WAITOK | Z_ZERO);
+		if (slots == NULL) {
+			return;
+		}
+		lck_mtx_lock(&rm->rm_lock);
+		if (node->rn_nslots == have) {
+			if (node->rn_pages != NULL) {
+				memcpy(slots, node->rn_pages, have * sizeof(void *));
+				kfree_type(void *, have, node->rn_pages);
+			}
+			node->rn_pages = slots;
+			node->rn_nslots = want;
+			slots = NULL;
+		}
+		lck_mtx_unlock(&rm->rm_lock);
+		if (slots == NULL) {
+			return;
+		}
+		kfree_type(void *, want, slots);        /* it grew meanwhile: look again */
+	}
+}
+
+/* Drop file pages from slot `from` on. The mount lock is held. */
+static void
+ramfs_free_pages(struct ramfs_node *node, uint64_t from)
+{
+	for (uint64_t i = from; i < node->rn_nslots; i++) {
+		if (node->rn_pages[i] != NULL) {
+			ramfs_page_free(node->rn_pages[i]);
+			node->rn_pages[i] = NULL;
+			node->rn_nalloc--;
+			node->rn_mount->rm_pages--;
+			os_atomic_dec(&ramfs_pages_in_use, relaxed);
+		}
+	}
+}
+
+static void
+ramfs_xattr_free(struct ramfs_xattr *xa)
+{
+	kfree_data(xa->rx_name, xa->rx_namelen + 1);
+	if (xa->rx_data != NULL) {
+		kfree_data(xa->rx_data, xa->rx_size);
+	}
+	kfree_type(struct ramfs_xattr, xa);
+}
+
+/*
+ * Nodes by their number. What asks for a file by number rather than by name -- fsgetpath(), and through
+ * it LaunchServices, which keeps an application as its volume and file number and finds the path again
+ * from them -- comes to vfs_vget, which this filesystem did not have: an application in /private/var
+ * (the package manager's prefix, /var/jb/Applications) could not be registered at all ("Unable to
+ * register"), while one on an APFS volume could. The mount lock is held.
+ */
+static void
+ramfs_hash_insert(struct ramfs_mount *rm, struct ramfs_node *node)
+{
+	struct ramfs_node **chain = &rm->rm_hash[node->rn_ino & (RAMFS_HASH_SIZE - 1)];
+
+	node->rn_hnext = *chain;
+	*chain = node;
+	node->rn_hashed = true;
+}
+
+static void
+ramfs_hash_remove(struct ramfs_mount *rm, struct ramfs_node *node)
+{
+	struct ramfs_node **link = &rm->rm_hash[node->rn_ino & (RAMFS_HASH_SIZE - 1)];
+
+	while (*link != NULL && *link != node) {
+		link = &(*link)->rn_hnext;
+	}
+	if (*link == node) {
+		*link = node->rn_hnext;
+	}
+	node->rn_hashed = false;
+}
+
+/* The node is named by nothing and has no vnode. The mount lock is held. */
+static void
+ramfs_node_free(struct ramfs_node *node)
+{
+	struct ramfs_xattr *xa;
+
+	if (node->rn_hashed) {
+		ramfs_hash_remove(node->rn_mount, node);
+	}
+
+	assert(TAILQ_EMPTY(&node->rn_entries));
+	while ((xa = TAILQ_FIRST(&node->rn_xattrs)) != NULL) {
+		TAILQ_REMOVE(&node->rn_xattrs, xa, rx_link);
+		ramfs_xattr_free(xa);
+	}
+	ramfs_free_pages(node, 0);
+	if (node->rn_pages != NULL) {
+		kfree_type(void *, node->rn_nslots, node->rn_pages);
+	}
+	if (node->rn_target != NULL) {
+		kfree_data(node->rn_target, node->rn_size + 1);
+	}
+	node->rn_mount->rm_nodes--;
+	kfree_type(struct ramfs_node, node);
+}
+
+static void
+ramfs_touch(struct ramfs_node *node, bool modified)
+{
+	struct timespec now;
+
+	nanotime(&now);
+	node->rn_ctime = now;
+	if (modified) {
+		node->rn_mtime = now;
+	}
+}
+
+static struct ramfs_dirent *
+ramfs_dirent_alloc(const char *name, size_t len)
+{
+	struct ramfs_dirent *de = kalloc_type(struct ramfs_dirent, Z_WAITOK | Z_ZERO | Z_NOFAIL);
+
+	de->rd_name = kalloc_data(len + 1, Z_WAITOK | Z_NOFAIL);
+	memcpy(de->rd_name, name, len);
+	de->rd_name[len] = '\0';
+	de->rd_namelen = (uint32_t)len;
+	return de;
+}
+
+static void
+ramfs_dirent_free(struct ramfs_dirent *de)
+{
+	kfree_data(de->rd_name, de->rd_namelen + 1);
+	kfree_type(struct ramfs_dirent, de);
+}
+
+static struct ramfs_dirent *
+ramfs_dir_find(struct ramfs_node *dir, const char *name, size_t len)
+{
+	struct ramfs_dirent *de;
+
+	TAILQ_FOREACH(de, &dir->rn_entries, rd_link) {
+		if (de->rd_namelen == len && memcmp(de->rd_name, name, len) == 0) {
+			return de;
+		}
+	}
+	return NULL;
+}
+
+static void
+ramfs_dir_add(struct ramfs_node *dir, struct ramfs_dirent *de, struct ramfs_node *node)
+{
+	de->rd_node = node;
+	TAILQ_INSERT_TAIL(&dir->rn_entries, de, rd_link);
+	dir->rn_nentries++;
+	ramfs_touch(dir, true);
+}
+
+static void
+ramfs_dir_remove(struct ramfs_node *dir, struct ramfs_dirent *de)
+{
+	TAILQ_REMOVE(&dir->rn_entries, de, rd_link);
+	dir->rn_nentries--;
+	ramfs_touch(dir, true);
+	ramfs_dirent_free(de);
+}
+
+/*
+ * Get the vnode of a node that is known to exist (it was just found in a
+ * directory, or is the root). Called with the mount lock held; returns with
+ * it dropped. 0: *vpp carries an iocount. EAGAIN: the node could not be
+ * pinned (its vnode is on the way out, or another thread is creating one)
+ * and may be gone by now; the caller must find it again.
+ */
+static int
+ramfs_vget_locked(struct ramfs_mount *rm, struct ramfs_node *node, vnode_t dvp, struct componentname *cnp, vnode_t *vpp)
+{
+	struct vnode_fsparam param;
+	vnode_t vp;
+	int error;
+
+	if (node->rn_state & RAMFS_N_CREATING) {
+		node->rn_state |= RAMFS_N_WANTED;
+		msleep(node, &rm->rm_lock, PINOD | PDROP, "ramfs_create", NULL);
+		return EAGAIN;
+	}
+	if (node->rn_vp != NULLVP) {
+		uint32_t vid = node->rn_vid;
+
+		vp = node->rn_vp;
+		lck_mtx_unlock(&rm->rm_lock);
+		if (vnode_getwithvid(vp, vid) == 0) {
+			*vpp = vp;
+			return 0;
+		}
+		/* being reclaimed: give it a moment */
+		tsleep(rm, PINOD, "ramfs_reclaim", 1);
+		return EAGAIN;
+	}
+
+	/* The CREATING mark keeps the node in place: nobody can unlink what they cannot get a vnode for. */
+	node->rn_state |= RAMFS_N_CREATING;
+	lck_mtx_unlock(&rm->rm_lock);
+
+	bzero(&param, sizeof(param));
+	param.vnfs_mp = rm->rm_mp;
+	param.vnfs_vtype = node->rn_type;
+	param.vnfs_str = "ramfs";
+	param.vnfs_dvp = dvp;
+	param.vnfs_fsnode = node;
+	param.vnfs_vops = ramfs_vnodeop_p;
+	param.vnfs_markroot = (node == rm->rm_root);
+	param.vnfs_filesize = node->rn_type == VREG ? (off_t)node->rn_size : 0;
+	param.vnfs_cnp = cnp;
+	/* names change under rename and unlink at any time: keep them out of the name cache */
+	param.vnfs_flags = VNFS_NOCACHE | VNFS_CANTCACHE;
+	error = vnode_create(VNCREATE_FLAVOR, VCREATESIZE, &param, &vp);
+
+	lck_mtx_lock(&rm->rm_lock);
+	if (!error) {
+		node->rn_vp = vp;
+		node->rn_vid = vnode_vid(vp);
+	}
+	if (node->rn_state & RAMFS_N_WANTED) {
+		wakeup(node);
+	}
+	node->rn_state &= ~(RAMFS_N_CREATING | RAMFS_N_WANTED);
+	lck_mtx_unlock(&rm->rm_lock);
+
+	if (!error) {
+		*vpp = vp;
+	}
+	return error;
+}
+
+/* ------------------------------------------------------------------------ */
+/* File contents                                                            */
+
+/* Make sure the page array has a slot for page `index`. The mount lock is held. */
+static int
+ramfs_grow_slots(struct ramfs_node *node, uint64_t index)
+{
+	uint64_t want = node->rn_nslots ? node->rn_nslots : 4;
+	void **slots;
+
+	if (index < node->rn_nslots) {
+		return 0;
+	}
+	while (want <= index) {
+		want *= 2;
+	}
+	slots = kalloc_type(void *, want, Z_NOWAIT | Z_ZERO);
+	if (slots == NULL) {
+		return ENOSPC;
+	}
+	if (node->rn_pages != NULL) {
+		memcpy(slots, node->rn_pages, node->rn_nslots * sizeof(void *));
+		kfree_type(void *, node->rn_nslots, node->rn_pages);
+	}
+	node->rn_pages = slots;
+	node->rn_nslots = want;
+	return 0;
+}
+
+/*
+ * Copy len bytes (within one page) into the file at offset off, extending
+ * the file if needed. *spare is a zeroed page the caller allocated without
+ * the lock; it is consumed if the slot was empty. The mount lock is held.
+ */
+static int
+ramfs_store(struct ramfs_node *node, uint64_t off, const void *src, size_t len, void **spare)
+{
+	struct ramfs_mount *rm = node->rn_mount;
+	uint64_t index = off / PAGE_SIZE;
+	int error = ramfs_grow_slots(node, index);
+
+	if (error) {
+		return error;
+	}
+	if (node->rn_pages[index] == NULL) {
+		if (*spare == NULL || rm->rm_pages >= rm->rm_max_pages) {
+			return ENOSPC;
+		}
+		node->rn_pages[index] = *spare;
+		*spare = NULL;
+		node->rn_nalloc++;
+		rm->rm_pages++;
+		os_atomic_inc(&ramfs_pages_in_use, relaxed);
+	}
+	memcpy((char *)node->rn_pages[index] + (off & PAGE_MASK), src, len);
+	if (off + len > node->rn_size) {
+		node->rn_size = off + len;
+	}
+	return 0;
+}
+
+/* Copy len bytes (within one page) out of the file; holes read as zeros. The mount lock is held. */
+static void
+ramfs_fetch(struct ramfs_node *node, uint64_t off, void *dst, size_t len)
+{
+	uint64_t index = off / PAGE_SIZE;
+
+	if (index < node->rn_nslots && node->rn_pages[index] != NULL) {
+		memcpy(dst, (char *)node->rn_pages[index] + (off & PAGE_MASK), len);
+	} else {
+		bzero(dst, len);
+	}
+}
+
+/* Change the file size; shrinking frees pages and clears the tail of the last one. The mount lock is held. */
+static void
+ramfs_resize(struct ramfs_node *node, uint64_t size)
+{
+	if (size < node->rn_size) {
+		uint64_t keep = (size + PAGE_MASK) / PAGE_SIZE;
+
+		ramfs_free_pages(node, keep);
+		if ((size & PAGE_MASK) != 0 && keep - 1 < node->rn_nslots && node->rn_pages[keep - 1] != NULL) {
+			bzero((char *)node->rn_pages[keep - 1] + (size & PAGE_MASK), PAGE_SIZE - (size & PAGE_MASK));
+		}
+	}
+	node->rn_size = size;
+	ramfs_touch(node, true);
+}
+
+/*
+ * What a write() has changed, into the pages of the page cache that hold it, where there are such
+ * pages: each is filled anew from the file, in place. Throwing them away instead, for the next
+ * page-in to fetch again, is not enough: the page cache cannot throw away a page that somebody
+ * holds wired, and that page goes on showing the file as it was. A surface made around memory that
+ * maps a file wires the pages under it (MiniIOSurface.cpp; CoreAnimation's window server makes one
+ * around every picture it shows, and the pictures of the home screen's icons are memory that maps
+ * IconServices' cache, a file here). When SpringBoard wrote the Calendar's new icon into that
+ * cache, the pages of the icon that it shares with the icons next to it were still held by those
+ * icons' surfaces: they kept the old icon, in the top 16 rows and the bottom 4 of the new one, and
+ * SpringBoard's own mapping of the cache, being of those very pages, showed the same.
+ */
+static void
+ramfs_refresh_cache(vnode_t vp, struct ramfs_node *node, uint64_t start, uint64_t end)
+{
+	struct ramfs_mount *rm = node->rn_mount;
+
+	for (uint64_t page = trunc_page_64(start); page < end; page += PAGE_SIZE) {
+		upl_t upl = NULL;
+		upl_page_info_t *pl = NULL;
+		vm_offset_t addr;
+		int flags = 0;
+
+		if (ubc_page_op(vp, (off_t)page, 0, NULL, &flags) != KERN_SUCCESS) {
+			continue;                       /* not in the page cache: the next page-in fetches it */
+		}
+		if (ubc_create_upl_kernel(vp, (off_t)page, PAGE_SIZE, &upl, &pl, UPL_SET_LITE | UPL_WILL_MODIFY,
+		    VM_KERN_MEMORY_FILE) != KERN_SUCCESS || upl == NULL) {
+			continue;
+		}
+		if (!upl_page_present(pl, 0) || ubc_upl_map(upl, &addr) != KERN_SUCCESS) {
+			/* (gone meanwhile: the page the request made is thrown away again) */
+			ubc_upl_abort_range(upl, 0, PAGE_SIZE, UPL_ABORT_FREE_ON_EMPTY);
+			continue;
+		}
+		lck_mtx_lock(&rm->rm_lock);
+		if (page < node->rn_size) {
+			size_t len = (size_t)MIN((uint64_t)PAGE_SIZE, node->rn_size - page);
+
+			ramfs_fetch(node, page, (void *)addr, len);
+			bzero((void *)(addr + len), PAGE_SIZE - len);
+		} else {
+			bzero((void *)addr, PAGE_SIZE);
+		}
+		lck_mtx_unlock(&rm->rm_lock);
+		ubc_upl_unmap(upl);
+		ubc_upl_commit_range(upl, 0, PAGE_SIZE, UPL_COMMIT_CLEAR_DIRTY | UPL_COMMIT_FREE_ON_EMPTY);
+	}
+}
+
+/* A mapping may hold changes that have not been paged out to us yet: get them. */
+static void
+ramfs_sync_mapping(vnode_t vp, struct ramfs_node *node)
+{
+	if (node->rn_mapped_write) {
+		(void)ubc_msync(vp, 0, ubc_getsize(vp), NULL, UBC_PUSHDIRTY | UBC_SYNC);
+	}
+}
+
+/* ------------------------------------------------------------------------ */
+/* Vnode operations                                                         */
+
+static int
+ramfs_lookup(struct vnop_lookup_args *ap)
+{
+	vnode_t dvp = ap->a_dvp;
+	struct componentname *cnp = ap->a_cnp;
+	struct ramfs_node *dir = RAMFS_NODE(dvp);
+	struct ramfs_mount *rm = dir->rn_mount;
+	int error;
+
+	*ap->a_vpp = NULLVP;
+	if (dir->rn_type != VDIR) {
+		return ENOTDIR;
+	}
+	if (cnp->cn_namelen == 1 && cnp->cn_nameptr[0] == '.') {
+		error = vnode_get(dvp);
+		if (!error) {
+			*ap->a_vpp = dvp;
+		}
+		return error;
+	}
+
+	do {
+		struct ramfs_node *target;
+		bool dotdot = (cnp->cn_flags & ISDOTDOT) != 0;
+
+		lck_mtx_lock(&rm->rm_lock);
+		if (dotdot) {
+			target = dir->rn_parent;
+		} else {
+			struct ramfs_dirent *de = ramfs_dir_find(dir, cnp->cn_nameptr, (size_t)cnp->cn_namelen);
+
+			target = de ? de->rd_node : NULL;
+		}
+		if (target == NULL) {
+			lck_mtx_unlock(&rm->rm_lock);
+			/* a name that may be created: tell VFS to go ahead (unless the directory itself is gone) */
+			if (!dotdot && dir->rn_nlink != 0 && (cnp->cn_flags & ISLASTCN) &&
+			    (cnp->cn_nameiop == CREATE || cnp->cn_nameiop == RENAME)) {
+				return EJUSTRETURN;
+			}
+			return ENOENT;
+		}
+		error = ramfs_vget_locked(rm, target, dotdot ? NULLVP : dvp, dotdot ? NULL : cnp, ap->a_vpp);
+	} while (error == EAGAIN);
+	return error;
+}
+
+/* create, mkdir, symlink and mknod are one operation with different node types */
+static int
+ramfs_make(vnode_t dvp, vnode_t *vpp, struct componentname *cnp, struct vnode_attr *vap, enum vtype type, const char *target)
+{
+	struct ramfs_node *dir = RAMFS_NODE(dvp);
+	struct ramfs_mount *rm = dir->rn_mount;
+	struct ramfs_node *node;
+	struct ramfs_dirent *de;
+	int error;
+
+	if (cnp->cn_namelen > RAMFS_MAX_NAME) {
+		return ENAMETOOLONG;
+	}
+	node = ramfs_node_alloc(rm, type, vap);
+	de = ramfs_dirent_alloc(cnp->cn_nameptr, (size_t)cnp->cn_namelen);
+	if (type == VLNK) {
+		node->rn_size = strlen(target);
+		node->rn_target = kalloc_data(node->rn_size + 1, Z_WAITOK | Z_NOFAIL);
+		memcpy(node->rn_target, target, node->rn_size + 1);
+	}
+
+	lck_mtx_lock(&rm->rm_lock);
+	rm->rm_nodes++;
+	if (dir->rn_nlink == 0) {
+		error = ENOENT;         /* the directory has been removed */
+	} else if (ramfs_dir_find(dir, cnp->cn_nameptr, (size_t)cnp->cn_namelen) != NULL) {
+		error = EEXIST;
+	} else {
+		error = 0;
+	}
+	if (error) {
+		ramfs_node_free(node);
+		lck_mtx_unlock(&rm->rm_lock);
+		ramfs_dirent_free(de);
+		return error;
+	}
+	node->rn_ino = rm->rm_next_ino++;
+	ramfs_hash_insert(rm, node);
+	if (type == VDIR) {
+		node->rn_nlink = 2;
+		node->rn_parent = dir;
+		dir->rn_nlink++;
+	} else {
+		node->rn_nlink = 1;
+	}
+	ramfs_dir_add(dir, de, node);
+
+	/* a fresh node has no vnode and no other suitor: this cannot ask for a retry */
+	error = ramfs_vget_locked(rm, node, dvp, cnp, vpp);
+	if (error) {
+		lck_mtx_lock(&rm->rm_lock);
+		ramfs_dir_remove(dir, de);
+		if (type == VDIR) {
+			dir->rn_nlink--;
+		}
+		ramfs_node_free(node);
+		lck_mtx_unlock(&rm->rm_lock);
+	}
+	return error;
+}
+
+static int
+ramfs_create(struct vnop_create_args *ap)
+{
+	return ramfs_make(ap->a_dvp, ap->a_vpp, ap->a_cnp, ap->a_vap, VREG, NULL);
+}
+
+static int
+ramfs_mkdir(struct vnop_mkdir_args *ap)
+{
+	return ramfs_make(ap->a_dvp, ap->a_vpp, ap->a_cnp, ap->a_vap, VDIR, NULL);
+}
+
+static int
+ramfs_symlink(struct vnop_symlink_args *ap)
+{
+	if (strlen(ap->a_target) >= MAXPATHLEN) {
+		return ENAMETOOLONG;
+	}
+	return ramfs_make(ap->a_dvp, ap->a_vpp, ap->a_cnp, ap->a_vap, VLNK, ap->a_target);
+}
+
+/* Only the name of a local socket can be made here (bind); devices live in devfs. */
+static int
+ramfs_mknod(struct vnop_mknod_args *ap)
+{
+	if (ap->a_vap->va_type != VSOCK) {
+		return ENOTSUP;
+	}
+	return ramfs_make(ap->a_dvp, ap->a_vpp, ap->a_cnp, ap->a_vap, VSOCK, NULL);
+}
+
+static int
+ramfs_remove(struct vnop_remove_args *ap)
+{
+	struct ramfs_node *dir = RAMFS_NODE(ap->a_dvp);
+	struct ramfs_node *node = RAMFS_NODE(ap->a_vp);
+	struct ramfs_mount *rm = dir->rn_mount;
+	struct ramfs_dirent *de;
+
+	if (node->rn_type == VDIR) {
+		return EPERM;
+	}
+	if ((ap->a_flags & VNODE_REMOVE_NODELETEBUSY) && vnode_isinuse(ap->a_vp, 0)) {
+		return EBUSY;
+	}
+	lck_mtx_lock(&rm->rm_lock);
+	de = ramfs_dir_find(dir, ap->a_cnp->cn_nameptr, (size_t)ap->a_cnp->cn_namelen);
+	if (de == NULL || de->rd_node != node) {
+		lck_mtx_unlock(&rm->rm_lock);
+		return ENOENT;
+	}
+	ramfs_dir_remove(dir, de);
+	node->rn_nlink--;
+	ramfs_touch(node, false);
+	lck_mtx_unlock(&rm->rm_lock);
+	/* with no links left the node goes away when its vnode does: see ramfs_inactive() */
+	return 0;
+}
+
+static int
+ramfs_rmdir(struct vnop_rmdir_args *ap)
+{
+	struct ramfs_node *dir = RAMFS_NODE(ap->a_dvp);
+	struct ramfs_node *node = RAMFS_NODE(ap->a_vp);
+	struct ramfs_mount *rm = dir->rn_mount;
+	struct ramfs_dirent *de;
+	int error = 0;
+
+	if (node->rn_type != VDIR) {
+		return ENOTDIR;
+	}
+	lck_mtx_lock(&rm->rm_lock);
+	de = ramfs_dir_find(dir, ap->a_cnp->cn_nameptr, (size_t)ap->a_cnp->cn_namelen);
+	if (de == NULL || de->rd_node != node) {
+		error = ENOENT;
+	} else if (node->rn_nentries != 0) {
+		error = ENOTEMPTY;
+	} else {
+		ramfs_dir_remove(dir, de);
+		dir->rn_nlink--;
+		node->rn_nlink = 0;
+		node->rn_parent = NULL;
+	}
+	lck_mtx_unlock(&rm->rm_lock);
+	return error;
+}
+
+static int
+ramfs_link(struct vnop_link_args *ap)
+{
+	struct ramfs_node *node = RAMFS_NODE(ap->a_vp);
+	struct ramfs_node *dir = RAMFS_NODE(ap->a_tdvp);
+	struct ramfs_mount *rm = dir->rn_mount;
+	struct componentname *cnp = ap->a_cnp;
+	struct ramfs_dirent *de;
+	int error = 0;
+
+	if (node->rn_type == VDIR) {
+		return EPERM;
+	}
+	if (cnp->cn_namelen > RAMFS_MAX_NAME) {
+		return ENAMETOOLONG;
+	}
+	de = ramfs_dirent_alloc(cnp->cn_nameptr, (size_t)cnp->cn_namelen);
+
+	lck_mtx_lock(&rm->rm_lock);
+	if (dir->rn_nlink == 0 || node->rn_nlink == 0) {
+		error = ENOENT;
+	} else if (ramfs_dir_find(dir, cnp->cn_nameptr, (size_t)cnp->cn_namelen) != NULL) {
+		error = EEXIST;
+	} else {
+		ramfs_dir_add(dir, de, node);
+		node->rn_nlink++;
+		ramfs_touch(node, false);
+		de = NULL;
+	}
+	lck_mtx_unlock(&rm->rm_lock);
+	if (de != NULL) {
+		ramfs_dirent_free(de);
+	}
+	return error;
+}
+
+static int
+ramfs_rename(struct vnop_rename_args *ap)
+{
+	struct ramfs_node *fdir = RAMFS_NODE(ap->a_fdvp);
+	struct ramfs_node *tdir = RAMFS_NODE(ap->a_tdvp);
+	struct ramfs_node *node = RAMFS_NODE(ap->a_fvp);
+	struct ramfs_mount *rm = node->rn_mount;
+	struct componentname *fcnp = ap->a_fcnp, *tcnp = ap->a_tcnp;
+	struct ramfs_dirent *fde, *tde, *spare;
+	int error = 0;
+
+	if (tcnp->cn_namelen > RAMFS_MAX_NAME) {
+		return ENAMETOOLONG;
+	}
+	spare = ramfs_dirent_alloc(tcnp->cn_nameptr, (size_t)tcnp->cn_namelen);
+
+	lck_mtx_lock(&rm->rm_lock);
+	fde = ramfs_dir_find(fdir, fcnp->cn_nameptr, (size_t)fcnp->cn_namelen);
+	tde = ramfs_dir_find(tdir, tcnp->cn_nameptr, (size_t)tcnp->cn_namelen);
+
+	if (fde == NULL || fde->rd_node != node || tdir->rn_nlink == 0) {
+		error = ENOENT;
+		goto out;
+	}
+	if (node->rn_type == VDIR) {
+		/* a directory cannot move into itself or below itself */
+		for (struct ramfs_node *up = tdir; up != NULL; up = (up == rm->rm_root) ? NULL : up->rn_parent) {
+			if (up == node) {
+				error = EINVAL;
+				goto out;
+			}
+		}
+	}
+	if (tde != NULL && tde->rd_node == node) {
+		/* two names of the same file: POSIX wants the rename to do nothing */
+		goto out;
+	}
+
+	if (tde != NULL) {
+		struct ramfs_node *victim = tde->rd_node;
+
+		if (victim->rn_type == VDIR) {
+			if (node->rn_type != VDIR) {
+				error = EISDIR;
+			} else if (victim->rn_nentries != 0) {
+				error = ENOTEMPTY;
+			}
+		} else if (node->rn_type == VDIR) {
+			error = ENOTDIR;
+		}
+		if (error) {
+			goto out;
+		}
+		if (victim->rn_type == VDIR) {
+			victim->rn_nlink = 0;
+			victim->rn_parent = NULL;
+			tdir->rn_nlink--;
+		} else {
+			victim->rn_nlink--;
+			ramfs_touch(victim, false);
+		}
+		tde->rd_node = node;
+		ramfs_touch(tdir, true);
+	} else {
+		ramfs_dir_add(tdir, spare, node);
+		spare = NULL;
+	}
+	ramfs_dir_remove(fdir, fde);
+	if (node->rn_type == VDIR && fdir != tdir) {
+		fdir->rn_nlink--;
+		tdir->rn_nlink++;
+		node->rn_parent = tdir;
+	}
+	ramfs_touch(node, false);
+out:
+	lck_mtx_unlock(&rm->rm_lock);
+	if (spare != NULL) {
+		ramfs_dirent_free(spare);
+	}
+	if (!error) {
+		vnode_update_identity(ap->a_fvp, ap->a_tdvp, tcnp->cn_nameptr, tcnp->cn_namelen, tcnp->cn_hash,
+		    VNODE_UPDATE_PARENT | VNODE_UPDATE_NAME);
+	}
+	return error;
+}
+
+/*
+ * renamex_np(2): RENAME_SWAP exchanges two names, RENAME_EXCL refuses an existing target. iOS writes
+ * files "atomically" by swapping a new copy in -- usermanagerd's user sessions and persona manifest in
+ * /private/var/keybags among them, and with ENOTSUP here it never saved them and aborted at every start.
+ */
+static int
+ramfs_renamex(struct vnop_renamex_args *ap)
+{
+	struct vnop_rename_args plain = {
+		.a_desc = &vnop_rename_desc, .a_fdvp = ap->a_fdvp, .a_fvp = ap->a_fvp, .a_fcnp = ap->a_fcnp,
+		.a_tdvp = ap->a_tdvp, .a_tvp = ap->a_tvp, .a_tcnp = ap->a_tcnp, .a_context = ap->a_context,
+	};
+	struct ramfs_node *fdir = RAMFS_NODE(ap->a_fdvp);
+	struct ramfs_node *tdir = RAMFS_NODE(ap->a_tdvp);
+	struct ramfs_node *fnode, *tnode;
+	struct ramfs_mount *rm;
+	struct componentname *fcnp = ap->a_fcnp, *tcnp = ap->a_tcnp;
+	struct ramfs_dirent *fde, *tde;
+	int error = 0;
+
+	if (ap->a_flags & ~(VFS_RENAME_SWAP | VFS_RENAME_EXCL)) {
+		return ENOTSUP;
+	}
+	if (ap->a_flags == VFS_RENAME_EXCL) {
+		if (ap->a_tvp != NULLVP) {
+			return EEXIST;
+		}
+		return ramfs_rename(&plain);
+	}
+	if (ap->a_flags != VFS_RENAME_SWAP) {
+		return EINVAL;
+	}
+	if (ap->a_tvp == NULLVP) {
+		return ENOENT;
+	}
+	fnode = RAMFS_NODE(ap->a_fvp);
+	tnode = RAMFS_NODE(ap->a_tvp);
+	rm = fnode->rn_mount;
+	if (fnode == tnode) {
+		return 0;
+	}
+
+	lck_mtx_lock(&rm->rm_lock);
+	fde = ramfs_dir_find(fdir, fcnp->cn_nameptr, (size_t)fcnp->cn_namelen);
+	tde = ramfs_dir_find(tdir, tcnp->cn_nameptr, (size_t)tcnp->cn_namelen);
+	if (fde == NULL || fde->rd_node != fnode || tde == NULL || tde->rd_node != tnode) {
+		error = ENOENT;
+		goto out;
+	}
+	/* neither may end up inside itself */
+	for (struct ramfs_node *up = tdir; fnode->rn_type == VDIR && up != NULL; up = (up == rm->rm_root) ? NULL : up->rn_parent) {
+		if (up == fnode) {
+			error = EINVAL;
+			goto out;
+		}
+	}
+	for (struct ramfs_node *up = fdir; tnode->rn_type == VDIR && up != NULL; up = (up == rm->rm_root) ? NULL : up->rn_parent) {
+		if (up == tnode) {
+			error = EINVAL;
+			goto out;
+		}
+	}
+	fde->rd_node = tnode;
+	tde->rd_node = fnode;
+	if (fdir != tdir) {
+		if (fnode->rn_type == VDIR) {
+			fdir->rn_nlink--;
+			tdir->rn_nlink++;
+			fnode->rn_parent = tdir;
+		}
+		if (tnode->rn_type == VDIR) {
+			tdir->rn_nlink--;
+			fdir->rn_nlink++;
+			tnode->rn_parent = fdir;
+		}
+	}
+	ramfs_touch(fdir, true);
+	ramfs_touch(tdir, true);
+	ramfs_touch(fnode, false);
+	ramfs_touch(tnode, false);
+out:
+	lck_mtx_unlock(&rm->rm_lock);
+	if (!error) {
+		vnode_update_identity(ap->a_fvp, ap->a_tdvp, tcnp->cn_nameptr, tcnp->cn_namelen, tcnp->cn_hash,
+		    VNODE_UPDATE_PARENT | VNODE_UPDATE_NAME);
+		vnode_update_identity(ap->a_tvp, ap->a_fdvp, fcnp->cn_nameptr, fcnp->cn_namelen, fcnp->cn_hash,
+		    VNODE_UPDATE_PARENT | VNODE_UPDATE_NAME);
+	}
+	return error;
+}
