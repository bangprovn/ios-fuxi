--- /dev/null
+++ b/bsd/miscfs/apfs/libdeflate/lib/zlib_decompress.c
@@ -0,0 +1,104 @@
+/*
+ * zlib_decompress.c - decompress with a zlib wrapper
+ *
+ * Copyright 2016 Eric Biggers
+ *
