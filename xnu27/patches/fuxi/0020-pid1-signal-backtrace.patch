+
 /*
  * Missing prototypes that Mach should export
  *
@@ -3190,6 +3195,11 @@ postsig_locked(int signum)
 		KERNEL_DEBUG_CONSTANT(BSDDBG_CODE(DBG_BSD_PROC, BSD_PROC_FRCEXIT) | DBG_FUNC_NONE,
 		    proc_getpid(p), W_EXITCODE(0, signum), 3, 0, 0);
 
+#if defined(FUXI)
