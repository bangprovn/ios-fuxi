+#if defined(FUXI)
+/* Boot-arg fuxi_proc_log=1: one console line per exec and per process exit (bring-up without logd). */
+bool
+fuxi_proc_log(void)
+{
+	static int on = -1;
+	if (on < 0) {
+		uint32_t v = 0;
+		on = (PE_parse_boot_argn("fuxi_proc_log", &v, sizeof(v)) && v == 1) ? 1 : 0;
+	}
+	return on == 1;
+}
