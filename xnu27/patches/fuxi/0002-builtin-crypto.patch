diff --git a/osfmk/prng/prng_random.c b/osfmk/prng/prng_random.c
index 504b3fa..0aa41d3 100644
--- a/osfmk/prng/prng_random.c
+++ b/osfmk/prng/prng_random.c
@@ -502,3 +502,140 @@ random_bool_gen_bits(struct bool_gen * bg, unsigned int * buffer, unsigned int c
 	}
 	return rbits;
 }
+
+#if defined(FUXI)
+/*
+ * FUXI boots without the corecrypto kext that normally installs the kernel
+ * PRNG. Install the built-in NIST HMAC-SHA256 DRBG that early_random already
+ * uses (osfmk/corecrypto). One mutex serializes generation and reseeding on
+ * all CPUs: a small, auditable bring-up generator, not a per-CPU one. Only
+ * the PRNG is registered, not the g_crypto_funcs table.
+ */
+#include <kern/startup.h>
+
+static LCK_GRP_DECLARE(fuxi_prng_group, "fuxi-prng");
+static LCK_MTX_DECLARE(fuxi_prng_lock, &fuxi_prng_group);
+static struct cckprng_ctx fuxi_prng_ctx;
+static const struct ccdrbg_nisthmac_custom fuxi_prng_custom = {
+	.di = &ccsha256_ltc_di,
+	.strictFIPS = 0,
+};
+static cckprng_getentropy fuxi_getentropy;
+static void *fuxi_getentropy_arg;
+static unsigned fuxi_max_ngens;
+static bool fuxi_generators[MAX_CPUS];
+
+static struct ccdrbg_state *
+fuxi_prng_state(struct cckprng_ctx *ctx)
+{
+	return (struct ccdrbg_state *)ctx->drbg_state;
+}
+
+static void
+fuxi_prng_check(int status)
+{
+	if (status != CCDRBG_STATUS_OK) {
+		panic("FUXI HMAC DRBG error %d", status);
+	}
+}
+
+static void
+fuxi_prng_init_with_getentropy(struct cckprng_ctx *ctx, unsigned max_ngens,
+    size_t seed_nbytes, const void *seed, size_t nonce_nbytes, const void *nonce,
+    cckprng_getentropy getentropy, void *getentropy_arg)
+{
+	assert(max_ngens > 0 && max_ngens <= MAX_CPUS);
+	ccdrbg_factory_nisthmac(&ctx->drbg_info, &fuxi_prng_custom);
+	assert(ctx->drbg_info.size <= sizeof(ctx->drbg_state));
+	const char ps[] = "xnu fuxi kernel random";
+	fuxi_prng_check(ccdrbg_init(&ctx->drbg_info, fuxi_prng_state(ctx),
+	    seed_nbytes, seed, nonce_nbytes, nonce, sizeof(ps) - 1, ps));
+	fuxi_getentropy = getentropy;
+	fuxi_getentropy_arg = getentropy_arg;
+	fuxi_max_ngens = max_ngens;
+}
+
+static void
+fuxi_prng_init(struct cckprng_ctx *ctx, size_t seed_nbytes, const void *seed,
+    size_t nonce_nbytes, const void *nonce, cckprng_getentropy getentropy,
+    void *getentropy_arg)
+{
+	fuxi_prng_init_with_getentropy(ctx, MAX_CPUS, seed_nbytes, seed,
+	    nonce_nbytes, nonce, getentropy, getentropy_arg);
+}
+
+static void
+fuxi_prng_initgen(__unused struct cckprng_ctx *ctx, unsigned gen_idx)
+{
+	lck_mtx_lock(&fuxi_prng_lock);
+	assert(gen_idx < fuxi_max_ngens);
+	assert(!fuxi_generators[gen_idx]);
+	fuxi_generators[gen_idx] = true;
+	lck_mtx_unlock(&fuxi_prng_lock);
+}
+
+static void
+fuxi_prng_reseed(struct cckprng_ctx *ctx, size_t nbytes, const void *seed)
+{
+	lck_mtx_lock(&fuxi_prng_lock);
+	fuxi_prng_check(ccdrbg_reseed(&ctx->drbg_info, fuxi_prng_state(ctx),
+	    nbytes, seed, 0, NULL));
+	lck_mtx_unlock(&fuxi_prng_lock);
+}
+
+static void
+fuxi_prng_refresh(struct cckprng_ctx *ctx)
+{
+	/* The entropy callback also uses try-lock; refresh must not wait. */
+	if (!lck_mtx_try_lock(&fuxi_prng_lock)) {
+		return;
+	}
+	uint8_t entropy[CCKPRNG_ENTROPY_SIZE];
+	size_t nbytes = sizeof(entropy);
+	int32_t nsamples = fuxi_getentropy(&nbytes, entropy, fuxi_getentropy_arg);
+	if (nsamples < 0) {
+		panic("FUXI PRNG entropy health test failed");
+	}
+	if (nsamples >= 256) {
+		assert(nbytes >= 32 && nbytes <= sizeof(entropy));
+		fuxi_prng_check(ccdrbg_reseed(&ctx->drbg_info, fuxi_prng_state(ctx),
+		    nbytes, entropy, 0, NULL));
+	}
+	cc_clear(sizeof(entropy), entropy);
+	lck_mtx_unlock(&fuxi_prng_lock);
+}
+
+static void
+fuxi_prng_generate(struct cckprng_ctx *ctx, unsigned gen_idx,
+    size_t nbytes, void *out)
+{
+	assert(nbytes <= CCKPRNG_GENERATE_MAX_NBYTES);
+	lck_mtx_lock(&fuxi_prng_lock);
+	assert(gen_idx < fuxi_max_ngens && fuxi_generators[gen_idx]);
+	fuxi_prng_check(ccdrbg_generate(&ctx->drbg_info, fuxi_prng_state(ctx),
+	    nbytes, out, 0, NULL));
+	lck_mtx_unlock(&fuxi_prng_lock);
+}
+
+__startup_func
+static void
+fuxi_prng_startup(void)
+{
+	if (prng_ready) {
+		return; /* a corecrypto kext started before EARLY_BOOT registered its own */
+	}
+	/* The boot seed must exist before registration erases the early DRBG. */
+	(void)early_random();
+	const struct cckprng_funcs funcs = {
+		.init = fuxi_prng_init,
+		.initgen = fuxi_prng_initgen,
+		.reseed = fuxi_prng_reseed,
+		.refresh = fuxi_prng_refresh,
+		.generate = fuxi_prng_generate,
+		.init_with_getentropy = fuxi_prng_init_with_getentropy,
+	};
+	register_and_init_prng(&fuxi_prng_ctx, &funcs);
+	kprintf("FUXI PRNG: HMAC-SHA256 DRBG registered\n");
+}
+STARTUP(EARLY_BOOT, STARTUP_RANK_FIRST, fuxi_prng_startup);
+#endif /* FUXI */
