diff --git a/libkern/crypto/corecrypto_rand.c b/libkern/crypto/corecrypto_rand.c
index d46815b..3ff4197 100644
--- a/libkern/crypto/corecrypto_rand.c
+++ b/libkern/crypto/corecrypto_rand.c
@@ -52,12 +52,50 @@ random_buf(void *buf, size_t buflen)
 	return cc_rand_generate(buf, buflen);
 }
 
+#if defined(FUXI)
+/*
+ * FUXI boots without the corecrypto kext. The kmem RNG contract permits a
+ * non-cryptographic, lock-free generator: per-CPU SplitMix64 state seeded
+ * from early_random() (the kernel's built-in HMAC-SHA256 DRBG). SplitMix64:
+ * Sebastiano Vigna, 2015, public-domain reference at
+ * https://prng.di.unimi.it/splitmix64.c. A corecrypto kext that registers
+ * before EARLY_BOOT replaces all of this.
+ */
+extern uint64_t early_random(void);
+
+struct fuxi_kmem_rng {
+	uint64_t state;
+};
+
+static uint64_t
+fuxi_kmem_random64(struct fuxi_kmem_rng *rng)
+{
+	uint64_t value = (rng->state += 0x9e3779b97f4a7c15ULL);
+	value = (value ^ (value >> 30)) * 0xbf58476d1ce4e5b9ULL;
+	value = (value ^ (value >> 27)) * 0x94d049bb133111ebULL;
+	return value ^ (value >> 31);
+}
+#endif /* FUXI */
+
 void
 crypto_random_generate(
 	crypto_random_ctx_t ctx,
 	void *random,
 	size_t random_size)
 {
+#if defined(FUXI)
+	if (!g_crypto_funcs) {
+		uint8_t *out = random;
+		while (random_size > 0) {
+			uint64_t value = fuxi_kmem_random64((struct fuxi_kmem_rng *)ctx);
+			size_t n = random_size < sizeof(value) ? random_size : sizeof(value);
+			memcpy(out, &value, n);
+			out += n;
+			random_size -= n;
+		}
+		return;
+	}
+#endif
 	g_crypto_funcs->random_generate_fn(ctx, random, random_size);
 }
 
@@ -67,12 +105,29 @@ crypto_random_uniform(
 	uint64_t bound,
 	uint64_t *random)
 {
+#if defined(FUXI)
+	if (!g_crypto_funcs) {
+		/* Reject the incomplete residue interval to avoid modulo bias. */
+		const uint64_t threshold = -bound % bound;
+		uint64_t value;
+		do {
+			value = fuxi_kmem_random64((struct fuxi_kmem_rng *)ctx);
+		} while (value < threshold);
+		*random = value % bound;
+		return;
+	}
+#endif
 	g_crypto_funcs->random_uniform_fn(ctx, bound, random);
 }
 
 size_t
 crypto_random_kmem_ctx_size(void)
 {
+#if defined(FUXI)
+	if (!g_crypto_funcs) {
+		return sizeof(struct fuxi_kmem_rng);
+	}
+#endif
 	return g_crypto_funcs->random_kmem_ctx_size_fn();
 }
 
@@ -80,5 +135,11 @@ void
 crypto_random_kmem_init(
 	crypto_random_ctx_t ctx)
 {
+#if defined(FUXI)
+	if (!g_crypto_funcs) {
+		((struct fuxi_kmem_rng *)ctx)->state = early_random();
+		return;
+	}
+#endif
 	g_crypto_funcs->random_kmem_init_fn(ctx);
 }
diff --git a/libkern/crypto/corecrypto_sha2.c b/libkern/crypto/corecrypto_sha2.c
index 7392f0c..eb5168a 100644
--- a/libkern/crypto/corecrypto_sha2.c
+++ b/libkern/crypto/corecrypto_sha2.c
@@ -31,37 +31,66 @@
 #include <libkern/libkern.h>
 #include <kern/debug.h>
 #include <corecrypto/ccdigest.h>
+#if defined(FUXI)
+#include <corecrypto/ccsha2.h>
+#endif
 
 #if defined(CRYPTO_SHA2)
 
+#if defined(FUXI)
+/*
+ * FUXI boots without the corecrypto kext. Until one registers, SHA-256 and
+ * SHA-512 use the digests the kernel already links for early_random
+ * (osfmk/corecrypto). SHA-384 has no built-in digest and still needs a kext.
+ */
+static const struct ccdigest_info *
+fuxi_sha2_di(const struct ccdigest_info *registered, const struct ccdigest_info *builtin, const char *name)
+{
+	if (g_crypto_funcs) {
+		return registered;
+	}
+	if (builtin == NULL) {
+		panic("%s: no corecrypto registered and no built-in digest", name);
+	}
+	return builtin;
+}
+#define SHA2_DI(field, builtin) fuxi_sha2_di(g_crypto_funcs ? g_crypto_funcs->field : NULL, builtin, __FUNCTION__)
+#define SHA2_INIT(di, ctx) (g_crypto_funcs ? g_crypto_funcs->ccdigest_init_fn(di, ctx) : ccdigest_init(di, ctx))
+#define SHA2_UPDATE(di, ctx, len, data) (g_crypto_funcs ? g_crypto_funcs->ccdigest_update_fn(di, ctx, len, data) : ccdigest_update(di, ctx, len, data))
+#else
+#define SHA2_DI(field, builtin) (g_crypto_funcs->field)
+#define SHA2_INIT(di, ctx) g_crypto_funcs->ccdigest_init_fn(di, ctx)
+#define SHA2_UPDATE(di, ctx, len, data) g_crypto_funcs->ccdigest_update_fn(di, ctx, len, data)
+#endif
+
 void
 SHA256_Init(SHA256_CTX *ctx)
 {
 	const struct ccdigest_info *di;
-	di = g_crypto_funcs->ccsha256_di;
+	di = SHA2_DI(ccsha256_di, &ccsha256_ltc_di);
 
 	/* Make sure the context size for the digest info fits in the one we have */
 	if (ccdigest_di_size(di) > sizeof(SHA256_CTX)) {
 		panic("%s: inconsistent size for SHA256 context", __FUNCTION__);
 	}
 
-	g_crypto_funcs->ccdigest_init_fn(di, ctx->ctx);
+	SHA2_INIT(di, ctx->ctx);
 }
 
 void
 SHA256_Update(SHA256_CTX *ctx, const void *data, size_t len)
 {
 	const struct ccdigest_info *di;
-	di = g_crypto_funcs->ccsha256_di;
+	di = SHA2_DI(ccsha256_di, &ccsha256_ltc_di);
 
-	g_crypto_funcs->ccdigest_update_fn(di, ctx->ctx, len, data);
+	SHA2_UPDATE(di, ctx->ctx, len, data);
 }
 
 void
 SHA256_Final(void *digest, SHA256_CTX *ctx)
 {
 	const struct ccdigest_info *di;
-	di = g_crypto_funcs->ccsha256_di;
+	di = SHA2_DI(ccsha256_di, &ccsha256_ltc_di);
 
 	ccdigest_final(di, ctx->ctx, digest);
 }
