+/*
+ * Fuxi: a stand-in IOSurface (boot-arg fuxi_fb=1, with FuxiFramebuffer.cpp).
+ *
+ * Fuxi has no IOSurface kext of its own: Apple's needs the GPU and display families around it,
+ * and CoreAnimation's window server (backboardd) cannot make a single buffer without it.
+ *
+ * Ported from hakios-arm64e-dada's MiniIOSurface.h (base/xnu/files/iokit/Kernel, APSL 2.0,
+ * a derivative work of XNU), which describes the situation and the protocol:
+ *
+ *   enough of it for the iOS window server and its clients to share pixel buffers on a machine
+ *   without Apple hardware. The protocol (user client selectors, traps and the layout of the
+ *   structures the kernel hands to IOSurface.framework) was worked out from the user-space side
+ *   of iOS 16.5 [and widened for iOS 26].
+ *
+ * The GPU's parts of it (snapshots of client memory, the GPU's submissions per surface) are left
+ * out: here only the processor draws, and the framebuffer copies what it drew.
+ */
+#ifndef _IOKIT_ARM_FUXIIOSURFACE_H
+#define _IOKIT_ARM_FUXIIOSURFACE_H
+
+#if defined(FUXI)
+#include <IOKit/IOService.h>
+#include <IOKit/IOUserClient.h>
+#include <IOKit/IOBufferMemoryDescriptor.h>
+
+#define FUXISURF_MAX_PLANES     4
+#define FUXISURF_RESULT_MAX     0xa68           /* what IOSurface.framework (iOS 16.5) reserves for a result */
+
+/* One plane, as IOSurface.framework reads it (0x80 bytes). */
+struct fuxisurf_plane {
+	uint32_t width;                         /* 0x00 */
+	uint32_t height;                        /* 0x04 */
+	uint32_t reserved08;
+	uint32_t offset;                        /* 0x0c from the base address */
+	uint32_t bytesPerRow;                   /* 0x10 */
+	uint32_t size;                          /* 0x14 */
+	uint16_t bytesPerElement;               /* 0x18 */
+	uint8_t  elementWidth;                  /* 0x1a */
+	uint8_t  elementHeight;                 /* 0x1b */
+	uint8_t  componentCount;                /* 0x1c */
+	uint8_t  addressFormat;                 /* 0x1d */
+	uint8_t  reserved1e[2];
+	uint8_t  componentBitDepth[4];          /* 0x20 */
+	uint8_t  componentBitOffset[4];         /* 0x24 */
+	uint8_t  componentName[4];              /* 0x28 */
+	uint8_t  componentType[4];              /* 0x2c */
+	uint8_t  componentRange[4];             /* 0x30 */
+	uint8_t  reserved34[0x20];
+	uint8_t  compression;                   /* 0x54: 1 = compressed, then there is no base address */
+	uint8_t  reserved55[0x1b];
+	uint32_t extendedPixels[4];             /* 0x70 */
+};
+
+/* What "create" and the lookups return: this header, then the planes (at least one). */
+struct fuxisurf_result {
+	uint64_t base;                          /* 0x00 where the memory is mapped in the client */
+	uint64_t shared;                        /* 0x08 struct fuxisurf_shared, mapped in the client */
+	uint64_t aux;                           /* 0x10 struct fuxisurf_aux, mapped in the client */
+	uint32_t sid;                           /* 0x18 */
+	uint32_t allocSize;                     /* 0x1c */
+	uint32_t width;                         /* 0x20 */
+	uint32_t height;                        /* 0x24 */
+	uint32_t bytesPerRow;                   /* 0x28 */
+	uint32_t offset;                        /* 0x2c */
+	uint32_t pixelFormat;                   /* 0x30 */
+	uint32_t reserved34;
+	uint32_t planeCount;                    /* 0x38 */
+	uint32_t reserved3c;
+	uint16_t bytesPerElement;               /* 0x40 */
+	uint8_t  elementWidth;                  /* 0x42 */
+	uint8_t  elementHeight;                 /* 0x43 */
+	uint32_t cacheMode;                     /* 0x44 */
+	uint32_t lockSeed;                      /* 0x48 the client keeps the seed of its last lock here */
+	uint8_t  subsampling;                   /* 0x4c */
+	uint8_t  prohibitUseCount;              /* 0x4d */
+	uint16_t reserved4e;
+	uint32_t parentID;                      /* 0x50 */
+	uint32_t sliceCount;                    /* 0x54 */
+	uint64_t traceID;                       /* 0x58 */
+	uint64_t protectionOptions;             /* 0x60 */
+};
+
+/* State that every client reads straight from memory shared with the kernel. */
+struct fuxisurf_shared {
+	uint64_t registryID;                    /* 0x00 */
+	uint16_t accelID;                       /* 0x08 */
+	uint16_t accelSubID;                    /* 0x0a */
+	uint32_t seed;                          /* 0x0c changes when somebody has written the pixels */
+	uint32_t reserved10;
+	uint8_t  tiled;                         /* 0x14 */
+	uint8_t  reserved15[3];
+	uint64_t useCount;                      /* 0x18 two 32-bit counters, one per category */
+	uint32_t valuesSeed;                    /* 0x20 */
+	uint32_t ycbcrMatrix;                   /* 0x24 */
+	uint32_t valuesSize;                    /* 0x28 room needed to fetch the values; 0 = none */
+	uint8_t  pixelSizeCasting;              /* 0x2c */
+	uint8_t  displayable;                   /* 0x2d */
+	uint8_t  sysMemOnly;                    /* 0x2e */
+	uint8_t  reserved2f;
+	uint8_t  attachments[0x70];             /* 0x30 the "bulk attachments" */
+};
+
+struct fuxisurf_aux {
+	uint64_t timestamps[4];
+	uint64_t detachModeCode;
+};
+
+#define FUXISURF_AUX_OFFSET     0x400           /* of the aux structure inside the shared page */
+
+class FuxiIOSurface : public OSObject
+{
+	OSDeclareDefaultStructors(FuxiIOSurface);
+
+public:
+	uint32_t                        sid;
+	uint32_t                        holders;        /* clients, send rights, kernel users */
+	IOBufferMemoryDescriptor *      memory;         /* one page of shared state, then the pixels */
+	uint8_t *                       kbase;          /* the same, in the kernel */
+	/*
+	 * ... unless the surface was made around memory its maker has already (IOSurfaceAddress):
+	 * then the pixels are that memory, held in place and seen from the kernel as well, and
+	 * `memory` is the page of shared state alone.
+	 */
+	IOMemoryDescriptor *            client;
+	IOMemoryMap *                   clientMap;
+	task_t                          clientTask;     /* whose memory it is (not held: only compared) */
+	mach_vm_address_t               clientAddress;  /* ... and where it is there */
+	uint8_t *                       kpixels;        /* where the pixel memory starts in the kernel, either way */
+	struct fuxisurf_result          info;           /* addresses not filled in */
+	struct fuxisurf_plane           planes[FUXISURF_MAX_PLANES];
+	OSDictionary *                  values;
+	uint32_t                        useCount[2];
+	uint32_t                        purgeable;
+	bool                            traced;         /* made by a program of boot-arg fuxi_surf_trace_of */
+
+	virtual bool
+	init(void) APPLE_KEXT_OVERRIDE
+	{
+		return OSObject::init();
+	}
+	virtual void free(void) APPLE_KEXT_OVERRIDE;
+
+	struct fuxisurf_shared *
+	shared(void) const
+	{
+		return (struct fuxisurf_shared *) kbase;
+	}
+	struct fuxisurf_aux *
+	aux(void) const
+	{
+		return (struct fuxisurf_aux *) (kbase + FUXISURF_AUX_OFFSET);
+	}
+	/* The first byte of the pixels (the "base address" clients see). */
+	uint8_t *
+	pixels(void) const
+	{
+		return kpixels + info.offset;
+	}
+	void updateValuesState(void);
+};
+
+/* Publishes IOService:/IOResources/IOCoreSurfaceRoot (FuxiFramebuffer.cpp fuxi_fb_start). */
+void            FuxiIOSurfaceStart(IOService * provider);
+/*
+ * For the framebuffer: a surface found or made here is held until FuxiIOSurfaceDrop().
+ */
+FuxiIOSurface * FuxiIOSurfaceCopy(uint32_t sid);
+FuxiIOSurface * FuxiIOSurfaceCreateSimple(uint32_t width, uint32_t height, uint32_t pixelFormat);
+void            FuxiIOSurfaceDrop(FuxiIOSurface * surface);
+/*
+ * What making and freeing surfaces has cost since this was last asked: how many, microseconds
+ * each; how many got memory that was kept from one before.
+ */
+void            FuxiIOSurfaceCost(uint32_t * made, uint64_t * making, uint32_t * freed, uint64_t * freeing, uint32_t * again);
+/* Clear the memory that is kept of surfaces that are gone, for the next ones: when the caller has a moment. */
+void            FuxiIOSurfaceClearKept(void);
+/* A Mach send right for the surface in the task (what IOSurfaceCreateMachPort gives); 0 on failure. */
+mach_port_name_t FuxiIOSurfaceMakeSendRight(task_t task, FuxiIOSurface * surface);
+
+/*
+ * pexpert/arm/pe_serial.c: the splash framebuffer the text console draws on (ADT /sweet-fbcon),
+ * which the panel scans out by itself.
+ */
+extern "C" {
+int  fuxi_fbcon_geometry(volatile void ** base, uint32_t * width, uint32_t * height, uint32_t * stride);
+void fuxi_fbcon_quiet(void);            /* the text console stops drawing (a panic still draws) */
+void fuxi_fbcon_flush(void);            /* a frame is written: out to memory, and the panel kicked if it needs it */
+}
+
+#endif /* FUXI */
+#endif /* _IOKIT_ARM_FUXIIOSURFACE_H */
