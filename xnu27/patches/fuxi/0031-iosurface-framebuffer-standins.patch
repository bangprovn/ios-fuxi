+/* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * */
+
+/* What a Mach send right for a surface points at. Holds the surface while any right exists. */
+/*
+ * hakios: IOSurfaceSharedEvent, the events processes signal each other's frames with (CoreAnimation, PosterKit): a value of 64 bits in a
+ * page every holder maps read-only, set through a trap, waited for through another, and listeners told by an asynchronous message
+ * once it reaches theirs. Missing, every poster's IOSurfaceSharedEventAddEventListener failed (e00002c7), no snapshot completed and
+ * the wallpaper stayed black (hakios g2k16). The event's port is the event object's own.
+ */
+/* The event: kept by an IOSurfaceSendRight (whose port is the event's) in memory of no type -- a class of its own was one kalloc type
+ * too many for its size (hakios g2k17 panicked at boot: KT_ZONES_FOR_SIZE_SIZE). */
+struct fuxi_event_data {
+	IOBufferMemoryDescriptor *      page;
+	volatile uint64_t *             value;
+	uint64_t                        id;
+};
+class IOSurfaceSendRight;
+typedef IOSurfaceSendRight FuxiSharedEvent;
+
+#define FUXI_EVENT_WAITS        512
+struct fuxi_event_wait {
+	FuxiSharedEvent *       event;          /* held while waiting */
+	void *                  client;         /* the user client that asked (forgotten as it closes) */
+	uint64_t                target;
+	OSAsyncReference64      ref;
+	io_user_reference_t     args[3];        /* the block, the event object, the value */
+};
+static IOLock * gEventLock;
+static struct fuxi_event_wait gEventWaits[FUXI_EVENT_WAITS];
+static uint64_t gEventIds;
+
+class IOSurfaceSendRight : public OSObject
+{
+	OSDeclareDefaultStructors(IOSurfaceSendRight);
+
+public:
+	FuxiIOSurface * surface;
+	struct fuxi_event_data * ev;            /* an IOSurfaceSharedEvent's, not a surface's */
+
+	virtual bool
+	init(void) APPLE_KEXT_OVERRIDE
+	{
+		return OSObject::init();
+	}
+	virtual void free(void) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(IOSurfaceSendRight, OSObject);
+
+void
+IOSurfaceSendRight::free(void)
+{
+	if (ev != NULL) {
+		OSSafeReleaseNULL(ev->page);
+		IOFreeData(ev, sizeof(*ev));
+		ev = NULL;
+	}
+	if (surface != NULL) {
+		FuxiIOSurfaceDrop(surface);
+	}
+	surface = NULL;
+	OSObject::free();
+}
