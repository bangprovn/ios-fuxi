+/* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * */
+
+class IOCoreSurfaceRoot : public IOService
+{
+	OSDeclareDefaultStructors(IOCoreSurfaceRoot);
+
+public:
+	virtual bool start(IOService * provider) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(IOCoreSurfaceRoot, IOService);
+
+bool
+IOCoreSurfaceRoot::start(IOService * provider)
+{
+	if (!IOService::start(provider)) {
+		return false;
+	}
+	setProperty(kIOUserClientClassKey, "IOSurfaceRootUserClient");
+	setName("IOCoreSurfaceRoot");
+	registerService();
+	return true;
+}
+
+void
+FuxiIOSurfaceStart(IOService * provider)
+{
+	IOCoreSurfaceRoot * root;
+
+	if (gSurfaceLock != NULL) {
+		return;                         /* (started once) */
+	}
+	gSurfaceLock = IOLockAlloc();
+	gSurfaceKeptLock = IOLockAlloc();
+	gEventLock = IOLockAlloc();
+	PE_parse_boot_argn("fuxi_surf_trace", &gSurfaceTrace, sizeof(gSurfaceTrace));
+	PE_parse_boot_argn("fuxi_surf_clear", &gSurfaceClear, sizeof(gSurfaceClear));
+	if (!PE_parse_boot_arg_str("fuxi_surf_trace_of", gSurfaceTraceOf, sizeof(gSurfaceTraceOf))) {
+		gSurfaceTraceOf[0] = 0;
+	}
+	gSurfaceClearing = thread_call_allocate(surfaceMemoryClear, NULL);
+	if (gSurfaceLock == NULL || gSurfaceKeptLock == NULL || gEventLock == NULL || gSurfaceClearing == NULL) {
+		IOLog("FuxiIOSurface: no locks\n");
+		return;
+	}
+	root = OSTypeAlloc(IOCoreSurfaceRoot);
+	if (root == NULL || !root->init() || !root->attach(provider)) {
+		OSSafeReleaseNULL(root);
+		IOLog("FuxiIOSurface: cannot create the root service\n");
+		return;
+	}
+	if (!root->start(provider)) {
+		root->detach(provider);
+		IOLog("FuxiIOSurface: the root service did not start\n");
+	}
+	root->release();
+}
