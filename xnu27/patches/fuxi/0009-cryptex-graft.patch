+/*
+ * The BSD name ("diskNsM") of a window's partition, for fuxi_root27_graft() in the built-in
+ * APFS: matched on the UUID publish() gave it, waiting up to timeout_ms for the media and
+ * for its BSD client to name it. 0 or an errno.
+ */
+extern "C" int
+fuxi_root27_bsdname(const char *window, char *out, size_t len, uint32_t timeout_ms)
+{
+	char uuid[37];
+	unsigned i;
+	for (i = 0; i < fr.nwin && strncmp(fr.win[i].name, window, sizeof(fr.win[i].name)); i++) {
+	}
+	if (i == fr.nwin) {
+		return ENOENT;
+	}
+	fx27_window_uuid(fr.win[i].sha256, uuid);
+	const OSSymbol *key = OSSymbol::withCString(kIOMediaUUIDKey);
+	OSString *value = OSString::withCString(uuid);
+	OSDictionary *match = IOService::serviceMatching("IOMedia");
+	IOService *media = NULL;
+	int error = ENOMEM;
+	if (key && value && match && IOService::propertyMatching(key, value, match)) {
+		media = IOService::waitForMatchingService(match, (uint64_t)timeout_ms * kMillisecondScale);
+		error = ETIMEDOUT;
+	}
+	for (uint32_t t = 0; media && t <= timeout_ms; t += 10) {
+		OSString *name = OSDynamicCast(OSString, media->getProperty("BSD Name"));
+		if (name) {
+			error = strlcpy(out, name->getCStringNoCopy(), len) < len ? 0 : ENAMETOOLONG;
+			break;
+		}
+		IOSleep(10);
+	}
+	OSSafeReleaseNULL(media);
+	OSSafeReleaseNULL(match);
+	OSSafeReleaseNULL(value);
+	OSSafeReleaseNULL(key);
+	return error;
+}
