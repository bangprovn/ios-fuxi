+#if defined(FUXI)
+/*
+ * Boot-arg fuxi_root27_cryptex=1: the IPSW OS volume keeps the dyld shared cache in the
+ * SystemOS cryptex (and Safari's pieces in AppOS), which libignition grafts on a real boot.
+ * With ignition skipped (dyld_flags=8) the kernel mounts them before launchd: SystemOS at
+ * /private/preboot/Cryptexes/OS (where /System/Cryptexes/OS points), AppOS at .../App, and the
+ * cache directory of SystemOS once more at /System/Library/Caches/com.apple.dyld, the only
+ * place dyld looks without ignition. Mount points are synthetic directories of the root.
+ */
+extern int fuxi_root27_bsdname(const char *window, char *out, size_t len, uint32_t timeout_ms);
+
+static int
+fuxi_graft_dir(char *buf, const char *path)
+{
+	int error;
+
+	strlcpy(buf, path, MAXPATHLEN);
+	error = apfs_synthetic_make(buf);
+	return error == EEXIST ? 0 : error;
+}
+
+static int
+fuxi_graft_one(const char *window, const char *sub, const char *at, mount_t *mpp)
+{
+	char dev[32] = "";
+	char *buf = kalloc_data(MAXPATHLEN, Z_WAITOK | Z_ZERO);
+	vnode_t vp = NULLVP;
+	int error;
+
+	if (buf == NULL) {
+		return ENOMEM;
+	}
+	error = fuxi_root27_bsdname(window, dev, sizeof(dev), 10000);
+	if (error == 0) {
+		error = fuxi_graft_dir(buf, at);
+	}
+	if (error == 0) {
+		snprintf(buf, MAXPATHLEN, "/dev/%s%s%s", dev, sub != NULL ? ",sub=" : "", sub != NULL ? sub : "");
+		error = kernel_mount("apfs", NULLVP, NULLVP, at, buf, strlen(buf) + 1, MNT_RDONLY,
+		    KERNEL_MOUNT_NOAUTH, vfs_context_kernel());
+	}
+	if (error == 0 && (error = vnode_lookup(at, 0, &vp, vfs_context_kernel())) == 0) {
+		*mpp = vnode_mount(vp);
+		vnode_put(vp);
+	}
+	printf("fuxi: cryptex %s (%s%s%s) at %s: %d\n", window, dev, sub != NULL ? " " : "",
+	    sub != NULL ? sub : "", at, error);
+	kfree_data(buf, MAXPATHLEN);
+	return error;
+}
+
+void
+fuxi_root27_graft(void)
+{
+	char *buf;
+	uint32_t on = 0;
+
+	if (!PE_parse_boot_argn("fuxi_root27_cryptex", &on, sizeof(on)) || on != 1) {
+		return;
+	}
+	if (rootvnode == NULLVP || strcmp(vfs_statfs(vnode_mount(rootvnode))->f_fstypename, "apfs") != 0) {
+		printf("fuxi: cryptex graft needs the built-in APFS as root\n");
+		return;
+	}
+	buf = kalloc_data(MAXPATHLEN, Z_WAITOK | Z_ZERO);
+	if (buf == NULL || fuxi_graft_dir(buf, "/private/preboot/Cryptexes") != 0) {
+		printf("fuxi: cannot make /private/preboot/Cryptexes\n");
+	} else {
+		(void)fuxi_graft_one("SystemOS", NULL, "/private/preboot/Cryptexes/OS", &fuxi_root27_cryptex_mp[0]);
+		(void)fuxi_graft_one("SystemOS", "/System/Library/Caches/com.apple.dyld",
+		    "/System/Library/Caches/com.apple.dyld", &fuxi_root27_cryptex_mp[1]);
+		(void)fuxi_graft_one("AppOS", NULL, "/private/preboot/Cryptexes/App", &fuxi_root27_cryptex_mp[2]);
+	}
+	if (buf != NULL) {
+		kfree_data(buf, MAXPATHLEN);
+	}
+}
+#endif /* FUXI */
