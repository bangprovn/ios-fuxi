diff --git a/bsd/kern/kern_exit.c b/bsd/kern/kern_exit.c
index c10a08a..b9e20be 100644
--- a/bsd/kern/kern_exit.c
+++ b/bsd/kern/kern_exit.c
@@ -1972,6 +1972,32 @@ fuxi_proc_log(void)
 	}
 	return on == 1;
 }
+
+extern void IOSleep(unsigned int milliseconds);
+
+/* With fuxi_proc_log=1: what pid 1's threads are doing, every 20 s for 8 minutes. */
+static void
+fuxi_proc_watch(__unused void *arg, __unused wait_result_t wr)
+{
+	for (int i = 0; i < 24; i++) {
+		IOSleep(i == 0 ? 15000 : 20000);
+		proc_t p = proc_find(1);
+		if (p != PROC_NULL) {
+			fuxi_task_report(proc_task(p), 1);
+			proc_rele(p);
+		}
+	}
+}
+
+void
+fuxi_proc_watch_start(void)
+{
+	thread_t thread;
+
+	if (fuxi_proc_log() && kernel_thread_start(fuxi_proc_watch, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
 #endif
 
