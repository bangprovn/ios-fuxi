@@ -109,6 +109,40 @@ static LCK_SPIN_DECLARE_ATTR(g_bank_task_lock_data, &bank_lock_grp, &bank_lock_a
 static TUNABLE(bool, disable_persona_propagate_check,
     "disable_persona_propagate_check", false);
 
+#if defined(FUXI)
+#include <pexpert/pexpert.h>
+extern void proc_name(int pid, char *buf, int size);
+
+/*
+ * fuxi_bank_log=NAME[,NAME]: log the persona a bank task (a process's side of a voucher) gets, and every
+ * persona query of a voucher, for the processes whose names are in the list. To see what containermanagerd
+ * learns of a client's persona (it answers INVALID_PERSONA).
+ */
+static bool
+fuxi_bank_log_wanted(int pid, char *name, int size)
+{
+	static char list[128];
+	static int parsed;
+	static int logged;
+
+	if (!parsed) {
+		parsed = 1;
+		if (!PE_parse_boot_argn("fuxi_bank_log", list, sizeof(list))) {
+			list[0] = '\0';
+		}
+	}
+	if (list[0] == '\0' || logged >= 400) {
+		return false;
+	}
+	proc_name(pid, name, size);
+	if (name[0] == '\0' || strnstr(list, name, sizeof(list)) == NULL) {
+		return false;
+	}
+	logged++;
+	return true;
+}
+#endif
+
