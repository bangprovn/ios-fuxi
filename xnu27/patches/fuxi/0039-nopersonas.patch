+		}
+		if (nopersonas) {
+			uid_t fake = id != PERSONA_ID_NONE ? id : fake_id++;
+
+			printf("fuxi: persona %u (%s) not made (fuxi_nopersonas)\n", fake, login != NULL ? login : "-");
+			kinfo.persona_id = fake;
+			error = copyout(&fake, idp, sizeof(fake));
+			if (error == 0) {
+				error = kpersona_copyout(&kinfo, infop);
+			}
+			return error;
+		}
+	}
+
