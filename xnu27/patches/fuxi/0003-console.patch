diff --git a/osfmk/arm64/fuxi_console.c b/osfmk/arm64/fuxi_console.c
new file mode 100644
index 0000000..a9bca31
--- /dev/null
+++ b/osfmk/arm64/fuxi_console.c
@@ -0,0 +1,93 @@
+/*
+ * Fuxi bring-up console (see fuxi_console.h). No allocation, locks or ADT
+ * parsing: it runs from arm_init before the VM is up and from panic().
+ *
+ * tools/fuxi-xnu-monitor.py finds these by name in the unstripped kernel's
+ * symbol table: _fuxi_early_status, _sweet_log_ring and _sweet_log_total
+ * (the names are shared with the xnu-8796 kernel so one host tool reads both).
+ */
+#include <arm64/fuxi_console.h>
+
+#if defined(FUXI)
+#include <kern/assert.h>
+#include <machine/atomic.h>
+
+/* Initialized data, so the record exists (and says "not entered") before XNU runs. */
+struct fuxi_early_record {
+	uint64_t stage;
+	char text[120];
+};
+volatile struct fuxi_early_record fuxi_early_status __attribute__((aligned(64), used)) = {
+	0x4655584900000000ULL, "not entered"
+};
+
+#define SWEET_LOG_SIZE (4u << 20)
+static char sweet_log_ring[SWEET_LOG_SIZE] __attribute__((aligned(64), used));
+static uint64_t _Atomic sweet_log_total __attribute__((aligned(64), used));
+
+static inline void
+fuxi_clean_line(const volatile void *p)
+{
+	__asm__ volatile ("dc cvac, %0" :: "r"(p) : "memory");
+}
+
+void
+fuxi_early_mark(unsigned int stage, const char *label)
+{
+	fuxi_early_status.stage = 0x10000u + stage;
+	unsigned int i = 0;
+	while (label && label[i] && i < sizeof(fuxi_early_status.text) - 1) {
+		fuxi_early_status.text[i] = label[i];
+		i++;
+	}
+	fuxi_early_status.text[i] = 0;
+	for (uintptr_t p = (uintptr_t)&fuxi_early_status;
+	    p < (uintptr_t)&fuxi_early_status + sizeof(fuxi_early_status); p += 64) {
+		fuxi_clean_line((const volatile void *)p);
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
+
+void
+fuxi_log_append(const char *c, int size)
+{
+	if (size <= 0) {
+		return;
+	}
+	uint64_t at = os_atomic_add_orig(&sweet_log_total, (uint64_t)size, relaxed);
+	for (int i = 0; i < size; i++) {
+		uint64_t slot = (at + (uint64_t)i) % SWEET_LOG_SIZE;
+		sweet_log_ring[slot] = c[i];
+		/* Publish each finished 64-byte line, the ring's end and the last byte. */
+		if (((uintptr_t)&sweet_log_ring[slot] & 63) == 63 || slot == SWEET_LOG_SIZE - 1 || i == size - 1) {
+			fuxi_clean_line(&sweet_log_ring[slot]);
+		}
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+	fuxi_clean_line(&sweet_log_total);
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
+
+uint64_t
+fuxi_log_position(void)
+{
+	return os_atomic_load(&sweet_log_total, relaxed);
+}
+
+/* Copy bytes from *pos on; skips ahead if the ring has already overwritten them. */
+size_t
+fuxi_log_copy(uint64_t *pos, char *out, size_t len)
+{
+	uint64_t total = os_atomic_load(&sweet_log_total, relaxed);
+	if (total - *pos > SWEET_LOG_SIZE) {
+		*pos = total - SWEET_LOG_SIZE;
+	}
+	size_t n = 0;
+	while (n < len && *pos + n < total) {
+		out[n] = sweet_log_ring[(*pos + n) % SWEET_LOG_SIZE];
+		n++;
+	}
+	*pos += n;
+	return n;
+}
+#endif /* FUXI */
diff --git a/osfmk/arm64/fuxi_console.h b/osfmk/arm64/fuxi_console.h
new file mode 100644
index 0000000..5df82b0
--- /dev/null
+++ b/osfmk/arm64/fuxi_console.h
@@ -0,0 +1,30 @@
+/*
+ * Fuxi bring-up console: a RAM log ring and an early-stage record that the
+ * loader's native USB monitor (cpu@100, outside XNU) reads by physical
+ * address with its own MMU and caches off. Every write is cleaned to the
+ * point of coherency so the monitor never needs to snoop XNU's caches.
+ */
+#ifndef _ARM64_FUXI_CONSOLE_H_
+#define _ARM64_FUXI_CONSOLE_H_
+
+#include <sys/cdefs.h>
+#include <stddef.h>
+#include <stdint.h>
+
+#if defined(FUXI)
+__BEGIN_DECLS
+void fuxi_early_mark(unsigned int stage, const char *label);
+void fuxi_log_append(const char *c, int size);
+uint64_t fuxi_log_position(void);
+size_t fuxi_log_copy(uint64_t *pos, char *out, size_t len);
+__END_DECLS
+#else
+static inline void
+fuxi_early_mark(unsigned int stage, const char *label)
+{
+	(void)stage;
+	(void)label;
+}
+#endif
+
+#endif /* _ARM64_FUXI_CONSOLE_H_ */
diff --git a/osfmk/arm64/start.s b/osfmk/arm64/start.s
index 05d38d6..3240d9c 100644
--- a/osfmk/arm64/start.s
+++ b/osfmk/arm64/start.s
@@ -75,6 +75,22 @@
 #endif
 .endmacro
 
+#if defined(FUXI)
+/*
+ * Record a boot stage in fuxi_early_status for the loader's USB monitor
+ * (osfmk/arm64/fuxi_console.c). Clobbers x16 and x17. With the MMU off the
+ * store reaches memory directly; with it on, the line is cleaned.
+ */
+.macro FUXI_EARLY_STAGE stage
+	adrp	x16, EXT(fuxi_early_status)@page
+	add		x16, x16, EXT(fuxi_early_status)@pageoff
+	mov		x17, #\stage
+	str		x17, [x16]
+	dc		cvac, x16
+	dsb		sy
+.endmacro
+#endif /* FUXI */
+
 .macro MSR_SCTLR_EL1_X0
 #if defined(KERNEL_INTEGRITY_KTRR)
 	mov		x1, lr
@@ -472,6 +488,9 @@ start_cpu:
 	.align 2
 	.globl EXT(start_first_cpu)
 LEXT(start_first_cpu)
+#if defined(FUXI)
+	FUXI_EARLY_STAGE 1
+#endif
 
 	// Unlock the core for debugging
 	msr		OSLAR_EL1, xzr
@@ -655,6 +674,9 @@ Lbootstrap_tables_ready:
  *	TPIDRRO_EL0 - CPU number
  */
 common_start:
+#if defined(FUXI)
+	FUXI_EARLY_STAGE 2
+#endif
 
 #if HAS_NEX_PG
 	mov x19, lr
@@ -760,9 +782,15 @@ common_start:
 #endif /* HAS_APPLE_PAC */
 
 	// Enable caches, MMU, ROP and JOP
+#if defined(FUXI)
+	FUXI_EARLY_STAGE 3
+#endif
 	MOV64   x0, SCTLR_EL1_DEFAULT
 	MSR_SCTLR_EL1_X0
 	isb		sy
+#if defined(FUXI)
+	FUXI_EARLY_STAGE 4
+#endif
 
 #if !VMAPPLE
 	MOV64	x1, SCTLR_EL1_DEFAULT
