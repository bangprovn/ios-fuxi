+			const char *upper = lower + blob->csb_mem_size;
+			size_t length = MIN((size_t)16384, chunk_length - block);
+			offset = chunk + block;
+			expected = hashes(cd, (uint32_t)(offset >> 14), md->cs_size, lower, upper);
+			if (expected == NULL) {
