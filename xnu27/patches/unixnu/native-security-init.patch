+	/* A boot collection component whose start leaves its security policy unregistered names its
+	 * own registration routine in _NativePrelinkEarlySecurityInit. It runs here, with dependencies
+	 * and constructors ready and before MAC policy lockdown. Original component code runs; no
+	 * policy result is supplied.
+	 */
+	if (result == KERN_SUCCESS && getPropertyForHostArch("_NativePrelinkEarlySecurityInit") != NULL) {
+#if CONFIG_MACF
+		OSNumber *earlyInit = OSDynamicCast(OSNumber, getPropertyForHostArch("_NativePrelinkEarlySecurityInit"));
+		uintptr_t target = 0;
+		bool executable = false;
+		if (!earlyInit || !isPrelinked() || mac_late ||
+		    getPropertyForHostArch(kAppleSecurityExtensionKey) != kOSBooleanTrue ||
+		    __builtin_add_overflow((uintptr_t)earlyInit->unsigned64BitValue(), vm_kernel_slide, &target) ||
+		    (target & 3)) {
+			panic("NativePrelink: invalid early security initializer or phase for %s", getIdentifierCString());
+		}
+		kernel_mach_header_t *header = (kernel_mach_header_t *)kmod_info->address;
+		for (kernel_segment_command_t *seg = firstsegfromheader(header); seg != NULL;
+		    seg = nextsegfromheader(header, seg)) {
+			if (seg->initprot == (VM_PROT_READ | VM_PROT_EXECUTE) && !(seg->maxprot & VM_PROT_WRITE) &&
+			    seg->vmsize >= 4 && target >= seg->vmaddr && target - seg->vmaddr <= seg->vmsize - 4) {
+				executable = true;
+				break;
+			}
+		}
+		if (!executable) {
+			panic("NativePrelink: early security initializer %p outside %s code", (void *)target,
+			    getIdentifierCString());
+		}
+		/*
+		 * A function pointer cast here is signed with the type discriminator but called with a zero one,
+		 * so the call fails authentication. Branch to the checked address directly; the entry is a
+		 * BTI-c function and the clobbers are the AAPCS64 caller-saved set.
+		 */
+		register uint64_t x0 __asm__("x0");
+		register uint64_t x16 __asm__("x16") = target;
+		__asm__ volatile ("blr x16"
+		    : "=r"(x0), "+r"(x16)
+		    :
+		    : "x1", "x2", "x3", "x4", "x5", "x6", "x7", "x8", "x9", "x10", "x11", "x12", "x13", "x14", "x15",
+		    "x17", "x30", "v0", "v1", "v2", "v3", "v4", "v5", "v6", "v7", "v16", "v17", "v18", "v19", "v20",
+		    "v21", "v22", "v23", "v24", "v25", "v26", "v27", "v28", "v29", "v30", "v31", "cc", "memory");
+		result = (int)x0;
+		if (result != KERN_SUCCESS) {
+			OSKextLog(this, kOSKextLogErrorLevel | kOSKextLogLoadFlag,
+			    "Kext %s early security initializer failed: %d", getIdentifierCString(), result);
+		}
+#else
+		panic("NativePrelink: early security initializer requires the MAC framework");
+#endif
+	}
+
 	flags.starting = 0;
 
