 	OSKextLogKextInfo(this, kmod_info->address, kmod_info->size, firehose_tracepoint_code_load);
 	result = OSRuntimeInitializeCPP(this);
 	if (result == KERN_SUCCESS) {
+#if defined(XNU_SOURCE_CORECRYPTO14)
+		if (kmod_info == source_corecrypto14_original()) {
+			/* The kernel already started the original corecrypto; share that one result. */
+			result = source_corecrypto14_start_once(kmod_info, kmodStartData);
