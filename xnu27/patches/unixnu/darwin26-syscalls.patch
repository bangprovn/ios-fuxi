+	}
+	if (flags & O_CLOFORK) {
+		fp_flags |= FP_CLOFORK;
+	}
+
 	error = pipepair_alloc(&rpipe, &wpipe);
 	if (error) {
 		return error;
@@ -409,7 +452,8 @@ pipe(proc_t p, __unused struct pipe_args *uap, int32_t *retval)
