      "symbols": [
        "lx_os_alloc",
        "lx_os_free",
        "lx_os_lock",
        "lx_os_nanoseconds",
        "lx_os_option",
        "lx_os_panic",
        "lx_os_print",
        "lx_os_random",
        "lx_os_sleep",
        "lx_os_tell",
        "lx_os_thread",
        "lx_os_thread_self",
