        "__stack_chk_guard",
        "bzero",
        "memcmp",
        "memcpy",
        "memmove",
        "memset",
        "snprintf",
        "strchr",
        "strcmp",
        "strlcat",
        "strlcpy",
        "strlen",
        "strncmp",
        "strrchr",
        "vsnprintf"
      ]
    },
    "fuxi-ath12k-os": {
